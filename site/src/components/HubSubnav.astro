---
// Same visual language as TimeAttackSubnav.astro -- kept in sync intentionally.
interface Props {
  active?: 'overview' | 'events' | 'crews' | 'tracks' | null;
}
const { active = null } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { key: 'overview', label: 'Overview', href: `${base}community/` },
  { key: 'events', label: 'Events', href: `${base}community/events/` },
  { key: 'crews', label: 'Crews', href: `${base}community/crews/` },
  { key: 'tracks', label: 'Tracks', href: `${base}community/tracks/` },
];
---
<div class="subnav-bar">
  <div class="wrap">
    <nav class="subnav-tabs" aria-label="The Hub">
      {links.map((l) => (
        <a href={l.href} class:list={['subnav-tab', { 'is-active': active === l.key }]} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</div>

<style>
  .subnav-bar { border-bottom: 1px solid var(--gh-line); margin-bottom: 1.5rem; }
  .subnav-tabs { display: flex; gap: .5rem; }
  .subnav-tab { color: var(--gh-muted); text-decoration: none; font-family: var(--gh-font-body); font-weight: 600; text-transform: uppercase; font-size: .8rem; letter-spacing: .08em; padding: .7rem 1rem; border-top: 2px solid transparent; border-bottom: 2px solid transparent; }
  .subnav-tab:hover { color: var(--gh-text); }
  .subnav-tab.is-active { color: var(--gh-text); border-bottom-color: var(--gh-red); }
  @media (max-width: 760px) {
    .subnav-tabs { gap: .25rem; overflow-x: auto; }
  }
  /* phone: all four tabs visible without sideways scrolling (Tracks added, RS-0045) */
  @media (max-width: 480px) {
    .subnav-tabs { gap: 0; justify-content: space-between; }
    .subnav-tab { padding: .7rem .45rem; font-size: .78rem; }
  }
</style>
