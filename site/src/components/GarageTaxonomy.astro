---
// Class / manufacturer landing page (RS-0050, DEC-0087; redesign after the mockup
// boards ClassPage / ClassPageActive / ClassPageMobile, DEC-0130). Image band with
// intro + "at a glance" panel, class chips, the shared car list (CarsBrowser) and
// "More on …" links. Manufacturer pages use the same layout (no own mockup, DEC-0130).
// SEO title/description/JSON-LD unchanged (Codex copy 2026-10-01).
// COPY STATUS: band + About from data/taxonomy-copy.ts (approved 16.10.); labels after Codex review (DEC-0130).
import Base from '../layouts/Base.astro';
import CarsBrowser from './CarsBrowser.astro';
import { compareGarageOrder, vehicleOptions, vehicleValues, fastestGellhornLapMs, bandVehicle, type VehicleOption } from '../data/vehicles';
import { classPages, manufacturerPages, classSlug, type TaxonomyPage } from '../data/garage-taxonomy';
import { lapTime } from '../data/leaderboard';
import { taxonomyCopy } from '../data/taxonomy-copy';
import { LAUNCH_DATE, LAUNCH_AT } from '../data/launch';
import '../styles/garage-tile.css';

/** New cars + model family pages use the same layout (DEC-0147, Fausto 20.10.2026). */
export interface TaxonomyCustom {
  path: string;
  crumbs: { name: string; href?: string }[];
  breadcrumbs: { name: string; path: string }[];
  eyebrow: string;
  heading: string;
  lede: string;
  metaTitle: string;
  metaDescription: string;
  noindex?: boolean;
  /** vehicle id whose garage photo fills the band, plus object-position */
  band?: { id?: string; src?: string; pos: string; style?: string }; // src: /images/... base path, files <src>-{640,1280,1920}.webp
  glanceTitle: string;
  countLabel: string;
  glance: { k: string; v: string }[]; // v: trusted HTML
  about?: { title: string; paras: string[] };
  chips?: { label: string; items: { name: string; href: string; count: number; on: boolean; logo?: string }[] };
  links: { title: string; items: { name: string; href: string; count?: number }[]; all?: { name: string; href: string } }[];
  noun: string;
  /** Cars-style head (DEC-0163): compact band and the My Garage tile instead of the glance tile */
  garageTile?: boolean;
  /** hide the class or manufacturer filter (e.g. a one-make family) */
  scope?: 'class' | 'make' | null;
}
interface Props {
  kind: 'class' | 'manufacturer' | 'custom';
  page: TaxonomyPage;
  vehicles: VehicleOption[];
  /** Search-facing name, e.g. "Sports Cars" / "Bravado Cars". */
  label: string;
  custom?: TaxonomyCustom;
}
const { kind, page, vehicles, label, custom } = Astro.props;
const base = import.meta.env.BASE_URL;
const isClass = kind === 'class';
const list = [...vehicles].sort(compareGarageOrder);
const N = list.length;
const path = custom?.path ?? `cars/${isClass ? 'classes' : 'manufacturers'}/${page.slug}/`;
const metaTitle = isClass ? `GTA VI ${label}` : `${label} in GTA VI`;
const copy = taxonomyCopy[page.slug];
const heading = copy?.h1 ?? label; // visible H1 without "GTA VI" (DEC-0130); GTA VI stays in title, eyebrow, meta
const seoName = isClass ? `GTA VI ${label}` : `${label} in GTA VI`;
// before launch: "After launch"; after: field-specific empty state (Codex review 16.10.)
const launched = Date.now() >= new Date(LAUNCH_AT ?? `${LAUNCH_DATE}T00:00:00Z`).getTime();
const noLap = launched ? 'No lap recorded yet' : 'After launch';
const noSpeed = launched ? 'No speed recorded yet' : 'After launch';
const metaDescription = isClass
  ? `Browse GTA 6 ${page.name} vehicles in The Garage. Compare models, key vehicle characteristics, real-life inspirations, release details, and available performance data.`
  : `Explore ${page.name} vehicles in GTA 6. See the real-world inspiration behind each model and compare key characteristics and available performance data.`;
const pageUrl = new URL(`${base}${path}`, Astro.site).href;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: seoName,
  url: pageUrl,
  description: metaDescription,
  about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI', alternateName: ['GTA VI', 'GTA 6'] },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: list.length,
    itemListElement: list.map((v, i) => ({ '@type': 'ListItem', position: i + 1, name: `${v.make} ${v.model}`, url: new URL(`${base}cars/vehicles/${v.id}/`, Astro.site).href })),
  },
}];

// ---- image band: fastest car with a photo, else first photo, else the garage ----
const bandCar = custom?.band?.id ? list.find((v) => v.id === custom.band!.id) ?? bandVehicle(list) : bandVehicle(list);
const bandSrc = custom?.band?.src ? `${base}${custom.band.src}` : bandCar ? `${base}images/vehicles/${bandCar.id}` : null;
const bandPos = custom?.band && (custom.band.src || bandCar?.id === custom.band.id) ? custom.band.pos : undefined;
const bandStyle = [bandPos ? `object-position:${bandPos}` : '', custom?.band?.style ?? ''].filter(Boolean).join(';') || undefined;

// ---- at a glance ----
const lapOf = (v: VehicleOption) => fastestGellhornLapMs(v.id);
const fastest = list.filter((v) => lapOf(v) != null).sort((a, b) => lapOf(a)! - lapOf(b)!)[0] ?? null;
const speedOf = (v: VehicleOption) => vehicleValues[v.id]?.top_speed_mph?.value ?? null;
const topSpeed = list.filter((v) => speedOf(v) != null).sort((a, b) => speedOf(b)! - speedOf(a)!)[0] ?? null;
const shortName = (v: VehicleOption) => (isClass ? `${v.make} ${v.model}` : v.model);

// ---- chips + links ----
const classCount = (slug: string) => vehicleOptions.filter((v) => v.classes.some((c) => classSlug(c) === slug)).length;
const makeCount = (slug: string) => vehicleOptions.filter((v) => v.logoSlug === slug).length;
const makesHere = [...new Map(list.map((v) => [v.logoSlug, v.make])).entries()].sort((a, b) => a[1].localeCompare(b[1]));
const classesHere = [...new Set(list.flatMap((v) => v.classes))].sort();
const makeHere = (slug: string) => list.filter((v) => v.logoSlug === slug).length;
const classHere = (name: string) => list.filter((v) => v.classes.includes(name)).length;
const noun = isClass ? `${page.name} cars` : `${page.name} cars`;
const lbClass = isClass ? page.name : null;

const ico = {
  trophy: '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg>',
  timer: '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg>',
  plus: '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>',
};
const more = custom
  ? [
      { ico: ico.trophy, eb: 'Ranking', t: 'Fastest cars in GTA VI', s: 'Available stock top-speed results, with the source of each value.', a: 'See the ranking', href: `${base}cars/rankings/fastest/` },
      { ico: ico.timer, eb: 'Time Attack', t: 'Gellhorn leaderboard', s: 'Driver-submitted laps at Gellhorn. Filter by car to find available times.', a: 'Open leaderboard', href: `${base}time-attack/gellhorn-international-raceway/#leaderboard` },
      { ico: ico.plus, eb: 'Compare', t: `Compare ${custom.heading}`, s: 'Pick up to four cars and compare their available specs and lap times.', a: 'Start comparing', href: `${base}cars/compare/` },
    ]
  : isClass
  ? [
      { ico: ico.trophy, eb: 'Ranking', t: `Fastest ${heading} in GTA 6`, s: 'Recorded top speeds in stock form, with the source of each value.', a: 'See the ranking', href: `${base}cars/rankings/fastest/${page.slug}/` },
      { ico: ico.timer, eb: 'Time Attack', t: `${page.name} leaderboard at Gellhorn`, s: 'Recorded driver laps at Gellhorn for this class.', a: 'Open leaderboard', href: `${base}time-attack/gellhorn-international-raceway/?class=${encodeURIComponent(page.name)}#leaderboard` },
      { ico: ico.plus, eb: 'Compare', t: `Compare ${heading}`, s: 'Pick up to four cars and compare their available specs and lap times.', a: 'Start comparing', href: `${base}cars/compare/` },
    ]
  : [
      { ico: ico.trophy, eb: 'Ranking', t: 'Fastest cars in GTA 6', s: 'Recorded top speeds in stock form, with the source of each value.', a: 'See the ranking', href: `${base}cars/rankings/fastest/` },
      { ico: ico.timer, eb: 'Time Attack', t: `${page.name} leaderboard at Gellhorn`, s: 'Recorded driver laps at Gellhorn for this manufacturer.', a: 'Open leaderboard', href: `${base}time-attack/gellhorn-international-raceway/?make=${encodeURIComponent(page.slug)}#leaderboard` },
      { ico: ico.plus, eb: 'Compare', t: `Compare ${heading}`, s: 'Pick up to four cars and compare their available specs and lap times.', a: 'Start comparing', href: `${base}cars/compare/` },
    ];
---
<Base
  title={custom?.metaTitle ?? metaTitle}
  description={custom?.metaDescription ?? metaDescription}
  section="garage"
  jsonLd={custom ? undefined : jsonLd}
  noindex={custom?.noindex}
  breadcrumbs={custom?.breadcrumbs ?? [{ name: 'Cars', path: 'cars/' }, { name: isClass ? 'Classes' : 'Manufacturers', path: `cars/${isClass ? 'classes' : 'manufacturers'}/` }, { name: page.name, path }]}
>
  <section class="tb">
    {bandSrc
      ? <img class="tb-bg" style={bandStyle} src={`${bandSrc}-1280.webp`} srcset={`${bandSrc}-640.webp 640w, ${bandSrc}-1280.webp 1280w, ${bandSrc}-1920.webp 1920w`} sizes="100vw" alt="" width="1920" height="1080" fetchpriority="high" />
      : <img class="tb-bg tb-ph" src={`${base}images/garage/garage-hero-placeholder-1080.webp`} alt="" width="1080" height="608" fetchpriority="high" />}
    <span class="lr-shade is-open" aria-hidden="true"></span>
    <div class:list={['wrap tb-inner lr-band-in', { 'is-compact is-cars': custom?.garageTile }]}>
      {custom ? (
        <div class="tb-copy">
          <nav class="lr-crumb" aria-label="Breadcrumb">
            {custom.crumbs.map((c, i) => <Fragment>{i > 0 && <span aria-hidden="true">/</span>}{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</Fragment>)}
          </nav>
          <p class="eyebrow">{custom.eyebrow}</p>
          <h1 class="display lr-t2 tb-title">{custom.heading}</h1>
          <p class="lr-lede">{custom.lede}</p>
        </div>
      ) : (
      <div class="tb-copy">
        <nav class="lr-crumb" aria-label="Breadcrumb">
          <a href={`${base}cars/`}>Cars</a><span aria-hidden="true">/</span><a href={`${base}cars/${isClass ? 'classes' : 'manufacturers'}/`}>{isClass ? 'Classes' : 'Manufacturers'}</a><span aria-hidden="true">/</span><span aria-current="page">{page.name}</span>
        </nav>
        <p class="eyebrow">{isClass ? 'GTA VI Vehicle Class' : 'GTA VI Manufacturer'}</p>
        <h1 class="display lr-t2 tb-title">{!isClass && <img class="tb-logo" src={`${base}images/logos/${page.slug}-gta-6-logo.svg`} alt="" width="56" height="56" />}{heading}</h1>
        <p class="lr-lede">{copy?.band ?? page.intro[0]}</p>
      </div>
      )}
      {custom?.garageTile ? (
        <a class="garage-tile" id="garage-tile" href={`${base}account/garage/`}>
          <span class="gt-top"><span class="gt-eb">My Garage</span><span class="arrow gt-cta" id="gt-cta">Log in to start →</span></span>
          <span class="gt-val"><span id="gt-owned">0</span> <small>/ {N} owned</small></span>
          <span class="mbar"><i id="gt-bar" style="width:0%"></i></span>
        </a>
      ) : custom ? (
        <div class="glance">
          <p class="glance-eb">{custom.glanceTitle}</p>
          <div class="gl-row"><span>{custom.countLabel}</span><b class="tnum">{N}</b></div>
          {custom.glance.map((g) => <div class="gl-row"><span>{g.k}</span><b set:html={g.v} /></div>)}
          <div class="gl-row"><span>Fastest at Gellhorn</span>{fastest
            ? <b><a href={`${base}cars/vehicles/${fastest.id}/`}>{fastest.model}</a>{' · '}<span class="tnum">{lapTime(lapOf(fastest)!)}</span></b>
            : <b class="is-tba">{noLap}</b>}</div>
          <a class="gl-row gl-garage" id="garage-tile" data-glance href={`${base}account/garage/`}>
            <span>In your garage</span><span class="arrow gt-cta" id="gt-cta">Log in to save cars →</span>
            <span id="gt-owned" hidden>0</span>
            <span class="mbar"><i id="gt-bar" style="width:0%"></i></span>
          </a>
        </div>
      ) : (
      <div class="glance">
        <p class="glance-eb">{page.name} at a glance</p>
        <div class="gl-row"><span>{isClass ? 'Cars in this class' : `Cars from ${page.name}`}</span><b class="tnum">{N}</b></div>
        <div class="gl-row"><span>Fastest at Gellhorn</span>{fastest
          ? <b><a href={`${base}cars/vehicles/${fastest.id}/`}>{shortName(fastest)}</a>{' · '}<span class="tnum">{lapTime(lapOf(fastest)!)}</span></b>
          : <b class="is-tba">{noLap}</b>}</div>
        <div class="gl-row"><span>Highest top speed</span>{topSpeed
          ? <b><a href={`${base}cars/vehicles/${topSpeed.id}/`}>{shortName(topSpeed)}</a>{' · '}<span class="tnum">{speedOf(topSpeed)} mph</span></b>
          : <b class="is-tba">{noSpeed}</b>}</div>
        <a class="gl-row gl-garage" id="garage-tile" data-glance href={`${base}account/garage/`}>
          <span>In your garage</span><span class="arrow gt-cta" id="gt-cta">Log in to save cars →</span>
          <span id="gt-owned" hidden>0</span>
          <span class="mbar"><i id="gt-bar" style="width:0%"></i></span>
        </a>
      </div>
      )}
    </div>
  </section>

  {isClass && (
    <nav class="wrap tchips" aria-label="Classes" data-collapse>
      {classPages.map((c) => <a class:list={['tchip', { on: c.slug === page.slug }]} href={`${base}cars/classes/${c.slug}/`} aria-current={c.slug === page.slug ? 'page' : undefined}>{c.name}<span>{classCount(c.slug)}</span></a>)}
      <a class="tchip" href={`${base}cars/`}>All cars<span>{vehicleOptions.length}</span></a>
    </nav>
  )}

  {kind === 'manufacturer' && (
    <nav class="wrap tchips tchips-make" aria-label="Manufacturers" id="mchips" data-collapse>
      {manufacturerPages.map((m) => <a class:list={['tchip', { on: m.slug === page.slug }]} href={`${base}cars/manufacturers/${m.slug}/`} aria-current={m.slug === page.slug ? 'page' : undefined}><img class="tchip-logo" src={`${base}images/logos/${m.slug}-gta-6-logo.svg`} alt="" width="20" height="20" loading="lazy" />{m.name}<span>{makeCount(m.slug)}</span></a>)}
      <a class="tchip" href={`${base}cars/manufacturers/`}>All manufacturers</a>
    </nav>
  )}

  {custom?.chips && (
    <nav class="wrap tchips" aria-label={custom.chips.label} data-collapse>
      {custom.chips.items.map((c) => <a class:list={['tchip', { on: c.on }]} href={c.href} aria-current={c.on ? 'page' : undefined}>{c.logo && <img class="tchip-logo" src={c.logo} alt="" width="20" height="20" loading="lazy" />}{c.name}<span>{c.count}</span></a>)}
    </nav>
  )}

  <CarsBrowser vehicles={list} scope={custom ? (custom.scope ?? null) : isClass ? 'class' : 'make'} noun={custom?.noun ?? noun} defaultSort="name">
    <Fragment slot="after-grid">
      <section class="wrap tmore">
        <p class="tsec-eb">More on {heading}</p>
        <div class="tmore-grid">
          {more.map((m) => (
            <a class="tm" href={m.href}>
              <span class="tm-eb"><Fragment set:html={m.ico} />{m.eb}</span>
              <b class="tm-t">{m.t}</b>
              <span class="tm-s">{m.s}</span>
              <span class="arrow tm-a">{m.a} →</span>
            </a>
          ))}
        </div>
      </section>
      {custom?.about && (
        <section class="wrap tabout" aria-labelledby="tabout-h">
          <h2 class="lr-h2 tabout-h" id="tabout-h">{custom.about.title}</h2>
          {custom.about.paras.map((p) => <p>{p}</p>)}
        </section>
      )}
      {!custom && copy && (
        <section class="wrap tabout" aria-labelledby="tabout-h">
          <h2 class="lr-h2 tabout-h" id="tabout-h">{copy.aboutTitle}</h2>
          {copy.about.map((p) => <p>{p}</p>)}
        </section>
      )}
      <section class="wrap tlinks">
        {custom ? custom.links.map((l) => (
          <div>
            <p class="tsec-eb">{l.title}</p>
            <div class="tls">{l.items.map((it) => <a href={it.href}>{it.name}{it.count != null && <span>{it.count}</span>}</a>)}{l.all && <a class="arrow" href={l.all.href}>{l.all.name} →</a>}</div>
          </div>
        )) : isClass ? (
          <>
            <div>
              <p class="tsec-eb">Other classes</p>
              <div class="tls">{classPages.filter((c) => c.slug !== page.slug).map((c) => <a href={`${base}cars/classes/${c.slug}/`}>{c.name}</a>)}<a class="arrow" href={`${base}cars/classes/`}>All classes →</a></div>
            </div>
            <div>
              <p class="tsec-eb">{heading} by manufacturer</p>
              <div class="tls">{makesHere.filter(([slug]) => manufacturerPages.some((m) => m.slug === slug)).map(([slug, name]) => <a href={`${base}cars/manufacturers/${slug}/`}>{name}<span>{makeHere(slug)}</span></a>)}<a class="arrow" href={`${base}cars/manufacturers/`}>All manufacturers →</a></div>
            </div>
          </>
        ) : (
          <>
            <div>
              <p class="tsec-eb">{page.name} cars by class</p>
              <div class="tls">{classesHere.map((c) => classPages.some((p) => p.slug === classSlug(c)) ? <a href={`${base}cars/classes/${classSlug(c)}/`}>{c}<span>{classHere(c)}</span></a> : <span>{c}<span>{classHere(c)}</span></span>)}<a class="arrow" href={`${base}cars/classes/`}>All classes →</a></div>
            </div>
            <div>
              <p class="tsec-eb">Other manufacturers</p>
              <div class="tls">{manufacturerPages.filter((m) => m.slug !== page.slug).map((m) => <a href={`${base}cars/manufacturers/${m.slug}/`}>{m.name}<span>{makeCount(m.slug)}</span></a>)}<a class="arrow" href={`${base}cars/manufacturers/`}>All manufacturers →</a></div>
            </div>
          </>
        )}
      </section>
    </Fragment>
  </CarsBrowser>
</Base>

<script>
  // Chip rows (Fausto 18.10.): desktop shows one row; the current chip moves to the front and a
  // "+N more" chip at the end of the row opens the rest underneath. Phone: one swipeable row with
  // the current chip in view. Without JS all chips show (wrapped), so every link stays crawlable.
  const rows = [...document.querySelectorAll<HTMLElement>('[data-collapse]')];
  const mq = window.matchMedia('(max-width: 860px)');
  function layout(row: HTMLElement) {
    const chips = [...row.querySelectorAll<HTMLElement>('.tchip')];
    row.querySelector('.tchip-more')?.remove();
    chips.forEach((c) => c.classList.remove('is-x'));
    const on = row.querySelector<HTMLElement>('.tchip.on');
    if (mq.matches) {
      if (on) row.scrollLeft = Math.max(0, on.offsetLeft - row.offsetLeft - 16);
      return;
    }
    if (on && row.firstElementChild !== on) row.prepend(on);
    if (row.dataset.open === '1') return addToggle(row, 0, true);
    const ordered = [...row.querySelectorAll<HTMLElement>('.tchip')];
    const top = ordered[0].offsetTop;
    let hidden = ordered.filter((c) => c.offsetTop > top);
    if (!hidden.length) return;
    hidden.forEach((c) => c.classList.add('is-x'));
    const btn = addToggle(row, hidden.length, false);
    // make room for the toggle at the end of the first row
    const visible = ordered.filter((c) => !hidden.includes(c));
    while (btn.offsetTop > top && visible.length > 1) {
      const last = visible.pop()!;
      last.classList.add('is-x');
      hidden = [last, ...hidden];
      btn.textContent = `+${hidden.length} more`;
    }
  }
  function addToggle(row: HTMLElement, n: number, open: boolean) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'tchip tchip-more';
    b.setAttribute('aria-expanded', String(open));
    b.textContent = open ? 'Show less' : `+${n} more`;
    b.addEventListener('click', () => { row.dataset.open = open ? '0' : '1'; layout(row); });
    row.append(b);
    return b;
  }
  const run = () => rows.forEach(layout);
  run();
  let t = 0;
  window.addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(run, 120); });
  document.fonts?.ready.then(run);
</script>

<style>
  .ico, .tm :global(.ico) { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .is-tba { color: var(--lr-muted) !important; font-weight: 500 !important; }

  /* ---- image band ---- */
  .tb { position: relative; overflow: hidden; border-bottom: 1px solid rgba(200,200,222,.22); }
  .tb-bg, .tb-t { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tb-bg { object-fit: cover; object-position: 50% 55%; }
  .tb-ph { filter: grayscale(.5); }
  .tb-inner { display: flex; align-items: flex-start; justify-content: space-between; gap: 48px; }
  /* Tile sits on the lower edge of the photo band (Fausto 22.10.2026, DEC-0154): text top, tile bottom. */
  @media (min-width: 1101px) { .tb-inner > .glance { align-self: flex-end; margin-top: 0; } }
  /* Cars-style head (New cars): same layout as the Cars page — tile beside the text down to 761px, bottom edge */
  @media (min-width: 761px) { .tb-inner.is-cars { flex-direction: row; gap: 40px; } .tb-inner.is-cars > .garage-tile { align-self: flex-end; } }
  @media (max-width: 760px) { .tb-inner.is-cars { flex-direction: column; align-items: stretch; gap: 16px; } }
  .tb-copy { min-width: 0; max-width: 700px; }
  .tb-title { display: flex; align-items: center; gap: 16px; }
  .tb-logo { width: 56px; height: 56px; flex: none; object-fit: contain; filter: brightness(0) invert(1); }

  .glance { flex: none; width: 380px; margin-top: 30px; padding: 18px 18px 14px; border: 1px solid rgba(200,200,222,.2); border-radius: 8px; background: rgba(20,20,31,.88); backdrop-filter: blur(6px); }
  .glance-eb { margin: 0 0 6px; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-orange); }
  .gl-row { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; padding: 9px 0; border-top: 1px solid var(--lr-line); font-size: 15px; color: var(--lr-soft); }
  .gl-row:first-of-type { border-top: 0; }
