---
// The Guide is one page: the tabs jump to its sections. Same visual language
// as HubSubnav / TimeAttackSubnav (Fausto, 2026-10-03: header like Garage/Hub).
const links = [
  ['vehicles', 'Vehicles'], ['granforma', 'GranForma'], ['driving', 'Driving'], ['heat', 'Heat'], ['ownership', 'Ownership'], ['customization', 'Customization'],
  ['racing', 'Racing'], ['car-culture', 'Car Culture'], ['faq', 'FAQ'], ['sources', 'Sources'],
];
---
<div class="subnav-bar">
  <div class="wrap">
    <nav class="subnav-tabs" aria-label="On this page">
      {links.map(([id, label]) => <a href={`#${id}`} class="subnav-tab">{label}</a>)}
    </nav>
  </div>
</div>

<style>
  .subnav-bar { border-bottom: 1px solid var(--gh-line); margin-bottom: 1.5rem; }
  .subnav-tabs { display: flex; gap: .5rem; overflow-x: auto; scrollbar-width: none; }
  .subnav-tabs::-webkit-scrollbar { display: none; }
  .subnav-tab { flex: none; color: var(--gh-muted); text-decoration: none; font-family: var(--gh-font-body); font-weight: 600; text-transform: uppercase; font-size: .8rem; letter-spacing: .08em; padding: .7rem 1rem; border-top: 2px solid transparent; border-bottom: 2px solid transparent; }
  .subnav-tab:hover { color: var(--gh-text); border-bottom-color: var(--gh-red); }
  @media (max-width: 760px) {
    .subnav-tabs { gap: .25rem; }
    .subnav-tab { padding: .7rem .6rem; font-size: .78rem; }
  }
</style>
