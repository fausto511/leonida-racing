---
// Units switch (DEC-0197): km/h · km | mph · mi. Footer (size "sm") and Settings (size "md").
// Same segmented look as the other switches (My cars | Wishlist). The choice is kept in this
// browser; without a choice the site picks the units from the device's time zone (Base.astro).
// Labels are placeholders until Codex delivers the copy (DEC-0088).
interface Props { size?: 'sm' | 'md'; label?: string }
const { size = 'md', label = 'Units' } = Astro.props;
---
<div class:list={['u-switch', `u-switch-${size}`]} role="group" aria-label={label}>
  <button type="button" data-units-set="metric" aria-pressed="false">km/h · km</button>
  <button type="button" data-units-set="imperial" aria-pressed="false">mph · mi</button>
</div>

<style>
  .u-switch { display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--lr-line); border-radius: 8px; background: var(--lr-card); }
  .u-switch button { display: inline-flex; align-items: center; justify-content: center; height: 36px; padding: 0 14px; border: 0; border-radius: 5px; background: transparent; color: var(--lr-muted); font: 600 14px var(--gh-font-body); white-space: nowrap; cursor: pointer; }
  .u-switch button:hover { color: var(--lr-text); }
  .u-switch button[aria-pressed="true"] { background: var(--lr-raised); color: var(--lr-text); }
  .u-switch button:focus-visible { outline: 2px solid var(--lr-orange); outline-offset: -2px; }
  .u-switch-sm { padding: 3px; gap: 2px; }
  .u-switch-sm button { height: 26px; padding: 0 10px; font-size: 12px; }
</style>

<script>
  import { UNITS_KEY, currentUnits, type Units } from '../data/units';
  function paint() {
    const u = currentUnits();
    document.querySelectorAll<HTMLElement>('[data-units-set]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.unitsSet === u)));
  }
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-units-set]');
    if (!b) return;
    const u = b.dataset.unitsSet as Units;
    if (u === currentUnits()) return;
    document.documentElement.dataset.units = u;
    try { localStorage.setItem(UNITS_KEY, u); } catch {}
    paint();
    // pages that draw values in script (Cars filters, Compare) redraw on this
    document.dispatchEvent(new CustomEvent('lr-units', { detail: { units: u } }));
  });
  paint();
</script>
