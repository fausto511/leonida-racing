---
// Shared layout for Legal Notice, Privacy Policy and Terms of Use (redesign 21.10.2026, DEC-0150).
// Compact band without photo, switcher between the three documents, "On this page" navigation
// (sticky on desktop, collapsible on the phone), readable text column. The texts themselves are
// unchanged and live in the pages. The TOC is built from the h2 headings in the browser; headings
// keep existing ids (e.g. #contact, #analytics) and get one from their text otherwise.
import Base from '../layouts/Base.astro';
interface Props { title: string; description: string; heading: string; kicker: string; updated?: string; current: 'legal' | 'privacy' | 'terms' }
const { title, description, heading, kicker, updated, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const docs = [
  { id: 'legal', name: 'Legal Notice', href: `${base}legal/` },
  { id: 'privacy', name: 'Privacy Policy', href: `${base}privacy/` },
  { id: 'terms', name: 'Terms of Use', href: `${base}terms/` },
];
---
<Base title={title} description={description}>
  <section class="lg-band">
    <div class="wrap lr-band-in is-compact lg-band-in">
      <nav class="lr-crumb" aria-label="Breadcrumb"><a href={base}>Home</a><span aria-hidden="true">/</span><span aria-current="page">{heading}</span></nav>
      <p class="eyebrow">{kicker}</p>
      <h1 class="display lr-t2">{heading}</h1>
      {updated && <p class="lg-updated">{updated}</p>}
    </div>
  </section>

  <nav class="wrap lg-docs" aria-label="Legal documents">
    {docs.map((d) => <a class:list={['lg-doc', { on: d.id === current }]} href={d.href} aria-current={d.id === current ? 'page' : undefined}>{d.name}</a>)}
    <a class="lg-doc" href={`${base}privacy/#analytics`} data-consent-open>Privacy settings</a>
  </nav>

  <div class="wrap lg">
    <aside class="lg-toc-wrap" aria-label="On this page">
      <details class="lg-toc" open>
        <summary>On this page</summary>
        <ol id="lg-toc-list"></ol>
      </details>
    </aside>
    <article class="lg-body" id="lg-body">
      <slot />
    </article>
  </div>
</Base>

<script>
  const body = document.getElementById('lg-body');
  const list = document.getElementById('lg-toc-list');
  if (body && list) {
    const used = new Set<string>();
    const slug = (t: string) => t.toLowerCase().replace(/^\d+\.\s*/, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'section';
    body.querySelectorAll('h2').forEach((h) => {
      let id = h.id || slug(h.textContent ?? '');
      while (!h.id && (used.has(id) || document.getElementById(id))) id += '-x';
      if (!h.id) h.id = id;
      used.add(h.id);
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${h.id}`; a.textContent = (h.textContent ?? '').trim();
      li.appendChild(a); list.appendChild(li);
    });
    // phone: the list starts collapsed
    const det = list.closest('details');
    if (det && window.matchMedia('(max-width: 960px)').matches) det.open = false;
    // highlight the section in view
    const links = new Map([...list.querySelectorAll('a')].map((a) => [a.getAttribute('href')!.slice(1), a]));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { links.forEach((a) => a.classList.remove('on')); links.get((en.target as HTMLElement).id)?.classList.add('on'); } });
    }, { rootMargin: '-20% 0px -70% 0px' });
    body.querySelectorAll('h2').forEach((h) => io.observe(h));
  }
</script>

<style>
  .lg-band { position: relative; border-bottom: 1px solid rgba(200,200,222,.22); background:
    radial-gradient(120% 140% at 100% 0%, rgba(255,62,165,.14), transparent 55%),
    radial-gradient(90% 120% at 85% 100%, rgba(255,149,90,.10), transparent 60%),
    var(--lr-card); }
  .lg-band-in { display: flex; flex-direction: column; justify-content: center; }
  .lg-updated { margin: 14px 0 0; font-size: 14px; color: var(--lr-soft); }

  .lg-docs { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 24px; }
  .lg-doc { display: inline-flex; align-items: center; height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid rgba(200,200,222,.24); color: #E4E4EC; font-size: 15px; font-weight: 500; text-decoration: none; white-space: nowrap; }
  .lg-doc:hover { border-color: var(--lr-pink); color: var(--lr-text); }
  .lg-doc.on { background: var(--lr-text); border-color: var(--lr-text); color: #14141F; font-weight: 600; }

  .lg { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 56px; align-items: start; padding-top: 40px; padding-bottom: 80px; }
  .lg-toc-wrap { position: sticky; top: 96px; }
  .lg-toc summary { list-style: none; cursor: default; margin: 0 0 12px; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-soft); }
  .lg-toc summary::-webkit-details-marker { display: none; }
  .lg-toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; border-left: 1px solid var(--lr-line); }
  .lg-toc :global(a) { display: block; margin-left: -1px; padding: 6px 0 6px 14px; border-left: 2px solid transparent; font-size: 14px; line-height: 1.35; color: var(--lr-muted); text-decoration: none; }
  .lg-toc :global(a:hover) { color: var(--lr-text); }
  .lg-toc :global(a.on) { color: var(--lr-text); border-left-color: var(--lr-pink); }

  .lg-body { max-width: 720px; }
  .lg-body :global(h2) { margin: 40px 0 12px; padding-top: 28px; border-top: 1px solid var(--lr-line); font-size: 21px; font-weight: 700; line-height: 1.3; color: var(--lr-text); scroll-margin-top: 96px; }
  .lg-body :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .lg-body :global(h3) { margin: 22px 0 8px; font-size: 16px; font-weight: 700; color: var(--lr-text); }
  .lg-body :global(p), .lg-body :global(li) { font-size: 16px; line-height: 1.7; color: #CFCFDA; }
  .lg-body :global(p) { margin: 0 0 14px; }
  .lg-body :global(ul), .lg-body :global(ol) { margin: 0 0 14px; padding-left: 1.2rem; }
  .lg-body :global(li) { margin-bottom: 6px; }
  .lg-body :global(strong) { color: var(--lr-text); }
  .lg-body :global(a) { color: var(--gh-yellow); text-underline-offset: 3px; }

  @media (max-width: 960px) {
    .lg { grid-template-columns: 1fr; gap: 24px; padding-top: 24px; }
    .lg-toc-wrap { position: static; }
    .lg-toc { border: 1px solid var(--lr-line); border-radius: 8px; background: var(--lr-card); padding: 14px 16px; }
    .lg-toc summary { cursor: pointer; margin: 0; display: flex; justify-content: space-between; align-items: center; }
    .lg-toc summary::after { content: '+'; font-size: 18px; letter-spacing: 0; color: var(--lr-soft); }
    .lg-toc[open] summary::after { content: '−'; }
    .lg-toc[open] summary { margin-bottom: 12px; }
  }
  @media (max-width: 760px) {
    .lg-docs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-top: 16px; }
    .lg-docs::-webkit-scrollbar { display: none; }
    .lg-doc { flex: none; height: 36px; font-size: 14px; }
    .lg-body :global(h2) { font-size: 19px; margin-top: 32px; padding-top: 22px; }
    .lg-body :global(p), .lg-body :global(li) { font-size: 15px; }
  }
</style>
