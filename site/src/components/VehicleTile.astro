---
// One vehicle tile, shared by The Garage, the class/manufacturer pages and
// the home page (2026-10-01: same tile everywhere). Server-rendered, so all
// content is in the HTML for search engines; compare + owned markers are
// wired by scripts/vehicle-tiles.ts.
import { vehicleValues, formatVehicleValue, type VehicleOption } from '../data/vehicles';

interface Props { vehicle: VehicleOption }
const { vehicle: v } = Astro.props;
const base = import.meta.env.BASE_URL;
const acquisitionLabels: Record<string, string> = {
  'pre-order': 'Pre-Order',
  'ultimate-edition': 'Ultimate Edition',
  'gta-plus': 'GTA+',
};
---
<article
  class="v-tile"
  data-id={v.id}
  data-search={`${v.make} ${v.model}`.toLowerCase()}
  data-classes={v.classes.join('|')}
  data-make={v.make}
  data-drive={v.drive}
>
  <a class="v-tile-link" href={`${base}garage/vehicles/${v.id}/`}><span class="sr-only">{v.make} {v.model}</span></a>
  <div class="v-photo">
    <div class="v-badges">
      {v.acquisition && (
        <span class="v-badge">{acquisitionLabels[v.acquisition]}</span>
      )}
      {!v.releaseId && <span class="v-badge v-badge-muted">Not officially revealed</span>}
    </div>
    {v.photo ? (
      <img
        src={`${base}images/vehicles/${v.id}-640.webp`}
        srcset={`${base}images/vehicles/${v.id}-640.webp 640w, ${base}images/vehicles/${v.id}-1280.webp 1280w`}
        sizes="(max-width: 700px) 100vw, 400px"
        alt="" loading="lazy" width="640" height="360" />
    ) : (
      <>
        <img class="v-photo-fallback" src={`${base}images/garage/garage-hero-placeholder.webp`} alt="" loading="lazy" width="640" height="360" />
        <span class="v-photo-pending">Photo pending</span>
      </>
    )}
    <div class="v-name">
      <strong>{v.make} {v.model}</strong>
      <span>
        <img class="v-logo" src={`${base}images/logos/${v.logoSlug}-gta-6-logo.webp`} alt="" width="18" height="18" loading="lazy" />
        {v.make}
      </span>
    </div>
  </div>
  <button type="button" class="v-compare-mark" data-id={v.id} aria-pressed="false" aria-label={`Add ${v.make} ${v.model} to compare`}><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 2.5v11M2.5 8h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg></button>
  <div class="v-data">
    <span>Price{vehicleValues[v.id]?.price_gtad ? <strong>{formatVehicleValue(vehicleValues[v.id]!.price_gtad!)}</strong> : <strong class="status-pending"><span class="status-dot"></span>Not announced</strong>}</span>
    <span>GTA Class<strong>{v.classes.join(' / ')}</strong></span>
  </div>
  <details class="v-expand">
    <summary>Racing data</summary>
    <div class="v-inner">
      <span>Gellhorn Lap{vehicleValues[v.id]?.gellhorn_reference_lap_ms ? <strong>{formatVehicleValue(vehicleValues[v.id]!.gellhorn_reference_lap_ms!)}</strong> : <strong class="status-pending"><span class="status-dot"></span>From Nov 19</strong>}</span>
      <span>Top Speed{vehicleValues[v.id]?.top_speed_mph ? <strong>{formatVehicleValue(vehicleValues[v.id]!.top_speed_mph!)}</strong> : <strong class="status-pending"><span class="status-dot"></span>After launch</strong>}</span>
      <span>Drive<strong>{v.drive}</strong></span>
    </div>
  </details>
</article>

<style>
  .v-tile { position: relative; background: var(--gh-surface); border: 1px solid var(--gh-line); border-radius: var(--gh-radius-lg); overflow: hidden; transition: border-color .15s; }
  .v-tile:hover { border-color: var(--gh-muted); }
  .v-tile-link { position: absolute; inset: 0; z-index: 1; }
  .v-photo { position: relative; aspect-ratio: 16/9; background: rgba(160,160,198,.08); overflow: hidden; }
  .v-photo > img { width: 100%; height: 100%; object-fit: cover; }
  .v-photo-fallback { opacity: .4; filter: saturate(.7); }
  /* Pills top left: "Owned" always first (added by script), edition next to it (2026-09-30) */
  .v-badges { position: absolute; top: .6rem; left: .6rem; right: 3rem; z-index: 2; display: flex; flex-wrap: wrap; gap: .35rem; pointer-events: none; }
  .v-badge { padding: .25rem .6rem; border-radius: 999px; background: var(--gh-red); color: #fff; font-size: .6rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .v-badge-muted { background: rgba(20,20,26,.8); color: var(--gh-muted); border: 1px solid rgba(252,250,247,.18); }
  .v-photo-pending { position: absolute; top: 38%; left: 50%; transform: translate(-50%, -50%); background: rgba(20,20,26,.7); border: 1px solid rgba(252,250,247,.12); padding: .35rem .75rem; border-radius: 999px; color: var(--gh-muted); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; white-space: nowrap; }
  .v-name { position: absolute; left: 0; right: 0; bottom: 0; padding: .6rem .75rem; background: linear-gradient(to top, rgba(20,20,26,.95), transparent); display: flex; flex-direction: column; gap: .25rem; }
  .v-name strong { font-size: .92rem; }
  .v-name span { display: inline-flex; align-items: center; gap: .35rem; font-size: .7rem; color: var(--gh-muted); text-transform: uppercase; letter-spacing: .03em; }
  .v-logo { width: 18px; height: 18px; flex-shrink: 0; filter: brightness(0) invert(1); opacity: .85; object-fit: contain; }

  /* Fixed square box + no UA padding: iOS Safari adds button padding, which
     made the round button oval on phones (2026-10-01). */
  .v-compare-mark { position: absolute; top: .6rem; right: .6rem; z-index: 2; box-sizing: border-box; flex: none; width: 1.9rem; height: 1.9rem; min-width: 0; padding: 0; margin: 0; -webkit-appearance: none; appearance: none; aspect-ratio: 1; border-radius: 50%; border: 1px solid rgba(252,250,247,.35); background: rgba(20,20,26,.65); color: var(--gh-text); line-height: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .v-compare-mark:hover { border-color: var(--gh-text); }
  .v-compare-mark.is-selected { background: var(--gh-yellow); border-color: var(--gh-yellow); color: #1a1206; }

  .v-data { position: relative; z-index: 2; pointer-events: none; display: flex; justify-content: space-between; padding: .6rem .9rem; font-size: .72rem; border-top: 1px solid var(--gh-line); }
  .v-data span { display: flex; flex-direction: column; gap: .2rem; text-transform: uppercase; letter-spacing: .03em; color: var(--gh-muted); }
  .v-data strong { color: var(--gh-text); font-size: .78rem; text-transform: none; letter-spacing: 0; }
  .v-data strong.status-pending { color: var(--gh-muted); font-weight: 600; }

  .v-expand { position: relative; z-index: 2; border-top: 1px solid var(--gh-line); }
  .v-expand summary { cursor: pointer; padding: .55rem .9rem; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--gh-muted); list-style: none; }
  .v-expand summary::-webkit-details-marker { display: none; }
  .v-expand summary::before { content: '▸ '; }
  .v-expand[open] summary::before { content: '▾ '; }
  .v-expand summary:hover { color: var(--gh-text); }
  .v-inner { display: flex; justify-content: space-between; padding: 0 .9rem .75rem; font-size: .72rem; }
  .v-inner span { display: flex; flex-direction: column; gap: .2rem; text-transform: uppercase; letter-spacing: .03em; color: var(--gh-muted); }
  .v-inner strong { color: var(--gh-text); font-size: .78rem; text-transform: none; letter-spacing: 0; }
  .v-inner strong.status-pending { color: var(--gh-muted); font-weight: 600; }

  /* Owned by the signed-in driver (RS-0032) */
  :global(.v-tile.is-owned) { border-color: var(--gh-yellow); }
  :global(.v-owned) { padding: .25rem .6rem; border-radius: 999px; background: var(--gh-yellow); color: #1a1206; font-size: .6rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
</style>
