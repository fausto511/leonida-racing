---
// Shared image header for section pages (The Hub, Time Attack subpages).
// Rule (Fausto, 2026-09-25): on every page the header image has the same
// height, the section subnav sits directly below it, and the text block is
// always eyebrow + title + short lede in the same sizes. Height, veil and
// type are kept in sync, literally, with the Garage and Gellhorn heroes
// (.hero-grid min-height 21rem / 35rem below 860px).
// Images: <name>-640/1080/1672.webp + <name>-1672.jpg under /images/.
import LaunchStatus from './LaunchStatus.astro';
interface Props {
  /** Pre-release status card on the right (RS-0050). */
  status?: 'garage' | 'time-attack' | 'hub' | 'tracks' | 'guide';
  image: 'hub' | 'hub-events' | 'hub-crews' | 'hub-tracks' | 'gellhorn' | 'guide';
  eyebrow: string;
  title: string;
  lede: string;
}
const { image, eyebrow, title, lede, status } = Astro.props;
const base = import.meta.env.BASE_URL;
const images = {
  // Visual/Cars/carmeet1.png (chosen by Fausto, 2026-09-25), 1672x940
  hub: { path: `${base}images/hub/hub-carmeet`, w: 1672, h: 940, pos: '60% 45%', posMobile: '58% 70%' },
  // Hub subpages (2026-09-30, Fausto: own image per page, placeholders until final art)
  'hub-events': { path: `${base}images/hub/hub-events`, w: 1672, h: 941, pos: '50% 55%', posMobile: '55% 55%' }, // Crews and Events/carmeet2.png
  'hub-crews': { path: `${base}images/hub/hub-crews`, w: 1672, h: 940, pos: '55% 35%', posMobile: '62% 40%' }, // Crews and Events/crews (2).jpg
  'hub-tracks': { path: `${base}images/hub/hub-tracks`, w: 1672, h: 941, pos: '50% 60%', posMobile: '62% 70%' }, // Racing/hotlap-gir-3 (1).png
  // same image as the Gellhorn track page hero
  gellhorn: { path: `${base}images/gellhorn-raceway`, w: 1672, h: 941, pos: '50% 50%', posMobile: '50% 50%' },
  // The Guide (2026-10-03): Visual/Guide/ULTIMATE_EDITION_GROTTI_CHEETAH_02 (chosen by Fausto)
  guide: { path: `${base}images/guide/guide-hero`, w: 1672, h: 940, pos: '70% 55%', posMobile: '72% 60%' },
};
const img = images[image];
---
<section class="hero">
  <picture>
    <source type="image/webp" srcset={`${img.path}-640.webp 640w, ${img.path}-1080.webp 1080w, ${img.path}-1672.webp 1672w`} sizes="100vw" />
    <img src={`${img.path}-1672.jpg`} alt="" width={img.w} height={img.h} loading="eager" fetchpriority="high" style={`--pos:${img.pos};--pos-m:${img.posMobile}`} />
  </picture>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class:list={['wrap', 'hero-grid', { 'has-aside': status }]}>
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="display hero-title">{title}</h1>
      <p class="hero-lede">{lede}</p>
    </div>
    {status && <LaunchStatus area={status} />}
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero picture, .hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Crop per image (see `images` above). Car meet: faces of the group on
     the left + both wrapped cars stay in view; sky/tarmac get cut. */
  .hero img { object-position: var(--pos); }
  .hero-veil { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(11,11,20,.97) 15%, rgba(11,11,20,.6) 60%, rgba(11,11,20,.85)); }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1fr; /* no right-hand aside on hub pages */ align-items: center; gap: 2rem; min-height: 21rem; padding-block: 2rem; }
  .hero-grid.has-aside { grid-template-columns: 1.5fr 1fr; } /* same split as Garage/Gellhorn (RS-0050) */
  .hero-copy { max-width: 46rem; align-self: start; }
  .hero-title { font-size: clamp(1.75rem, 7.4vw, 2.5rem); margin: .5rem 0 .8rem; }
  .hero-lede { color: var(--gh-muted); font-size: 1rem; margin: 0; max-width: 56ch; }
  @media (max-width: 860px) {
    .hero-grid, .hero-grid.has-aside { grid-template-columns: 1fr; min-height: 35rem; padding-block: 2.5rem; }
    .hero img { object-position: var(--pos-m); }
  }
</style>
