---
// Switch between the internal moderator tools. Internal pages only.
interface Props { active: 'laps' | 'hub' | 'reports' | 'content' | 'vehicles' | 'drivers'; }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { key: 'laps', label: 'Lap Review', href: `${base}moderator/` },
  { key: 'hub', label: 'Hub Content', href: `${base}moderator/hub/` },
  { key: 'reports', label: 'Time Reports', href: `${base}moderator/reports/` },
  { key: 'content', label: 'Content Reports', href: `${base}moderator/content/` },
  { key: 'vehicles', label: 'Vehicles', href: `${base}moderator/vehicles/` },
  { key: 'drivers', label: 'Drivers', href: `${base}moderator/drivers/` },
];
---
<nav class="modnav" aria-label="Moderator tools">
  {links.map((l) => <a href={l.href} class:list={['modnav-link', { 'is-active': active === l.key }]} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>)}
</nav>
<style>
  .modnav { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1.4rem; }
  .modnav-link { padding: .4rem .8rem; border-radius: 999px; border: 1px solid var(--gh-line); color: var(--gh-muted); font-size: .76rem; font-weight: 700; text-decoration: none; }
  .modnav-link:hover { color: var(--gh-text); border-color: var(--gh-muted); }
  .modnav-link.is-active { color: #1a1206; background: var(--gh-yellow); border-color: var(--gh-yellow); }
</style>
