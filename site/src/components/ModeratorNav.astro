---
// Moderator navigation, grouped by task (RS-0102 stage 1, Fausto 09.11.2026).
// Counters come from mod_overview() (scripts/mod-overview.ts). Internal pages only.
// 'hub' = Moderator > Hub Content: the active entry follows its ?tab= (crews, events, tracks, requests).
interface Props { active: 'overview' | 'laps' | 'event-review' | 'hub' | 'reports' | 'content' | 'vehicles' | 'drivers' | 'videos'; }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const m = `${base}moderator/`;
const groups: { name: string; items: { key: string; label: string; href: string; count?: string }[] }[] = [
  { name: 'Review', items: [
    { key: 'laps', label: 'Laps', href: `${m}laps/`, count: 'laps_review,videos_check' },
    { key: 'event-review', label: 'Events', href: `${m}event-review/`, count: 'events_review,event_changes' },
    { key: 'hub:tracks', label: 'Tracks', href: `${m}hub/?tab=tracks`, count: 'tracks' },
  ] },
  { name: 'Reports', items: [
    { key: 'reports', label: 'Times', href: `${m}reports/`, count: 'time_reports' },
    { key: 'content', label: 'Content', href: `${m}content/`, count: 'content_reports' },
  ] },
  { name: 'Community', items: [
    { key: 'hub:crews', label: 'Crews', href: `${m}hub/?tab=crews` },
    { key: 'hub:events', label: 'Events', href: `${m}hub/?tab=events` },
    { key: 'hub:requests', label: 'Roles & requests', href: `${m}hub/?tab=requests`, count: 'requests' },
  ] },
  { name: 'Data', items: [
    { key: 'vehicles', label: 'Vehicles', href: `${m}vehicles/` },
    { key: 'drivers', label: 'Drivers', href: `${m}drivers/` },
    { key: 'videos', label: 'Videos & streams', href: `${m}videos/` },
  ] },
];
---
<nav class="modnav" aria-label="Moderator tools" data-active={active}>
  <div class="modnav-g">
    <span class="modnav-gn" aria-hidden="true">&nbsp;</span>
    <div class="modnav-row">
      <a href={m} class:list={['modnav-link', { 'is-active': active === 'overview' }]} data-key="overview" aria-current={active === 'overview' ? 'page' : undefined}>Overview</a>
    </div>
  </div>
  {groups.map((g) => (
    <div class="modnav-g">
      <span class="modnav-gn">{g.name}</span>
      <div class="modnav-row">
        {g.items.map((it) => (
          <a href={it.href} class:list={['modnav-link', { 'is-active': active === it.key }]} data-key={it.key} data-count={it.count} aria-current={active === it.key ? 'page' : undefined}>{it.label}<span class="modnav-n" hidden></span></a>
        ))}
      </div>
    </div>
  ))}
</nav>
<script>
  import { loadModOverview } from '../scripts/mod-overview';
  const nav = document.querySelector<HTMLElement>('.modnav')!;
  // Hub Content: highlight the entry of the open tab
  if (nav.dataset.active === 'hub') {
    const tab = new URLSearchParams(location.search).get('tab') || 'crews';
    const a = nav.querySelector<HTMLElement>(`[data-key="hub:${tab.replace(/[^a-z]/g, '')}"]`);
    if (a) { a.classList.add('is-active'); a.setAttribute('aria-current', 'page'); }
  }
  loadModOverview().then((ov) => {
    if (!ov) return;
    nav.querySelectorAll<HTMLElement>('[data-count]').forEach((a) => {
      const n = (a.dataset.count ?? '').split(',').reduce((s, k) => s + (Number((ov.todo as any)[k]) || 0), 0);
      const el = a.querySelector<HTMLElement>('.modnav-n')!;
      el.textContent = String(n);
      el.hidden = n === 0;
      if (n) a.setAttribute('aria-label', `${a.firstChild?.textContent ?? ''}, ${n} to do`);
    });
  });
</script>
<style>
  .modnav { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: flex-end; padding-bottom: 20px; margin-bottom: 28px; border-bottom: 1px solid var(--lr-line); }
  .modnav-g { display: flex; flex-direction: column; gap: 6px; }
  .modnav-gn { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--lr-muted); }
  .modnav-row { display: flex; flex-wrap: wrap; gap: 6px; }
  .modnav-link { display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--lr-line-strong); color: var(--lr-soft); font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .modnav-link:hover { color: var(--lr-text); border-color: var(--lr-line-hover); }
  .modnav-link:focus-visible { outline: 2px solid var(--lr-orange); outline-offset: 2px; }
  .modnav-link.is-active { color: var(--lr-text); border-color: var(--lr-orange); background: var(--lr-orange-fill); }
  .modnav-n { min-width: 20px; height: 20px; padding: 0 6px; box-sizing: border-box; border-radius: 999px; background: var(--lr-orange); color: var(--lr-on-orange); font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .modnav-n[hidden] { display: none; }
</style>
