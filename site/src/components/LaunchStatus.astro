---
// Pre-release status card for section headers (RS-0050, Fausto 2026-10-01).
// Stays until launch, then remove it.
// COPY STATUS: approved Codex copy (Freigegebene Website-Texte, 2026-10-01).
import { LAUNCH_DATE, LAUNCH_AT, LAUNCH_LABEL } from '../data/launch';

interface Props { area: 'garage' | 'time-attack' | 'hub' | 'tracks' | 'guide' }
const { area } = Astro.props;
const base = import.meta.env.BASE_URL;

const lines: Record<Props['area'], string> = {
  'time-attack': 'Lap submissions open on launch day.',
  garage: 'All GTA VI cars will be added after launch.',
  hub: 'Create your crew or plan an event now.',
  tracks: 'Community jobs open when creation tools are available.',
  guide: 'Updated as new GTA VI car and racing details emerge.', // Codex 2026-10-03, approved
};
const countdown = area !== 'tracks';
---
<aside class="launch-card" aria-label="Pre-release status">
  <p class="launch-label"><span class="launch-dot" aria-hidden="true"></span>GTA VI Pre-Release</p>
  <p class="launch-title">Road to Launch</p>
  <p class="launch-text">We’re building Leonida Racing ahead of GTA VI. Sign in with Discord now and get your profile ready.</p>
  <p class="launch-text launch-area">{lines[area]}</p>
  {countdown ? (
    <div class="launch-count" data-launch-date={LAUNCH_DATE} data-launch-at={LAUNCH_AT ?? ''}>
      <span class="launch-count-label">GTA VI launches <span data-cd-when>{LAUNCH_LABEL}</span></span>
      <span class="launch-count-row" data-cd-row hidden>
        <span><strong data-cd="d">–</strong>days</span>
        <span><strong data-cd="h">–</strong>hrs</span>
        <span><strong data-cd="m">–</strong>min</span>
      </span>
    </div>
  ) : (
    <div class="launch-count"><span class="launch-count-label">Creation tools: availability to be announced</span></div>
  )}
  <a class="btn btn-red launch-btn" href={`${base}account/`}>Create Your Driver Profile</a>
</aside>

<script>
  import '../scripts/launch-countdown';
</script>

<style>
  .launch-card { position: relative; justify-self: end; align-self: center; width: 100%; max-width: 19rem; padding: 1.15rem 1.25rem 1.1rem; border-radius: var(--gh-radius-lg); background: rgba(20,20,26,.72); border: 1px solid var(--gh-line); backdrop-filter: blur(8px); box-shadow: 0 10px 30px rgba(0,0,0,.35); overflow: hidden; }
  .launch-card::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: linear-gradient(90deg, var(--gh-red), var(--gh-yellow)); }
  .launch-label { display: inline-flex; align-items: center; gap: .45rem; margin: 0 0 .55rem; color: var(--gh-yellow); font-size: .64rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .launch-dot { width: .45rem; height: .45rem; border-radius: 50%; background: var(--gh-yellow); box-shadow: 0 0 0 0 rgba(255,215,76,.6); animation: launch-pulse 2s infinite; }
  @keyframes launch-pulse { 0% { box-shadow: 0 0 0 0 rgba(255,215,76,.55); } 70% { box-shadow: 0 0 0 .5rem rgba(255,215,76,0); } 100% { box-shadow: 0 0 0 0 rgba(255,215,76,0); } }
  @media (prefers-reduced-motion: reduce) { .launch-dot { animation: none; } }
  .launch-title { margin: 0 0 .45rem; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.15rem; line-height: 1.05; color: var(--gh-text); }
  .launch-text { margin: 0 0 .45rem; color: var(--gh-muted); font-size: .8rem; line-height: 1.45; }
  .launch-area { color: var(--gh-text); }
  .launch-count { margin: .75rem 0 .7rem; padding-top: .7rem; border-top: 1px solid var(--gh-line); }
  .launch-count-label { display: block; color: var(--gh-muted); font-size: .66rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .launch-count-row { display: flex; gap: .9rem; margin-top: .35rem; }
  .launch-count-row[hidden] { display: none; }
  .launch-count-row span { display: flex; align-items: baseline; gap: .25rem; color: var(--gh-muted); font-size: .66rem; text-transform: uppercase; letter-spacing: .05em; }
  .launch-count-row strong { font-family: var(--gh-font-display); font-style: italic; font-weight: 900; font-size: 1.55rem; color: var(--gh-text); letter-spacing: 0; }
  .launch-btn { display: flex; width: 100%; justify-content: center; margin-top: .15rem; font-size: .8rem; }
  @media (max-width: 860px) {
    .launch-card { justify-self: stretch; max-width: none; align-self: end; }
  }
</style>
