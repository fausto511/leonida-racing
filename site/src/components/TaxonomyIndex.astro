---
// Overview pages /cars/classes/ and /cars/manufacturers/ (2026-10-01):
// no dead path above the class/manufacturer pages, and a landing page for
// "GTA 6 vehicle classes" / "GTA 6 car manufacturers" searches.
// COPY STATUS: intro + meta approved (Codex 2026-10-02, Fausto).
// Redesign 2026-10-16 (DEC-0130): no own mockup, built from the class-page parts
// (image band, card look, link rows). Assumption, check with Fausto.
import Base from '../layouts/Base.astro';
import { compareGarageOrder, type VehicleOption } from '../data/vehicles';
import type { TaxonomyPage } from '../data/garage-taxonomy';
import { taxonomyCopy } from '../data/taxonomy-copy';

interface Props {
  kind: 'class' | 'manufacturer';
  pages: { page: TaxonomyPage; vehicles: VehicleOption[] }[];
  title: string;
  heading: string;
  description: string;
  intro: string;
  /** text block under the grid (H2 + paragraphs) */
  about?: { heading: string; paragraphs: string[] };
}
const { kind, pages, title, heading, description, intro, about } = Astro.props;
const base = import.meta.env.BASE_URL;
const dir = kind === 'class' ? 'classes' : 'manufacturers';
const path = `cars/${dir}/`;
const cards = pages.map(({ page, vehicles }) => {
  const sorted = [...vehicles].sort(compareGarageOrder);
  const cover = sorted.find((v) => v.photo);
  // Only officially revealed models are named in the card text.
  const named = sorted.filter((v) => v.releaseId).slice(0, 3).map((v) => (kind === 'class' ? `${v.make} ${v.model}` : v.model));
  return { page, count: vehicles.length, cover, named, logo: vehicles[0]?.logoSlug };
});
const pageUrl = new URL(`${base}${path}`, Astro.site).href;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `GTA VI ${heading}`, // SEO name keeps GTA VI; visible H1 without it (DEC-0130)
  url: pageUrl,
  description,
  about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI', alternateName: ['GTA VI', 'GTA 6'] },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: cards.length,
    itemListElement: cards.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.page.name, url: new URL(`${base}cars/${dir}/${c.page.slug}/`, Astro.site).href })),
  },
}];
---
<Base
  title={title}
  description={description}
  section="garage"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Cars', path: 'cars/' }, { name: kind === 'class' ? 'Classes' : 'Manufacturers', path }]}
>
  <section class="tb">
    <img class="tb-bg" src={`${base}images/garage/cars-band-1280.webp`} srcset={`${base}images/garage/cars-band-640.webp 640w, ${base}images/garage/cars-band-1280.webp 1280w, ${base}images/garage/cars-band-1920.webp 1920w`} sizes="100vw" alt="" width="1920" height="600" fetchpriority="high" />
    <span class="lr-shade is-open" aria-hidden="true"></span>
    <div class="wrap tb-inner lr-band-in">
      <nav class="lr-crumb" aria-label="Breadcrumb">
        <a href={`${base}cars/`}>Cars</a><span aria-hidden="true">/</span><span aria-current="page">{kind === 'class' ? 'Classes' : 'Manufacturers'}</span>
      </nav>
      <p class="eyebrow">GTA VI Vehicle Database</p>
      <h1 class:list={['display', 'lr-t1', { 'lr-long-word': kind === 'manufacturer' }]}>{heading}</h1>
      <p class="lr-lede">{intro}</p>
    </div>
  </section>

  <section class:list={['wrap', 'ti-grid', { 'ti-grid-logos': kind === 'manufacturer' }]} aria-label={heading}>
    {cards.map((c) => (
      <a class="ti-card" href={`${base}cars/${dir}/${c.page.slug}/`}>
        <span class="ti-photo">
          {c.cover
            ? <img src={`${base}images/vehicles/${c.cover.id}-640.webp`} alt="" width="640" height="360" loading="lazy" />
            : <img class="ti-fallback" src={`${base}images/garage/garage-hero-placeholder-640.webp`} alt="" width="640" height="360" loading="lazy" />}
          {/* Manufacturers: darkened photo + big white logo (Fausto, 2026-10-03; classes stay plain). Logos: logos/tile/, equal visual area per logo. */}
          {kind === 'manufacturer' && c.logo && <img class="ti-badge" src={`${base}images/logos/tile/${c.logo}.webp`} alt="" width="600" height="360" loading="lazy" />}
          <span class="ti-count">{c.count} {c.count === 1 ? 'car' : 'cars'}</span>
        </span>
        <span class="ti-body">
          <strong class="ti-name">{c.page.name}</strong>
          {c.page.inspiration?.length && <span class="ti-insp">Real-life inspiration: <b>{c.page.inspiration.join(' · ')}</b></span>}
          {c.page.teaser ? <span class="ti-teaser">{c.page.teaser}</span> : c.named.length > 0 && <span class="ti-models">{c.named.join(' · ')}</span>}
          <span class="arrow ti-a">View {taxonomyCopy[c.page.slug]?.h1 ?? c.page.name} →</span>
        </span>
      </a>
    ))}
  </section>

  {about && (
    <section class="wrap ti-about" aria-labelledby="ti-about-h">
      <h2 class="lr-h2 ti-about-h" id="ti-about-h">{about.heading}</h2>
      {about.paragraphs.map((t) => <p>{t}</p>)}
    </section>
  )}

  <nav class="wrap ti-more" aria-label="More in The Garage">
    <a class="arrow" href={`${base}cars/${kind === 'class' ? 'manufacturers' : 'classes'}/`}>{kind === 'class' ? 'Browse by manufacturer' : 'Browse by class'} →</a>
    <a class="arrow" href={`${base}cars/`}>All cars →</a>
    <a class="arrow" href={`${base}cars/compare/`}>Compare cars →</a>
  </nav>
</Base>

<style>
  /* image band: same as class pages (GarageTaxonomy.astro) */
  .tb { position: relative; overflow: hidden; border-bottom: 1px solid var(--lr-line-strong); }
  .tb-bg, .tb-t { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tb-bg { object-fit: cover; object-position: 50% 92%; }
  .tb-inner { display: flex; flex-direction: column; }

  .ti-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; padding-top: 32px; }
  .ti-card { display: flex; flex-direction: column; background: var(--lr-card); border: 1px solid var(--lr-line-strong); border-radius: 8px; overflow: hidden; color: var(--lr-text); text-decoration: none; transition: border-color .15s; }
  .ti-card:hover { border-color: var(--lr-pink); }
  .ti-photo { position: relative; aspect-ratio: 16/9; background: var(--lr-line-soft); }
  .ti-grid-logos .ti-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,11,20,.72), rgba(11,11,20,.88)); }
  .ti-photo .ti-badge { position: absolute; inset: 0; margin: auto; z-index: 1; width: 100%; height: 100%; max-height: 120px; object-fit: contain; filter: drop-shadow(0 2px 10px rgba(11,11,20,.55)); transition: transform .2s; }
  .ti-card:hover .ti-badge { transform: scale(1.04); }
  .ti-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ti-fallback { opacity: .45; filter: saturate(.7); }
  .ti-count { position: absolute; z-index: 2; right: 10px; bottom: 10px; padding: 3px 9px; border-radius: 999px; background: var(--lr-dark-80); border: 1px solid var(--lr-line-strong); font-size: 12px; font-weight: 600; color: var(--lr-text); }
  .ti-body { display: flex; flex-direction: column; gap: 6px; flex: 1; padding: 14px 16px 16px; }
  .ti-name { font-size: 20px; font-weight: 700; line-height: 1.2; }
  .ti-insp { color: var(--lr-soft); font-size: 14px; }
  .ti-insp b { color: var(--lr-text); font-weight: 600; }
  .ti-models { color: var(--lr-soft); font-size: 14px; line-height: 1.45; }
  .ti-teaser { color: var(--lr-soft); font-size: 14px; line-height: 1.45; }
  .ti-a { margin-top: auto; padding-top: 8px; font-size: 14px; }
  .ti-about { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--lr-line); }
  .ti-about-h { margin: 0 0 12px; }
  .ti-about p { max-width: 900px; margin: 0 0 14px; font-size: 16px; line-height: 1.7; color: var(--lr-text); }
  .ti-more { display: flex; flex-wrap: wrap; gap: 8px 24px; padding-top: 24px; padding-bottom: 56px; font-size: 15px; }

  @media (max-width: 1100px) { .ti-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .ti-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } }
  @media (max-width: 760px) {
    .ti-grid { padding-top: 20px; }
    .ti-name { font-size: 17px; }
    .ti-insp, .ti-models, .ti-teaser { font-size: 13px; }
  }
  @media (max-width: 520px) {
    .ti-grid { grid-template-columns: 1fr; }
  }
</style>
