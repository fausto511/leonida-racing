---
// Consent for anonymous visitor statistics (Cloudflare Web Analytics, no
// cookies). Fausto, 2026-10-02: full-width bar at the bottom, the page frame
// shrinks by its height instead of being covered; muted lilac tone from the
// palette; clear switches. The beacon loads ONLY after "Allow".
// Choice is stored in localStorage (technically necessary, Section 25(2) TDDDG).
// Footer link "Privacy settings" reopens the bar; the stored choice stays until a button is pressed.
// Withdrawal (No Thanks after Allow, Codex privacy review 16.10.2026): the choice is saved, any
// further request of the already running beacon is blocked (incl. the pagehide send) and the page
// reloads without it, so no visitor-statistics data is sent after withdrawal.
// COPY STATUS: approved (Codex 2026-10-02, Fausto). No pulse on Allow: both
// choices equally easy (Fausto, 2026-10-02).
const base = import.meta.env.BASE_URL;
---
<div class="consent-bar" id="consent-bar" role="region" aria-label="Visitor statistics" hidden>
  <div class="wrap consent-inner">
    <p class="consent-text">
      Allow Cloudflare Web Analytics to count visits? No cookies or cross-site tracking.{' '}
      <a href={`${base}privacy/#analytics`}>Privacy Policy</a>
    </p>
    <div class="consent-actions">
      <button type="button" class="consent-btn consent-no" data-consent="denied">No Thanks</button>
      <button type="button" class="consent-btn consent-yes" data-consent="granted">Allow</button>
    </div>
  </div>
</div>

<script>
  const KEY = 'lr-analytics-consent';
  const TOKEN = '4d1bcf5ef7214ae8a1b3330c5387809c';
  const bar = document.getElementById('consent-bar') as HTMLElement;

  const read = (): string | null => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const write = (v: string | null) => { try { v ? localStorage.setItem(KEY, v) : localStorage.removeItem(KEY); } catch { /* storage blocked */ } };

  let loaded = false;
  function loadBeacon() {
    if (loaded) return;
    loaded = true;
    const s = document.createElement('script');
    s.type = 'module';
    s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
    s.setAttribute('data-cf-beacon', JSON.stringify({ token: TOKEN }));
    document.body.appendChild(s);
  }

  // Page frame shrinks by the bar's height (body padding), nothing is covered.
  function syncSpace() {
    document.documentElement.style.setProperty('--consent-h', bar.hidden ? '0px' : `${bar.offsetHeight}px`);
  }
  function show() {
    bar.hidden = false;
    requestAnimationFrame(() => { bar.classList.add('is-in'); syncSpace(); });
  }
  function hide() {
    bar.classList.remove('is-in');
    bar.hidden = true;
    syncSpace();
  }

  const choice = read();
  if (choice === 'granted') loadBeacon();
  else if (choice !== 'denied') show();

  // Block every request to Cloudflare Web Analytics from this document (sendBeacon, fetch, XHR).
  function blockBeacon() {
    const cf = (u: unknown) => String(u).includes('cloudflareinsights.com');
    try { const sb = navigator.sendBeacon.bind(navigator); navigator.sendBeacon = (u, d) => (cf(u) ? true : sb(u, d)); } catch { /* not supported */ }
    const f = window.fetch.bind(window);
    window.fetch = (i, o) => (cf(typeof i === 'string' ? i : i instanceof Request ? i.url : i) ? Promise.resolve(new Response(null, { status: 204 })) : f(i, o));
    const open = XMLHttpRequest.prototype.open, send = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function (this: XMLHttpRequest & { _cf?: boolean }, m: string, u: string | URL, ...rest: unknown[]) { this._cf = cf(u); return (open as any).call(this, m, u, ...rest); } as any;
    XMLHttpRequest.prototype.send = function (this: XMLHttpRequest & { _cf?: boolean }, b?: any) { if (this._cf) return; return send.call(this, b); };
  }

  bar.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-consent]');
    if (!b) return;
    const v = b.dataset.consent!;
    write(v);
    hide();
    if (v === 'granted') loadBeacon();
    else if (loaded) { blockBeacon(); location.reload(); }
  });
  window.addEventListener('resize', () => { if (!bar.hidden) syncSpace(); });
  // "Privacy Settings" in the footer: show the choice again. Just opening it changes nothing.
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-consent-open]')) { e.preventDefault(); show(); }
  });
</script>

<style>
  .consent-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; background: color-mix(in srgb, var(--gh-muted) 22%, var(--gh-bg)); border-top: 1px solid color-mix(in srgb, var(--gh-muted) 45%, transparent); box-shadow: 0 -10px 30px rgba(0,0,0,.35); transform: translateY(100%); transition: transform .35s cubic-bezier(.2,.8,.2,1); }
  .consent-bar[hidden] { display: none; }
  .consent-bar.is-in { transform: none; }
  .consent-inner { display: flex; align-items: center; gap: .75rem 1.25rem; padding-block: .45rem; }
  .consent-text { flex: 1; min-width: 0; margin: 0; color: var(--gh-text); font-size: .8rem; line-height: 1.35; }
  .consent-text strong { margin-right: .25rem; }
  .consent-text a { color: var(--gh-text); text-decoration: underline; text-underline-offset: 2px; white-space: nowrap; }
  .consent-actions { display: flex; gap: .5rem; flex: none; }
  .consent-btn { min-width: 6rem; padding: .38rem .9rem; border-radius: var(--gh-radius); font-family: var(--gh-font-display); font-weight: 900; font-size: .74rem; letter-spacing: .02em; text-transform: uppercase; cursor: pointer; transition: transform .12s, filter .12s, background .12s; }
  .consent-btn:hover { transform: translateY(-1px); }
  .consent-btn:focus-visible { outline: 2px solid var(--gh-yellow); outline-offset: 2px; }
  /* Palette only (Fausto, 2026-10-02). Clearly a button (white text, full contrast) -- rejecting must stay as easy as allowing */
  .consent-no { background: var(--gh-surface); color: var(--gh-text); border: 2px solid var(--gh-muted); }
  .consent-no:hover { background: var(--gh-bg); }
  .consent-yes { background: var(--gh-yellow); color: #2A0F22; /* same as .btn-primary */ border: 2px solid var(--gh-yellow); }
  .consent-yes:hover { filter: brightness(1.08); }
  @media (prefers-reduced-motion: reduce) { .consent-bar { transition: none; } }
  @media (max-width: 640px) {
    .consent-inner { flex-direction: column; align-items: stretch; gap: .65rem; }
    .consent-text { font-size: .8rem; }
    .consent-actions .consent-btn { flex: 1; min-width: 0; }
  }
  :global(body) { padding-bottom: var(--consent-h, 0px); }
</style>
