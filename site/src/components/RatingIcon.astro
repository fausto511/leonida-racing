---
// Road / off-road rating icons: Lucide "road" and "mountain" (lucide.dev, ISC; DEC-0162).
// Fausto 27.11.2026: Lucide everywhere, replaces the frame icons traced from the in-game panel (23.11.2026).
// Used left of the number (vehicle pages, cards, filters, home rankings tiles).
interface Props { kind: 'road' | 'offroad'; size?: number }
const { kind, size = 17 } = Astro.props;
---
<svg class="rating-ico" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'road'
    ? <Fragment><path d="M12 17v4" /><path d="M12 5V3" /><path d="M12 9v3" /><path d="M2.077 18.449A2 2 0 0 0 4 21h16a2 2 0 0 0 1.924-2.55l-4-14A2 2 0 0 0 16 3H8a2 2 0 0 0-1.924 1.45z" /></Fragment>
    : <path d="m8 3 4 8 5-5 5 15H2L8 3z" />}
</svg>
<style>
  .rating-ico { flex: none; display: block; color: var(--lr-soft); }
</style>
