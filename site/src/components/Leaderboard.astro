---
// Gellhorn leaderboard (2026-09-26, DEC-0072). Filters (Fausto 17.10.): Class, Manufacturer, Vehicle
// (?class=Sports&make=grotti&vehicle=<id>). Class/Manufacturer rank every driver once by their best lap
// on the matching vehicles. Older note: one vehicle dropdown --
// "All vehicles" = Overall (across all vehicles and classes), or one
// vehicle's own board -- plus driver/crew search and All times / Verified only.
// The build renders the sample data with the same renderer the browser uses
// (data/leaderboard.ts); the browser takes over and swaps in live rows as
// soon as at least one real run is published.
import { sampleEntries, initialState, render, vehiclesNeededHtml, vehicleSelectHtml, classSelectHtml, makeSelectHtml } from '../data/leaderboard';
const vehicleSelect = vehicleSelectHtml(sampleEntries, initialState);
const first = render(sampleEntries, initialState, true);
const needed = vehiclesNeededHtml(sampleEntries);
---
<section id="leaderboard" class="lb">
  <div class="wrap">
    <div class="lb-head">
      <div>
        <span class="sample-flag" id="lb-flag">Sample data — fictional drivers, crews and times</span>
        <h2 class="display lb-title">Leaderboard</h2>
        <p class="lb-meta" id="lb-meta">{first.meta}</p>
      </div>
    </div>

    <div class="lb-controls">
      <label class="lb-vehicle-select lb-filter-select">
        <span class="sr-only">Class</span>
        <select class="ui-select" id="lb-class" aria-label="Class" set:html={classSelectHtml(initialState)}></select>
      </label>
      <label class="lb-vehicle-select lb-filter-select">
        <span class="sr-only">Manufacturer</span>
        <select class="ui-select" id="lb-make" aria-label="Manufacturer" set:html={makeSelectHtml(initialState)}></select>
      </label>
      <label class="lb-vehicle-select">
        <span class="sr-only">Vehicle</span>
        <select class="ui-select" id="lb-vehicle" aria-label="Vehicle: All vehicles (Overall) or one vehicle's leaderboard" set:html={vehicleSelect}></select>
      </label>
      <label class="ui-search lb-search">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" id="lb-q-driver" placeholder="Search driver or crew tag" aria-label="Search driver or crew tag" autocomplete="off" />
      </label>
      <div class="lb-toggle" role="group" aria-label="Time filter">
        <button type="button" class="is-active" aria-pressed="true" data-verified="0">All Times</button>
        <button type="button" aria-pressed="false" data-verified="1">Verified Only</button>
      </div>
    </div>

    <div id="lb-context" set:html={first.context} />

    <div class="panel lb-table-wrap">
      <table class="lb-table">
        <thead id="lb-thead" set:html={first.head} />
        <tbody id="lb-tbody" set:html={first.body} aria-live="polite" />
      </table>
    </div>
    <div class="lb-more" id="lb-more" set:html={first.more} />

    <div class="panel needed">
      <div class="needed-head">
        <div class="needed-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
          <h3>Vehicles Needed</h3>
        </div>
        <p>These vehicles don't have a verified record yet on Gellhorn. Be the first.</p>
      </div>
      <ul id="lb-needed" set:html={needed} />
    </div>
  </div>
</section>

<style>
  .lb { padding-top: 1rem; padding-bottom: var(--gh-gap-section); }
  .lb-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin-bottom: 1.5rem; }
  .sample-flag { display: inline-block; margin-bottom: .7rem; padding: .3rem .65rem; border-radius: 999px; background: rgba(242,75,157,.14); color: var(--gh-red); font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  /* JS sets [hidden] on this once live data loads; without this rule the
     UA default [hidden]{display:none} loses to the display:inline-block
     above (author CSS always beats UA CSS), so the badge stayed visible
     even though renderLiveRows() correctly hid it. */
  .sample-flag[hidden] { display: none; }
  .lb-title { font-size: clamp(1.9rem, 3vw, 2.6rem); margin: 0; }
  .lb-meta { margin: .5rem 0 0; color: var(--gh-muted); font-size: .85rem; }

  .lb-controls { display: flex; flex-wrap: wrap; gap: .85rem; margin-bottom: 1.25rem; }
  .lb-vehicle-select { flex: 1 1 16rem; display: flex; }
  .lb-filter-select { flex: 1 1 11rem; }
  .lb-vehicle-select select { width: 100%; }
  .lb-search { flex: 1 1 14rem; } /* look: site-wide .ui-search (tokens.css) */
  .lb-toggle { display: inline-flex; border: 1px solid var(--gh-line); border-radius: var(--gh-radius); overflow: hidden; }
  .lb-toggle button { padding: .65rem 1.1rem; border: none; background: transparent; color: var(--gh-muted); font-weight: 700; font-size: .78rem; cursor: pointer; }
  .lb-toggle button.is-active { background: var(--gh-yellow); color: #2A0F22; }

  .lb-table-wrap { padding: 0; overflow-x: auto; }
  .lb-table { width: 100%; border-collapse: collapse; min-width: 46rem; }
  :global(.lb-table th) { text-align: left; padding: .9rem 1.1rem; color: var(--gh-muted); font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; border-bottom: 1px solid var(--gh-line); }
  /* :global() throughout this block: #lb-tbody's real rows are inserted at
     runtime via innerHTML from live Supabase data (renderLiveRows() below),
     so Astro's scoped-CSS attribute never reaches them -- same bug class
     already found and fixed on the account page's .records-table (see
     e8ce020). Without :global() every one of these rules silently only
     ever applied to the build-time sample rows, and live rows fell back to
     bare browser defaults: ~1px cell padding, no rank/gap/logo/status
     styling, no top3 highlight -- which is exactly what "sieht komisch
     aus" / "Tabelle sieht nicht ordentlich aus" was. */
  :global(.lb-table td) { padding: .85rem 1.1rem; font-size: .88rem; border-bottom: 1px solid var(--gh-line); }
  :global(.lb-table tbody tr:last-child td) { border-bottom: none; }
  :global(.lb-table tr.is-top3) { background: rgba(255,149,90,.05); }
  :global(.lb-rank) { font-family: var(--gh-font-display); font-weight: 900; color: var(--gh-muted); }
  :global(.is-top3 .lb-rank) { color: var(--gh-yellow); }
  :global(.lb-driver) { font-weight: 700; }
  :global(.lb-crew-tag) { margin-left: .45rem; vertical-align: 1px; }
  :global(.lb-vehicle) { display: inline-flex; align-items: center; gap: .5rem; }
  :global(.lb-link), :global(.lb-logo-link) { color: inherit; text-decoration: none; }
  :global(.lb-link:hover), :global(.lb-link:focus-visible) { color: var(--gh-text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--gh-red); }
  /* same spacing between make and model as the non-link rows (flex gap) */
  :global(.lb-vehicle-name) { display: inline-flex; align-items: baseline; gap: .5rem; }
  :global(.needed-link) { color: inherit; text-decoration: none; }
  :global(.needed-link:hover strong) { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--gh-muted); }
  :global(.lb-make) { color: var(--gh-muted); }
  :global(.lb-model) { color: var(--gh-text); }
  :global(.lb-num) { color: var(--gh-muted); }
  :global(.lb-time) { font-variant-numeric: tabular-nums; font-weight: 700; }
  :global(.lb-gap) { display: block; color: var(--gh-muted); font-size: .72rem; font-weight: 400; }
  :global(.status-ok) { color: var(--gh-yellow); }
  :global(.check-circle) { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; flex: none; border-radius: 50%; background: var(--gh-yellow); color: #2A0F22; }
  :global(.watch-btn) { display: inline-flex; align-items: center; padding: .35rem .8rem; border-radius: var(--gh-radius); background: transparent; border: 1px solid var(--gh-line); color: var(--gh-text); font-size: .76rem; font-weight: 700; text-decoration: none; }

  /* Logos in white, no circle, a bit larger (Fausto, 2026-10-03). Source
     files are black on transparent; invert(.97) ≈ the palette text white. */
  :global(.logo-chip) { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; flex: none; }
  :global(.logo-chip img) { width: 100%; height: 100%; object-fit: contain; display: block; filter: invert(.97); }
  :global(.logo-chip-lg) { width: 48px; height: 48px; }

  /* 6 vehicles as a fixed grid next to the heading (Fausto, 2026-09-30): 3x2 desktop, 2 cols tablet, 1 col phone */
  .needed { display: grid; grid-template-columns: minmax(12rem, 16rem) 1fr; gap: 1.5rem; align-items: start; margin-top: 1.25rem; padding: var(--gh-pad-card); }
  .needed-title { display: flex; align-items: center; gap: .5rem; }
  .needed-title svg { color: var(--gh-yellow); flex: none; }
  .needed-head h3 { margin: 0; font-family: var(--gh-font-display); font-weight: 900; text-transform: uppercase; font-size: 1.3rem; }
  .needed-head p { margin: .3rem 0 0; max-width: 30ch; color: var(--gh-muted); font-size: .82rem; }
  .needed ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; list-style: none; margin: 0; padding: 0; }
  @media (max-width: 1100px) { .needed { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .needed ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .needed ul { grid-template-columns: 1fr; } }
  :global(.needed li) { display: flex; align-items: center; gap: .6rem; padding: .7rem .95rem; border: 1px solid var(--gh-line); border-radius: var(--gh-radius); min-width: 0; }
  :global(.needed-text) { display: flex; flex-direction: column; gap: .2rem; }
  :global(.needed-text strong) { font-size: .82rem; }
  :global(.needed-text span) { color: var(--gh-muted); font-size: .7rem; }

  @media (max-width: 700px) {
    /* phone: keep rank, driver, vehicle, lap time and a status icon on screen */
    .lb-table { min-width: 0; }
    :global(.lb-table .col-opt), :global(.lb-table .st-txt) { display: none; }
    :global(.lb-table td), :global(.lb-table th) { padding-inline: .55rem; }
    :global(.lb-table .lb-vehicle-name) { flex-direction: column; gap: 0; }
    :global(.lb-table .lb-crew-tag) { margin-left: .3rem; }
    :global(.lb-table .lb-vehicle .logo-chip) { display: none; }
    .lb-head { align-items: flex-start; }
  }

  :global(.sr-only) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  :global(a.lb-crew-tag) { text-decoration: none; color: #111; }
  :global(a.lb-crew-tag:hover) { filter: brightness(.9); }
  :global(.watch-btn) { cursor: pointer; font-family: var(--gh-font-body); }
  :global(.watch-btn.is-disabled) { opacity: .45; cursor: not-allowed; }
  :global(.lb-empty-row td) { padding: 2rem 1.1rem; text-align: center; color: var(--gh-muted); }
  .lb-toggle button:hover:not(.is-active) { color: var(--gh-text); }
  .lb-more { display: flex; justify-content: center; }
  :global(.lb-more-btn) { margin-top: 1rem; }
  :global(.lb-context) { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.2rem; margin-bottom: 1rem; }
  :global(.lb-context-title) { display: flex; align-items: center; gap: .65rem; flex: 1 1 auto; }
  :global(.lb-context-title h3) { margin: 0; font-family: var(--gh-font-display); font-weight: 900; text-transform: uppercase; font-size: 1.25rem; }
  :global(.lb-context-kicker) { margin: 0; color: var(--gh-muted); font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  :global(.lb-context-link) { color: var(--gh-muted); font-size: .8rem; font-weight: 700; }
  :global(.lb-context-link:hover) { color: var(--gh-text); }
  @media (max-width: 380px) {
    :global(.lb-table td), :global(.lb-table th) { padding-inline: .4rem; }
  }
</style>

<script>
  // Browser side: state + filters, and the live feed. The markup above is
  // the sample data rendered at build time; this script re-renders with the
  // same renderer. Live rows replace the sample as soon as public_leaderboard
  // returns at least one row (pre-launch: zero rows -> sample stays, flagged).
  // TRACK_ID is fixed while Gellhorn is the only track.
  import { createClient } from '@supabase/supabase-js';
  import { LEADERBOARD_PLATFORM } from '../data/platforms';
  import { sampleEntries, initialState, render, vehiclesNeededHtml, vehicleSelectHtml, classSelectHtml, makeSelectHtml, inFilter, lbClasses, lbMakes, type LbEntry, type LbState } from '../data/leaderboard';

  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
  const TRACK_ID = 'gellhorn-international-raceway';
  const $ = (id: string) => document.getElementById(id)!;

  let data: LbEntry[] = sampleEntries;
  // Best VERIFIED run per driver + vehicle (RS-0040). `data` holds only the
  // fastest run, which may be unverified while a slower verified one exists;
  // "Verified only" therefore uses its own view. Sample data: same list.
  let verifiedData: LbEntry[] = sampleEntries;
  let sample = true;
  const current = () => (state.verifiedOnly ? verifiedData : data);
  const state: LbState = { ...initialState };

  // Shareable state: ?vehicle=<id>&verified=1
  const params = new URLSearchParams(location.search);
  if (params.get('vehicle')) state.vehicle = params.get('vehicle');
  const pc = params.get('class'); if (pc && lbClasses.includes(pc)) state.cls = pc;
  const pm = params.get('make'); if (pm && lbMakes.some(([k]) => k === pm)) state.make = pm;
  if (params.get('verified') === '1') state.verifiedOnly = true;

  function syncUrl() {
    const u = new URL(location.href);
    ['vehicle', 'class', 'make', 'verified', 'lb'].forEach((k) => u.searchParams.delete(k));
    if (state.cls) u.searchParams.set('class', state.cls);
    if (state.make) u.searchParams.set('make', state.make);
    if (state.vehicle) u.searchParams.set('vehicle', state.vehicle);
    if (state.verifiedOnly) u.searchParams.set('verified', '1');
    history.replaceState(null, '', u.pathname + u.search + u.hash);
  }

  const vehicleSel = $('lb-vehicle') as HTMLSelectElement;
  const classSel = $('lb-class') as HTMLSelectElement;
  const makeSel = $('lb-make') as HTMLSelectElement;
  function draw() {
    const r = render(current(), state, sample);
    $('lb-thead').innerHTML = r.head;
    $('lb-tbody').innerHTML = r.body;
    $('lb-context').innerHTML = r.context;
    $('lb-more').innerHTML = r.more;
    $('lb-meta').textContent = r.meta;
    vehicleSel.innerHTML = vehicleSelectHtml(current(), state); // counts follow the verified filter
    vehicleSel.value = state.vehicle ?? '';
    classSel.innerHTML = classSelectHtml(state); classSel.value = state.cls ?? '';
    makeSel.innerHTML = makeSelectHtml(state); makeSel.value = state.make ?? '';
    document.querySelectorAll<HTMLButtonElement>('.lb-toggle button').forEach((b) => {
      const on = (b.dataset.verified === '1') === state.verifiedOnly;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    syncUrl();
  }

  const qDriver = $('lb-q-driver') as HTMLInputElement;
  qDriver.addEventListener('input', () => { state.qDriver = qDriver.value; draw(); });
  vehicleSel.addEventListener('change', () => { state.vehicle = vehicleSel.value || null; state.showAll = false; draw(); });
  // a chosen vehicle outside the new class/manufacturer is dropped
  const refilter = () => { if (state.vehicle && !inFilter(state.vehicle, null, state)) state.vehicle = null; state.showAll = false; draw(); };
  classSel.addEventListener('change', () => { state.cls = classSel.value || null; refilter(); });
  makeSel.addEventListener('change', () => { state.make = makeSel.value || null; refilter(); });
  document.querySelectorAll<HTMLButtonElement>('.lb-toggle button').forEach((b) => b.addEventListener('click', () => {
    state.verifiedOnly = b.dataset.verified === '1';
    draw();
  }));
  $('leaderboard').addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-lb-more]')) { state.showAll = true; draw(); }
  });

  draw();

  interface LiveRow {
    driver: string; driver_id: string; vehicle_id: string; make: string; model: string;
    manufacturer_logo_slug: string | null; lap_time_ms: number; track_entries: number;
    video_verified: boolean; video_url: string | null;
  }
  async function loadLive() {
    const sb = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    const cols = 'driver, driver_id, vehicle_id, make, model, manufacturer_logo_slug, lap_time_ms, track_entries, video_verified, video_url';
    const query = (view: string) => sb.from(view).select(cols)
      .eq('track_id', TRACK_ID)
      .eq('platform', LEADERBOARD_PLATFORM) // DEC-0073: PS5 board only
      .order('lap_time_ms', { ascending: true });
    const [allRes, verRes] = await Promise.all([query('public_leaderboard'), query('public_leaderboard_verified')]);
    const rows = allRes.data;
    if (allRes.error || !rows || rows.length === 0) return;
    const live = rows as LiveRow[];
    const liveVerified = (verRes.error ? [] : (verRes.data ?? [])) as LiveRow[];
    // Crew tag (RS-0024): active members of published crews, never anonymised drivers.
    const tags = new Map<string, { tag: string; color: string }>();
    const ids = [...new Set([...live, ...liveVerified].map((r) => r.driver_id).filter(Boolean))];
    if (ids.length) {
      // Up to 5 crews per driver (DEC-0093): show the main crew (is_primary).
      // select('*') keeps working with or without the is_primary column.
      const roster = await sb.from('public_crew_roster').select('*').in('driver_id', ids.slice(0, 300));
      for (const r of (roster.data ?? []) as { driver_id: string; tag: string; color: string; is_primary?: boolean }[]) {
        if (!tags.has(r.driver_id) || r.is_primary) tags.set(r.driver_id, { tag: r.tag, color: r.color });
      }
    }
    const toEntry = (r: LiveRow): LbEntry => ({
      driver: r.driver, driver_id: r.driver_id, crew: tags.get(r.driver_id) ?? null,
      vehicle_id: r.vehicle_id, make: r.make, model: r.model, logo: r.manufacturer_logo_slug,
      lap_time_ms: r.lap_time_ms, entries: Number(r.track_entries) || 0,
      verified: Boolean(r.video_verified), video_url: r.video_url,
    });
    data = live.map(toEntry);
    verifiedData = liveVerified.map(toEntry);
    sample = false;
    ($('lb-flag') as HTMLElement).hidden = true;
    // a vehicle counts as verified if ANY driver has a verified run on it
    $('lb-needed').innerHTML = vehiclesNeededHtml([...data, ...verifiedData]);
    draw();
  }
  if (SUPABASE_URL && SUPABASE_ANON_KEY) loadLive();
</script>
