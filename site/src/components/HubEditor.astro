---
// The Hub editor (crews, events, roles, role requests), RS-0022/0023/0026.
// mode="moderator": full admin view in /moderator/hub/.
// mode="crew" / "events" / "tracks": personal view inside My Account -- only the
// crews the driver leads / the events they run / the tracks they built (RS-0045).
// RLS enforces the same rules.
import '../styles/hub.css';
import { eventTypeLabels, focusLabels, platformLabels } from '../data/hub';
import { PLATFORMS, comingLater } from '../data/platforms';
import { crewLanguages, mainCrewLanguages } from '../data/languages';
import { raceTypeLabels, layoutLabels, trackVehicleClasses } from '../data/tracks';
const moreLanguages = Object.keys(crewLanguages).filter((k) => !mainCrewLanguages.includes(k)).sort((a, b) => crewLanguages[a].localeCompare(crewLanguages[b]));
interface Props { mode: 'moderator' | 'crew' | 'events' | 'tracks'; }
const { mode } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div id="hc-root" data-mode={mode}>
    <div id="backend-notice" class="notice" hidden>
      <strong>Backend not connected.</strong>
      <span>No Supabase project is configured for this build, so nothing can be loaded or saved here.</span>
    </div>
    {mode === 'moderator' && (<div id="auth-box" class="panel auth-box" hidden>
      <p>Sign in with Discord to access the moderator area.</p>
      <button type="button" id="discord-signin-btn" class="btn btn-outline">Sign in with Discord</button>
    </div>)}
    {mode === 'moderator' && (<div id="not-mod-notice" class="notice" hidden>
      <strong>Moderators only.</strong>
      <span>Crew leaders and event hosts manage their crew and events in <a href={`${base}account/crew/`}>My Account</a>.</span>
    </div>)}

    <div id="mod-content" hidden>
      <div class="hc-tabs" role="tablist">
        <button type="button" class="hc-tab is-active" data-kind="crews" role="tab" aria-selected="true">Crews</button>
        <button type="button" class="hc-tab" data-kind="events" role="tab" aria-selected="false">Events</button>
        <button type="button" class="hc-tab" data-kind="tracks" role="tab" aria-selected="false" data-mod-only hidden>Tracks</button>
        <button type="button" class="hc-tab" data-kind="roles" role="tab" aria-selected="false" data-mod-only hidden>Roles</button>
        <button type="button" class="hc-tab" data-kind="requests" role="tab" aria-selected="false" data-mod-only hidden>Requests</button>
      </div>

      <div class="mod-layout">
        <div class="panel list-panel">
          <div class="list-head">
            <h2 class="list-title" id="list-title">Crews</h2>
            <button type="button" class="btn btn-red btn-sm" id="new-btn">+ New crew</button>
          </div>
          <div class="list" id="list"></div>
          <p class="list-empty" id="list-empty" hidden>Nothing here yet.</p>
          <p class="list-error" id="list-error" hidden></p>
        </div>

        <div class="panel editor-panel">
          <p class="editor-placeholder" id="editor-placeholder">Select an entry on the left or create a new one.</p>

          <!-- CREW FORM -->
          <form id="crew-form" class="hc-form" hidden novalidate>
            <div class="form-head">
              <h2 id="crew-form-title">New crew</h2>
              <label class="pub-toggle" data-mod-only><input type="checkbox" name="is_published" /> <span>Published</span></label>
              <span class="pub-state" data-leader-only hidden></span>
            </div>
            <p class="track-note" id="crew-mod-note" hidden></p>
            <div class="grid">
              <label class="span2">Crew name *<input type="text" name="name" maxlength="40" required /></label>
              <label>Crew tag * <small>exactly 4 letters/digits</small><input type="text" name="tag" maxlength="4" required class="tag-input" /></label>
              <label>Crew color *<span class="color-row"><input type="color" name="color_picker" value="#ed253d" /><input type="text" name="color" value="#ed253d" maxlength="7" /></span></label>
              <label data-mod-only>URL slug * <small>auto from name</small><input type="text" name="slug" maxlength="48" required /></label>
              <label>Members <small>optional, e.g. from Social Club</small><input type="number" name="member_count" min="0" step="1" /></label>
              <fieldset class="span2 platforms-set"><legend>Platforms</legend>
                {PLATFORMS.map((p) => p.active
                  ? <label class="check"><input type="checkbox" name="platforms" value={p.id} checked data-locked /> {p.label}</label>
                  : <label class="check is-soon" title={comingLater(p)}><input type="checkbox" disabled /> {p.label} <span class="soon">Coming later</span></label>)}
              </fieldset>
              <fieldset class="span2"><legend>Focus</legend>
                {Object.entries(focusLabels).map(([k, v]) => <label class="check"><input type="checkbox" name="focus" value={k} /> {v}</label>)}
              </fieldset>
              <label>Region<input type="text" name="region" maxlength="40" placeholder="e.g. Europe" /></label>
              <fieldset class="span2 lang-set"><legend>Languages <small>pick all your crew speaks</small></legend>
                {mainCrewLanguages.map((k) => <label class="check"><input type="checkbox" name="languages" value={k} /> {crewLanguages[k]}</label>)}
                <details class="lang-more">
                  <summary>More languages</summary>
                  <div class="lang-more-list">
                    {moreLanguages.map((k) => <label class="check"><input type="checkbox" name="languages" value={k} /> {crewLanguages[k]}</label>)}
                  </div>
                </details>
              </fieldset>
              <label class="span2">Description <small><span id="crew-desc-count">0</span>/400</small><textarea name="description" maxlength="400" rows="3"></textarea></label>
              <label>Discord invite<input type="url" name="discord_url" placeholder="https://discord.gg/…" /></label>
              <label>Social Club page<input type="url" name="social_club_url" placeholder="https://socialclub.rockstargames.com/…" /></label>
              <label class="check" data-mod-only><input type="checkbox" name="is_partner" /> Partner crew</label>
              <label class="check" data-mod-only><input type="checkbox" name="is_featured" /> Featured crew <small>shown on the home page and Hub overview</small></label>
              <label data-mod-only>Sort order <small>lower = earlier</small><input type="number" name="sort_order" step="1" value="0" /></label>
              <label class="span2" data-mod-only>Note to the crew leader <small>optional, e.g. why the crew is hidden or what to fix</small><textarea name="moderation_note" maxlength="300" rows="2"></textarea></label>
            </div>
            <div class="preview-wrap"><p class="preview-label">Preview</p><div class="crew-grid preview" id="crew-preview"></div></div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Save</button>
              <button type="button" class="btn btn-outline-red" data-action="delete" hidden>Delete</button>
              <p class="form-msg" data-role="msg" aria-live="polite"></p>
            </div>
          </form>

          <!-- CREW MEMBERS (RS-0024) -->
          <div id="members-panel" class="members-panel" hidden>
            <div class="form-head"><h2>Members</h2><span class="members-sub" id="members-sub"></span></div>
            <div id="members-pending"></div>
            <!-- Invite drivers (RS-0063, DEC-0094). COPY: Claude placeholders. -->
            <div class="mem-invite">
              <p class="mem-group-title">Invite a driver</p>
              <label class="ui-search mem-invite-search"><input type="search" id="invite-q" placeholder="Driver name (min. 3 letters)" aria-label="Search drivers to invite" autocomplete="off" /></label>
              <div id="invite-results"></div>
              <div id="members-invited"></div>
            </div>
            <div id="members-active"></div>
            <p class="form-msg" id="members-msg" aria-live="polite"></p>
          </div>

          <!-- EVENT FORM -->
          <form id="event-form" class="hc-form" hidden novalidate>
            <div class="form-head">
              <h2 id="event-form-title">New event</h2>
              <label class="pub-toggle" data-mod-only><input type="checkbox" name="is_published" checked /> <span>Published</span></label>
            </div>
            <p class="track-note" id="event-mod-note" hidden></p>
            <div class="grid">
              <label class="span2">Title *<input type="text" name="title" maxlength="80" required /></label>
              <label>Event type *<select name="event_type" required>{Object.entries(eventTypeLabels).map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
              <label>Status<select name="status"><option value="scheduled">Scheduled</option><option value="cancelled">Cancelled</option></select></label>
              <label>Start * <small id="tz-hint">your local time</small><input type="datetime-local" name="starts_at" min="2026-11-19T00:00" required /></label>
              <label>End <small>optional</small><input type="datetime-local" name="ends_at" /></label>
              <fieldset class="span2 platforms-set"><legend>Platforms</legend>
                {PLATFORMS.map((p) => p.active
                  ? <label class="check"><input type="checkbox" name="platforms" value={p.id} checked data-locked /> {p.label}</label>
                  : <label class="check is-soon" title={comingLater(p)}><input type="checkbox" disabled /> {p.label} <span class="soon">Coming later</span></label>)}
              </fieldset>
              <label>Host PSN name <small>so players can add you on PlayStation</small><input type="text" name="host_name" maxlength="16" placeholder="e.g. Racer_01" autocomplete="off" /></label>
              <label>Host crew <small>optional — its tag is shown next to your name</small><select name="host_crew_id"><option value="">— none —</option></select></label>
              <label>Location<input type="text" name="location" maxlength="80" placeholder="e.g. Vice Beach" /></label>
              <label class="span2">Discord invite <small>where participants meet you — a PSN name or a Discord (yours or your crew's) is required</small><input type="url" name="discord_url" placeholder="https://discord.gg/…" /></label>
              <label>Details link <small>optional, any https page</small><input type="url" name="join_url" placeholder="https://…" /></label>
              <label>Max. participants <small>optional, e.g. lobby size</small><input type="number" name="max_participants" min="2" max="500" step="1" /></label>
              <label>Sign-ups <small>Controls the “I'm in” button on the calendar</small><select name="registration"><option value="open">Open</option><option value="closed">Closed — Listed, No Sign-ups</option></select></label>
              <label class="span2">Stream link <small>Optional — Twitch, YouTube, or Kick. Shown even when sign-ups are full or closed.</small><input type="url" name="stream_url" placeholder="https://www.twitch.tv/…" /></label>
              <label class="span2">Description <small><span id="event-desc-count">0</span>/600</small><textarea name="description" maxlength="600" rows="3"></textarea></label>
              <label class="span2" data-mod-only>Note to the host <small>optional, e.g. why the event is hidden or what to fix</small><textarea name="moderation_note" maxlength="300" rows="2"></textarea></label>
            </div>
            <div class="preview-wrap"><p class="preview-label">Preview</p><div class="ev-list preview" id="event-preview"></div></div>
            <div class="rsvp-panel" id="rsvp-panel" hidden><p class="preview-label">Sign-ups</p><div id="rsvp-list"></div></div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Save</button>
              <button type="button" class="btn btn-outline-red" data-action="delete" hidden>Delete</button>
              <p class="form-msg" data-role="msg" aria-live="polite"></p>
            </div>
          </form>

          <!-- TRACK FORM (RS-0045) -->
          <form id="track-form" class="hc-form" hidden novalidate>
            <div class="form-head">
              <h2 id="track-form-title">New track</h2>
              <label class="pub-toggle" data-mod-only><input type="checkbox" name="is_published" /> <span>Published</span></label>
              <span class="pub-state" data-creator-only hidden></span>
            </div>
            <p class="track-note" id="track-review-note" hidden></p>
            <div class="grid">
              <label class="span2">Track name *<input type="text" name="title" maxlength="60" required /></label>
              <label class="span2">Social Club link * <small>the job's page on Social Club — we check the details there</small><input type="url" name="social_club_url" placeholder="https://socialclub.rockstargames.com/job/…" required /></label>
              <label>Layout *<select name="layout">{Object.entries(layoutLabels).map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
              <label>Length (km) * <small>as shown on Social Club</small><input type="number" name="length_km" min="0.1" max="500" step="0.01" required /></label>
              <label>Players from *<input type="number" name="players_min" min="1" max="64" step="1" value="2" required /></label>
              <label>Players up to *<input type="number" name="players_max" min="1" max="64" step="1" value="16" required /></label>
              <fieldset class="span2"><legend>Race type * <small>one or more</small></legend>
                {Object.entries(raceTypeLabels).map(([k, v]) => <label class="check"><input type="checkbox" name="race_types" value={k} /> {v}</label>)}
              </fieldset>
              <fieldset class="span2"><legend>Vehicle classes * <small>one or more</small></legend>
                {trackVehicleClasses.map((c) => <label class="check"><input type="checkbox" name="vehicle_classes" value={c} /> {c}</label>)}
              </fieldset>
              <label class="span2" data-mod-only>Note to the creator <small>optional, e.g. what to fix before publishing</small><textarea name="review_note" maxlength="300" rows="2"></textarea></label>
            </div>
            <div class="preview-wrap"><p class="preview-label">Preview</p><div class="tr-list preview" id="track-preview"></div></div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Save</button>
              <button type="button" class="btn btn-outline-red" data-action="delete" hidden>Delete</button>
              <p class="form-msg" data-role="msg" aria-live="polite"></p>
            </div>
          </form>

          <!-- ROLE REQUESTS (moderators only, RS-0026) -->
          <div id="requests-panel" class="hc-form" hidden>
            <div class="form-head"><h2 id="req-title">Request</h2><span class="pub-state" id="req-state"></span></div>
            <div id="req-body" class="req-body"></div>
            <label class="req-note">Note to the driver <small>optional, only stored with a rejection</small><textarea id="req-note" maxlength="300" rows="2"></textarea></label>
            <div class="form-actions" id="req-actions">
              <button type="button" class="btn btn-primary" id="req-approve">Approve</button>
              <button type="button" class="btn btn-outline-red" id="req-reject">Reject</button>
              <p class="form-msg" id="req-msg" aria-live="polite"></p>
            </div>
          </div>

          <!-- ROLES (moderators only) -->
          <div id="roles-panel" class="hc-form" hidden>
            <div id="role-selected" class="role-selected" hidden>
              <p><strong id="role-selected-text"></strong></p>
              <button type="button" class="btn btn-outline-red btn-sm" id="role-revoke">Revoke role</button>
            </div>
            <div class="form-head"><h2>Grant a role</h2></div>
            <div class="grid">
              <label class="span2">Driver <small>search by display name — the driver must have signed in once</small>
                <input type="text" id="role-driver-search" placeholder="Type at least 2 letters" autocomplete="off" />
              </label>
              <div class="span2 driver-results" id="role-driver-results"></div>
              <fieldset class="span2"><legend>Roles <small>pick one or more</small></legend>
                <label class="check"><input type="checkbox" name="role" value="crew_leader" /> Crew Leader — manages one crew (card, join requests, members)</label>
                <label class="check"><input type="checkbox" name="role" value="event_host" /> Event Host — publishes own events in the calendar</label>
                <label class="check"><input type="checkbox" name="role" value="creator" /> Creator — submits own race jobs to Tracks (a moderator publishes them)</label>
              </fieldset>
              <label class="span2" id="role-crew-wrap" hidden>Crew <small>crew not listed yet? Create it under Crews first, or let the driver apply with a new crew (approving the request creates it)</small><select id="role-crew"></select></label>
            </div>
            <div class="form-actions">
              <button type="button" class="btn btn-primary" id="role-grant">Grant roles</button>
              <p class="form-msg" id="role-msg" aria-live="polite"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
</div>

<style>
  [hidden] { display: none !important; }
  .notice { display: flex; flex-direction: column; gap: .3rem; margin-bottom: 1.5rem; padding: 1rem 1.2rem; border: 1px solid var(--gh-yellow); background: rgba(255,215,76,.08); border-radius: var(--gh-radius); font-size: .85rem; }
  .notice strong { color: var(--gh-yellow); }
  .auth-box { margin-bottom: 1.5rem; padding: 1rem 1.2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .auth-box p { margin: 0; font-size: .88rem; }

  .hc-tabs { display: flex; gap: .4rem; margin-bottom: 1rem; }
  .hc-tab { padding: .55rem 1.1rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: transparent; color: var(--gh-muted); font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: .85rem; cursor: pointer; }
  .hc-tab.is-active { color: var(--gh-text); border-color: var(--gh-muted); background: var(--gh-surface-soft); }

  .mod-layout { display: grid; grid-template-columns: 20rem 1fr; gap: 1.5rem; align-items: start; }
  @media (max-width: 900px) { .mod-layout { grid-template-columns: 1fr; } }
  .list-panel { padding: 1.1rem; position: sticky; top: 5.5rem; }
  @media (max-width: 900px) { .list-panel { position: static; } }
  .list-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: 1rem; }
  .list-title { margin: 0; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.15rem; }
  .btn-sm { padding: .45rem .8rem; font-size: .78rem; }
  .list { display: flex; flex-direction: column; gap: .45rem; max-height: 34rem; overflow-y: auto; }
  .list-empty, .list-error { margin: 0; color: var(--gh-muted); font-size: .85rem; }
  .list-error { color: var(--gh-red); }
  /* built via innerHTML -> :global */
  :global(.li) { display: flex; align-items: center; gap: .6rem; width: 100%; text-align: left; padding: .6rem .7rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); border-left: 3px solid transparent; background: var(--gh-surface-soft); color: var(--gh-text); cursor: pointer; font-family: var(--gh-font-body); }
  :global(.li:hover) { border-color: var(--gh-muted); }
  :global(.li.is-active) { border-left-color: var(--gh-yellow); background: rgba(255,215,76,.08); }
  :global(.li-main) { flex: 1; min-width: 0; }
  :global(.li-title) { display: block; font-weight: 700; font-size: .86rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.li-sub) { display: block; color: var(--gh-muted); font-size: .74rem; margin-top: .15rem; }
  :global(.li-pill) { flex: none; padding: .12rem .45rem; border-radius: 999px; font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
  :global(.li-pill.pub) { background: rgba(79,209,197,.14); color: #4fd1c5; }
  :global(.li-pill.draft) { background: var(--gh-surface); color: var(--gh-muted); border: 1px solid var(--gh-line); }

  .editor-panel { padding: var(--gh-pad-card); min-height: 20rem; }
  .editor-placeholder { margin: 0; color: var(--gh-muted); font-size: .9rem; }
  .form-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--gh-line); }
  .form-head h2 { margin: 0; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.35rem; }
  .hc-form .pub-toggle { flex-direction: row; text-transform: none; letter-spacing: 0; color: var(--gh-text); }
  .pub-toggle { display: inline-flex; align-items: center; gap: .5rem; padding: .45rem .8rem; border-radius: 999px; border: 1px solid var(--gh-line); font-size: .8rem; font-weight: 700; cursor: pointer; }
  .pub-toggle input { width: 1rem; height: 1rem; accent-color: #4fd1c5; }
  .pub-toggle:has(input:checked) { border-color: #4fd1c5; color: #4fd1c5; }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem 1.1rem; }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
  .span2 { grid-column: 1 / -1; }
  .hc-form label, .hc-form legend { display: flex; flex-direction: column; gap: .35rem; font-size: .72rem; color: var(--gh-muted); font-weight: 700; text-transform: uppercase; letter-spacing: .03em; }
  .hc-form small { font-weight: 500; text-transform: none; letter-spacing: 0; color: var(--gh-muted); opacity: .8; }
  .hc-form input[type="text"], .hc-form input[type="url"], .hc-form input[type="number"], .hc-form input[type="datetime-local"], .hc-form select, .hc-form textarea {
    padding: .6rem .7rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: var(--gh-bg); color: var(--gh-text);
    font-size: .88rem; font-family: var(--gh-font-body); text-transform: none; letter-spacing: normal; font-weight: 400; color-scheme: dark;
  }
  .hc-form select option { background: var(--gh-surface); }
  .hc-form textarea { resize: vertical; }
  .hc-form :is(input, select, textarea):focus { outline: 2px solid var(--gh-yellow); outline-offset: 1px; }
  .hc-form :is(input, select, textarea)[aria-invalid="true"] { border-color: var(--gh-red); }
  .tag-input { text-transform: uppercase !important; letter-spacing: .12em !important; font-weight: 800 !important; }
  .color-row { display: flex; gap: .5rem; }
  .color-row input[type="color"] { width: 2.6rem; height: 2.4rem; padding: 0; border: 1px solid var(--gh-line); border-radius: var(--gh-radius); background: none; cursor: pointer; }
  .color-row input[type="text"] { flex: 1; min-width: 0; }
  fieldset { border: 1px solid var(--gh-line); border-radius: var(--gh-radius); padding: .6rem .8rem .7rem; margin: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; }
  fieldset legend { padding: 0 .3rem; }
  .lang-more { flex-basis: 100%; }
  .lang-more summary { cursor: pointer; color: var(--gh-muted); font-size: .82rem; font-weight: 700; }
  .lang-more[open] summary { margin-bottom: .45rem; }
  .lang-more-list { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; }
  fieldset[hidden] { display: none; }
  .hc-form label.check.is-soon { color: var(--gh-muted); cursor: not-allowed; }
  .check.is-soon input { cursor: not-allowed; }
  .soon { padding: .1rem .45rem; border-radius: 999px; border: 1px solid var(--gh-line); font-size: .66rem; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: var(--gh-muted); }
  .hc-form label.check { flex-direction: row; align-items: center; gap: .45rem; text-transform: none; letter-spacing: 0; font-size: .86rem; font-weight: 600; color: var(--gh-text); }
  .check input { width: 1rem; height: 1rem; accent-color: var(--gh-red); }

  .pub-state { padding: .35rem .75rem; border-radius: 999px; border: 1px solid var(--gh-line); font-size: .75rem; font-weight: 700; color: var(--gh-muted); }
  .role-selected { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem; margin-bottom: 1.4rem; padding: .9rem 1rem; border: 1px solid var(--gh-yellow); border-radius: var(--gh-radius); background: rgba(255,215,76,.06); }
  .role-selected p { margin: 0; font-size: .9rem; }
  .driver-results { display: flex; flex-wrap: wrap; gap: .4rem; min-height: 0; }
  :global(.driver-pick) { padding: .4rem .7rem; border-radius: 999px; border: 1px solid var(--gh-line); background: var(--gh-bg); color: var(--gh-text); font: inherit; font-size: .82rem; cursor: pointer; }
  :global(.driver-pick.is-active) { border-color: var(--gh-yellow); color: var(--gh-yellow); }
  :global(.li-role) { flex: none; padding: .12rem .45rem; border-radius: 999px; font-size: .62rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; background: rgba(255,215,76,.14); color: var(--gh-yellow); }
  .preview-wrap { margin-top: 1.5rem; padding-top: 1.1rem; border-top: 1px solid var(--gh-line); }
  .preview-label { margin: 0 0 .7rem; color: var(--gh-muted); font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .crew-grid.preview { grid-template-columns: minmax(0, 24rem); }
  .rsvp-panel { margin-top: 1.2rem; padding-top: 1rem; border-top: 1px solid var(--gh-line); }
  :global(.rsvp-count) { margin: 0 0 .3rem; font-size: .9rem; }
  :global(.rsvp-names) { margin: 0; color: var(--gh-muted); font-size: .84rem; }
  .form-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; margin-top: 1.4rem; }
  .form-msg { margin: 0; font-size: .84rem; }
  .form-msg.is-error { color: var(--gh-red); }
  .form-msg.is-ok { color: #4fd1c5; }
  .req-body { font-size: .9rem; }
  :global(.req-list) { display: grid; gap: .7rem; margin: 0; }
  :global(.req-row) { display: grid; grid-template-columns: 9rem 1fr; gap: .8rem; }
  :global(.req-row dt) { color: var(--gh-muted); font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; padding-top: .15rem; }
  :global(.req-row dd) { margin: 0; overflow-wrap: anywhere; }
  :global(.req-row a) { color: var(--gh-text); }
  @media (max-width: 640px) { :global(.req-row) { grid-template-columns: 1fr; gap: .2rem; } }
  .req-note { margin-top: 1.2rem; }
  .track-note { margin: -.4rem 0 1.1rem; padding: .6rem .8rem; border-left: 3px solid var(--gh-yellow); background: rgba(255,215,76,.06); font-size: .85rem; }
</style>

<script>
  import { getSupabase, backendConfigured } from '../scripts/supabase-client';
  import { crewCardHtml, eventRowHtml, crewTagHtml, esc, localizeTimes, streamPlatform, type HubCrew, type HubEvent } from '../data/hub';
  import { ACTIVE_PLATFORMS } from '../data/platforms';
  import { trackRowHtml, type CommunityTrack } from '../data/tracks';
  // DEC-0073: only active platforms can be saved; PS5 is always set while it is the only one.
  const platformsFrom = (fd: FormData) => {
    const picked = (fd.getAll('platforms') as string[]).filter((p) => (ACTIVE_PLATFORMS as readonly string[]).includes(p as never));
    return picked.length ? picked : [...ACTIVE_PLATFORMS];
  };
  // The only active platform cannot be unticked (a crew/event without platform makes no sense).
  document.addEventListener('click', (ev) => {
    const box = (ev.target as HTMLElement).closest<HTMLInputElement>('input[data-locked]');
    if (box && ACTIVE_PLATFORMS.length === 1) { ev.preventDefault(); box.checked = true; }
  });

  type Kind = 'crews' | 'events' | 'tracks' | 'roles' | 'requests';
  // 'moderator' = full admin view (/moderator/hub/); 'crew' / 'events' =
  // personal view in My Account (RS-0026): only crews I lead / my events,
  // even for moderators (they use the moderator panel for everything else).
  const MODE = (document.getElementById('hc-root')!.dataset.mode ?? 'moderator') as 'moderator' | 'crew' | 'events' | 'tracks';
  const PERSONAL = MODE !== 'moderator';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const rootEl = $('hc-root');
  const authBoxEl = document.getElementById('auth-box');
  const notModEl = document.getElementById('not-mod-notice');
  const contentEl = $('mod-content');
  const listEl = $('list');
  const listEmptyEl = $('list-empty');
  const listErrorEl = $('list-error');
  const listTitleEl = $('list-title');
  const newBtn = $<HTMLButtonElement>('new-btn');
  const placeholderEl = $('editor-placeholder');
  const crewForm = $<HTMLFormElement>('crew-form');
  const eventForm = $<HTMLFormElement>('event-form');
  const trackForm = $<HTMLFormElement>('track-form');

  let kind: Kind = 'crews';
  let crews: any[] = [];
  let events: any[] = [];
  let tracks: any[] = [];
  let selectedId: string | null = null; // null + form visible = creating new
  let ownDriverId: string | null = null;
  // Access model (RS-0023): moderators see/edit everything; crew leaders
  // only their crew(s) + those crews' events; event hosts only their own
  // events. The database (RLS + trigger) enforces the same rules -- this
  // only shapes what the page offers.
  let isMod = false;
  let isHost = false;
  let isCreator = false;
  let leaderCrewIds = new Set<string>();
  let memberCrewIds = new Set<string>(); // crews I'm an active member of (host crew choice)
  let roles: any[] = [];
  let members: any[] = []; // crew_membership_overview rows visible to me
  const pendingFor = (crewId: string) => members.filter((m) => m.crew_id === crewId && m.status === 'pending').length;
  const visibleCrews = () => (isMod ? crews : crews.filter((c) => leaderCrewIds.has(c.crew_id)));
  // RS-0027: events belong to event hosts only (crew leaders need the host role too).
  const visibleEvents = () => (isMod ? events : events.filter((e) => e.created_by === ownDriverId));
  const canCreateEvent = () => isMod || isHost;
  // RS-0045: creators see their own tracks; moderators all (drafts first).
  const visibleTracks = () => (isMod ? [...tracks].sort((a, b) => Number(a.is_published) - Number(b.is_published)) : tracks.filter((t) => t.created_by === ownDriverId));
  function applyRoleVisibility() {
    document.querySelectorAll<HTMLElement>('[data-mod-only]').forEach((el) => (el.hidden = !isMod));
    document.querySelectorAll<HTMLElement>('[data-leader-only]').forEach((el) => (el.hidden = isMod));
    document.querySelectorAll<HTMLElement>('[data-creator-only]').forEach((el) => (el.hidden = isMod));
    const crewTab = document.querySelector<HTMLElement>('.hc-tab[data-kind="crews"]')!;
    crewTab.hidden = !isMod && leaderCrewIds.size === 0;
  }

  // ------------------------------------------------------------ helpers
  const slugify = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 48);
  const blank = (v: FormDataEntryValue | null) => { const t = String(v ?? '').trim(); return t === '' ? null : t; };
  const toLocalInput = (iso: string | null) => {
    if (!iso) return '';
    const d = new Date(iso); const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
  };
  const fromLocalInput = (v: string) => (v ? new Date(v).toISOString() : null);

  function msg(form: HTMLFormElement, text: string, isError = false) {
    const el = form.querySelector<HTMLElement>('[data-role="msg"]')!;
    el.textContent = text;
    el.className = `form-msg ${text ? (isError ? 'is-error' : 'is-ok') : ''}`;
  }
  function markInvalid(form: HTMLFormElement, names: string[]) {
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    names.map((n) => (n === 'starts_before_launch' ? 'starts_at' : n)).forEach((n) => form.querySelector(`[name="${n}"]`)?.setAttribute('aria-invalid', 'true'));
  }
  // Friendlier wording for the database's own checks.
  function dbError(e: { message: string; code?: string }) {
    const m = e.message || '';
    if (e.code === '23505' || /duplicate key/.test(m)) return 'This URL slug is already used by another crew — change it.';
    if (/crews_tag_check/.test(m)) return 'Crew tag must be exactly 4 letters/digits.';
    if (/hub_events_not_before_launch/.test(m)) return 'Events can start on Nov 19, 2026 (GTA VI launch day) at the earliest.';
    if (/row-level security/.test(m)) return 'Not allowed — your account is not a moderator.';
    if (/check constraint/.test(m)) return `The database rejected a value (${m.match(/"([^"]+)"/)?.[1] ?? 'check'}). Please review the fields.`;
    return m;
  }

  // Clear a field's error mark (and the error line) as soon as it is edited.
  [crewForm, eventForm, trackForm].forEach((form) => form.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t.getAttribute('aria-invalid')) {
      t.removeAttribute('aria-invalid');
      if (!form.querySelector('[aria-invalid]')) msg(form, '');
    }
  }));

  // ------------------------------------------------------------ list
  function renderList() {
    if (kind === 'roles') { renderRolesList(); return; }
    if (kind === 'requests') { renderRequestsList(); return; }
    if (kind === 'tracks') { renderTracksList(); return; }
    const rows = kind === 'crews' ? visibleCrews() : visibleEvents();
    listTitleEl.textContent = kind === 'crews' ? (isMod ? 'Crews' : 'My crew') : (isMod ? 'Events' : 'My events');
    newBtn.textContent = kind === 'crews' ? '+ New crew' : '+ New event';
    newBtn.hidden = kind === 'crews' ? !isMod : !canCreateEvent();
    listEl.innerHTML = rows.map((r) => {
      const id = kind === 'crews' ? r.crew_id : r.event_id;
      const pill = r.is_published ? '<span class="li-pill pub">Live</span>' : '<span class="li-pill draft">Draft</span>';
      if (kind === 'crews') {
        const req = pendingFor(id);
        const reqPill = req ? `<span class="li-pill req" title="Open join requests">${req} new</span>` : '';
        return `<button type="button" class="li${id === selectedId ? ' is-active' : ''}" data-id="${esc(id)}">${crewTagHtml(r.tag, r.color, 'sm')}<span class="li-main"><span class="li-title">${esc(r.name)}</span><span class="li-sub">/${esc(r.slug)}</span></span>${reqPill}${pill}</button>`;
      }
      const when = new Date(r.starts_at).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
      return `<button type="button" class="li${id === selectedId ? ' is-active' : ''}" data-id="${esc(id)}"><span class="li-main"><span class="li-title">${r.status === 'cancelled' ? '✕ ' : ''}${esc(r.title)}</span><span class="li-sub">${esc(when)}</span></span>${pill}</button>`;
    }).join('');
    listEmptyEl.hidden = rows.length > 0;
  }

  async function loadAll() {
    listErrorEl.hidden = true;
    const sb = getSupabase();
    const [c, e, t] = await Promise.all([
      sb.from('crews').select('*').order('is_partner', { ascending: false }).order('sort_order').order('name'),
      sb.from('hub_events').select('*, streams:hub_event_streams(stream_id, platform, url, sort_order)').order('starts_at', { ascending: false }),
      sb.from('community_tracks').select('*').order('updated_at', { ascending: false }),
    ]);
    if (c.error || e.error) {
      listErrorEl.textContent = `Could not load: ${(c.error || e.error)!.message}`;
      listErrorEl.hidden = false;
    }
    crews = c.data ?? [];
    events = e.data ?? [];
    tracks = t.data ?? [];
    const trTab = document.querySelector<HTMLElement>('.hc-tab[data-kind="tracks"]');
    const toReview = isMod ? tracks.filter((x) => !x.is_published).length : 0;
    if (trTab) trTab.innerHTML = `Tracks${toReview ? `<span class="tab-count">${toReview}</span>` : ''}`;
    if (isMod) await Promise.all([loadRoles(), loadRequests()]);
    await loadMembers();
    renderList();
    fillHostSelect();
    fillRoleCrewSelect();
  }

  function fillHostSelect() {
    const sel = eventForm.elements.namedItem('host_crew_id') as HTMLSelectElement;
    const current = sel.value;
    // Moderators: any crew. Hosts: no crew, or a crew they are an active member of.
    const options = isMod ? crews : crews.filter((c) => memberCrewIds.has(c.crew_id));
    sel.innerHTML = '<option value="">— none —</option>' + options.map((c) => `<option value="${esc(c.crew_id)}">${esc(c.tag)} · ${esc(c.name)}${c.is_published ? '' : ' (draft)'}</option>`).join('');
    sel.value = current;
  }

  function showForm(which: Kind | null) {
    placeholderEl.hidden = which !== null;
    crewForm.hidden = which !== 'crews';
    eventForm.hidden = which !== 'events';
    trackForm.hidden = which !== 'tracks';
    $('roles-panel').hidden = which !== 'roles';
    $('requests-panel').hidden = which !== 'requests';
    $('members-panel').hidden = which !== 'crews' || !selectedId;
  }

  // ------------------------------------------------------------ members
  async function loadMembers() {
    let res: any = await getSupabase().from('crew_membership_overview').select('membership_id, crew_id, driver_id, display_name, status, requested_at, decided_at, invited_by_name').order('requested_at');
    if (res.error) res = await getSupabase().from('crew_membership_overview').select('membership_id, crew_id, driver_id, display_name, status, requested_at, decided_at').order('requested_at');
    const data = res.data;
    // Own membership in a crew I don't manage is not relevant here.
    members = ((data ?? []) as any[]).filter((m) => isMod || leaderCrewIds.has(m.crew_id));
    const total = visibleCrews().reduce((n, c) => n + pendingFor(c.crew_id), 0);
    const tab = document.querySelector<HTMLElement>('.hc-tab[data-kind="crews"]')!;
    tab.innerHTML = `Crews${total ? `<span class="tab-count">${total}</span>` : ''}`;
  }

  function renderMembers(message = '', isError = false) {
    if (!selectedId) return;
    const mine = members.filter((m) => m.crew_id === selectedId);
    const pending = mine.filter((m) => m.status === 'pending');
    const active = mine.filter((m) => m.status === 'active');
    const invited = mine.filter((m) => m.status === 'invited');
    const d = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString(undefined, { dateStyle: 'medium' }) : '');
    $('members-invited').innerHTML = invited.length
      ? `<p class="mem-group-title">Open invites (${invited.length}/20)</p>` + invited.map((m) => `<div class="mem-row is-pending"><span class="mem-name">${esc(m.display_name)}</span><span class="mem-date">invited ${esc(d(m.requested_at))}${m.invited_by_name ? ` by ${esc(m.invited_by_name)}` : ''}</span><span class="mem-actions"><button type="button" class="btn btn-outline-red btn-sm" data-drop="${esc(m.membership_id)}" data-label="Withdraw">Withdraw</button></span></div>`).join('')
      : '';
    $('members-sub').textContent = `${active.length} member${active.length === 1 ? '' : 's'} on this site`;
    $('members-pending').innerHTML = `<p class="mem-group-title">Join requests</p>` + (pending.length
      ? pending.map((m) => `<div class="mem-row is-pending"><span class="mem-name">${esc(m.display_name)}</span><span class="mem-date">asked ${esc(d(m.requested_at))}</span><span class="mem-actions"><button type="button" class="btn btn-primary btn-sm" data-approve="${esc(m.membership_id)}">Approve</button><button type="button" class="btn btn-outline-red btn-sm" data-drop="${esc(m.membership_id)}" data-label="Decline">Decline</button></span></div>`).join('')
      : '<p class="mem-empty">No open requests.</p>');
    $('members-active').innerHTML = `<p class="mem-group-title">Members</p>` + (active.length
      ? active.map((m) => `<div class="mem-row"><span class="mem-name">${esc(m.display_name)}</span><span class="mem-date">since ${esc(d(m.decided_at))}</span><span class="mem-actions">${m.driver_id === ownDriverId ? '<span class="mem-date">you</span>' : `<button type="button" class="btn btn-outline-red btn-sm" data-drop="${esc(m.membership_id)}" data-label="Remove">Remove</button>`}</span></div>`).join('')
      : '<p class="mem-empty">No members yet. Drivers ask to join on the public Crews page.</p>');
    const msgEl = $('members-msg');
    msgEl.textContent = message;
    msgEl.className = `form-msg ${message ? (isError ? 'is-error' : 'is-ok') : ''}`;
  }

  $('members-panel').addEventListener('click', async (ev) => {
    const t = ev.target as HTMLElement;
    const approve = t.closest<HTMLButtonElement>('[data-approve]');
    const drop = t.closest<HTMLButtonElement>('[data-drop]');
    const sb = getSupabase();
    if (approve) {
      approve.disabled = true;
      const { error } = await sb.from('crew_memberships').update({ status: 'active' }).eq('membership_id', approve.dataset.approve!);
      await loadMembers(); renderList();
      renderMembers(error ? `Could not approve: ${error.message}` : 'Approved — the driver now shows up in your roster.', Boolean(error));
      return;
    }
    if (drop) {
      if (drop.dataset.armed !== '1') {
        drop.dataset.armed = '1';
        drop.textContent = `Click again to ${drop.dataset.label!.toLowerCase()}`;
        setTimeout(() => { if (drop.isConnected && drop.dataset.armed === '1') { drop.dataset.armed = ''; drop.textContent = drop.dataset.label!; } }, 4000);
        return;
      }
      drop.disabled = true;
      const { error } = await sb.from('crew_memberships').delete().eq('membership_id', drop.dataset.drop!);
      await loadMembers(); renderList();
      renderMembers(error ? `That did not work: ${error.message}` : drop.dataset.label === 'Decline' ? 'Request declined.' : drop.dataset.label === 'Withdraw' ? 'Invite withdrawn.' : 'Member removed.', Boolean(error));
      return;
    }
    const inv = t.closest<HTMLButtonElement>('[data-invite]');
    if (inv && selectedId) {
      inv.disabled = true;
      const { error } = await sb.from('crew_memberships').insert({ crew_id: selectedId, driver_id: inv.dataset.invite!, status: 'invited', invited_by: ownDriverId });
      ($('invite-q') as HTMLInputElement).value = '';
      $('invite-results').innerHTML = '';
      await loadMembers();
      const why = error ? (/invite_limit/.test(error.message) ? 'Your crew already has 20 open invites.' : /invite_declined/.test(error.message) ? 'This driver declined an invite from your crew in the last 30 days.' : /duplicate|unique/i.test(error.message) ? 'This driver is already a member, invited or has asked to join.' : `Could not invite: ${error.message}`) : `Invite sent to ${inv.dataset.name}. They accept it in My Account.`;
      renderMembers(why, Boolean(error));
    }
  });

  // Driver search for invites (leader/moderator only, enforced by the RPC)
  let inviteTimer: number | undefined;
  $('invite-q').addEventListener('input', () => {
    clearTimeout(inviteTimer);
    const q = ($('invite-q') as HTMLInputElement).value.trim();
    const out = $('invite-results');
    if (q.length < 3 || !selectedId) { out.innerHTML = ''; return; }
    inviteTimer = window.setTimeout(async () => {
      const { data, error } = await getSupabase().rpc('search_drivers_for_invite', { p_crew: selectedId, p_query: q });
      if (error) { out.innerHTML = `<p class="mem-empty">Search is not available right now.</p>`; return; }
      const rows = (data ?? []) as { driver_id: string; display_name: string }[];
      out.innerHTML = rows.length
        ? rows.map((r) => `<div class="mem-row"><span class="mem-name">${esc(r.display_name)}</span><span class="mem-actions"><button type="button" class="btn btn-primary btn-sm" data-invite="${esc(r.driver_id)}" data-name="${esc(r.display_name)}">Invite to Crew</button></span></div>`).join('')
        : '<p class="mem-empty">No driver found who isn\u2019t already in your crew or invited.</p>';
    }, 300);
  });

  // ------------------------------------------------------------ crew form
  const cf = crewForm.elements as any;
  let slugTouched = false;

  function crewFromForm(): HubCrew & { slug: string; sort_order: number; is_published: boolean } {
    const fd = new FormData(crewForm);
    const mc = blank(fd.get('member_count'));
    return {
      slug: String(fd.get('slug') ?? '').trim(),
      name: String(fd.get('name') ?? '').trim(),
      tag: String(fd.get('tag') ?? '').trim().toUpperCase(),
      color: String(fd.get('color') ?? '').trim().toLowerCase(),
      platforms: platformsFrom(fd) as any,
      focus: fd.getAll('focus') as any,
      region: blank(fd.get('region')),
      languages: fd.getAll('languages').map(String),
      description: blank(fd.get('description')),
      member_count: mc === null ? null : Math.max(0, Math.round(Number(mc))),
      discord_url: blank(fd.get('discord_url')),
      social_club_url: blank(fd.get('social_club_url')),
      is_partner: fd.get('is_partner') === 'on',
      is_featured: fd.get('is_featured') === 'on',
      sort_order: Math.round(Number(fd.get('sort_order') || 0)),
      is_published: fd.get('is_published') === 'on',
      ...(isMod ? { moderation_note: blank(fd.get('moderation_note')) } : {}),
    };
  }

  function validateCrew(c: ReturnType<typeof crewFromForm>): string[] {
    const bad: string[] = [];
    if (c.name.length < 2) bad.push('name');
    if (!/^[A-Z0-9]{4}$/.test(c.tag)) bad.push('tag');
    if (!/^#[0-9a-f]{6}$/.test(c.color)) bad.push('color');
    if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(c.slug)) bad.push('slug');
    if (c.discord_url && !/^https:\/\/(discord\.gg|discord\.com\/invite)\/[A-Za-z0-9-]+$/.test(c.discord_url)) bad.push('discord_url');
    if (c.social_club_url && !/^https:\/\/socialclub\.rockstargames\.com\//.test(c.social_club_url)) bad.push('social_club_url');
    return bad;
  }
  const crewFieldHelp: Record<string, string> = {
    name: 'name (2–40 characters)', tag: 'tag (exactly 4 letters/digits)', color: 'color (#rrggbb)', slug: 'URL slug (a-z, 0-9, hyphens)',
    discord_url: 'Discord invite (https://discord.gg/… or https://discord.com/invite/…)', social_club_url: 'Social Club link (https://socialclub.rockstargames.com/…)',
  };

  function renderCrewPreview() {
    const c = crewFromForm();
    const safe = { ...c, tag: c.tag || '????', name: c.name || 'Crew name', color: /^#[0-9a-f]{6}$/.test(c.color) ? c.color : '#a0a0c6' };
    $('crew-preview').innerHTML = crewCardHtml(safe);
    $('crew-desc-count').textContent = String((cf.description.value || '').length);
  }

  // Moderator note shown to the crew leader / host (2026-10-02), like tracks.
  // unpublishedMeansHidden: events are published on creation, so unpublished
  // = hidden by a moderator; new crews start as drafts, so not for crews.
  function showModNote(id: string, r: any, mod: boolean, unpublishedMeansHidden = false) {
    const el = $(id);
    const hidden = unpublishedMeansHidden && r.is_published === false;
    el.hidden = mod || (!r.moderation_note && !hidden);
    el.textContent = r.moderation_note
      ? `Moderator note: ${r.moderation_note}${hidden ? ' Hidden from the site by a moderator.' : ''}`
      : hidden ? 'Hidden from the site by a moderator.' : '';
  }

  function openCrew(row: any | null) {
    selectedId = row?.crew_id ?? null;
    crewForm.reset();
    slugTouched = Boolean(row);
    $('crew-form-title').textContent = row ? `Edit: ${row.name}` : 'New crew';
    const r = row ?? { color: '#ed253d', platforms: [], focus: [], sort_order: 0 };
    for (const k of ['name', 'tag', 'slug', 'region', 'description', 'discord_url', 'social_club_url']) cf[k].value = r[k] ?? '';
    cf.color.value = r.color ?? '#ed253d';
    cf.color_picker.value = r.color ?? '#ed253d';
    cf.member_count.value = r.member_count ?? '';
    cf.sort_order.value = r.sort_order ?? 0;
    cf.is_partner.checked = Boolean(r.is_partner);
    cf.is_featured.checked = Boolean(r.is_featured);
    cf.is_published.checked = Boolean(r.is_published);
    cf.moderation_note.value = r.moderation_note ?? '';
    showModNote('crew-mod-note', r, isMod);
    const ps = crewForm.querySelector<HTMLElement>('.pub-state')!;
    ps.textContent = r.is_published ? 'Live on the site' : 'Draft — a moderator publishes it';
    crewForm.querySelectorAll<HTMLInputElement>('input[name="platforms"]').forEach((i) => (i.checked = (r.platforms ?? []).includes(i.value) || (ACTIVE_PLATFORMS.length === 1 && i.hasAttribute('data-locked'))));
    crewForm.querySelectorAll<HTMLInputElement>('input[name="focus"]').forEach((i) => (i.checked = (r.focus ?? []).includes(i.value)));
    crewForm.querySelectorAll<HTMLInputElement>('input[name="languages"]').forEach((i) => (i.checked = (r.languages ?? []).includes(i.value)));
    // open "More languages" when one of them is already picked
    crewForm.querySelector<HTMLDetailsElement>('.lang-more')!.open = [...crewForm.querySelectorAll<HTMLInputElement>('.lang-more input')].some((i) => i.checked);
    resetDelete(crewForm, Boolean(row));
    markInvalid(crewForm, []);
    msg(crewForm, '');
    showForm('crews');
    renderCrewPreview();
    renderList();
    renderMembers();
  }

  cf.name.addEventListener('input', () => { if (!slugTouched) cf.slug.value = slugify(cf.name.value); });
  cf.slug.addEventListener('input', () => { slugTouched = true; });
  cf.tag.addEventListener('input', () => { cf.tag.value = cf.tag.value.toUpperCase().replace(/[^A-Z0-9]/g, ''); });
  cf.color_picker.addEventListener('input', () => { cf.color.value = cf.color_picker.value; renderCrewPreview(); });
  cf.color.addEventListener('input', () => { if (/^#[0-9a-fA-F]{6}$/.test(cf.color.value)) cf.color_picker.value = cf.color.value.toLowerCase(); });
  crewForm.addEventListener('input', renderCrewPreview);
  crewForm.addEventListener('change', renderCrewPreview);

  crewForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const c: any = crewFromForm();
    if (!isMod) { delete c.slug; delete c.is_partner; delete c.is_featured; delete c.sort_order; delete c.is_published; }
    const bad = validateCrew({ ...crewFromForm(), ...(isMod ? {} : { slug: crews.find((x) => x.crew_id === selectedId)?.slug ?? 'x' }) });
    markInvalid(crewForm, bad);
    if (bad.length) { msg(crewForm, `Please fix: ${bad.map((b) => crewFieldHelp[b] ?? b).join('; ')}.`, true); return; }
    const sb = getSupabase();
    const q = selectedId
      ? sb.from('crews').update(c).eq('crew_id', selectedId).select().single()
      : sb.from('crews').insert(c).select().single();
    const { data, error } = await q;
    if (error) { msg(crewForm, dbError(error), true); return; }
    await loadAll();
    openCrew(data);
    msg(crewForm, data.is_published ? 'Saved — live on the site.' : 'Saved as draft (not visible publicly).');
  });

  // ------------------------------------------------------------ event form
  const ef = eventForm.elements as any;
  $('tz-hint').textContent = `your local time (${Intl.DateTimeFormat().resolvedOptions().timeZone})`;

  function eventFromForm() {
    const fd = new FormData(eventForm);
    return {
      title: String(fd.get('title') ?? '').trim(),
      event_type: String(fd.get('event_type')),
      status: String(fd.get('status')),
      starts_at: fromLocalInput(String(fd.get('starts_at') ?? '')),
      ends_at: fromLocalInput(String(fd.get('ends_at') ?? '')),
      platforms: platformsFrom(fd),
      host_crew_id: blank(fd.get('host_crew_id')),
      host_name: blank(fd.get('host_name')),
      location: blank(fd.get('location')),
      description: blank(fd.get('description')),
      join_url: blank(fd.get('join_url')),
      discord_url: blank(fd.get('discord_url')),
      max_participants: fd.get('max_participants') ? Number(fd.get('max_participants')) : null,
      registration: String(fd.get('registration') ?? 'open') === 'closed' ? 'closed' : 'open',
      is_published: isMod ? fd.get('is_published') === 'on' : true,
      ...(isMod ? { moderation_note: blank(fd.get('moderation_note')) } : {}),
    };
  }
  // Stream link lives in hub_event_streams (RS-0058), not on the event row.
  const streamUrlFromForm = () => String(new FormData(eventForm).get('stream_url') ?? '').trim();
  function validateEvent(e: ReturnType<typeof eventFromForm>): string[] {
    const bad: string[] = [];
    if (e.title.length < 3) bad.push('title');
    if (!e.starts_at) bad.push('starts_at');
    // Earliest start = GTA VI launch day, local midnight (RS-0051; DB check hub_events_not_before_launch)
    else if (new Date(e.starts_at) < new Date(2026, 10, 19, 0, 0, 0)) bad.push('starts_before_launch');
    if (e.ends_at && e.starts_at && new Date(e.ends_at) <= new Date(e.starts_at)) bad.push('ends_at');
    if (e.join_url && !/^https:\/\//.test(e.join_url)) bad.push('join_url');
    if (e.discord_url && !/^https:\/\/(discord\.gg|discord\.com\/invite)\/[A-Za-z0-9-]+$/.test(e.discord_url)) bad.push('discord_url');
    // DEC-0077: PSN name or a Discord (own invite / host crew with one) -- at least one, both allowed
    if (e.host_name && !/^[A-Za-z][A-Za-z0-9_-]{2,15}$/.test(e.host_name)) bad.push('host_name');
    const hostCrew = crews.find((c) => c.crew_id === e.host_crew_id);
    if (!e.host_name && !e.discord_url && !hostCrew?.discord_url) bad.push('contact_required');
    if (e.max_participants != null && (!Number.isInteger(e.max_participants) || e.max_participants < 2 || e.max_participants > 500)) bad.push('max_participants');
    const su = streamUrlFromForm();
    if (su && !streamPlatform(su)) bad.push('stream_url');
    return bad;
  }
  const eventFieldHelp: Record<string, string> = { title: 'title (3–80 characters)', starts_at: 'start date/time', starts_before_launch: 'events can start on Nov 19, 2026 (GTA VI launch day) at the earliest', ends_at: 'end must be after start', join_url: 'details link must start with https://', discord_url: 'Discord invite (https://discord.gg/… or https://discord.com/invite/…)', host_name: 'PSN name (3–16 characters, starts with a letter; letters, digits, - and _)', contact_required: 'add your PSN name or a Discord invite (or pick a host crew that has one), so players can reach you', max_participants: 'max. participants between 2 and 500', stream_url: 'a Twitch channel, YouTube video/live/channel, or Kick channel URL (https://…)' };

  function renderEventPreview() {
    const e = eventFromForm();
    const host = crews.find((c) => c.crew_id === e.host_crew_id);
    const preview: HubEvent = {
      event_id: 'preview', title: e.title || 'Event title', event_type: e.event_type as any, starts_at: e.starts_at ?? new Date().toISOString(),
      ends_at: e.ends_at, platforms: e.platforms as any, host_name: e.host_name, location: e.location, description: e.description,
      join_url: e.join_url, discord_url: e.discord_url, status: e.status as any, host: host ? { name: host.name, tag: host.tag, color: host.color, discord_url: host.discord_url ?? null } : null,
      registration: e.registration as any,
      streams: (() => { const u = streamUrlFromForm(); const pl = u ? streamPlatform(u) : null; return pl ? [{ platform: pl, url: u }] : []; })(),
    };
    const root = $('event-preview');
    root.innerHTML = eventRowHtml(preview);
    localizeTimes(root);
    $('event-desc-count').textContent = String((ef.description.value || '').length);
  }

  function openEvent(row: any | null) {
    selectedId = row?.event_id ?? null;
    eventForm.reset();
    $('event-form-title').textContent = row ? `Edit: ${row.title}` : 'New event';
    const r = row ?? { event_type: 'race', status: 'scheduled', platforms: [] };
    for (const k of ['title', 'host_name', 'location', 'description', 'join_url', 'discord_url']) ef[k].value = r[k] ?? '';
    ef.event_type.value = r.event_type;
    ef.status.value = r.status;
    ef.starts_at.value = toLocalInput(r.starts_at ?? null);
    ef.ends_at.value = toLocalInput(r.ends_at ?? null);
    ef.host_crew_id.value = r.host_crew_id ?? '';
    ef.is_published.checked = row ? Boolean(r.is_published) : true;
    ef.max_participants.value = r.max_participants ?? '';
    ef.registration.value = r.registration ?? 'open';
    ef.moderation_note.value = r.moderation_note ?? '';
    showModNote('event-mod-note', r, isMod, true);
    ef.stream_url.value = [...(r.streams ?? [])].sort((a: any, b: any) => (a.sort_order ?? 0) - (b.sort_order ?? 0))[0]?.url ?? '';
    eventForm.querySelectorAll<HTMLInputElement>('input[name="platforms"]').forEach((i) => (i.checked = (r.platforms ?? []).includes(i.value) || (ACTIVE_PLATFORMS.length === 1 && i.hasAttribute('data-locked'))));
    resetDelete(eventForm, Boolean(row));
    markInvalid(eventForm, []);
    msg(eventForm, '');
    showForm('events');
    renderEventPreview();
    renderList();
    loadRsvps();
  }

  // Sign-ups for the open event (same data the public page shows).
  async function loadRsvps() {
    const panel = $('rsvp-panel');
    panel.hidden = !selectedId;
    if (!selectedId) return;
    const { data } = await getSupabase().from('public_event_rsvps').select('display_name, created_at').eq('event_id', selectedId).order('created_at');
    const rows = (data ?? []) as any[];
    const named = rows.filter((r) => r.display_name).map((r) => esc(r.display_name));
    const anon = rows.length - named.length;
    const max = Number(ef.max_participants.value) || null;
    $('rsvp-list').innerHTML = rows.length
      ? `<p class="rsvp-count"><strong>${rows.length}${max ? ' / ' + max : ''}</strong> going</p><p class="rsvp-names">${named.join(', ')}${anon ? `${named.length ? ' + ' : ''}${anon} anonymous` : ''}</p>`
      : `<p class="rsvp-count">No sign-ups yet${max ? ` (max. ${max})` : ''}.</p>`;
  }
  eventForm.addEventListener('input', renderEventPreview);
  eventForm.addEventListener('change', renderEventPreview);

  eventForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const e = eventFromForm();
    const bad = validateEvent(e);
    markInvalid(eventForm, bad);
    if (bad.length) { msg(eventForm, `Please fix: ${bad.map((b) => eventFieldHelp[b] ?? b).join('; ')}.`, true); return; }
    const sb = getSupabase();
    const q = selectedId
      ? sb.from('hub_events').update(e).eq('event_id', selectedId).select().single()
      : sb.from('hub_events').insert({ ...e, created_by: ownDriverId }).select().single();
    const { data, error } = await q;
    if (error) { msg(eventForm, dbError(error), true); return; }
    // Sync the (for now single) stream link; the table allows several later.
    const su = streamUrlFromForm();
    const prev = events.find((x) => x.event_id === data.event_id)?.streams ?? [];
    const prevUrl = [...prev].sort((a: any, b: any) => (a.sort_order ?? 0) - (b.sort_order ?? 0))[0]?.url ?? '';
    if (su !== prevUrl) {
      const del = await sb.from('hub_event_streams').delete().eq('event_id', data.event_id);
      const ins = su && !del.error ? await sb.from('hub_event_streams').insert({ event_id: data.event_id, platform: streamPlatform(su), url: su }) : { error: null };
      if (del.error || ins.error) { await loadAll(); openEvent(events.find((x) => x.event_id === data.event_id) ?? data); msg(eventForm, `Event saved, but the stream link could not be saved: ${dbError((del.error || ins.error)!)}`, true); return; }
    }
    await loadAll();
    openEvent(events.find((x) => x.event_id === data.event_id) ?? data);
    msg(eventForm, data.is_published ? 'Saved — live in the calendar.' : 'Saved — hidden (moderator setting).');
  });

  // ------------------------------------------------------------ track form (RS-0045)
  const tf = trackForm.elements as any;
  const trackUrlOk = (u: string) => /^https:\/\/socialclub\.rockstargames\.com\//.test(u);

  function renderTracksList() {
    const rows = visibleTracks();
    listTitleEl.textContent = isMod ? 'Tracks' : 'My tracks';
    newBtn.textContent = '+ New track';
    newBtn.hidden = !(isMod || isCreator);
    listEl.innerHTML = rows.map((r) => {
      const pill = r.is_published ? '<span class="li-pill pub">Live</span>' : '<span class="li-pill draft">In review</span>';
      const when = new Date(r.updated_at).toLocaleDateString(undefined, { dateStyle: 'medium' });
      return `<button type="button" class="li${r.track_id === selectedId ? ' is-active' : ''}" data-id="${esc(r.track_id)}"><span class="li-main"><span class="li-title">${esc(r.title)}</span><span class="li-sub">updated ${esc(when)}</span></span>${pill}</button>`;
    }).join('');
    listEmptyEl.hidden = rows.length > 0;
    listEmptyEl.textContent = rows.length ? '' : (isMod ? 'No tracks submitted yet.' : 'You have not submitted a track yet.');
  }

  function trackFromForm() {
    const fd = new FormData(trackForm);
    const num = (k: string) => Number(String(fd.get(k) ?? '').replace(',', '.'));
    return {
      title: String(fd.get('title') ?? '').trim(),
      social_club_url: String(fd.get('social_club_url') ?? '').trim(),
      layout: String(fd.get('layout')),
      race_types: fd.getAll('race_types').map(String),
      vehicle_classes: fd.getAll('vehicle_classes').map(String),
      players_min: Math.round(num('players_min')),
      players_max: Math.round(num('players_max')),
      length_km: Math.round(num('length_km') * 100) / 100,
      is_published: fd.get('is_published') === 'on',
      review_note: blank(fd.get('review_note')),
    };
  }
  function validateTrack(t: ReturnType<typeof trackFromForm>): string[] {
    const bad: string[] = [];
    if (t.title.length < 2) bad.push('title');
    if (!trackUrlOk(t.social_club_url)) bad.push('social_club_url');
    if (!(t.length_km > 0 && t.length_km <= 500)) bad.push('length_km');
    if (!(t.players_min >= 1 && t.players_min <= 64)) bad.push('players_min');
    if (!(t.players_max >= 1 && t.players_max <= 64) || t.players_max < t.players_min) bad.push('players_max');
    if (!t.race_types.length) bad.push('race_types');
    if (!t.vehicle_classes.length) bad.push('vehicle_classes');
    return bad;
  }
  const trackFieldHelp: Record<string, string> = {
    title: 'track name (2–60 characters)', social_club_url: 'Social Club link (https://socialclub.rockstargames.com/…)', length_km: 'length in km (up to 500)',
    players_min: 'players from (1–64)', players_max: 'players up to (1–64, not less than "from")', race_types: 'pick at least one race type', vehicle_classes: 'pick at least one vehicle class',
  };

  function renderTrackPreview() {
    const t = trackFromForm();
    const now = new Date().toISOString();
    const row = selectedId ? tracks.find((x) => x.track_id === selectedId) : null;
    const preview: CommunityTrack = {
      track_id: 'preview', title: t.title || 'Track name', social_club_url: trackUrlOk(t.social_club_url) ? t.social_club_url : null,
      layout: t.layout as any, race_types: t.race_types as any, vehicle_classes: t.vehicle_classes,
      players_min: t.players_min || 1, players_max: t.players_max || t.players_min || 1, length_km: t.length_km || 0,
      created_at: row?.created_at ?? now, updated_at: now,
    };
    $('track-preview').innerHTML = trackRowHtml(preview, { sample: true }).replace(/<span class="chip chip-sample"[^>]*>Sample<\/span>/, '');
  }

  function openTrack(row: any | null) {
    selectedId = row?.track_id ?? null;
    trackForm.reset();
    $('track-form-title').textContent = row ? `Edit: ${row.title}` : 'New track';
    const r = row ?? { layout: 'circuit', players_min: 2, players_max: 16, race_types: [], vehicle_classes: [] };
    for (const k of ['title', 'social_club_url', 'layout', 'length_km', 'players_min', 'players_max', 'review_note']) tf[k].value = r[k] ?? '';
    tf.is_published.checked = Boolean(r.is_published);
    trackForm.querySelectorAll<HTMLInputElement>('input[name="race_types"]').forEach((i) => (i.checked = (r.race_types ?? []).includes(i.value)));
    trackForm.querySelectorAll<HTMLInputElement>('input[name="vehicle_classes"]').forEach((i) => (i.checked = (r.vehicle_classes ?? []).includes(i.value)));
    const ps = trackForm.querySelector<HTMLElement>('[data-creator-only]')!;
    ps.textContent = !row ? 'New — a moderator checks and publishes it' : r.is_published ? 'Live on the Tracks page' : 'In review — a moderator checks it';
    const note = $('track-review-note');
    note.hidden = isMod || !r.review_note;
    note.textContent = r.review_note ? `Moderator note: ${r.review_note}` : '';
    resetDelete(trackForm, Boolean(row));
    markInvalid(trackForm, []);
    msg(trackForm, '');
    showForm('tracks');
    renderTrackPreview();
    renderList();
  }
  trackForm.addEventListener('input', renderTrackPreview);
  trackForm.addEventListener('change', renderTrackPreview);

  trackForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const t: any = trackFromForm();
    const bad = validateTrack(t);
    markInvalid(trackForm, bad);
    if (bad.length) { msg(trackForm, `Please fix: ${bad.map((b) => trackFieldHelp[b] ?? b).join('; ')}.`, true); return; }
    if (!isMod) { delete t.is_published; delete t.review_note; }
    const sb = getSupabase();
    const q = selectedId
      ? sb.from('community_tracks').update(t).eq('track_id', selectedId).select().single()
      : sb.from('community_tracks').insert({ ...t, created_by: ownDriverId }).select().single();
    const { data, error } = await q;
    if (error) { msg(trackForm, /row-level security/.test(error.message) ? 'Not allowed — you need the creator role.' : dbError(error), true); return; }
    await loadAll();
    openTrack(data);
    msg(trackForm, data.is_published ? 'Saved — live on the Tracks page.' : isMod ? 'Saved — not published.' : 'Saved — a moderator checks it before it goes live.');
  });

  // ------------------------------------------------------------ delete (two-step, no browser dialog)
  function resetDelete(form: HTMLFormElement, show: boolean) {
    const b = form.querySelector<HTMLButtonElement>('[data-action="delete"]')!;
    b.hidden = !show || (form === crewForm && !isMod);
    b.dataset.armed = '';
    b.textContent = 'Delete';
  }
  [crewForm, eventForm, trackForm].forEach((form) => {
    const b = form.querySelector<HTMLButtonElement>('[data-action="delete"]')!;
    b.addEventListener('click', async () => {
      if (!selectedId) return;
      if (!b.dataset.armed) {
        b.dataset.armed = '1';
        b.textContent = form === crewForm ? 'Click again to delete this crew' : form === trackForm ? 'Click again to delete this track' : 'Click again to delete this event';
        setTimeout(() => { if (b.dataset.armed) { b.dataset.armed = ''; b.textContent = 'Delete'; } }, 4000);
        return;
      }
      const sb = getSupabase();
      const table = form === crewForm ? 'crews' : form === trackForm ? 'community_tracks' : 'hub_events';
      const key = form === crewForm ? 'crew_id' : form === trackForm ? 'track_id' : 'event_id';
      const { error } = await sb.from(table).delete().eq(key, selectedId);
      if (error) { msg(form, dbError(error), true); resetDelete(form, true); return; }
      selectedId = null;
      showForm(null);
      await loadAll();
      placeholderEl.textContent = 'Deleted.';
    });
  });

  // ------------------------------------------------------------ roles (moderators)
  const roleLabel = (r: string) => (r === 'crew_leader' ? 'Crew Leader' : r === 'creator' ? 'Creator' : 'Event Host');
  const roleShort = (r: string) => (r === 'crew_leader' ? 'Leader' : r === 'creator' ? 'Creator' : 'Host');
  let pickedDriver: { driver_id: string; display_name: string } | null = null;

  async function loadRoles() {
    const { data, error } = await getSupabase()
      .from('hub_roles')
      .select('role_id, role, crew_id, driver_id, granted_at, driver:drivers!hub_roles_driver_id_fkey(display_name)')
      .order('granted_at', { ascending: false });
    roles = error ? [] : data ?? [];
  }
  function renderRolesList() {
    listTitleEl.textContent = 'Roles';
    newBtn.hidden = true;
    listEl.innerHTML = roles.map((r) => {
      const crew = crews.find((c) => c.crew_id === r.crew_id);
      return `<button type="button" class="li${r.role_id === selectedId ? ' is-active' : ''}" data-id="${esc(r.role_id)}">${crew ? crewTagHtml(crew.tag, crew.color, 'sm') : ''}<span class="li-main"><span class="li-title">${esc(r.driver?.display_name ?? 'Unknown driver')}</span><span class="li-sub">${esc(roleLabel(r.role))}${crew ? ' · ' + esc(crew.name) : ''}</span></span><span class="li-role">${roleShort(r.role)}</span></button>`;
    }).join('');
    listEmptyEl.hidden = roles.length > 0;
    listEmptyEl.textContent = roles.length ? '' : 'No roles granted yet.';
  }
  function fillRoleCrewSelect() {
    const sel = $<HTMLSelectElement>('role-crew');
    sel.innerHTML = crews.length
      ? '<option value="">— choose the crew —</option>' + crews.map((c) => `<option value="${esc(c.crew_id)}">${esc(c.tag)} · ${esc(c.name)}${c.is_published ? '' : ' (draft)'}</option>`).join('')
      : '<option value="">Create a crew first</option>';
  }
  function roleMsg(text: string, isError = false) {
    const el = $('role-msg'); el.textContent = text; el.className = `form-msg ${text ? (isError ? 'is-error' : 'is-ok') : ''}`;
  }
  function openRole(row: any | null) {
    selectedId = row?.role_id ?? null;
    const box = $('role-selected');
    box.hidden = !row;
    if (row) {
      const crew = crews.find((c) => c.crew_id === row.crew_id);
      $('role-selected-text').textContent = `${row.driver?.display_name ?? 'Driver'} — ${roleLabel(row.role)}${crew ? ' of ' + crew.name + ' (' + crew.tag + ')' : ''}`;
      const b = $<HTMLButtonElement>('role-revoke'); b.dataset.armed = ''; b.textContent = 'Revoke role';
    }
    showForm('roles');
    renderList();
  }
  const pickedRoles = () => [...document.querySelectorAll<HTMLInputElement>('input[name="role"]:checked')].map((i) => i.value);
  const syncRoleCrew = () => { $('role-crew-wrap').hidden = !pickedRoles().includes('crew_leader'); };
  document.querySelectorAll('input[name="role"]').forEach((i) => i.addEventListener('change', syncRoleCrew));

  let searchTimer: number | undefined;
  $<HTMLInputElement>('role-driver-search').addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.trim();
    pickedDriver = null;
    clearTimeout(searchTimer);
    const out = $('role-driver-results');
    if (q.length < 2) { out.innerHTML = ''; return; }
    searchTimer = window.setTimeout(async () => {
      const safe = q.replace(/[%_\\]/g, (m) => '\\' + m);
      const { data } = await getSupabase().from('drivers').select('driver_id, display_name').ilike('display_name', `%${safe}%`).is('deleted_at', null).order('display_name').limit(8);
      out.innerHTML = (data ?? []).map((d) => `<button type="button" class="driver-pick" data-id="${esc(d.driver_id)}" data-name="${esc(d.display_name)}">${esc(d.display_name)}</button>`).join('') || '<span class="hint-none">No driver found.</span>';
    }, 250);
  });
  $('role-driver-results').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('.driver-pick');
    if (!b) return;
    pickedDriver = { driver_id: b.dataset.id!, display_name: b.dataset.name! };
    document.querySelectorAll('.driver-pick').forEach((x) => x.classList.toggle('is-active', x === b));
    roleMsg('');
  });
  $('role-grant').addEventListener('click', async () => {
    const picked = pickedRoles();
    const crewId = $<HTMLSelectElement>('role-crew').value || null;
    if (!pickedDriver) { roleMsg('Pick a driver from the search results first.', true); return; }
    if (!picked.length) { roleMsg('Pick at least one role.', true); return; }
    if (picked.includes('crew_leader') && !crewId) { roleMsg('Choose the crew this driver leads.', true); return; }
    // One insert per role, so an existing role doesn't block the others.
    const granted: string[] = [], had: string[] = [];
    for (const role of picked) {
      const { error } = await getSupabase().from('hub_roles').insert({ driver_id: pickedDriver.driver_id, role, crew_id: role === 'crew_leader' ? crewId : null, granted_by: ownDriverId });
      if (!error) granted.push(roleLabel(role));
      else if (/duplicate|unique/i.test(error.message)) had.push(roleLabel(role));
      else { roleMsg(dbError(error), true); await loadRoles(); renderList(); return; }
    }
    roleMsg([granted.length ? `${pickedDriver.display_name} is now ${granted.join(' + ')}.` : '', had.length ? `Already had: ${had.join(', ')}.` : ''].filter(Boolean).join(' '), !granted.length);
    await loadRoles(); renderList();
  });
  $('role-revoke').addEventListener('click', async () => {
    const b = $<HTMLButtonElement>('role-revoke');
    if (!selectedId) return;
    if (!b.dataset.armed) { b.dataset.armed = '1'; b.textContent = 'Click again to revoke'; return; }
    const { error } = await getSupabase().from('hub_roles').delete().eq('role_id', selectedId);
    if (error) { roleMsg(dbError(error), true); return; }
    roleMsg('Role revoked.');
    await loadRoles(); openRole(null);
  });

  // ------------------------------------------------------------ role requests (moderators, RS-0026)
  let requests: any[] = [];
  async function loadRequests() {
    const { data, error } = await getSupabase()
      .from('hub_role_requests')
      .select('*, driver:drivers!hub_role_requests_driver_id_fkey(display_name, discord_user_id), crew:crews(name, tag, color)')
      .eq('status', 'pending')
      .order('requested_at');
    requests = error ? [] : data ?? [];
    const tab = document.querySelector<HTMLElement>('.hc-tab[data-kind="requests"]');
    if (tab) tab.innerHTML = `Requests${requests.length ? `<span class="tab-count">${requests.length}</span>` : ''}`;
  }
  const reqCrewLabel = (r: any) => (r.role !== 'crew_leader' ? '' : r.crew ? `${r.crew.tag} · ${r.crew.name}` : `NEW: ${r.new_crew_tag} · ${r.new_crew_name}`);
  function renderRequestsList() {
    listTitleEl.textContent = 'Open requests';
    newBtn.hidden = true;
    listEl.innerHTML = requests.map((r) => {
      const tag = r.role === 'crew_leader' ? (r.crew ? crewTagHtml(r.crew.tag, r.crew.color, 'sm') : crewTagHtml(r.new_crew_tag, r.new_crew_color, 'sm')) : '';
      return `<button type="button" class="li${r.request_id === selectedId ? ' is-active' : ''}" data-id="${esc(r.request_id)}">${tag}<span class="li-main"><span class="li-title">${esc(r.driver?.display_name ?? 'Driver')}</span><span class="li-sub">${esc(roleLabel(r.role))}${r.role === 'crew_leader' ? ' · ' + esc(reqCrewLabel(r)) : ''}</span></span><span class="li-role">${roleShort(r.role)}</span></button>`;
    }).join('');
    listEmptyEl.hidden = requests.length > 0;
    listEmptyEl.textContent = requests.length ? '' : 'No open requests.';
  }
  function reqMsg(text: string, isError = false) {
    const el = $('req-msg'); el.textContent = text; el.className = `form-msg ${text ? (isError ? 'is-error' : 'is-ok') : ''}`;
  }
  function openRequest(r: any | null) {
    selectedId = r?.request_id ?? null;
    if (!r) { showForm(null); renderList(); return; }
    const row = (k: string, v: string | null | undefined, html = false) => (v ? `<div class="req-row"><dt>${esc(k)}</dt><dd>${html ? v : esc(v)}</dd></div>` : '');
    const link = (u: string | null) => (u ? `<a href="${esc(u)}" target="_blank" rel="noopener">${esc(u)}</a>` : '');
    $('req-title').textContent = `${roleLabel(r.role)} request`;
    $('req-state').textContent = `asked ${new Date(r.requested_at).toLocaleDateString(undefined, { dateStyle: 'medium' })}`;
    $('req-body').innerHTML = '<dl class="req-list">' + [
      row('Driver', r.driver?.display_name),
      row('Discord user ID', r.driver?.discord_user_id),
      r.role === 'crew_leader' && r.crew ? row('Existing crew', `${crewTagHtml(r.crew.tag, r.crew.color, 'sm')} ${esc(r.crew.name)}`, true) : '',
      r.role === 'crew_leader' && !r.crew ? row('New crew', `${crewTagHtml(r.new_crew_tag, r.new_crew_color, 'sm')} ${esc(r.new_crew_name)} <small>(goes live as soon as you approve)</small>`, true) : '',
      row('Crew Discord', link(r.new_crew_discord_url), true),
      row('Crew description', r.new_crew_description),
      row('Message', r.message),
      row('Link', link(r.link_url), true),
    ].join('') + '</dl>';
    ($('req-note') as HTMLTextAreaElement).value = '';
    const rb = $<HTMLButtonElement>('req-reject'); rb.dataset.armed = ''; rb.textContent = 'Reject';
    $<HTMLButtonElement>('req-approve').disabled = false;
    reqMsg('');
    showForm('requests');
    renderList();
  }
  $('req-approve').addEventListener('click', async () => {
    if (!selectedId) return;
    const b = $<HTMLButtonElement>('req-approve'); b.disabled = true;
    const r = requests.find((x) => x.request_id === selectedId);
    const { error } = await getSupabase().rpc('approve_hub_role_request', { p_request_id: selectedId });
    if (error) { b.disabled = false; reqMsg(error.message, true); return; }
    await loadAll();
    openRequest(null);
    placeholderEl.textContent = `Approved — ${r?.driver?.display_name ?? 'the driver'} is now ${roleLabel(r?.role ?? '')}${r?.role === 'crew_leader' && !r?.crew ? ' and the crew is live' : ''}.`;
  });
  $('req-reject').addEventListener('click', async () => {
    const b = $<HTMLButtonElement>('req-reject');
    if (!selectedId) return;
    if (!b.dataset.armed) { b.dataset.armed = '1'; b.textContent = 'Click again to reject'; return; }
    const note = ($('req-note') as HTMLTextAreaElement).value.trim() || null;
    const { error } = await getSupabase().from('hub_role_requests').update({ status: 'rejected', decided_at: new Date().toISOString(), decided_by: ownDriverId, decision_note: note }).eq('request_id', selectedId);
    if (error) { reqMsg(error.message, true); return; }
    await loadAll();
    openRequest(null);
    placeholderEl.textContent = 'Request rejected.';
  });

  // ------------------------------------------------------------ wiring
  document.querySelectorAll<HTMLButtonElement>('.hc-tab').forEach((t) => t.addEventListener('click', () => {
    document.querySelectorAll('.hc-tab').forEach((x) => { x.classList.toggle('is-active', x === t); x.setAttribute('aria-selected', String(x === t)); });
    kind = t.dataset.kind as Kind;
    selectedId = null;
    if (kind === 'roles') { showForm('roles'); openRole(null); } else showForm(null);
    if (kind === 'requests') placeholderEl.hidden = false;
    placeholderEl.textContent = 'Select an entry on the left or create a new one.';
    renderList();
  }));
  newBtn.addEventListener('click', () => (kind === 'crews' ? openCrew(null) : kind === 'tracks' ? openTrack(null) : openEvent(null)));
  listEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.li');
    if (!btn) return;
    const id = btn.dataset.id;
    if (kind === 'crews') openCrew(crews.find((c) => c.crew_id === id));
    else if (kind === 'events') openEvent(events.find((x) => x.event_id === id));
    else if (kind === 'tracks') openTrack(tracks.find((x) => x.track_id === id));
    else if (kind === 'requests') openRequest(requests.find((x) => x.request_id === id));
    else openRole(roles.find((x) => x.role_id === id));
  });

  // ------------------------------------------------------------ auth / access
  async function checkAccess(session: any) {
    if (!session) {
      if (authBoxEl) authBoxEl.hidden = PERSONAL;
      if (notModEl) notModEl.hidden = true;
      contentEl.hidden = true;
      return;
    }
    if (authBoxEl) authBoxEl.hidden = true;
    const sb = getSupabase();
    const own = await sb.from('drivers').select('driver_id').eq('auth_user_id', session.user.id).maybeSingle();
    ownDriverId = own.data?.driver_id ?? null;
    const [modRes, roleRes] = await Promise.all([
      sb.from('moderators').select('driver_id').limit(1),
      ownDriverId ? sb.from('hub_roles').select('role, crew_id').eq('driver_id', ownDriverId) : Promise.resolve({ data: [], error: null }),
    ]);
    const realMod = !modRes.error && Array.isArray(modRes.data) && modRes.data.length > 0;
    // Personal views behave like a normal leader/host view, even for mods.
    isMod = realMod && !PERSONAL;
    const myRoles = (roleRes.data ?? []) as any[];
    isHost = myRoles.some((r) => r.role === 'event_host');
    isCreator = myRoles.some((r) => r.role === 'creator');
    leaderCrewIds = new Set(myRoles.filter((r) => r.role === 'crew_leader').map((r) => r.crew_id));
    if (ownDriverId) {
      const mem = await sb.from('crew_memberships').select('crew_id').eq('driver_id', ownDriverId).eq('status', 'active');
      memberCrewIds = new Set(((mem.data ?? []) as any[]).map((m) => m.crew_id));
    }
    const hasAccess = MODE === 'moderator' ? realMod : MODE === 'crew' ? leaderCrewIds.size > 0 : MODE === 'tracks' ? isCreator : isHost;
    if (notModEl) notModEl.hidden = hasAccess;
    contentEl.hidden = !hasAccess;
    rootEl.dispatchEvent(new CustomEvent('hc-access', { bubbles: true, detail: { hasAccess, isHost, isCreator, leaderCrewIds: [...leaderCrewIds], isMod: realMod, ownDriverId } }));
    if (!hasAccess) return;
    applyRoleVisibility();
    if (PERSONAL) {
      (document.querySelector('.hc-tabs') as HTMLElement).hidden = true;
      if (MODE === 'events') (document.querySelector('.hc-tab[data-kind="events"]') as HTMLElement).click();
      if (MODE === 'tracks') (document.querySelector('.hc-tab[data-kind="tracks"]') as HTMLElement).click();
    }
    syncRoleCrew();
    await loadAll();
    // A leader with exactly one crew: open it right away.
    if (MODE === 'crew' && visibleCrews().length === 1) openCrew(visibleCrews()[0]);
    if (MODE === 'events') placeholderEl.textContent = canCreateEvent() ? 'Select one of your events on the left or create a new one.' : 'Select an event on the left.';
    if (MODE === 'tracks') placeholderEl.textContent = 'Select one of your tracks on the left or submit a new one.';
  }

  if (!backendConfigured) {
    $('backend-notice').hidden = PERSONAL;
  } else {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => checkAccess(data?.session ?? null));
    sb.auth.onAuthStateChange((event, session) => { if (event === 'SIGNED_IN' || event === 'SIGNED_OUT') checkAccess(session); });
    document.getElementById('discord-signin-btn')?.addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname + window.location.search, scopes: 'identify email guilds.join' } });
    });
  }
</script>
