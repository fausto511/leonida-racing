---
// My Account sub-navigation (RS-0026, RS-0032): Time Attack (default) /
// Garage / Crew / Events / Tracks (RS-0045) / Settings.
// Account tabs (old visual language, redesign pending).
interface Props { active: 'time-attack' | 'garage' | 'crew' | 'events' | 'tracks' | 'settings'; }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { key: 'time-attack', label: 'My laps', href: `${base}account/` }, // was 'Time Attack'; other pages link it as 'My laps' (Fausto 21.10.)
  { key: 'garage', label: 'Garage', href: `${base}account/garage/` },
  { key: 'crew', label: 'Crew', href: `${base}account/crew/` },
  { key: 'events', label: 'Events', href: `${base}account/events/` },
  { key: 'tracks', label: 'Tracks', href: `${base}account/tracks/` },
  { key: 'settings', label: 'Settings', href: `${base}account/settings/` },
];
---
<nav class="acc-subnav" aria-label="My Account">
  {links.map((l) => (
    <a href={l.href} class:list={['acc-tab', { 'is-active': active === l.key }]} aria-current={active === l.key ? 'page' : undefined} data-acc-tab={l.key}>{l.label}<span class="acc-tab-count" hidden></span></a>
  ))}
</nav>

<style>
  .acc-subnav { display: flex; gap: .5rem; margin: 0 0 2rem; border-bottom: 1px solid var(--gh-line); overflow-x: auto; }
  .acc-tab { display: inline-flex; align-items: center; gap: .4rem; color: var(--gh-muted); text-decoration: none; font-family: var(--gh-font-body); font-weight: 600; text-transform: uppercase; font-size: .8rem; letter-spacing: .08em; padding: .7rem 1rem; border-bottom: 2px solid transparent; white-space: nowrap; }
  .acc-tab:hover { color: var(--gh-text); }
  .acc-tab.is-active { color: var(--gh-text); border-bottom-color: var(--gh-red); }
  .acc-tab-count { padding: 0 .4rem; border-radius: 999px; background: var(--gh-yellow); color: #111; font-style: normal; font-size: .7rem; line-height: 1.4; }
  .acc-tab-count[hidden] { display: none; }
  @media (max-width: 760px) { .acc-subnav { gap: .25rem; } .acc-tab { padding: .7rem .75rem; } }
  /* phone: all six tabs visible without sideways scrolling */
  @media (max-width: 480px) { .acc-subnav { gap: 0; justify-content: space-between; } .acc-tab { padding: .65rem .2rem; font-size: .68rem; letter-spacing: .02em; } }
</style>

<script>
  // Badge on the Crew tab: open join requests for crews I lead + invites for me.
  import { backendConfigured, getSupabase } from '../scripts/supabase-client';
  async function badge() {
    if (!backendConfigured) return;
    const sb = getSupabase();
    const { data: s } = await sb.auth.getSession();
    const session = s?.session;
    if (!session) return;
    const own = await sb.from('drivers').select('driver_id').eq('auth_user_id', session.user.id).maybeSingle();
    const me = own.data?.driver_id;
    if (!me) return;
    const roles = await sb.from('hub_roles').select('crew_id').eq('driver_id', me).eq('role', 'crew_leader');
    const ids = (roles.data ?? []).map((r: any) => r.crew_id).filter(Boolean);
    // + crew invites waiting for me (RS-0063)
    const inv = await sb.from('crew_memberships').select('membership_id', { count: 'exact', head: true }).eq('driver_id', me).eq('status', 'invited');
    let count = inv.count ?? 0;
    if (ids.length) {
      const req = await sb.from('crew_membership_overview').select('membership_id', { count: 'exact', head: true }).eq('status', 'pending').in('crew_id', ids);
      count += req.count ?? 0;
    }
    const el = document.querySelector<HTMLElement>('[data-acc-tab="crew"] .acc-tab-count');
    if (el && count) { el.textContent = String(count); el.hidden = false; }
  }
  badge();
</script>
