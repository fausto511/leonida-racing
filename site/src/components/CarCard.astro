---
// Vehicle card of the redesign (DEC-0116 "Fastest at Gellhorn", DEC-0117 card).
// Mockup class .vcard: image with class pill + compare "+", brand line, model,
// "Price · Top speed", "Based on …", foot with the Gellhorn rank. The whole
// card links to the vehicle page; the compare button sits above that link.
// COPY STATUS: "TBA" / "No Gellhorn lap yet" are Claude placeholders -> Codex (DEC-0088).
import { vehicleValues, COST_METRIC, sellValueText, type VehicleOption } from '../data/vehicles';
import { lapTime } from '../data/leaderboard';
import RatingIcon from './RatingIcon.astro';

interface Props {
  vehicle: VehicleOption;
  /** class shown in the pill (default: first class) */
  cls?: string;
  /** Gellhorn foot: rank + time in that class, or null = no lap yet */
  lap?: { rank: number; ms: number } | null;
  /** extra attributes for client-side rotation */
  rotate?: string;
  /** 'cars' = Cars page card (DEC-0117): availability/New pills, "Gellhorn #N" foot, garage button */
  variant?: 'home' | 'cars';
  /** data-* attributes for filtering/sorting on the Cars page */
  data?: Record<string, string | number>;
  isNew?: boolean;
  /** Cars page: phone shows the card as a list row (default). false = keep the card shape (vehicle page, swipe row) */
  list?: boolean;
}
const { vehicle: v, cls = v.classes[0], lap = null, rotate, variant = 'home', data = {}, isNew = false, list = true } = Astro.props;
const cars = variant === 'cars';
const dataAttrs = Object.fromEntries(Object.entries(data).map(([k, val]) => [`data-${k}`, String(val)]));
const base = import.meta.env.BASE_URL;
const href = `${base}cars/vehicles/${v.id}/`;
const price = vehicleValues[v.id]?.[COST_METRIC]?.value; // cost to register (DEC-0247)
const sell = sellValueText(v.id);
const road = vehicleValues[v.id]?.rating_road?.value;
const off = vehicleValues[v.id]?.rating_offroad?.value;
const spd = vehicleValues[v.id]?.stat_speed?.value; // in-game stats 0-10
const acc = vehicleValues[v.id]?.stat_acceleration?.value;
const hasRatings = road != null || off != null;
const hasBars = spd != null || acc != null;
const dash = '\u2014';
const pct = (x?: number) => `${Math.max(0, Math.min(10, x ?? 0)) * 10}%`;
const fmtPrice = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
// Card values (Fausto 23.11.2026, variant C): road + off-road rating as chips with the game's icons (icon left of the
// number), Speed + Acceleration bars, then Cost to register + Sell value. Home cards: only the rating chips. Edition label removed
// from the card (which Ultimate Edition cars are really exclusive is still open). Top speed returns once measured.
---
<article class:list={['card vcard lr-hcard', { 'vc-cars': cars, 'vc-list': cars && list }]} data-id={v.id} data-rotate={rotate} {...dataAttrs}>
  <a href={href} class="vc-img" tabindex="-1" aria-hidden="true">
    {v.photo ? (
      <img class="lr-hzoom" src={`${base}images/vehicles/${v.id}-640.webp`} srcset={`${base}images/vehicles/${v.id}-640.webp 640w, ${base}images/vehicles/${v.id}-1280.webp 1280w`} sizes="(max-width: 760px) 272px, 320px" alt="" width="640" height="360" loading="lazy" />
    ) : (
      <span class="vc-ph">
        <img class="vc-ph-bg lr-hzoom" src={`${base}images/garage/garage-hero-placeholder-640.webp`} alt="" width="640" height="360" loading="lazy" />
        <img class="vc-ph-logo" src={`${base}images/logos/${v.logoSlug}-gta-6-logo.svg`} alt="" width="92" height="92" loading="lazy" />
        <span class="vc-ph-pill">No photo yet</span>
      </span>
    )}
    <span class="vc-pills">
      <span class="vc-cls" data-cls-pill>{cls}</span>
      {cars && isNew && <span class="vc-cls vc-new">New</span>}
    </span>
  </a>
  <button type="button" class="vc-cmp" data-compare={v.id} aria-pressed="false" aria-label={`Add ${v.make} ${v.model} to compare`}>
    <svg class="vc-plus" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
    <svg class="vc-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
  </button>
  <div class="vc-body">
    <div class="vc-brand"><img src={`${base}images/logos/${v.logoSlug}-gta-6-logo.svg`} alt="" width="20" height="20" loading="lazy" />{v.make}</div>
    <a href={href} class="vc-name">{v.model}</a>
    {hasRatings ? (
      <div class="vc-chips">
        {road != null && <span class="vc-chip" title="Road rating"><RatingIcon kind="road" />{Math.round(road)}</span>}
        {off != null && <span class="vc-chip" title="Off-road rating"><RatingIcon kind="offroad" />{Math.round(off)}</span>}
      </div>
    ) : (!cars || !hasBars) && <div class="vc-stats vc-tba">No stats yet</div>}
    {cars && hasBars && (
      <div class="vc-bars">
        <div class="vc-bar"><span class="vc-bl">Speed</span><span class="vc-bv"><span class="vc-bt"><i style={`width:${pct(spd)}`}></i></span><b>{spd != null ? spd.toFixed(1) : dash}</b></span></div>
        <div class="vc-bar"><span class="vc-bl">Acceleration</span><span class="vc-bv"><span class="vc-bt"><i style={`width:${pct(acc)}`}></i></span><b>{acc != null ? acc.toFixed(1) : dash}</b></span></div>
      </div>
    )}
    {cars && (
      <div class="vc-money">
        <div><small><span class="vc-long">Cost to register</span><span class="vc-short">Register</span></small><b class:list={[{ 'vc-na': !price }]}>{price ? fmtPrice(price) : dash}</b></div>
        <div><small><span class="vc-long">Sell value</span><span class="vc-short">Sell</span></small><b class:list={[{ 'vc-na': !sell }]}>{sell ? sell.main : dash}</b></div>
      </div>
    )}
    <div class="vc-based">{v.realLifeInspiration ? `Based on ${v.realLifeInspiration}` : ' '}</div>
    <div class="vc-foot">
      <span class="vc-rank" title={cars && lap ? `Gellhorn rank in ${cls}` : 'Gellhorn International Raceway'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg>
        {lap ? (cars ? <>#{lap.rank}{'\u2002·\u2002'}<span class="tnum">{lapTime(lap.ms)}</span></> : <>#{lap.rank} in {cls}{'\u2002·\u2002'}<span class="tnum">{lapTime(lap.ms)}</span></>) : <><span class="vc-nolap-l">No Gellhorn lap yet</span><span class="vc-nolap-s">No lap yet</span></>}
      </span>
      {cars ? (
        <span class="vc-acts">
          <button type="button" class="vc-wish" data-wish={v.id} aria-pressed="false" aria-label={`Add ${v.make} ${v.model} to your wishlist`} title="Add to wishlist">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></svg>
          </button>
          <button type="button" class="vc-garage" data-garage={v.id} aria-pressed="false" aria-label={`Add ${v.make} ${v.model} to My garage`} title="Mark as owned · adds it to My garage">
            <svg class="vc-g-house" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 21V10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v11"/><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 1.132-1.803l7.95-3.974a2 2 0 0 1 1.837 0l7.948 3.974A2 2 0 0 1 22 8z"/><path d="M6 13h12"/><path d="M6 17h12"/></svg>
            <svg class="vc-g-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 1.132-1.803l7.95-3.974a2 2 0 0 1 1.837 0l7.948 3.974A2 2 0 0 1 22 8z"/><path d="m8.5 14 2.5 2.5 4.5-5"/></svg>
          </button>
        </span>
      ) : <span class="vc-arrow" aria-hidden="true">→</span>}
    </div>
  </div>
</article>

<style>
  .vcard { position: relative; display: flex; flex-direction: column; transition: border-color .15s; }
  .vc-img { position: relative; display: block; aspect-ratio: 16 / 10; background: var(--lr-raised); overflow: hidden; }
  .vc-img > img, .vc-ph-bg { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vc-ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .vc-ph-bg { position: absolute; inset: 0; filter: grayscale(.6) brightness(.35); }
  .vc-ph-logo { position: relative; width: 92px; height: 92px; object-fit: contain; filter: var(--lr-logo-filter); opacity: var(--lr-logo-ph); }
  .vc-ph-pill { position: absolute; right: 12px; bottom: 12px; height: 24px; padding: 0 10px; border-radius: 999px; background: var(--lr-dark-80); font-size: 11px; font-weight: 600; color: var(--lr-muted); display: inline-flex; align-items: center; }
  .vc-pills { position: absolute; left: 12px; top: 12px; right: 56px; display: flex; flex-wrap: wrap; gap: 6px; }
  .vc-cls { height: 26px; padding: 0 10px; border-radius: 999px; background: var(--lr-dark-80); backdrop-filter: blur(4px); font-size: 12px; font-weight: 600; color: var(--lr-text); display: inline-flex; align-items: center; }
  .vc-new { background: var(--lr-lime); color: var(--lr-on-lime); font-weight: 700; }
  .vc-garage { position: relative; z-index: 2; flex: none; width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; border: 1px solid var(--lr-line-strong); background: transparent; color: var(--lr-text); cursor: pointer; }
  .vc-garage:hover { border-color: var(--lr-text); }
  .vc-garage:focus-visible { outline: 2px solid var(--lr-orange); outline-offset: 2px; }
  .vc-garage svg { width: 17px; height: 17px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  /* Wishlist heart next to the garage (Fausto 05.11.): always shown, so every card looks the same;
     dimmed when you own the car (owning takes it off the wishlist) */
  .vc-nolap-s { display: none; }
  .vc-acts { display: flex; gap: 6px; flex: none; }
  .vc-wish { position: relative; z-index: 2; flex: none; width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; border: 1px solid var(--lr-line-strong); background: transparent; color: var(--lr-text); cursor: pointer; }
  .vc-wish:hover:not(:disabled) { border-color: var(--lr-pink); color: var(--lr-pink); }
  .vc-wish:focus-visible { outline: 2px solid var(--lr-orange); outline-offset: 2px; }
  .vc-wish svg { width: 17px; height: 17px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .vc-wish[aria-pressed="true"] { background: var(--lr-pink-fill); border-color: var(--lr-pink-border); color: var(--lr-pink); }
  .vc-wish[aria-pressed="true"] svg { fill: currentColor; }
  .vc-wish.is-owned { opacity: .35; cursor: default; }
  .vc-g-check { display: none; }
  .vc-garage[aria-pressed="true"] { background: var(--lr-lime-fill); border-color: var(--lr-lime-border); color: var(--lr-lime); }
  .vc-garage[aria-pressed="true"] .vc-g-house { display: none; }
  .vc-garage[aria-pressed="true"] .vc-g-check { display: block; stroke-width: 2; }
  .vc-cmp { position: absolute; z-index: 2; right: 12px; top: 12px; width: 32px; height: 32px; padding: 0; border-radius: 999px; border: 1px solid var(--lr-line-hover); background: var(--lr-dark-60); color: var(--lr-text); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .vc-cmp:hover { border-color: var(--lr-pink); color: var(--lr-pink); }
  .vc-cmp svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .vc-check { display: none; }
  .vc-cmp[aria-pressed="true"] { background: var(--lr-pink); border-color: var(--lr-pink); color: var(--lr-on-pink); }
  .vc-cmp[aria-pressed="true"] .vc-plus { display: none; }
  .vc-cmp[aria-pressed="true"] .vc-check { display: block; }
  .vc-cmp:focus-visible { outline: 2px solid var(--lr-orange); outline-offset: 2px; }
  .vc-body { flex: 1; padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 4px; }
  .vc-brand { display: flex; align-items: center; gap: 8px; min-height: 20px; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--lr-muted); }
  .vc-brand img { width: 20px; height: 20px; object-fit: contain; filter: var(--lr-logo-filter); opacity: var(--lr-logo-info); }
  .vc-name { font-size: 18px; font-weight: 700; line-height: 1.2; color: var(--lr-text); text-decoration: none; }
  .vc-name::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .vc-name:focus-visible { outline: none; }
  .vcard:has(.vc-name:focus-visible) { outline: 2px solid var(--lr-orange); outline-offset: 2px; }
  /* variant C (Fausto 23.11.2026) */
  .vc-chips { display: flex; gap: 6px; margin: 4px 0 2px; }
  .vc-chip { display: inline-flex; align-items: center; gap: 7px; height: 28px; padding: 0 9px 0 6px; border: 1px solid var(--lr-line-strong, rgba(255,255,255,.16)); border-radius: 8px; font-size: 14px; font-weight: 700; color: var(--lr-text); font-variant-numeric: tabular-nums; }
  .vc-bars { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 4px 0 2px; }
  .vc-bl, .vc-money small { display: block; font-size: 10px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--lr-muted); }
  .vc-bv { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
  .vc-bt { flex: 1; height: 4px; border-radius: 2px; background: rgba(255,255,255,.12); overflow: hidden; }
  .vc-bt i { display: block; height: 100%; background: var(--lr-orange); border-radius: 2px; }
  .vc-bv b { min-width: 24px; text-align: right; font-size: 13px; color: var(--lr-text); font-variant-numeric: tabular-nums; }
  .vc-money { display: flex; gap: 18px; margin: 2px 0; }
  .vc-money b { font-size: 15px; color: var(--lr-text); font-variant-numeric: tabular-nums; }
  .vc-money b.vc-na { color: var(--lr-muted); font-weight: 500; }
  .vc-short { display: none; }
  .vc-stats { margin-top: 2px; font-size: 14px; color: var(--lr-soft); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vc-tba { color: var(--lr-muted); }
  .vc-based { font-size: 14px; color: var(--lr-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 8px; }
  .vc-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: auto; padding-top: 10px; border-top: 1px solid var(--lr-line); font-size: 14px; color: var(--lr-soft); }
  .vc-rank { display: inline-flex; align-items: center; gap: 8px; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vc-rank svg { width: 16px; height: 16px; flex: none; stroke: var(--lr-orange); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .vc-arrow { color: var(--lr-muted); font-weight: 600; transition: color .15s, transform .15s; }
  .vcard:hover .vc-arrow { color: var(--lr-orange); transform: translateX(3px); }

  /* Phone: Cars page as a list (DEC-0117): image 118px, text, compare + garage stacked right */
  @media (max-width: 760px) {
    .vc-list { flex-direction: row; align-items: stretch; min-height: 118px; }
    .vc-list .vc-img { width: 118px; flex: none; aspect-ratio: auto; }
    .vc-list .vc-pills { left: 6px; top: 6px; right: 6px; gap: 4px; }
    .vc-list .vc-cls { height: 22px; padding: 0 7px; font-size: 11px; }
    .vc-list .vc-ph-logo { width: 48px; height: 48px; }
    .vc-list .vc-ph-pill { display: none; }
    .vc-list .vc-body { flex: 1; min-width: 0; padding: 10px 52px 10px 12px; gap: 2px; }
    .vc-list .vc-brand { font-size: 11px; min-height: 16px; }
    .vc-list .vc-brand img { width: 16px; height: 16px; }
    .vc-list .vc-name { font-size: 16px; }
    .vc-list .vc-stats { font-size: 13px; }
    /* phone list: no bars, short money labels, so the row keeps the height of its three buttons */
    .vc-list .vc-bars { display: none; }
    .vc-list .vc-chips { margin: 2px 0 0; }
    .vc-list .vc-chip { height: 26px; font-size: 13px; padding: 0 8px 0 5px; }
    .vc-list .vc-money { gap: 14px; margin: 0; }
    .vc-list .vc-long { display: none; }
    .vc-list .vc-short { display: inline; }
    .vc-list .vc-based { display: none; }
    .vc-list .vc-foot { margin-top: 4px; padding-top: 0; border-top: 0; font-size: 13px; }
    .vc-list .vc-cmp { top: 10px; right: 8px; width: 40px; height: 40px; }
    /* compare, heart, garage stacked on the right with 10px between them (Fausto 05.11.) */
    .vc-list { min-height: 160px; }
    .vc-list .vc-acts { position: absolute; right: 8px; bottom: 10px; flex-direction: column; gap: 10px; }
    .vc-list .vc-garage, .vc-list .vc-wish { width: 40px; height: 40px; }
  }
</style>
