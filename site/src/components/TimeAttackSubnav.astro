---
interface Props {
  active?: 'leaderboard' | 'how-it-works' | 'rules' | null;
}
const { active = null } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { key: 'leaderboard', label: 'Leaderboard', href: `${base}time-attack/gellhorn-international-raceway/` },
  { key: 'how-it-works', label: 'How It Works', href: `${base}time-attack/how-it-works/` },
  { key: 'rules', label: 'Rules', href: `${base}time-attack/rules/` },
];
---
<div class="subnav-bar">
  <div class="wrap">
    <nav class="subnav-tabs" aria-label="Section">
      {links.map((l) => (
        <a href={l.href} class:list={['subnav-tab', { 'is-active': active === l.key }]}>{l.label}</a>
      ))}
    </nav>
  </div>
</div>

<style>
  /* Same visual language as the Garage page's Vehicles/Compare tabs
     (.garage-tab in cars/index.astro) -- kept in sync intentionally.
     border-top (transparent) mirrors border-bottom so the label sits
     visually centered between the hero image above and the divider line
     below -- do not remove without checking garage-tab too.
     The divider line lives on .subnav-bar (full page width, like the
     main nav's border) rather than on .subnav-tabs (content width),
     so it stays consistent regardless of whether a page above it has
     a hero image or not. */
  .subnav-bar { border-bottom: 1px solid var(--gh-line); margin-bottom: 1.5rem; }
  .subnav-tabs { display: flex; gap: .5rem; }
  .subnav-tab { color: var(--gh-muted); text-decoration: none; font-family: var(--gh-font-body); font-weight: 600; text-transform: uppercase; font-size: .8rem; letter-spacing: .08em; padding: .7rem 1rem; border-top: 2px solid transparent; border-bottom: 2px solid transparent; }
  .subnav-tab:hover { color: var(--gh-text); }
  .subnav-tab.is-active { color: var(--gh-text); border-bottom-color: var(--gh-red); }
  @media (max-width: 760px) {
    .subnav-tabs { gap: .25rem; overflow-x: auto; }
  }
</style>
