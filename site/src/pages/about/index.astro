---
// About (redesign 21.10.2026, DEC-0149, no mockup): who we are instead of a product tour
// (Fausto 21.10.: convince people, show our roots, mindset, goals; invite to join and partner).
// Facts: interview with Fausto (Claude outputs/ABOUT-Interview-Fausto-2026-10-21.md) + RRL website.
// RRL numbers only in the RRL block, never in band/H1/lede/meta (Fausto 21.10.: different project).
// COPY STATUS: Codex 21.10.2026 (Codex Zuarbeit/About-Seite-neu-2026-10-21.md), DEC-0088.
// Exception: "150 championship races" added on Fausto's decision (21.10., reached by GTA VI release).
import Base from '../../layouts/Base.astro';
import DiscordBand from '../../components/DiscordBand.astro';
import { DISCORD_INVITE_URL } from '../../data/site';
const base = import.meta.env.BASE_URL;
const RRL_URL = 'https://fausto511.github.io/rockford-racing-league/';

const rrlNumbers = [
  { v: '2017', k: 'Championship founded' },
  { v: '150', k: 'Championship races' },
  { v: '200+', k: 'Championship drivers' },
  { v: '1,000+', k: 'Tracks tested and rated' },
];
const principles = [
  { t: 'Test across tracks', c: 'A car can tell a different story on a tight street circuit than on a fast, open route. We bring experience in testing across both, comparing clean laps and having another driver check a result when it needs a closer look.',
    i: 'M3 17l6-6 4 4 8-8 M14 7h7v7' },
  { t: 'Build it together', c: 'GTA VI means learning the cars and racing all over again. We want to build that knowledge with the community and share what we learn, with room for new testers, different perspectives and useful questions.',
    i: 'M11 17l2 2a1 1 0 1 0 3-3 M14 14l2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4 M21 3l1 11h-2 M3 3L2 14l6.5 6.5a1 1 0 1 0 3-3 M3 4h8' },
  { t: 'Give the scene room', c: 'Leonida Racing is here to help drivers discover events, crews and tracks across the scene. You do not have to race in the RRL to have a place here or bring something worth sharing.',
    i: 'M3 12h18 M12 3a14 14 0 0 1 0 18 M12 3a14 14 0 0 0 0 18 M12 3a9 9 0 1 1 0 18a9 9 0 0 1 0-18' },
  { t: 'Show the evidence', c: 'Our Guide separates confirmed information, community identifications and open questions. Time Attack submissions need moderator review before publication, and Video verified status requires a moderator to review and verify the full lap video.',
    i: 'M9 12l2 2 4-4 M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z' },
];
const roles = [
  { t: 'Test drivers', c: 'Help compare cars across different tracks with clean, repeatable laps and a second look at results that need one.' },
  { t: 'Gellhorn drivers', c: 'Help put a time against every car at Gellhorn, from your favorite daily driver to the one everyone else overlooks.' },
  { t: 'Creators', c: 'Bring your race-building ideas and help shape a collection of tracks that drivers want to run again.' },
  { t: 'Event hosts', c: 'Bring your races, meets and playlists to more drivers, and help them find their next regular lobby.' },
];
---
<Base
  title="About Leonida Racing — GTA 6 Racing Community"
  description="Meet the community behind Leonida Racing: our Rockford Racing League roots, how we test, and how to help build GTA 6 racing knowledge and connections."
>
  <section class="ab-band">
    <img class="ab-bg" src={`${base}images/hub/hub-carmeet-1080.webp`} srcset={`${base}images/hub/hub-carmeet-640.webp 640w, ${base}images/hub/hub-carmeet-1080.webp 1080w, ${base}images/hub/hub-carmeet-1672.webp 1672w`} sizes="100vw" alt="" width="1672" height="940" fetchpriority="high" />
    <span class="lr-shade is-open" aria-hidden="true"></span>
    <div class="wrap lr-band-in ab-band-in">
      <nav class="lr-crumb" aria-label="Breadcrumb"><a href={base}>Home</a><span aria-hidden="true">/</span><span aria-current="page">About</span></nav>
      <p class="eyebrow">GTA VI · Built by the community</p>
      <h1 class="display lr-t2">Good racing brings people together</h1>
      <p class="lr-lede">Leonida Racing comes from the people behind the Rockford Racing League. We’re building a GTA VI home for racers, car enthusiasts and the crews, hosts and creators who keep the scene moving.</p>
    </div>
  </section>

  <div class="wrap ab">
    <!-- Where we come from -->
    <section class="ab-sec ab-roots" aria-labelledby="ab-roots-h">
      <div class="ab-roots-text">
                <h2 class="lr-h2 lr-h2-s ab-h2" id="ab-roots-h">Where we come from</h2>
        <p>The <a href={RRL_URL} target="_blank" rel="noopener">Rockford Racing League</a> has been running GTA championships since 2017. Alongside the championship seasons came cup events, training sessions and a lot of testing. Drivers brought tracks, compared cars and helped shape racing classes where a close fight was the point.</p>
        <p>That work became a testing routine of its own. Cars were compared on tight city circuits, fast open-road routes and hills with climbs and descents. Only clean laps counted. Test drivers checked their pace against one another, and uncertain results got a second driver’s attention. The balancing grew more detailed over the years, with plenty of spreadsheets along the way.</p>
        <p>Racing Society brought another part of the idea: a Discord space connecting racers, hosts and creators. That server is now Leonida Racing’s Discord. This new project brings the RRL’s testing experience and Racing Society’s network together, with room for the wider scene to help shape it.</p>
      </div>
      <aside class="card ab-rrl" aria-labelledby="ab-rrl-h">
        <p class="ab-rrl-h" id="ab-rrl-h">The Rockford Racing League in numbers</p>
        <dl class="ab-stats">
          {rrlNumbers.map((n) => <div><dt>{n.k}</dt><dd>{n.v}</dd></div>)}
        </dl>
        <a class="arrow ab-rrl-a" href={RRL_URL} target="_blank" rel="noopener">Meet the RRL</a>
      </aside>
    </section>

    <!-- How we work -->
    <section class="ab-sec" aria-labelledby="ab-work-h">
            <h2 class="lr-h2 lr-h2-s ab-h2" id="ab-work-h">How we work</h2>
      <div class="ab-grid4">
        {principles.map((p) => (
          <div class="card ab-p">
            <svg class="ab-ico" viewBox="0 0 24 24" aria-hidden="true"><path d={p.i} /></svg>
            <h3>{p.t}</h3>
            <p>{p.c}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Where we're heading -->
    <section class="ab-sec ab-next" aria-labelledby="ab-next-h">
      <div class="ab-next-in">
                <h2 class="lr-h2 lr-h2-s ab-h2" id="ab-next-h">Where we’re heading</h2>
        <p>We want our first year to lay the groundwork for a detailed GTA VI car database: results from different tracks, a new approach to balancing built around those results, and useful comparisons of price, pace and where each car fits. Our GTA V testing gives us a way to approach the work. GTA VI needs its own results.</p>
        <p>We also want Leonida Racing to become a regular meeting point for experienced hosts, creators and racing crews from around the world. More events to discover, more creations to try, more people to line up alongside. Through Time Attack, we want drivers and their crews to show their pace with laps others can check.</p>
      </div>
    </section>

    <!-- Get involved -->
    <section class="ab-sec" aria-labelledby="ab-join-h">
      <div class="ab-join-head">
        <div>
          <h2 class="lr-h2 lr-h2-s ab-h2" id="ab-join-h">Get involved</h2>
          <p class="ab-lead">You do not have to chase an overall record to belong here. Bring an idea, a willingness to test, a track you’re building or an event you want people to find. Start a conversation on Discord; there’s room to contribute from the beginning. As you spend time helping shape the project, your ideas help steer it too.</p>
        </div>
        <a class="btn btn-discord ab-join-btn" href={DISCORD_INVITE_URL} target="_blank" rel="noopener">Join Discord</a>
      </div>
      <div class="ab-grid4">
        {roles.map((r) => <div class="ab-role"><h3>{r.t}</h3><p>{r.c}</p></div>)}
      </div>
    </section>

    <!-- Partner with us -->
    <section class="ab-sec" aria-labelledby="ab-partner-h">
      <div class="card ab-partner">
        <div>
                    <h2 class="lr-h2 lr-h2-s ab-h2" id="ab-partner-h">Partner with us</h2>
          <p>Run a crew, a community, a stream or a channel? We’re interested in working with people who want to share good racing, useful knowledge and an audience for each other’s work. Track-building communities are welcome too: tell us what you’re making and what we could do together.</p>
        </div>
        <div class="ab-partner-act">
          <a class="btn btn-p" href={DISCORD_INVITE_URL} target="_blank" rel="noopener">Talk partnerships</a>
          <a class="arrow" href={`${base}legal/`}>Contact us →</a>
        </div>
      </div>
    </section>

    <!-- Independent · Contact · Data -->
    <section class="ab-sec ab-info" aria-label="Independent, contact and data">
      <div>
        <h3 class="ab-h3">Independent</h3>
        <p>Leonida Racing is an independent community project built for GTA VI racers and car enthusiasts. It is not affiliated with Rockstar Games or Take-Two Interactive. Leonida Racing is free to use.</p>
      </div>
      <div>
        <h3 class="ab-h3">Contact</h3>
        <p>Have a question, spotted something wrong or want to contribute? Reach us on <a href={DISCORD_INVITE_URL} target="_blank" rel="noopener">Discord</a> or use the email address in the <a href={`${base}legal/`}>Legal Notice</a>. To flag a lap or other content for review, use <a href={`${base}report/`}>Report a time</a> or <a href={`${base}report-content/`}>Report content</a>.</p>
      </div>
      <div>
        <h3 class="ab-h3">How your data is used</h3>
        <p>Signing in uses Discord. Your account, submissions and community activity are handled as described in our <a href={`${base}privacy/`}>Privacy Policy</a>, including what we store, why we use it and how to exercise your rights.</p>
      </div>
    </section>
  </div>

  <DiscordBand />
</Base>

<style>
  /* ---- band (DEC-0139, text only) ---- */
  .ab-band { position: relative; overflow: hidden; border-bottom: 1px solid var(--lr-line-strong); }
  .ab-bg { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 60% 45%; }
  .ab-band-in .lr-t2 { max-width: 760px; }

  /* ---- sections ---- */
  .ab { padding-bottom: var(--lr-gap-sec); }
  .ab-sec { padding-top: var(--lr-gap-sec); }
  .ab-roots { padding-top: var(--lr-gap-head); }
  .ab-eb { margin: 0 0 8px; font-size: 13px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--lr-orange); }
  .ab-h2 { margin: 0 0 18px; }
  .ab p { line-height: 1.65; }
  .ab a:not(.btn):not(.arrow) { color: var(--lr-text); text-decoration: underline; text-decoration-color: var(--lr-orange); text-decoration-thickness: 1px; text-underline-offset: 3px; transition: color .15s; } /* text link (DEC-0169) */
  .ab a:not(.btn):not(.arrow):hover { color: var(--lr-orange); }

  /* roots */
  .ab-roots { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 56px; align-items: start; }
  .ab-roots-text p { margin: 0 0 16px; font-size: 17px; color: var(--lr-text); max-width: 680px; }
  .ab-roots-text p:last-child { margin-bottom: 0; }
  .ab-rrl { padding: 24px; margin-top: 36px; }
  .ab-rrl-h { margin: 0 0 14px; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-soft); }
  .ab-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; margin: 0 0 18px; }
  .ab-stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 4px; }
  .ab-stats dd { margin: 0; font-family: var(--gh-font-display); font-size: 34px; font-weight: 900; line-height: 1; color: var(--lr-text); }
  .ab-stats dt { font-size: 14px; color: var(--lr-soft); line-height: 1.35; }

  /* principles + roles */
  .ab-grid4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .ab-p { padding: 22px; display: flex; flex-direction: column; gap: 10px; }
  .ab-ico { width: 28px; height: 28px; fill: none; stroke: var(--lr-pink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ab-p h3, .ab-role h3 { margin: 0; font-size: var(--lr-h3-s); font-weight: 700; }
  .ab-p p, .ab-role p { margin: 0; font-size: 15px; color: var(--lr-soft); line-height: 1.55; }

  /* heading */
  .ab-next { padding-top: calc(var(--lr-gap-sec) - 32px); } /* the gradient line starts 32px above the heading */
  .ab-next-in > :last-child { margin-bottom: 0; }
  .ab-next-in { max-width: 820px; padding: 32px 0 0 28px; border-left: 3px solid; border-image: var(--lr-brand-gradient) 1; }
  .ab-next-in p { margin: 0 0 16px; font-size: 17px; color: var(--lr-text); }

  /* join */
  .ab-join-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 22px; }
  .ab-lead { margin: 0; max-width: 720px; font-size: 17px; color: var(--lr-text); }
  .ab-join-btn { flex: none; }
  .ab-role { padding: 20px; border-radius: 8px; background: var(--lr-raised); display: flex; flex-direction: column; gap: 8px; }

  /* partner */
  .ab-partner { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 32px; background: linear-gradient(135deg, rgba(242,75,157,.12), rgba(255,149,90,.08) 60%, transparent), var(--lr-card); }
  .ab-partner p { margin: 0; max-width: 680px; font-size: 16px; color: var(--lr-text); }
  .ab-partner-act { flex: none; display: flex; flex-direction: column; align-items: center; gap: 14px; }

  /* info */
  .ab-info { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; padding-top: 56px; margin-top: var(--lr-gap-sec); border-top: 1px solid var(--lr-line); }
  .ab-h3 { margin: 0 0 8px; font-size: var(--lr-h3-xs); font-weight: 700; }
  .ab-info p { margin: 0; font-size: 14px; color: var(--lr-soft); line-height: 1.6; }

  @media (max-width: 1100px) {
    .ab-roots { grid-template-columns: 1fr; gap: 8px; }
    .ab-rrl { margin-top: 8px; max-width: 560px; }
    .ab-grid4 { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .ab-roots-text p, .ab-next-in p, .ab-lead { font-size: 16px; }
    .ab-stats dd { font-size: 28px; }
    .ab-grid4 { grid-template-columns: 1fr; gap: 12px; }
    .ab-next-in { padding: 4px 0 0 18px; }
    .ab-next { padding-top: calc(var(--lr-gap-sec) - 4px); }
    .ab-join-head { flex-direction: column; align-items: flex-start; gap: 18px; }
    .ab-partner { flex-direction: column; align-items: flex-start; gap: 22px; padding: 22px; }
    .ab-partner-act { flex-direction: row; align-items: center; gap: 18px; }
    .ab-info { grid-template-columns: 1fr; gap: 22px; padding-top: 36px; }
  }
</style>
