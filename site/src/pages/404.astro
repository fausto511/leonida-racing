---
// 404 page (RS-0072), after the mockup boards NotFound / NotFoundMobile (16.10.2026).
// GitHub Pages serves dist/404.html for every unknown URL, so the requested path is
// read in the browser (location.pathname) and matched against cars, classes and
// manufacturers for "Did you mean". Old /garage/ and /hub/ paths are mapped too.
// COPY STATUS: Codex 404 texts (Codex Zuarbeit/404-Seite-Texte-2026-10-16.md) reviewed 17.10.: title + lede adopted;
// search placeholder stays "Search cars" (search does not cover classes); H1 "Wrong turn", tile lines and band from the mockup kept (closer to TEXTSTIL).
// Search: the mockup says "Search cars, tracks, crews", but only the car search exists,
// so the field says "Search cars" and goes to /cars/?q= like the header.
import Base from '../layouts/Base.astro';
import { vehicleOptions } from '../data/vehicles';
import { classPages, manufacturerPages, classSlug } from '../data/garage-taxonomy';
import { taxonomyCopy } from '../data/taxonomy-copy';

const base = import.meta.env.BASE_URL;
const data = {
  base,
  cars: vehicleOptions.map((v) => ({ id: v.id, make: v.make, model: v.model, logo: v.logoSlug, cls: v.classes[0] ?? null, clsSlug: v.classes[0] ? classSlug(v.classes[0]) : null, photo: !!v.photo })),
  classes: classPages.map((p) => ({ slug: p.slug, name: taxonomyCopy[p.slug]?.h1 ?? p.name })),
  makes: manufacturerPages.map((p) => ({ slug: p.slug, name: p.name })),
};
const tiles = [
  { href: `${base}cars/`, img: 'home/home-hero', name: 'Cars', cta: 'Browse all cars', line: 'Specs, real-life inspirations and Gellhorn lap times for every car in GTA VI.' },
  { href: `${base}time-attack/gellhorn-international-raceway/`, img: 'gellhorn-raceway', name: 'Time Attack', cta: 'See the leaderboard', line: 'Set a lap at Gellhorn International Raceway and climb the leaderboard.' },
  { href: `${base}community/`, img: 'hub/hub-events', name: 'Community', cta: 'Find events and crews', line: 'Find races, car meets and crews that drive the way you do.' },
  { href: `${base}guide/`, img: 'guide/guide-hero', name: 'Guide', cta: 'Read the guide', line: 'Everything confirmed about cars and racing in GTA VI, with sources.' },
];
const DISCORD_INVITE_URL = 'https://discord.gg/hPGuBwXRqT';
const discordPath = 'M20.33 4.23C18.78 3.5 17.12 2.97 15.38 2.67C15.17 3.06 14.92 3.58 14.74 3.99C12.9 3.71 11.07 3.71 9.26 3.99C9.09 3.58 8.83 3.06 8.62 2.67C6.88 2.97 5.21 3.5 3.66 4.23C0.53 8.97 -0.32 13.58 0.1 18.14C2.18 19.69 4.19 20.63 6.17 21.25C6.66 20.58 7.1 19.86 7.48 19.11C6.76 18.83 6.07 18.5 5.43 18.11C5.6 17.98 5.77 17.85 5.93 17.71C9.88 19.56 14.17 19.56 18.07 17.71C18.23 17.85 18.4 17.98 18.57 18.11C17.92 18.5 17.24 18.84 16.52 19.11C16.9 19.86 17.33 20.58 17.82 21.25C19.8 20.63 21.82 19.69 23.9 18.14C24.4 12.86 23.05 8.28 20.33 4.23ZM8.01 15.34C6.83 15.34 5.86 14.23 5.86 12.88C5.86 11.53 6.81 10.43 8.01 10.43C9.22 10.43 10.19 11.53 10.17 12.88C10.17 14.23 9.22 15.34 8.01 15.34ZM15.99 15.34C14.8 15.34 13.83 14.23 13.83 12.88C13.83 11.53 14.78 10.43 15.99 10.43C17.19 10.43 18.17 11.53 18.14 12.88C18.14 14.23 17.19 15.34 15.99 15.34Z';
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base title="Page Not Found" description="This link may be out of date, or there may be a typo in the address." noindex>
  <section class="nf">
    <img class="nf-bg" src={`${base}images/guide/street-race-1280.webp`} srcset={`${base}images/guide/street-race-640.webp 640w, ${base}images/guide/street-race-1280.webp 1280w`} sizes="100vw" alt="" width="1280" height="720" fetchpriority="high" />
    <span class="lr-shade" aria-hidden="true"></span>
    <div class="wrap nf-in lr-band-in">
      <div class="nf-tl"><span class="nf-code" aria-hidden="true">404</span><h1 class="display lr-t2">Wrong turn</h1></div>
      <p class="lr-lede nf-s">This link may be out of date, or there may be a typo in the address. Search for a car or pick up the racing line below.</p>
      <span class="nf-url" id="nf-url" hidden></span>
      <form class="nf-srch" role="search" action={`${base}cars/`} method="get">
        <label class="nf-f">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" name="q" placeholder="Search cars" aria-label="Search cars" autocomplete="off" />
        </label>
        <a class="btn btn-p nf-home" href={base}>Back to home</a>
      </form>
    </div>
  </section>

  <section class="wrap nf-dym-sec" id="nf-dym" hidden>
    <div class="nf-dym-wrap">
      <a class="dym" id="dym-main" href="#">
        <span class="dym-eb">Did you mean</span>
        <span class="dym-ph" id="dym-ph"></span>
        <span class="dym-t"><small id="dym-make"></small><b id="dym-name"></b><span class="dym-tm" id="dym-what2" aria-hidden="true"></span></span>
      </a>
      <div class="dym-ch" id="dym-ch"></div>
      <a class="dym-op" id="dym-op" href="#"><span id="dym-what">Open the car →</span></a>
    </div>
  </section>

  <section class="wrap nft">
    <h2>Or head somewhere else</h2>
    <div class="g4">
      {tiles.map((t) => (
        <a href={t.href}>
          <img src={`${base}images/${t.img}-640.webp`} alt="" width="640" height="320" loading="lazy" />
          <span class="b">
            <span class="g4-h display">{t.name}</span>
            <span class="g4-p">{t.line}</span>
            <span class="go">{t.cta} →</span>
          </span>
          <span class="g4-arrow" set:html={arrow} />
        </a>
      ))}
    </div>
    <p class="rep">Followed a broken link on our site? <a href={`${base}legal/#contact`}>Let us know</a> and we’ll fix it.</p>
  </section>
  <!-- Discord band like the home page (Fausto 17.10.); here a plain invite link, no login flow -->
  <section class="dband">
    <div class="wrap dband-inner">
      <div class="dband-copy">
        <h2 class="display dband-title">The scene talks on Discord</h2>
        <p class="dband-text">Find people to race with, catch the next event, talk cars, and discover new tracks and race jobs.</p>
        <a class="dband-more" href={`${base}discord/`}>What’s on the server →</a>
      </div>
      <a href={DISCORD_INVITE_URL} target="_blank" rel="noopener" class="btn dband-btn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={discordPath} /></svg>
        <span>Join the Discord</span>
      </a>
    </div>
  </section>
  <script type="application/json" id="nf-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  type Car = { id: string; make: string; model: string; logo: string; cls: string | null; clsSlug: string | null; photo: boolean };
  const D = JSON.parse(document.getElementById('nf-data')!.textContent!) as { base: string; cars: Car[]; classes: { slug: string; name: string }[]; makes: { slug: string; name: string }[] };
  const $ = (id: string) => document.getElementById(id)!;
  const path = decodeURIComponent(location.pathname);
  if (path && path !== '/' && !/^\/404(\.html|\/)?$/.test(path)) {
    $('nf-url').textContent = location.host + path;
    $('nf-url').hidden = false;
  }

  // ---- matching ---------------------------------------------------------
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/['’]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
  const grams = (s: string) => { const t = ` ${s} `; const g = new Set<string>(); for (let i = 0; i < t.length - 2; i++) g.add(t.slice(i, i + 3)); return g; };
  const sim = (a: string, b: string) => { const A = grams(a), B = grams(b); let n = 0; A.forEach((x) => { if (B.has(x)) n++; }); return (2 * n) / (A.size + B.size || 1); };
  const segs = path.split('/').filter(Boolean).map(norm).filter(Boolean);
  // old section names (14.10.: /garage/ -> /cars/, /hub/ -> /community/)
  const first = path.split('/').filter(Boolean)[0]?.toLowerCase();
  const legacy: Record<string, string> = { garage: 'cars/', hub: 'community/' };
  const tail = segs.filter((s) => !['cars', 'garage', 'vehicles', 'vehicle', 'classes', 'class', 'manufacturers', 'makes', 'make', 'hub', 'community'].includes(s));
  const q = tail.slice(-1)[0] ?? '';

  type Hit = { score: number; kind: 'car' | 'class' | 'make'; car?: Car; slug?: string; name?: string };
  let best: Hit | null = null;
  const take = (h: Hit) => { if (!best || h.score > best.score) best = h; };
  if (q.length >= 3) {
    for (const c of D.cars) {
      const full = norm(`${c.make} ${c.model}`), model = norm(c.model), id = norm(c.id);
      take({ score: Math.max(sim(q, full), sim(q, model), sim(q, id)), kind: 'car', car: c });
    }
    for (const p of D.classes) take({ score: Math.max(sim(q, norm(p.slug)), sim(q, norm(p.name))) - 0.02, kind: 'class', slug: p.slug, name: p.name });
    for (const p of D.makes) take({ score: Math.max(sim(q, norm(p.slug)), sim(q, norm(p.name))) - 0.02, kind: 'make', slug: p.slug, name: p.name });
  }

  const B = D.base;
  const chip = (href: string, label: string, note: string) => `<a href="${href}"><span>${label}</span><small>${note}</small></a>`;
  const show = (href: string, name: string, makeHtml: string, ph: string, what: string, chips: string) => {
    ($('dym-main') as HTMLAnchorElement).href = href;
    ($('dym-op') as HTMLAnchorElement).href = href;
    $('dym-name').textContent = name;
    $('dym-make').innerHTML = makeHtml;
    $('dym-ph').innerHTML = ph;
    $('dym-what').textContent = `Open ${what} →`;
    $('dym-what2').textContent = `Open ${what} →`;
    $('dym-ch').innerHTML = chips;
    $('nf-dym').hidden = false;
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]!));
  const hit = best as Hit | null;
  if (hit && hit.score >= 0.42) {
    if (hit.kind === 'car' && hit.car) {
      const c = hit.car;
      const ph = c.photo
        ? `<img src="${B}images/vehicles/${c.id}-640.webp" alt="">`
        : `<img class="ph-bg" src="${B}images/garage/garage-hero-placeholder-640.webp" alt=""><img class="ph-logo" src="${B}images/logos/${c.logo}-gta-6-logo.svg" alt="">`;
      const mk = D.makes.find((m) => m.slug === c.logo);
      const cl = D.classes.find((p) => p.slug === c.clsSlug);
      show(`${B}cars/vehicles/${c.id}/`, c.model, `<img src="${B}images/logos/${c.logo}-gta-6-logo.svg" alt="">${esc(c.make)}`, ph, 'the car',
        (mk ? chip(`${B}cars/manufacturers/${mk.slug}/`, `All ${esc(mk.name)} cars`, 'Manufacturer') : '') + (cl ? chip(`${B}cars/classes/${cl.slug}/`, esc(cl.name), 'Class') : ''));
    } else if (hit.slug && hit.name) {
      const isMake = hit.kind === 'make';
      const href = `${B}cars/${isMake ? 'manufacturers' : 'classes'}/${hit.slug}/`;
      const ph = isMake ? `<img class="ph-bg" src="${B}images/garage/garage-hero-placeholder-640.webp" alt=""><img class="ph-logo" src="${B}images/logos/${hit.slug}-gta-6-logo.svg" alt="">` : `<img src="${B}images/garage/cars-band-640.webp" alt="">`;
      show(href, isMake ? `${hit.name} Cars` : hit.name, isMake ? 'Manufacturer' : 'Class', ph, 'the page', '');
    }
  } else if (first && legacy[first]) {
    const target = `${B}${legacy[first]}`; // sub-paths that still exist are redirected before a 404 can happen
    show(target, legacy[first] === 'cars/' ? 'Cars' : 'Community', 'This section has a new address', `<img src="${B}images/${legacy[first] === 'cars/' ? 'vehicles/declasse-mamba-gt' : 'hub/hub-carmeet'}-640.webp" alt="">`, 'the page', '');
  }
</script>

<style>
  .ico { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }

  /* ---- band ---- */
  .nf { position: relative; overflow: hidden; border-bottom: 1px solid rgba(200,200,222,.16); }
  .nf-bg, .nf-o { position: absolute; inset: 0; width: 100%; height: 100%; }
  .nf-bg { object-fit: cover; object-position: 50% 62%; }
  .nf-in { display: flex; flex-direction: column; justify-content: center; }
  .nf-tl { display: flex; align-items: flex-end; gap: 22px; flex-wrap: wrap; }
  .nf-code { font-family: 'Archivo', sans-serif; font-variation-settings: 'wdth' 112; font-weight: 800; font-size: 96px; line-height: .8; letter-spacing: -.02em; background: linear-gradient(115deg, #F24B9D, #FF955A); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nf h1 { margin: 0; line-height: .9; }
  .nf-url { display: inline-flex; max-width: 100%; margin-top: 8px; font-size: 13px; color: var(--lr-muted); font-family: ui-monospace, Menlo, monospace; background: rgba(11,11,20,.7); padding: 4px 9px; border-radius: 5px; overflow-wrap: anywhere; }
  .nf-url[hidden] { display: none; }
  .nf-srch { margin-top: 20px; display: flex; gap: 10px; max-width: 620px; }
  .nf-f { flex: 1; min-width: 0; height: 48px; border-radius: 6px; border: 1px solid rgba(200,200,222,.3); background: rgba(20,20,31,.9); display: flex; align-items: center; gap: 10px; padding: 0 16px; color: var(--lr-muted); }
  .nf-f:focus-within { border-color: var(--lr-muted); }
  .nf-f input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--lr-text); font: inherit; font-size: 15px; padding: 0; }
  .nf-f input::placeholder { color: var(--lr-muted); }
  .nf-home { height: 48px; flex: none; }

  /* ---- did you mean ---- */
  .nf-dym-sec[hidden] { display: none; }
  .nf-dym-wrap { display: flex; align-items: center; gap: 8px; margin-top: 28px; padding: 14px 16px; border-radius: 8px; background: var(--lr-card); border: 1px solid rgba(200,200,222,.16); transition: border-color .15s; }
  .nf-dym-wrap:hover { border-color: var(--lr-orange); }
  .dym { display: flex; align-items: center; gap: 18px; flex: 1; min-width: 0; color: var(--lr-text); text-decoration: none; }
  .dym-eb { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-orange); white-space: nowrap; }
  .dym-ph { position: relative; width: 120px; height: 68px; flex: none; border-radius: 5px; overflow: hidden; background: var(--lr-raised); }
  .dym-ph :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dym-ph :global(.ph-bg) { filter: grayscale(.4) brightness(.7); }
  .dym-ph :global(.ph-logo) { inset: 18%; width: 64%; height: 64%; object-fit: contain; filter: brightness(0) invert(1); opacity: var(--lr-logo-ph); }
  .dym-t { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .dym-t small { display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--lr-muted); }
  .dym-t small :global(img) { width: 14px; height: 14px; object-fit: contain; filter: brightness(0) invert(1); opacity: var(--lr-logo-info); }
  .dym-t b { font-size: 19px; }
  .dym-tm { display: none; }
  .dym-op { text-decoration: none; flex: none; height: 40px; padding: 0 16px; border-radius: 6px; border: 1px solid rgba(255,149,90,.6); background: rgba(255,149,90,.1); color: var(--lr-orange); font-size: 14px; font-weight: 700; display: inline-flex; align-items: center; white-space: nowrap; }
  .dym-ch { display: flex; gap: 8px; margin-left: auto; }
  .dym-ch:empty + .dym-op { margin-left: auto; }
  .dym-ch :global(a) { height: 34px; padding: 0 12px; border-radius: 999px; border: 1px solid rgba(200,200,222,.24); display: inline-flex; align-items: center; font-size: 13px; color: #E4E4EC; white-space: nowrap; text-decoration: none; }
  .dym-ch :global(a:hover) { border-color: var(--lr-pink); }
  .dym-ch :global(small) { display: none; }

  /* ---- tiles ---- */
  .nft { padding-top: 32px; padding-bottom: 56px; }
  .nft h2 { margin: 0; font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--lr-muted); }
  .g4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 14px; }
  .g4 a { position: relative; display: flex; flex-direction: column; border-radius: 8px; overflow: hidden; background: var(--lr-card); border: 1px solid rgba(200,200,222,.16); color: var(--lr-text); text-decoration: none; transition: border-color .15s; }
  .g4 a:hover { border-color: var(--lr-orange); }
  .g4 img { width: 100%; height: auto; aspect-ratio: 16 / 8; object-fit: cover; display: block; }
  .g4 .b { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 4px; }
  .g4-h { font-size: 22px; line-height: 1.05; }
  .g4-p { font-size: 13px; color: #B4B4C2; line-height: 1.5; min-height: 39px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .g4 .go { margin-top: 6px; font-size: 13px; font-weight: 700; color: var(--lr-orange); }
  .g4-arrow { display: none; }
  .rep { margin: 28px 0 0; font-size: 14px; color: var(--lr-muted); }
  .rep a { color: var(--lr-text); text-decoration: underline; text-underline-offset: 3px; }

  /* Discord band (same look as home) */
  .dband { background: var(--lr-brand-gradient); }
  .dband-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding-top: 56px; padding-bottom: 56px; }
  .dband-copy { display: flex; flex-direction: column; gap: 8px; max-width: 720px; }
  .dband-title { margin: 0; font-size: 30px; }
  .dband-text { margin: 0; font-size: 15px; line-height: 1.5; color: rgba(255,255,255,.88); }
  .dband-more { align-self: flex-start; margin-top: 4px; font-size: 14px; font-weight: 600; color: #fff; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255,255,255,.5); }
  .dband-more:hover { text-decoration-color: #fff; }
  .dband-btn { background: var(--lr-text); color: var(--lr-discord); flex: none; }
  .dband-btn:hover { background: #fff; color: var(--lr-discord); }
  .dband-btn svg { width: 20px; height: 20px; fill: currentColor; flex: none; } /* white button, logo + text blurple (Fausto 20.10.) */
  :global(main:has(.dband) + .site-foot) { margin-top: 0; }

  @media (max-width: 1100px) {
    .g4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .nf-tl { gap: 12px; }
    .nf-code { font-size: 56px; }
    .nf-srch { flex-direction: column; }
    .nf-f { flex: none; }
    .nf-home { justify-content: center; }
    /* did you mean: card + rows (NotFoundMobile) */
    .nf-dym-wrap { flex-direction: column; align-items: stretch; gap: 0; padding: 0; margin-top: 18px; }
    .dym { flex-wrap: wrap; gap: 6px 14px; padding: 14px 14px 12px; }
    .dym-eb { flex-basis: 100%; }
    .dym-ph { width: 108px; height: 60px; }
    .dym-t { flex: 1; }
    .dym-op { display: none; }
    .dym-tm { display: block; margin-top: 2px; font-size: 13px; font-weight: 700; color: var(--lr-orange); }
    .dym-ch { flex-direction: column; gap: 0; margin-left: 0; border-top: 1px solid var(--lr-line); }
    .dym-ch :global(a) { height: auto; justify-content: space-between; padding: 10px 14px; border: 0; border-radius: 0; font-size: 15px; }
    .dym-ch :global(a + a) { padding-top: 0; }
    .dym-ch :global(small) { display: inline; color: var(--lr-muted); font-size: 14px; }
    .dym-ch:empty { display: none; }
    /* tiles as rows */
    .nft { padding-top: 24px; padding-bottom: 48px; }
    .g4 { grid-template-columns: 1fr; gap: 10px; }
    .g4 a { flex-direction: row; align-items: center; }
    .g4 a { align-items: stretch; min-height: 96px; }
    .g4 img { width: 104px; height: 0; min-height: 100%; aspect-ratio: auto; flex: none; }
    .g4-arrow { align-self: center; }
    .g4 .b { flex: 1; min-width: 0; padding: 14px 8px 14px 14px; gap: 2px; }
    .g4-h { font-size: 19px; }
    .g4-p { -webkit-line-clamp: 3; min-height: 0; }
    .g4 .go { display: none; }
    .g4-arrow { display: inline-flex; flex: none; margin-right: 14px; color: var(--lr-orange); }
    .g4-arrow :global(svg) { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .rep { margin-top: 18px; }
    .dband-inner { flex-direction: column; align-items: stretch; gap: 18px; padding-top: 36px; padding-bottom: 36px; }
    .dband-title { font-size: 24px; }
    .dband-btn { width: 100%; justify-content: center; }
  }
</style>
