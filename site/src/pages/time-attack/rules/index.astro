---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import TimeAttackSubnav from '../../../components/TimeAttackSubnav.astro';
const base = import.meta.env.BASE_URL;

const submitSteps = [
  'Set your fastest lap at Gellhorn International Raceway.',
  'Save a screenshot of the results screen. Record the full, uncut lap for Video Verified status.',
  'Open Submit a Lap, upload the screenshot, and add a YouTube link if you want video verification.',
  'Screenshot entries join the leaderboard as Not Video Verified. Submitted videos are reviewed for Video Verified status.',
];
---
<Base
  title="GTA VI Time Attack Rules & Video Verification"
  description="Learn how GTA 6 lap submissions are reviewed, what evidence you need, and how video verification and official records work."
  section="time-attack"
  breadcrumbs={[{ name: 'Gellhorn International Raceway', path: 'time-attack/gellhorn-international-raceway/' }, { name: 'Rules & Verification', path: 'time-attack/rules/' }]}
>
  <PageHero status="time-attack" image="gellhorn" eyebrow="GTA VI Time Attack" title="Rules & Verification" lede="Submit your time with a results screenshot. Add a full, uncut lap video for Video Verified status. Here’s how submissions, verification, and official records work." />
  <TimeAttackSubnav active="rules" />

  <section class="tiers">
    <div class="wrap tiers-grid">
      <div class="tier-card panel">
        <p class="eyebrow eyebrow-muted">Evidence Path</p>
        <h2 class="tier-title">Screenshot Entry</h2>
        <p class="tier-copy">Submit a screenshot of the results screen to add your time to the leaderboard.</p>
        <ul class="tier-list">
          <li>Listed under <strong>All Times</strong></li>
          <li>Marked <strong>Not Video Verified</strong></li>
          <li>Not eligible to set an <strong>Official Record</strong></li>
        </ul>
      </div>
      <div class="tier-card panel tier-card-highlight">
        <p class="eyebrow">Evidence Path</p>
        <h2 class="tier-title">Video Verification</h2>
        <p class="tier-copy">Upload the full, uncut lap to YouTube and add the link to your submission.</p>
        <ul class="tier-list">
          <li>Marked <strong>Video Verified</strong> once approved</li>
          <li>Included under <strong>All Times</strong> and <strong>Verified Only</strong></li>
          <li>Eligible to set an <strong>Official Record</strong></li>
          <li>Video link shown publicly with your leaderboard entry</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="process">
    <div class="wrap">
      <p class="eyebrow eyebrow-muted">How to submit</p>
      <ol class="process-line">
        {submitSteps.map((s, i) => (
          <li><span class="process-n">{i + 1}</span>{s}</li>
        ))}
      </ol>
      <p class="privacy-line">Your screenshot is private — only you and moderators ever see it. If you link a video, only the public link is shown; we never host or re-upload your footage. Full details on the <a href={`${base}privacy/`}>Privacy page</a>.</p>
    </div>
  </section>

  <section class="details">
    <div class="wrap details-list">
      <details class="detail">
        <summary>Valid Lap <span class="badge">Draft</span></summary>
        <div class="detail-body">
          <p>A lap is expected to count when it's a single clean run — no crashes, no exploited glitches, no editing or splicing — that matches the vehicle, category and Standard version you submitted it under. Anything that looks inconsistent gets flagged for a manual look before it's accepted.</p>
          <p>We haven't been able to test any of this against real Gellhorn gameplay yet, so the specifics stay in draft until after launch and hands-on testing.</p>
        </div>
      </details>
      <details class="detail">
        <summary>Status &amp; Review</summary>
        <div class="detail-body">
          <p>Every submission goes through an automatic check first, then either publishes or waits for a moderator. A run only becomes <strong>Video verified</strong> and <strong>Official</strong> once a person has watched the full, unedited lap video — a moderator glancing at just your screenshot never counts as verification.</p>
          <p>Some runs get a video requested even without a rule violation — an unusually large jump over the current record, a mismatch between the evidence and the conditions you entered, or anything a moderator flags for a second look.</p>
        </div>
      </details>
      <details class="detail">
        <summary>Privacy &amp; Evidence</summary>
        <div class="detail-body">
          <p>Screenshots you upload are stored privately for review — they're never shown publicly, to other drivers, or on your run's page. A video only becomes public if you choose to link one, and even then we link out to it rather than hosting a copy ourselves.</p>
          <p>See the <a href={`${base}privacy/`}>Privacy page</a> for how your data is stored and how to request a correction or removal.</p>
        </div>
      </details>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap cta-row">
      <div>
        <h2 class="display cta-title">Set your lap</h2>
        <p class="cta-copy">Not sure where to start? <a href={`${base}time-attack/how-it-works/`}>How It Works</a> walks through the whole path.</p>
      </div>
      <a class="btn btn-red" href={`${base}time-attack/submit/`}>Submit a Lap</a>
    </div>
  </section>
</Base>

<style>

  .eyebrow-muted { color: var(--gh-muted); }

  .tiers { padding-bottom: var(--gh-gap-section); }
  .tiers-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .tier-card { padding: clamp(1.5rem, 2.6vw, 2.1rem); }
  .tier-card-highlight { border-color: var(--gh-yellow); background: rgba(255,149,90,.06); }
  .tier-title { margin: .6rem 0 .6rem; font-size: 1.4rem; }
  .tier-copy { margin: 0 0 1.1rem; color: var(--gh-muted); font-size: .92rem; }
  .tier-list { margin: 0; padding-left: 1.1rem; color: var(--gh-text); font-size: .9rem; line-height: 1.7; }
  .tier-list li { margin-bottom: .3rem; }
  .tier-list li:last-child { margin-bottom: 0; }

  .process { padding-bottom: var(--gh-gap-section); }
  .process-line { list-style: none; margin: .8rem 0 1.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; }
  .process-line li { display: flex; align-items: center; gap: .6rem; color: var(--gh-text); font-size: .92rem; }
  .process-n { display: inline-flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; border: 1px solid var(--gh-line); color: var(--gh-yellow); font-size: .78rem; font-weight: 700; flex: none; }
  .privacy-line { margin: 0; max-width: 60ch; color: var(--gh-muted); font-size: .88rem; }
  .privacy-line a { color: var(--gh-yellow); }

  .details { padding-bottom: var(--gh-gap-section); }
  .details-list { display: flex; flex-direction: column; gap: .75rem; max-width: 52rem; }
  .detail { border: 1px solid var(--gh-line); border-radius: var(--gh-radius); padding: 1rem 1.25rem; background: var(--gh-surface-soft); }
  .detail summary { cursor: pointer; font-weight: 700; font-size: .95rem; display: flex; align-items: center; gap: .6rem; list-style: none; }
  .detail summary::-webkit-details-marker { display: none; }
  .detail summary::before { content: '+'; color: var(--gh-yellow); font-size: 1.1rem; width: 1rem; }
  .detail[open] summary::before { content: '−'; }
  .detail .badge { margin-top: 0; }
  .detail-body { margin-top: .9rem; color: var(--gh-muted); font-size: .9rem; line-height: 1.6; }
  .detail-body p { margin: 0 0 .8rem; }
  .detail-body p:last-child { margin-bottom: 0; }
  .detail-body a { color: var(--gh-yellow); }

  .cta-band { padding-block: var(--gh-gap-section); border-top: 1px solid var(--gh-line); background: var(--gh-surface-soft); }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; }
  .cta-title { margin: 0 0 .5rem; font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .cta-copy { margin: 0; max-width: 42ch; color: var(--gh-muted); font-size: .95rem; }
  .cta-copy a { color: var(--gh-yellow); }

  @media (max-width: 760px) {
    .tiers-grid { grid-template-columns: 1fr; }
  }
</style>
