---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import TimeAttackSubnav from '../../../components/TimeAttackSubnav.astro';
const base = import.meta.env.BASE_URL;

const steps = [
  {
    n: '01',
    title: 'Drive Your Lap',
    copy: 'Put down your best time at Gellhorn International Raceway.',
    icon: 'M12 2 2 7l10 5 10-5-10-5Z M2 17l10 5 10-5 M2 12l10 5 10-5',
  },
  {
    n: '02',
    title: 'Save Your Proof',
    copy: 'Save a screenshot of the results screen to list your time without video verification. Add a full, uncut lap video if you want the entry marked Video Verified.',
    icon: 'M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2Z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
  },
  {
    n: '03',
    title: 'Save It to Your Phone',
    copy: 'Open Captures in PlayStation App and download the results screenshot to your phone.',
    icon: 'M17 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Z M11 18h2',
  },
  {
    n: '04',
    title: 'Submit Your Lap',
    copy: 'Send us your results screenshot through Submit a Lap. For Video Verified status, upload the full lap to YouTube and add the link. It will appear publicly with your leaderboard entry.',
    icon: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M17 8l-5-5-5 5 M12 3v12',
  },
];
---
<Base
  title="How to Submit a Lap — GTA VI Time Attack"
  description="Learn how to submit a Gellhorn lap time with a results screenshot, add a full lap video, and follow your entry through review."
  section="time-attack"
  breadcrumbs={[{ name: 'Gellhorn International Raceway', path: 'time-attack/gellhorn-international-raceway/' }, { name: 'How It Works', path: 'time-attack/how-it-works/' }]}
>
  <PageHero status="time-attack" image="gellhorn" eyebrow="GTA VI Time Attack" title="How It Works" lede="From the track to the leaderboard in four steps. Set your fastest lap at Gellhorn International Raceway, save your proof, and send it in for review." />
  <TimeAttackSubnav active="how-it-works" />

  <section class="steps">
    <div class="wrap steps-grid">
      {steps.map((s) => (
        <div class="step panel">
          <div class="step-head">
            <span class="step-n">{s.n}</span>
            <svg class="step-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
          </div>
          <h2 class="step-title">{s.title}</h2>
          <p class="step-copy">{s.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap cta-row">
      <div>
        <h2 class="display cta-title">Ready to put a time on the board?</h2>
        <p class="cta-copy">Check the rules, then submit your lap.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-red" href={`${base}time-attack/submit/`}>Submit a Lap</a>
        <a class="btn btn-outline" href={`${base}time-attack/rules/`}>Read the Rules</a>
      </div>
    </div>
  </section>
</Base>

<style>

  .steps { padding-bottom: var(--gh-gap-section); }
  .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .step { padding: var(--gh-pad-card); display: flex; flex-direction: column; gap: .9rem; }
  .step-head { display: flex; align-items: center; justify-content: space-between; }
  .step-n { font-family: var(--gh-font-display); font-weight: 900; font-size: 1.6rem; color: var(--gh-line); }
  .step-icon { color: var(--gh-yellow); flex: none; }
  .step-title { margin: 0; font-size: 1.05rem; }
  .step-copy { margin: 0; color: var(--gh-muted); font-size: .9rem; line-height: 1.5; }

  .cta-band { padding-block: var(--gh-gap-section); border-top: 1px solid var(--gh-line); background: var(--gh-surface-soft); }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; }
  .cta-title { margin: 0 0 .5rem; font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .cta-copy { margin: 0; max-width: 42ch; color: var(--gh-muted); font-size: .95rem; }
  .cta-actions { display: flex; gap: .75rem; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .steps-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .steps-grid { grid-template-columns: 1fr; }
  }
</style>
