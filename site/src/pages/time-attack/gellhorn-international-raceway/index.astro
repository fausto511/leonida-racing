---
// Time Attack / Gellhorn -- Redesign (DEC-0119, boards TimeAttack / TimeAttackActive / TimeAttackMobile):
// image band with record tile (guest) / own best (logged in, set by Leaderboard.astro), no sub-nav,
// leaderboard, "No lap yet" + "Put a time on the board", About Gellhorn with facts, three cards.
// COPY STATUS: placeholders from the mockup until the Codex review (DEC-0088).
import Base from '../../../layouts/Base.astro';
import Leaderboard from '../../../components/Leaderboard.astro';
import { sampleEntries, trackStats, recordWhoHtml, lapTime } from '../../../data/leaderboard';
const base = import.meta.env.BASE_URL;
const st = trackStats(sampleEntries, sampleEntries);
const fmt = (n: number) => n.toLocaleString('en-US');
const stopwatch = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg>';
const DRIVE = 'https://www.thedrive.com/news/theres-convincing-evidence-that-sebring-raceway-will-be-in-grand-theft-auto-6';
const JALOPNIK = 'https://www.jalopnik.com/2246099/gta-6-race-track-new-details/';
// FAQ copy: Codex 25.10.2026 (Gellhorn-Seitentexte). "Where" and "How long" held back until measured (DEC-0181).
const faq = [
  { q: 'Is there a race track in GTA 6?', a: 'Yes. Rockstar’s Extended Look shows cars racing on a paved circuit, with lap information, a timer, and a position display.' },
  { q: 'Is Gellhorn International Raceway the official name?', a: 'It is the established name we use for the circuit. Rockstar’s footage separately shows the race track and “Gellhorn International” racing branding, but does not display the complete venue name alongside the circuit.' },
  { q: 'Is Gellhorn International Raceway based on Sebring?', a: 'Sebring is a rumored inspiration. The Drive and Jalopnik have discussed the comparison, but it has not been confirmed by Rockstar in the official material reviewed for this guide. Parts of that discussion rely on leaked maps. That does not establish that Gellhorn copies Sebring’s layout, length, or corners.',
    aHtml: `Sebring is a rumored inspiration. <a href="${DRIVE}" rel="noopener">The Drive</a> and <a href="${JALOPNIK}" rel="noopener">Jalopnik</a> have discussed the comparison, but it has not been confirmed by Rockstar in the official material reviewed for this guide. Parts of that discussion rely on leaked maps. That does not establish that Gellhorn copies Sebring’s layout, length, or corners.` },
  { q: 'What cars are best for Gellhorn?', a: 'Check the Gellhorn reference-lap rankings to compare cars, and the Time Attack leaderboard to see driver results. Compare the same tuning category and read the test notes before treating two times as equivalent. A reference lap is not a guarantee of your own result.',
    aHtml: `Check the <a href="${base}cars/rankings/gellhorn-lap/">Gellhorn reference-lap rankings</a> to compare cars, and the <a href="#leaderboard">Time Attack leaderboard</a> to see driver results. Compare the same tuning category and read the test notes before treating two times as equivalent. A reference lap is not a guarantee of your own result.` },
  { q: 'How do I submit a Gellhorn lap?', a: 'Use Submit a lap and follow the Time Attack rules for your entry and evidence. Video verification is shown separately from acceptance onto the leaderboard.',
    aHtml: `Use <a href="${base}time-attack/submit/">Submit a lap</a> and follow the <a href="${base}time-attack/how-it-works/#rules">Time Attack rules</a> for your entry and evidence. Video verification is shown separately from acceptance onto the leaderboard.` },
  { q: 'Is Leonida Racing’s leaderboard an official Rockstar ranking?', a: 'No. It is a community leaderboard run by Leonida Racing. Our submission rules and verification labels describe our own competition.' },
];
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
const trophy = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg>';
---
<Base
  title="Gellhorn International Raceway — GTA 6 Race Track"
  description="Explore the GTA 6 race track known as Gellhorn International Raceway, compare Time Attack lap times, and find the rules for submitting your own lap."
  jsonLd={jsonLd}
  section="time-attack"
  breadcrumbs={[{ name: 'Gellhorn International Raceway', path: 'time-attack/gellhorn-international-raceway/' }]}
>
  <section class="ta-band">
    <img class="ta-bg" src={`${base}images/gellhorn-raceway-1080.webp`} srcset={`${base}images/gellhorn-raceway-640.webp 640w, ${base}images/gellhorn-raceway-1080.webp 1080w, ${base}images/gellhorn-raceway-1672.webp 1672w`} sizes="100vw" alt="" width="1672" height="941" fetchpriority="high" />
    <span class="ta-o ta-o1" aria-hidden="true"></span><span class="ta-o ta-o2" aria-hidden="true"></span><span class="ta-o ta-o3" aria-hidden="true"></span>
    <div class="wrap ta-hero">
      <div>
        <p class="eyebrow">GTA VI Time Attack</p>
        <h1 class="display">Gellhorn International<br />Raceway</h1>
        <p class="lede">Set your fastest lap, submit your proof, and see where you rank. Outpace your next rival, move up the leaderboard, or put your favorite car on the board.</p>
        <div class="ta-cta">
          <a href={`${base}time-attack/submit/`} class="btn btn-p"><Fragment set:html={stopwatch} />Submit a lap</a>
          <a href={`${base}time-attack/how-it-works/`} class="btn btn-s ta-how">How it works</a>
        </div>
      </div>
      <div class="ta-tile" id="ta-tile" aria-live="polite">
        <div class="eb"><Fragment set:html={trophy} />Track record<span class="smp" data-sample>Sample</span></div>
        <div class="big" data-rec>{st.rec ? lapTime(st.rec.lap_time_ms) : '—'}</div>
        <div class="who" data-who set:html={recordWhoHtml(st.rec)} />
        <div class="row3">
          <div><b data-drivers>{fmt(st.drivers)}</b><span>Drivers</span></div>
          <div><b data-laps>{fmt(st.laps)}</b><span>Laps</span></div>
          <div><b data-cars>{fmt(st.cars)}</b><span>Cars</span></div>
        </div>
      </div>
    </div>
  </section>

  <Leaderboard />

  <section class="wrap ta-sec" id="track">
    <p class="eyebrow">The track</p>
    <h2 class="lr-h2 display">About Gellhorn</h2>
    <div class="track">
      <div class="img">
        <img src={`${base}images/gellhorn-raceway-1080.webp`} srcset={`${base}images/gellhorn-raceway-640.webp 640w, ${base}images/gellhorn-raceway-1080.webp 1080w, ${base}images/gellhorn-raceway-1672.webp 1672w`} sizes="(max-width: 760px) 100vw, 55vw" alt="Palm-lined race track straight with blue and red curbs in GTA VI" width="1080" height="608" loading="lazy" />
      </div>
      <div class="card txt">
        <p>Gellhorn International Raceway is the circuit at the center of Leonida Racing’s GTA VI Time Attack. Bring your favorite car, put a clean lap together, and give the next driver something to chase. Accepted laps follow our submission rules, with video verification shown separately.</p>
        <p>Rockstar’s Extended Look shows cars racing on a paved circuit with curbing and a racing HUD: lap information, a timer, and a position display. This is a dedicated motorsport circuit built by Rockstar, not a route laid out on public roads. There’s a grid to race against and a clock to watch. For anyone who enjoys chasing a personal best, that’s a good reason to pay attention.</p>
        <p>The name needs one distinction. Trailer 2 shows Lucia wearing “Gellhorn International” racing branding. The circuit footage does not display the full venue name beside the track. We use the established name Gellhorn International Raceway, while keeping those two pieces of official footage separate in our source notes.</p>
        <p>Sebring International Raceway comes up as a possible inspiration in coverage by <a href={DRIVE} rel="noopener">The Drive</a> and <a href={JALOPNIK} rel="noopener">Jalopnik</a>. That comparison remains unconfirmed, and parts of the discussion rely on leaked maps rather than official footage. It is a theory about the inspiration, not proof of a replica.</p>
        <p>Use the leaderboard to compare driver laps, then check the <a href={`${base}cars/rankings/gellhorn-lap/`}>car rankings</a> for Gellhorn reference times. Your favorite build still has to earn its time on the board.</p>
        <dl class="facts">
          <div><dt>Length</dt><dd class="p">Not measured</dd></div>
          <div><dt>Corners</dt><dd class="p">Not measured</dd></div>
          <div><dt>Track record</dt><dd id="ta-fact-rec">No record yet</dd></div>
        </dl>
      </div>
    </div>
    <div class="ta-3">
      <div class="card">
        <span class="pill"><i class="lime"></i>Rules</span>
        <h3>Screenshot or video?</h3>
        <p><b>Screenshot:</b> your lap is listed as Not video verified and can’t set an official record. <b>Full, uncut video:</b> if a moderator verifies the lap, it is listed as Video verified and is eligible for an official record.</p>
        <a href={`${base}time-attack/how-it-works/#rules`} class="arrow lk">Read the rules →</a>
      </div>
      <div class="card">
        <span class="pill"><i></i>After launch</span>
        <h3>Track guide</h3>
        <p>Braking points, racing lines and common mistakes, section by section. Goes up once we have driven Gellhorn ourselves.</p>
        <span class="arrow lk off">Coming after launch</span>
      </div>
      <div class="card">
        <span class="pill"><i class="pink"></i>Cars</span>
        <h3>Find a car for Gellhorn</h3>
        <p>Browse the cars, compare available specs and lap times, and pick your next Gellhorn entry.</p>
        <a href={`${base}cars/`} class="arrow lk">Browse cars →</a>
      </div>
    </div>
  </section>

  <section class="wrap ta-sec" id="faq" aria-labelledby="faq-h">
    <p class="eyebrow">FAQ</p>
    <h2 class="lr-h2 display" id="faq-h">GTA VI race track FAQ</h2>
    <div class="gf-faq card">
      {faq.map((f) => (
        <details>
          <summary><h3>{f.q}</h3><span class="gf-faq-i" aria-hidden="true"></span></summary>
          <p set:html={f.aHtml ?? f.a} />
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  /* ---- image band (same build as the 404 / class pages) ---- */
  .ta-band { position: relative; overflow: hidden; border-bottom: 1px solid var(--lr-line); }
  .ta-bg, .ta-o { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ta-bg { object-fit: cover; object-position: 50% 60%; }
  .ta-o1 { background: linear-gradient(115deg, rgba(242,75,157,.75) 0%, rgba(242,75,157,.2) 42%, rgba(255,149,90,.2) 58%, rgba(255,149,90,.75) 100%); mix-blend-mode: color; }
  .ta-o2 { background: linear-gradient(90deg, rgba(11,11,20,.9) 0%, rgba(11,11,20,.55) 55%, rgba(11,11,20,.35) 100%); }
  .ta-o3 { background: linear-gradient(180deg, rgba(11,11,20,0) 55%, rgba(11,11,20,.8) 100%); }
  .ta-hero { position: relative; display: grid; grid-template-columns: minmax(0,1fr) 400px; gap: 40px; align-items: end; padding-top: 56px; padding-bottom: 40px; }
  .ta-hero h1 { margin: 12px 0 0; font-size: 64px; line-height: .95; }
  .lede { margin: 16px 0 0; font-size: 17px; line-height: 1.55; color: var(--lr-text); max-width: 600px; text-shadow: 0 1px 12px rgba(11,11,20,.9); }
  .ta-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  .ta-how { background: var(--lr-dark-60); }
  .ta-tile { background: rgba(20,20,31,.88); backdrop-filter: blur(8px); border: 1px solid var(--lr-line); border-radius: 8px; padding: 18px; }
  .ta-tile :global(.eb) { font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-orange); display: flex; align-items: center; gap: 8px; }
  .smp { margin-left: auto; color: var(--lr-muted); letter-spacing: .12em; }
  .smp[hidden] { display: none; }
  .ta-tile :global(.big) { font-family: 'Archivo', sans-serif; font-variation-settings: 'wdth' 112; font-weight: 800; font-size: 34px; line-height: 1; margin-top: 10px; font-variant-numeric: tabular-nums; }
  .ta-tile :global(.who) { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin-top: 8px; font-size: 14px; color: var(--lr-soft); }
  .ta-tile :global(.who b) { color: var(--lr-text); font-weight: 600; }
  .ta-tile :global(.lb-crew-tag) { text-decoration: none; color: var(--lr-bg); }
  .ta-tile :global(.row3) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--lr-line); }
  .ta-tile :global(.row3 div) { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .ta-tile :global(.row3 b) { font-size: 18px; font-variant-numeric: tabular-nums; }
  .ta-tile :global(.row3 span) { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--lr-muted); }
  .ta-tile :global(.tgt) { display: flex; gap: 8px; align-items: flex-start; margin-top: 14px; padding: 12px; border-radius: 6px; background: var(--lr-pink-fill); border: 1px solid var(--lr-pink-border); font-size: 14px; line-height: 1.45; }
  .ta-tile :global(.tgt svg) { flex: none; margin-top: 3px; color: var(--lr-pink); }
  .ta-tile :global(.tgt b) { color: var(--lr-pink); }

  /* ---- track ---- */
  .ta-sec { padding-top: var(--lr-gap-sec); }
  .ta-sec > .eyebrow { display: flex; width: fit-content; margin: 0; }
  .ta-sec h2 { margin: 8px 0 0; } /* label -> H2: 8px (DEC-0168) */
  .track { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,1fr); gap: 20px; margin-top: 20px; align-items: stretch; }
  .track .img { position: relative; border-radius: 8px; overflow: hidden; min-height: 340px; }
  .track .img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .track .txt { padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .track .txt p { margin: 0; font-size: 16px; line-height: 1.65; color: var(--lr-text); }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 10px; margin: auto 0 0; }
  .facts div { background: var(--lr-raised); border-radius: 6px; padding: 12px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .facts dt { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--lr-muted); }
  .facts dd { margin: 0; font-size: 15px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .facts dd.p { color: var(--lr-muted); font-weight: 500; font-size: 13px; }
  .ta-3 { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 20px; margin-top: 20px; }
  .ta-3 .card { padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .ta-3 h3 { margin: 0; font-size: var(--lr-h3); font-weight: 700; }
  .ta-3 p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--lr-soft); }
  .ta-3 p b { color: var(--lr-text); }
  .track .txt a, .gf-faq p :global(a) { color: var(--lr-orange); }
  .gf-faq { margin-top: 20px; padding: 0; }
  .gf-faq details + details { border-top: 1px solid var(--lr-line); }
  .gf-faq summary { display: flex; align-items: center; gap: 16px; padding: 16px 18px; cursor: pointer; list-style: none; }
  .gf-faq summary::-webkit-details-marker { display: none; }
  .gf-faq summary:hover h3 { color: var(--lr-orange); }
  .gf-faq h3 { flex: 1; margin: 0; font-size: var(--lr-h3-xs); font-weight: 700; line-height: 1.4; }
  .gf-faq-i { position: relative; flex: none; width: 14px; height: 14px; }
  .gf-faq-i::before, .gf-faq-i::after { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; border-radius: 1px; background: var(--lr-muted); transition: transform .15s; }
  .gf-faq-i::after { transform: rotate(90deg); }
  .gf-faq details[open] .gf-faq-i::after { transform: rotate(0); }
  .gf-faq p { margin: -4px 0 0; padding: 0 18px 18px; font-size: 15px; line-height: 1.65; color: var(--lr-soft); }
  .lk { margin-top: auto; } /* style = .arrow (DEC-0170) */
  .lk.off { color: var(--lr-muted); }
  .pill { align-self: flex-start; height: 24px; padding: 0 9px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: .06em; display: inline-flex; align-items: center; gap: 6px; background: var(--lr-raised); color: var(--lr-soft); }
  .pill i { width: 7px; height: 7px; border-radius: 999px; background: var(--lr-orange); }
  .pill i.lime { background: var(--lr-lime); }
  .pill i.pink { background: var(--lr-pink); }

  @media (max-width: 1100px) {
    .ta-hero { grid-template-columns: minmax(0,1fr) 340px; gap: 28px; }
    .ta-hero h1 { font-size: 52px; }
  }
  @media (max-width: 860px) {
    .ta-hero { grid-template-columns: 1fr; gap: 20px; padding-top: 28px; padding-bottom: 24px; }
    .ta-hero h1 { font-size: 38px; }
    .lede { font-size: 16px; }
    .ta-cta { display: grid; grid-template-columns: 1fr 1fr; }
    .track { grid-template-columns: 1fr; }
    .track .img { min-height: 0; aspect-ratio: 16 / 9; }
    .ta-3 { grid-template-columns: 1fr; gap: 14px; }
  }
  @media (max-width: 420px) {
    .ta-hero h1 { font-size: 34px; }
    .track .txt { padding: 18px; }
    .facts { gap: 8px; }
    .facts div { padding: 10px; }
  }
</style>
