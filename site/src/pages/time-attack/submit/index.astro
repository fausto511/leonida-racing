---
// Submit a Lap (redesign 19.10.2026, DEC-0141): three-step wizard
// 1 Proof (screenshot and/or YouTube link, PS5 notice) -> 2 Your lap (PSN name,
// car search, lap time) -> 3 Check & submit (summary, leaderboard name Discord/PSN).
// Backend contract unchanged (submit-lap v7: >= 1 evidence item, vehicle_id + lap_time_ms required).
// All new UI copy = Claude placeholders (Codex, DEC-0088).
import Base from '../../../layouts/Base.astro';
import { vehicleOptions } from '../../../data/vehicles';
import { PLATFORMS } from '../../../data/platforms';

const base = import.meta.env.BASE_URL;
const active = PLATFORMS.find((p) => p.active)!;
const later = PLATFORMS.filter((p) => !p.active).map((p) => p.label.replace(' Series X|S', '')).join(' and ');
const vehicles = [...vehicleOptions]
  .sort((a, b) => a.make.localeCompare(b.make) || a.model.localeCompare(b.model))
  .map((v) => ({ id: v.id, make: v.make, model: v.model, logo: v.logoSlug ? `${base}images/logos/${v.logoSlug}-gta-6-logo.webp` : '' }));
const check = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
---
<Base
  title="Submit a Lap — GTA VI Time Attack"
  description="Submit your Gellhorn International Raceway lap time with a results screenshot or a full lap video."
  section="time-attack"
  noindex={true /* until laps can be submitted on launch day (RS-0050) */}
  breadcrumbs={[{ name: 'Time Attack', path: 'time-attack/gellhorn-international-raceway/' }, { name: 'Submit a Lap', path: 'time-attack/submit/' }]}
>
  <section class="sb-band">
    <div class="wrap lr-band-in sb-band-in">
      <nav class="lr-crumb" aria-label="Breadcrumb"><a href={`${base}time-attack/gellhorn-international-raceway/`}>Time Attack</a><span aria-hidden="true">/</span><span aria-current="page">Submit a lap</span></nav>
      <p class="eyebrow">Gellhorn International Raceway</p>
      <h1 class="display lr-t2">Submit a lap</h1>
    </div>
  </section>

  <div class="wrap sb-layout">
    <div class="sb-main">
      <div id="backend-notice" class="sb-notice" hidden>
        <strong>Backend not connected in this build.</strong> You can click through the form; nothing is sent.
      </div>

      <!-- Guest -->
      <div id="sb-guest" class="card sb-guest" hidden>
        <p class="sb-eb">Takes under a minute</p>
        <h2 class="sb-h2">Log in, then three short steps</h2>
        <ol class="sb-steps-preview">
          <li><b>1</b><span><strong>Proof</strong>Screenshot of the results screen or a YouTube link of your lap.</span></li>
          <li><b>2</b><span><strong>Your lap</strong>PSN name, car and lap time.</span></li>
          <li><b>3</b><span><strong>Submit</strong>Check it once and send. A moderator reviews it.</span></li>
        </ol>
        <p class="sb-ps"><span class="sb-plat">PS5</span>PS5 only for now. {later} will follow.</p>
        <button type="button" id="discord-signin-btn" class="btn btn-primary sb-login">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 5.3A18 18 0 0 0 15.9 4l-.3.6a15 15 0 0 1 4 1.6 16 16 0 0 0-13.2 0 15 15 0 0 1 4-1.6L10.1 4a18 18 0 0 0-4.4 1.3C2.9 9 2.2 12.6 2.5 16.1a18 18 0 0 0 5.5 2.8l.8-1.3a11 11 0 0 1-1.9-.9l.5-.4a13 13 0 0 0 9.2 0l.5.4a11 11 0 0 1-1.9.9l.8 1.3a18 18 0 0 0 5.5-2.8c.4-4-.7-7.5-2.2-10.8ZM9.3 14c-.8 0-1.4-.7-1.4-1.6s.6-1.6 1.4-1.6 1.4.7 1.4 1.6-.6 1.6-1.4 1.6Zm5.4 0c-.8 0-1.4-.7-1.4-1.6s.6-1.6 1.4-1.6 1.4.7 1.4 1.6-.6 1.6-1.4 1.6Z"/></svg>
          Log in with Discord
        </button>
      </div>

      <!-- Wizard -->
      <form id="submit-form" class="sb-wiz" novalidate hidden>
        <div class="sb-prog" aria-hidden="true">
          <p class="sb-prog-t">Step <span id="sb-stepno">1</span> of 3</p>
          <ol class="sb-prog-bar">
            <li data-p="1"><i></i><span>Proof</span></li>
            <li data-p="2"><i></i><span>Your lap</span></li>
            <li data-p="3"><i></i><span>Submit</span></li>
          </ol>
        </div>

        <!-- Step 1: proof -->
        <fieldset class="sb-step" data-step="1">
          <legend class="sb-h2">Prove your lap</legend>
          <p class="sb-ps"><span class="sb-plat">{active.label}</span>{active.label} only for now. {later} will follow.</p>

          <div class="sb-proof">
            <div class="sb-box" id="tile-shot">
              <label class="dropzone" id="dropzone" for="screenshot">
                <input id="screenshot" name="screenshot" type="file" accept="image/*" class="sr-only" />
                <span class="dz-empty" id="dz-empty">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  <strong class="dz-title">Screenshot</strong>
                  <span class="dz-sub dz-touch">Tap to choose</span>
                  <span class="dz-sub dz-desk">Drop, click or paste</span>
                </span>
                <img id="dz-preview" class="dz-preview" alt="Preview of your results screenshot" hidden />
                <span class="dz-busy" id="dz-busy" hidden>Preparing image…</span>
                <span class="sb-ok" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>
              </label>
              <div class="dz-meta" id="dz-meta" hidden>
                <span id="dz-info"></span>
                <span class="dz-actions"><button type="button" class="link-btn" id="dz-replace">Replace</button><button type="button" class="link-btn" id="dz-remove">Remove</button></span>
              </div>
            </div>

            <div class="sb-box" id="tile-video">
              <div class="sb-vbox">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/></svg>
                <strong class="dz-title">Video</strong>
                <label class="dz-sub" for="video_url">Full lap on YouTube</label>
                <input id="video_url" name="video_url" type="url" inputmode="url" autocomplete="off" placeholder="Paste YouTube link" />
                <span class="sb-vok" id="vid-ok" hidden>YouTube link added</span>
                <span class="sb-ok" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>
              </div>
            </div>
          </div>
          <details class="sb-need" id="sb-need">
            <summary><span>What counts as proof?</span><i aria-hidden="true"></i></summary>
            <div class="sb-need-b">
              <div>
<svg class="sb-sketch" viewBox="0 0 300 168" role="img" aria-label="Sketch of a results screen: your row with PSN name, car and lap time is highlighted.">
                <rect x="1" y="1" width="298" height="166" rx="8" fill="#14141F" stroke="rgba(200,200,222,.25)"/>
                <text x="14" y="22" fill="#9C9CAB" font-size="9" font-weight="700" letter-spacing="1.5">RESULTS</text>
                <g font-size="10" fill="#B4B4C2">
                  <text x="14" y="48">1</text><rect x="30" y="41" width="70" height="8" rx="2" fill="rgba(200,200,222,.18)"/><rect x="120" y="41" width="80" height="8" rx="2" fill="rgba(200,200,222,.18)"/><rect x="236" y="41" width="48" height="8" rx="2" fill="rgba(200,200,222,.18)"/>
                  <text x="14" y="104">3</text><rect x="30" y="97" width="60" height="8" rx="2" fill="rgba(200,200,222,.18)"/><rect x="120" y="97" width="72" height="8" rx="2" fill="rgba(200,200,222,.18)"/><rect x="236" y="97" width="48" height="8" rx="2" fill="rgba(200,200,222,.18)"/>
                  <text x="14" y="130">4</text><rect x="30" y="123" width="76" height="8" rx="2" fill="rgba(200,200,222,.18)"/><rect x="120" y="123" width="66" height="8" rx="2" fill="rgba(200,200,222,.18)"/><rect x="236" y="123" width="48" height="8" rx="2" fill="rgba(200,200,222,.18)"/>
                </g>
                <rect x="6" y="62" width="288" height="26" rx="5" fill="rgba(255,149,90,.12)" stroke="#FF955A"/>
                <g font-size="10.5" font-weight="700" fill="#FBF7EA">
                  <text x="14" y="79">2</text><text x="30" y="79">Racer_01</text><text x="120" y="79">Your car</text><text x="236" y="79">1:24.683</text>
                </g>
                <g font-size="8.5" font-weight="700" fill="#FF955A" letter-spacing=".5">
                  <text x="30" y="160">PSN NAME</text><text x="120" y="160">CAR</text><text x="236" y="160">LAP TIME</text>
                </g>
                <g stroke="#FF955A" stroke-width="1" stroke-dasharray="2 2"><path d="M44 150V90M136 150V90M256 150V90"/></g>
              </svg>
              <p class="sb-need-cap">Sketch. The real GTA VI results screen will look different.</p>
              </div>
              <div>
              <ul class="sb-need-l">
                <li><strong>Screenshot:</strong> the results screen with your PSN name, car and lap time readable. Stored privately, never published.</li>
                <li><strong>On PS5:</strong> share the screenshot to the PlayStation App, save it to your phone, add it here.</li>
                <li><strong>Video:</strong> the full, uncut lap on YouTube. A moderator watches it before your time gets Video verified.</li>
              </ul>
              <a class="sb-need-a" href={`${base}time-attack/how-it-works/#rules`}>Rules and verification →</a>
              </div>
            </div>
          </details>
          <div class="sb-err" data-err="1" hidden></div>
          <div class="sb-foot">
            <span></span>
            <button type="button" class="btn btn-primary sb-next" data-next="1">Continue</button>
          </div>
        </fieldset>

        <!-- Step 2: your lap -->
        <fieldset class="sb-step" data-step="2" hidden>
          <legend class="sb-h2">Your lap</legend>
          <div class="sb-lap">
            <div class="sb-mini" id="mini-2"></div>
            <div class="sb-fields">
              <div class="field">
                <label class="field-label" for="psn_name">PSN name <span class="sb-lab-x">(as on the results screen)</span></label>
                <input id="psn_name" name="psn_name" type="text" maxlength="16" autocomplete="off" spellcheck="false" placeholder="e.g. Racer_01" />
                <p class="hint">So we can find you if more drivers are on the screenshot.</p>
              </div>
              <div class="field sb-combo" id="veh-combo">
                <label class="field-label" for="veh-q">Car</label>
                <div class="sb-combo-in">
                  <img id="veh-logo" alt="" width="24" height="24" hidden />
                  <input id="veh-q" type="text" role="combobox" aria-expanded="false" aria-controls="veh-list" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="Type to search, e.g. Zorrusso" />
                  <button type="button" class="sb-combo-x" id="veh-clear" aria-label="Clear car" hidden>×</button>
                </div>
                <input type="hidden" id="vehicle_id" name="vehicle_id" />
                <ul id="veh-list" class="sb-combo-list" role="listbox" hidden></ul>
                <p class="hint" id="veh-hint"></p>
              </div>
              <div class="field">
                <label class="field-label" for="lap_time">Lap time</label>
                <input id="lap_time" name="lap_time" type="text" inputmode="numeric" autocomplete="off" enterkeyhint="done" placeholder="1:24.683" />
                <p class="hint">Just type the digits: 124683 becomes 1:24.683.</p>
              </div>
            </div>
          </div>
          <div class="sb-err" data-err="2" hidden></div>
          <div class="sb-foot">
            <button type="button" class="btn btn-outline sb-back" data-back="2">Back</button>
            <button type="button" class="btn btn-primary sb-next" data-next="2">Continue</button>
          </div>
        </fieldset>

        <!-- Step 3: check & submit -->
        <fieldset class="sb-step" data-step="3" hidden>
          <legend class="sb-h2">Check and submit</legend>
          <div class="sb-sum">
            <div class="sb-mini" id="mini-3"></div>
            <dl class="sb-sum-list" id="sum-list"></dl>
          </div>
          <div class="sb-name">
            <p class="field-label" id="name-label">Shown on the leaderboard as</p>
            <div class="sb-name-opts" role="radiogroup" aria-labelledby="name-label" id="name-opts"></div>
          </div>
          <div class="sb-err" data-err="3" hidden></div>
          <div class="sb-foot">
            <button type="button" class="btn btn-outline sb-back" data-back="3">Back</button>
            <button type="submit" class="btn btn-primary sb-submit" id="submit-btn"><span id="submit-label">Submit lap</span></button>
          </div>
        </fieldset>
      </form>

      <!-- Success -->
      <div id="form-success" class="card sb-done" hidden>
        <span class="sb-done-i" set:html={check} />
        <p class="sb-eb">In review</p>
        <h2 class="sb-h2">Lap submitted</h2>
        <p id="success-text" class="sb-done-t"></p>
        <p id="success-rank" class="sb-done-rank" hidden></p>
        <div class="sb-done-a">
          <button type="button" class="btn btn-primary" id="submit-another">Submit another lap</button>
          <a class="btn btn-outline" href={`${base}time-attack/gellhorn-international-raceway/`}>Leaderboard</a>
          <a class="btn btn-outline" href={`${base}account/`}>My laps</a>
        </div>
      </div>
    </div>

    <!-- What we need -->
  </div>

  <script type="application/json" id="veh-data" set:html={JSON.stringify(vehicles)} />
</Base>

<style>
  [hidden] { display: none !important; }
  /* ---- band: "without image" variant (DEC-0139) ---- */
  .sb-band { border-bottom: 1px solid var(--lr-line); background: linear-gradient(180deg, rgba(28,28,42,.6), rgba(11,11,20,0)); }
  .sb-band-in.lr-band-in { min-height: 0; padding-top: 32px; padding-bottom: 28px; }

  .sb-layout { padding-top: 28px; padding-bottom: 72px; }
  .sb-main { max-width: 760px; margin: 0 auto; min-width: 0; }
  .sb-notice { margin-bottom: 16px; padding: 12px 14px; border: 1px solid rgba(255,149,90,.4); border-radius: 8px; background: rgba(255,149,90,.08); font-size: 14px; color: var(--lr-soft); }
  .sb-notice strong { color: var(--lr-orange); }

  .sb-eb { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-orange); }
  .sb-h2 { margin: 0; padding: 0; font-family: var(--gh-font-display); font-size: 26px; font-weight: 800; text-transform: uppercase; line-height: 1.05; }
  .sb-plat { display: inline-flex; align-items: center; height: 22px; padding: 0 8px; margin-right: 10px; border-radius: 4px; background: rgba(217,245,142,.14); color: var(--lr-lime); font-size: 12px; font-weight: 800; letter-spacing: .04em; }
  .sb-ps { display: flex; align-items: center; flex-wrap: wrap; margin: 12px 0 0; font-size: 14px; color: var(--lr-soft); }

  /* guest */
  .sb-guest { padding: 28px; }
  .sb-guest .sb-h2 { margin-top: 8px; }
  .sb-steps-preview { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 12px; }
  .sb-steps-preview li { display: flex; gap: 14px; align-items: flex-start; }
  .sb-steps-preview b { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid rgba(255,149,90,.5); color: var(--lr-orange); font-size: 14px; }
  .sb-steps-preview span { display: flex; flex-direction: column; gap: 2px; font-size: 14px; line-height: 1.45; color: var(--lr-soft); }
  .sb-steps-preview strong { font-size: 15px; color: var(--lr-text); }
  .sb-guest .sb-ps { margin-top: 20px; }
  .sb-login { margin-top: 22px; }
  .sb-login svg { flex: none; }

  /* wizard */
  .sb-wiz { padding: 0; }
  .sb-prog { margin-bottom: 22px; }
  .sb-prog-t { margin: 0 0 8px; font-size: 12px; font-weight: 600; color: var(--lr-muted); }
  .sb-prog-bar { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .sb-prog-bar li { display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--lr-muted); }
  .sb-prog-bar i { display: block; height: 4px; border-radius: 2px; background: var(--lr-raised); }
  .sb-prog-bar li.is-done i, .sb-prog-bar li.is-on i { background: var(--lr-orange); }
  .sb-prog-bar li.is-on { color: var(--lr-text); font-weight: 600; }
  .sb-step { margin: 0; padding: 0; border: 0; min-width: 0; }

  .sb-proof { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px; }
  .sb-box { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .sb-vbox, .dropzone { position: relative; min-height: 230px; border: 2px dashed rgba(200,200,222,.32); border-radius: 10px; background: rgba(28,28,42,.55); transition: border-color .15s, background .15s; }
  .sb-vbox { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 20px; color: var(--lr-muted); text-align: center; }
  .sb-vbox:focus-within { border-color: var(--lr-orange); }
  .sb-vbox input { margin-top: 8px; max-width: 300px; text-align: center; }
  .sb-vok { font-size: 13px; font-weight: 600; color: var(--lr-lime); }
  .sb-ok { position: absolute; top: 10px; right: 10px; z-index: 2; display: none; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--lr-lime); color: #14141F; }
  .sb-box.is-set .sb-ok { display: grid; }
  .sb-box.is-set .sb-vbox, .sb-box.is-set .dropzone { border-style: solid; border-color: rgba(217,245,142,.55); }
  .sb-need { margin-top: 18px; }
  .sb-need summary { display: inline-flex; align-items: center; gap: 8px; list-style: none; cursor: pointer; font-size: 14px; font-weight: 600; color: var(--lr-soft); }
  .sb-need summary::-webkit-details-marker { display: none; }
  .sb-need summary:hover { color: var(--lr-text); }
  .sb-need summary i { width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-2px); transition: transform .15s; }
  .sb-need[open] summary i { transform: rotate(-135deg) translateY(-1px); }
  .sb-need-b { display: grid; grid-template-columns: 300px minmax(0,1fr); gap: 20px; align-items: start; margin-top: 14px; padding: 16px; border-radius: 8px; background: var(--lr-card); }
  .sb-sketch { display: block; width: 100%; height: auto; }
  .sb-need-cap { margin: 6px 0 0; font-size: 11px; color: var(--lr-muted); }
  .sb-need-l { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; font-size: 13px; line-height: 1.5; color: var(--lr-soft); }
  .sb-need-l strong { color: var(--lr-text); }
  .sb-need-a { display: inline-block; margin-top: 10px; font-size: 14px; font-weight: 700; color: var(--lr-orange); text-decoration: none; }
  .dropzone { display: grid; place-items: center; cursor: pointer; overflow: hidden; }
  .dropzone:hover, .dropzone.is-over { border-color: var(--lr-orange); background: rgba(255,149,90,.06); }
  .dropzone[aria-invalid] { border-color: var(--lr-pink); }
  .dz-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 12px; text-align: center; color: var(--lr-muted); }
  .dz-title { font-size: 18px; color: var(--lr-text); }
  .dz-sub { font-size: 13px; }
  .dz-touch { display: none; }
  :global(html.is-touch) .dz-touch { display: inline; }
  :global(html.is-touch) .dz-desk { display: none; }
  .dz-preview { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #000; }
  .dz-busy { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(11,11,20,.8); font-size: 14px; }
  .dz-meta { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--lr-muted); }
  .dz-meta #dz-info { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dz-actions { display: flex; gap: 12px; flex: none; }
  .link-btn, .sb-sum-list :global(.link-btn) { padding: 0; border: 0; background: none; color: var(--lr-orange); font: inherit; font-weight: 600; cursor: pointer; }

  input[type="text"], input[type="url"] { width: 100%; box-sizing: border-box; height: 46px; padding: 0 14px; border: 1px solid var(--lr-line-strong); border-radius: 6px; background: var(--lr-bg); color: var(--lr-text); font: inherit; font-size: 16px; }
  input:focus-visible { outline: 2px solid var(--lr-orange); outline-offset: 1px; border-color: transparent; }
  input[aria-invalid] { border-color: var(--lr-pink); }
  #lap_time { font-family: var(--gh-font-display); font-weight: 700; letter-spacing: .04em; font-size: 18px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .sb-lab-x { font-weight: 400; color: var(--lr-muted); }
  .field-label { margin: 0; font-size: 13px; font-weight: 600; color: var(--lr-soft); }
  .hint { margin: 0; font-size: 12px; line-height: 1.45; color: var(--lr-muted); }

  .sb-lap, .sb-sum { display: grid; grid-template-columns: 260px minmax(0,1fr); gap: 20px; margin-top: 20px; align-items: start; }
  .sb-mini { display: grid; gap: 8px; }
  .sb-mini :global(img) { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; background: #000; border-radius: 6px; border: 1px solid var(--lr-line); }
  .sb-mini :global(.sb-mini-vid) { display: grid; place-items: center; aspect-ratio: 16 / 9; border-radius: 6px; border: 1px solid var(--lr-line); background: var(--lr-card); color: var(--lr-muted); }
  .sb-mini :global(span) { font-size: 12px; color: var(--lr-muted); }
  .sb-fields { display: grid; gap: 16px; }

  .sb-combo { position: relative; }
  .sb-combo-in { position: relative; display: flex; align-items: center; }
  .sb-combo-in img { position: absolute; left: 10px; width: 24px; height: 24px; object-fit: contain; }
  .sb-combo-in img:not([hidden]) + input { padding-left: 42px; }
  .sb-combo-x { position: absolute; right: 6px; width: 34px; height: 34px; border: 0; border-radius: 4px; background: none; color: var(--lr-muted); font-size: 20px; cursor: pointer; }
  .sb-combo-x:hover { color: var(--lr-text); }
  .sb-combo-list { position: absolute; z-index: 30; top: 74px; left: 0; right: 0; max-height: 300px; overflow-y: auto; margin: 0; padding: 4px; list-style: none; border: 1px solid var(--lr-line-strong); border-radius: 6px; background: var(--lr-raised); box-shadow: 0 12px 32px rgba(0,0,0,.45); }
  .sb-combo-list :global(li) { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 4px; font-size: 15px; cursor: pointer; }
  .sb-combo-list :global(li img) { width: 22px; height: 22px; object-fit: contain; flex: none; }
  .sb-combo-list :global(li small) { color: var(--lr-muted); font-size: 12px; }
  .sb-combo-list :global(li.is-act), .sb-combo-list :global(li:hover) { background: rgba(255,149,90,.12); }
  .sb-combo-list :global(li.is-none) { color: var(--lr-muted); cursor: default; background: none; }

  .sb-sum-list { display: grid; grid-template-columns: auto minmax(0,1fr) auto; gap: 0 16px; margin: 0; }
  .sb-sum-list :global(dt), .sb-sum-list :global(dd) { margin: 0; padding: 10px 0; border-bottom: 1px solid var(--lr-line); font-size: 15px; }
  .sb-sum-list :global(dt) { color: var(--lr-muted); font-size: 13px; padding-top: 12px; }
  .sb-sum-list :global(dd) { font-weight: 600; overflow-wrap: anywhere; }
  .sb-sum-list :global(dd.e) { text-align: right; }
  .sb-sum-list :global(.t) { font-family: var(--gh-font-display); letter-spacing: .03em; }

  .sb-name { margin-top: 20px; }
  .sb-name-opts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .sb-name-opts :global(label) { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border: 1px solid var(--lr-line-strong); border-radius: 999px; cursor: pointer; font-size: 14px; }
  .sb-name-opts :global(label small) { color: var(--lr-muted); font-size: 12px; }
  .sb-name-opts :global(input) { position: absolute; opacity: 0; pointer-events: none; }
  .sb-name-opts :global(label:has(input:checked)) { border-color: var(--lr-orange); background: rgba(255,149,90,.1); }
  .sb-name-opts :global(label:has(input:focus-visible)) { outline: 2px solid var(--lr-orange); outline-offset: 2px; }
  .sb-name-opts :global(label.is-off) { opacity: .45; cursor: default; }

  .sb-err { margin-top: 16px; padding: 10px 12px; border: 1px solid rgba(242,75,157,.5); border-radius: 6px; background: rgba(242,75,157,.08); font-size: 14px; color: var(--lr-text); }
  .sb-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--lr-line); }
  .sb-next.is-wait, .sb-submit.is-wait { background: var(--lr-raised); border-color: var(--lr-line-strong); color: var(--lr-soft); }

  /* success */
  .sb-done { padding: 32px 28px; text-align: left; }
  .sb-done-i { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 14px; border-radius: 50%; background: rgba(217,245,142,.14); color: var(--lr-lime); }
  .sb-done-i :global(svg) { width: 22px; height: 22px; }
  .sb-done .sb-h2 { margin-top: 6px; }
  .sb-done-t { margin: 12px 0 0; font-size: 15px; line-height: 1.55; color: var(--lr-soft); }
  .sb-done-rank { margin: 14px 0 0; padding: 12px 14px; border-radius: 6px; border: 1px solid rgba(217,245,142,.35); background: rgba(217,245,142,.08); font-size: 15px; }
  .sb-done-rank :global(b) { color: var(--lr-lime); }
  .sb-done-a { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }

  /* aside */

  @media (max-width: 1000px) {
  }
  @media (max-width: 860px) {
    .sb-band-in.lr-band-in { padding-top: 24px; padding-bottom: 24px; }
    .sb-layout { padding-top: 16px; }
    .sb-guest, .sb-done { padding: 20px 16px; }
    .sb-h2 { font-size: 22px; }
    .sb-proof { grid-template-columns: 1fr; gap: 12px; margin-top: 18px; }
    .sb-vbox, .dropzone { min-height: 150px; }
    .sb-need-b { grid-template-columns: 1fr; }
    .sb-lap, .sb-sum { grid-template-columns: 1fr; gap: 14px; }
    .sb-mini { grid-template-columns: 120px 1fr; align-items: center; }
    .sb-foot { position: sticky; bottom: 0; z-index: 25; margin: 20px -16px 0; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: rgba(11,11,20,.96); backdrop-filter: blur(8px); }
    .sb-foot .sb-next, .sb-foot .sb-submit { flex: 1; }
    .sb-done-a .btn { flex: 1 1 100%; }
    .sb-login { width: 100%; }
  }
</style>

<script>
  import { getSupabase, SUPABASE_URL, SUPABASE_ANON_KEY } from '../../../scripts/supabase-client';

  const SUBMIT_LAP_URL = import.meta.env.PUBLIC_SUBMIT_LAP_URL ?? '';
  const backendConfigured = Boolean(SUPABASE_URL && SUPABASE_ANON_KEY && SUBMIT_LAP_URL);
  const TRACK = 'gellhorn-international-raceway';
  const PLATFORM = 'ps5';
  const PSN_RE = /^[A-Za-z][A-Za-z0-9_-]{2,15}$/;
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const VEH = JSON.parse($('veh-data').textContent || '[]');
  const vById = new Map(VEH.map((v) => [v.id, v]));

  const form = $('submit-form');
  const guestEl = $('sb-guest');
  const successEl = $('form-success');

  if (navigator.maxTouchPoints > 0 && !window.matchMedia('(pointer: fine)').matches) document.documentElement.classList.add('is-touch');
  // Phone: the "what counts" box starts closed so the form is visible first.

  // ------------------------------------------------------------ state
  let session = null;
  let driver = null;          // { driver_id, display_name, psn_name }
  let discordName = '';
  let step = 1;
  let screenshot = null;      // { blob, name, type, size, url, converted }
  let videoId = null;

  // ------------------------------------------------------------ auth
  function show(which) {
    guestEl.hidden = which !== 'guest';
    form.hidden = which !== 'form';
    successEl.hidden = which !== 'done';
  }
  async function loadDriver() {
    if (!session) return;
    const meta = session.user.user_metadata ?? {};
    discordName = meta.full_name ?? meta.name ?? meta.user_name ?? '';
    const sb = getSupabase();
    const { data } = await sb.from('drivers').select('driver_id, display_name, psn_name').eq('auth_user_id', session.user.id).maybeSingle();
    driver = data ?? null;
    const psnEl = $('psn_name');
    if (driver?.psn_name && !psnEl.value) psnEl.value = driver.psn_name;
    if (driver?.driver_id && !$('vehicle_id').value) {
      const { data: last } = await sb.from('runs').select('vehicle_id').eq('driver_id', driver.driver_id).order('created_at', { ascending: false }).limit(1);
      const v = last?.[0] && vById.get(last[0].vehicle_id);
      if (v) { pickVehicle(v); $('veh-hint').textContent = 'Your last car. Change it if you drove another one.'; }
    }
    refresh();
  }

  if (!backendConfigured) {
    $('backend-notice').hidden = false;
    show('form');
  } else {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => {
      session = data?.session ?? null;
      if (session) { show('form'); loadDriver(); } else show('guest');
    });
    sb.auth.onAuthStateChange((_e, s) => {
      const was = !!session; session = s;
      if (!s) show('guest');
      else if (!was) { show('form'); loadDriver(); }
    });
    $('discord-signin-btn').addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  }

  // ------------------------------------------------------------ steps
  function go(n) {
    step = n;
    form.querySelectorAll('.sb-step').forEach((el) => { el.hidden = Number(el.dataset.step) !== n; });
    form.querySelectorAll('.sb-prog-bar li').forEach((li) => {
      const p = Number(li.dataset.p);
      li.classList.toggle('is-on', p === n); li.classList.toggle('is-done', p < n);
    });
    $('sb-stepno').textContent = String(n);
    if (n === 2) renderMini('mini-2');
    if (n === 3) { renderMini('mini-3'); renderSummary(); renderNames(); }
    errs(n, []);
    refresh();
    const top = form.getBoundingClientRect().top + window.scrollY - (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--gh-header-h')) || 76) - 12;
    if (window.scrollY > top) window.scrollTo({ top, behavior: 'smooth' });
    if (n === 2 && !$('psn_name').value) $('psn_name').focus({ preventScroll: true });
  }
  function errs(n, list) {
    const el = form.querySelector(`[data-err="${n}"]`);
    el.hidden = !list.length;
    el.innerHTML = list.map(esc).join('<br>');
  }

  // What is still missing per step -> button label (shows the next thing to do).
  function missing(n) {
    if (n === 1) return screenshot || videoId ? null : 'Add a screenshot or a video';
    if (n === 2) {
      const psn = $('psn_name').value.trim();
      if (!psn) return 'Add your PSN name';
      if (!$('vehicle_id').value) return 'Pick your car';
      if (parseLapTimeToMs($('lap_time').value) === null) return 'Enter your lap time';
      return null;
    }
    return null;
  }
  function refresh() {
    [1, 2].forEach((n) => {
      const b = form.querySelector(`[data-next="${n}"]`);
      const m = missing(n);
      b.textContent = m ?? 'Continue';
      b.classList.toggle('is-wait', !!m);
    });
    $('tile-shot').classList.toggle('is-set', !!screenshot);
    $('tile-video').classList.toggle('is-set', !!videoId);
  }
  form.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', () => {
    const n = Number(b.dataset.next);
    const list = validate(n);
    if (list.length) { errs(n, list); return; }
    go(n + 1);
  }));
  form.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.back) - 1)));
  form.addEventListener('input', (e) => { e.target.removeAttribute?.('aria-invalid'); refresh(); });

  function validate(n) {
    const list = [];
    if (n === 1) {
      const raw = $('video_url').value.trim();
      if (raw && !videoId) { list.push('That does not look like a YouTube link. Paste the full link, e.g. https://youtu.be/…'); $('video_url').setAttribute('aria-invalid', 'true'); }
      else if (!screenshot && !videoId) list.push('Add a screenshot or a YouTube link of your lap.');
    }
    if (n === 2) {
      const psn = $('psn_name').value.trim();
      if (!psn) { list.push('Add your PSN name, so we can find you on the results screen.'); $('psn_name').setAttribute('aria-invalid', 'true'); }
      else if (!PSN_RE.test(psn)) { list.push('PSN name: 3–16 characters, starts with a letter; letters, digits, - and _ only.'); $('psn_name').setAttribute('aria-invalid', 'true'); }
      if (!$('vehicle_id').value) { list.push('Pick the car you drove.'); $('veh-q').setAttribute('aria-invalid', 'true'); }
      if (parseLapTimeToMs($('lap_time').value) === null) { list.push('Enter the lap time, e.g. 124683 or 1:24.683.'); $('lap_time').setAttribute('aria-invalid', 'true'); }
    }
    return list;
  }

  // ------------------------------------------------------------ lap time
  function normalizeLapTime(text) {
    const t = String(text).trim();
    if (/^\d{1,2}:\d{2}\.\d{1,3}$/.test(t)) return t;
    const digits = t.replace(/\D/g, '');
    if (digits.length < 5 || digits.length > 7) return null;
    const ms = digits.slice(-3), sec = digits.slice(-5, -3), min = digits.slice(0, -5) || '0';
    if (parseInt(sec, 10) > 59) return null;
    return `${parseInt(min, 10)}:${sec}.${ms}`;
  }
  function parseLapTimeToMs(text) {
    const norm = normalizeLapTime(text);
    if (!norm) return null;
    const m = /^(\d{1,2}):(\d{2})\.(\d{1,3})$/.exec(norm);
    if (!m || parseInt(m[2], 10) > 59) return null;
    return (parseInt(m[1], 10) * 60 + parseInt(m[2], 10)) * 1000 + parseInt(m[3].padEnd(3, '0'), 10);
  }
  const fmtMs = (ms) => `${Math.floor(ms / 60000)}:${String(Math.floor(ms / 1000) % 60).padStart(2, '0')}.${String(ms % 1000).padStart(3, '0')}`;
  $('lap_time').addEventListener('blur', () => { const n = normalizeLapTime($('lap_time').value); if (n) $('lap_time').value = n; });

  // ------------------------------------------------------------ video link
  function ytId(url) {
    try {
      const u = new URL(url.trim());
      const h = u.hostname.replace(/^www\.|^m\./, '');
      if (h === 'youtu.be') return u.pathname.slice(1).split('/')[0] || null;
      if (h === 'youtube.com' || h === 'music.youtube.com') {
        if (u.searchParams.get('v')) return u.searchParams.get('v');
        const m = u.pathname.match(/^\/(?:shorts|live|embed)\/([\w-]{6,})/);
        return m ? m[1] : null;
      }
    } catch {}
    return null;
  }
  $('video_url').addEventListener('input', () => {
    videoId = ytId($('video_url').value);
    $('vid-ok').hidden = !videoId;
    refresh();
  });

  // ------------------------------------------------------------ screenshot
  const MAX_BYTES = 8 * 1024 * 1024;
  // DEC-0070: stored at most 1920 px on the long edge as JPEG, target <= 600 KB.
  const MAX_EDGE = 1920;
  const TARGET_BYTES = 600 * 1024;
  const dropzone = $('dropzone');
  const fileInput = $('screenshot');
  const fmtSize = (n) => (n >= 1048576 ? `${(n / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(n / 1024))} KB`);
  const safeName = (n) => (n || 'screenshot').toLowerCase().normalize('NFKD').replace(/[^a-z0-9._-]+/g, '-').replace(/^-+|-+$/g, '').slice(-60) || 'screenshot';
  function loadImage(file) {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => resolve({ img, url });
      img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('unreadable')); };
      img.src = url;
    });
  }
  async function prepareImage(file) {
    if (!file.type.startsWith('image/') && !/\.(heic|heif)$/i.test(file.name)) throw new Error('That file is not an image. Please choose your screenshot (JPG or PNG).');
    let loaded;
    try { loaded = await loadImage(file); } catch { throw new Error('This image format cannot be read by your browser. Please use a JPG or PNG screenshot.'); }
    const { img, url } = loaded;
    const small = ['image/jpeg', 'image/webp'].includes(file.type) && file.size <= TARGET_BYTES && Math.max(img.naturalWidth, img.naturalHeight) <= MAX_EDGE;
    if (small) return { blob: file, name: file.name, type: file.type, size: file.size, url, converted: false };
    const scale = Math.min(1, MAX_EDGE / Math.max(img.naturalWidth, img.naturalHeight));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(img.naturalWidth * scale);
    canvas.height = Math.round(img.naturalHeight * scale);
    canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
    let blob = null;
    for (const q of [0.86, 0.8, 0.72, 0.64]) {
      blob = await new Promise((r) => canvas.toBlob(r, 'image/jpeg', q));
      if (blob && blob.size <= TARGET_BYTES) break;
    }
    if (!blob || blob.size > MAX_BYTES) throw new Error('Could not shrink this image below 8 MB. Please use a normal screenshot.');
    return { blob, name: `${(file.name || 'screenshot').replace(/\.[^.]+$/, '')}.jpg`, type: 'image/jpeg', size: blob.size, url, converted: true };
  }
  async function setScreenshot(file) {
    if (!file) return;
    errs(1, []);
    $('dz-busy').hidden = false;
    try {
      const p = await prepareImage(file);
      if (screenshot?.url) URL.revokeObjectURL(screenshot.url);
      screenshot = p;
      $('dz-preview').src = p.url; $('dz-preview').hidden = false;
      $('dz-empty').hidden = true;
      dropzone.classList.add('has-file'); dropzone.removeAttribute('aria-invalid');
      $('dz-meta').hidden = false;
      $('dz-info').textContent = `${p.name} · ${fmtSize(p.size)}${p.converted ? ' (optimized)' : ''}`;
    } catch (err) {
      errs(1, [err instanceof Error ? err.message : String(err)]);
    } finally {
      $('dz-busy').hidden = true;
      fileInput.value = '';
      refresh();
    }
  }
  function clearScreenshot() {
    if (screenshot?.url) URL.revokeObjectURL(screenshot.url);
    screenshot = null;
    $('dz-preview').hidden = true; $('dz-preview').removeAttribute('src');
    $('dz-empty').hidden = false; $('dz-meta').hidden = true;
    dropzone.classList.remove('has-file');
    refresh();
  }
  fileInput.addEventListener('change', () => setScreenshot(fileInput.files?.[0]));
  $('dz-replace').addEventListener('click', () => fileInput.click());
  $('dz-remove').addEventListener('click', clearScreenshot);
  const onStep1 = () => !form.hidden && step === 1;
  let dragDepth = 0;
  window.addEventListener('dragenter', (e) => { if (e.dataTransfer?.types?.includes('Files')) { dragDepth++; dropzone.classList.add('is-over'); } });
  window.addEventListener('dragleave', () => { dragDepth = Math.max(0, dragDepth - 1); if (!dragDepth) dropzone.classList.remove('is-over'); });
  window.addEventListener('dragover', (e) => { if (e.dataTransfer?.types?.includes('Files')) e.preventDefault(); });
  window.addEventListener('drop', (e) => {
    if (!e.dataTransfer?.files?.length) return;
    e.preventDefault(); dragDepth = 0; dropzone.classList.remove('is-over');
    if (onStep1()) setScreenshot(e.dataTransfer.files[0]);
  });
  document.addEventListener('paste', (e) => {
    if (!onStep1()) return;
    const item = [...(e.clipboardData?.items ?? [])].find((i) => i.kind === 'file' && i.type.startsWith('image/'));
    if (!item) return;
    e.preventDefault();
    const f = item.getAsFile();
    if (f) setScreenshot(new File([f], `pasted-${Date.now()}.${(f.type.split('/')[1] || 'png').replace('jpeg', 'jpg')}`, { type: f.type }));
  });

  // ------------------------------------------------------------ car search
  const q = $('veh-q'), list = $('veh-list'), vidEl = $('vehicle_id'), logoEl = $('veh-logo'), clearBtn = $('veh-clear');
  let hits = [], act = -1;
  const norm = (s) => s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9 ]/g, '');
  function search(text) {
    const toks = norm(text).split(/\s+/).filter(Boolean);
    if (!toks.length) return VEH.slice(0, 0);
    return VEH.filter((v) => { const h = norm(`${v.make} ${v.model}`); return toks.every((t) => h.includes(t)); })
      .sort((a, b) => Number(!norm(a.model).startsWith(toks[0])) - Number(!norm(b.model).startsWith(toks[0])))
      .slice(0, 8);
  }
  function openList() {
    hits = search(q.value); act = hits.length ? 0 : -1;
    list.innerHTML = hits.length
      ? hits.map((v, i) => `<li role="option" id="veh-o${i}" data-i="${i}"${i === act ? ' class="is-act" aria-selected="true"' : ''}>${v.logo ? `<img src="${esc(v.logo)}" alt="" width="22" height="22" loading="lazy" />` : ''}<span>${esc(v.model)} <small>${esc(v.make)}</small></span></li>`).join('')
      : (q.value.trim() ? '<li class="is-none">No car found. Try the model name.</li>' : '');
    list.hidden = !list.innerHTML;
    q.setAttribute('aria-expanded', String(!list.hidden));
  }
  function setAct(i) {
    act = i;
    list.querySelectorAll('li[data-i]').forEach((li) => { const on = Number(li.dataset.i) === i; li.classList.toggle('is-act', on); li.setAttribute('aria-selected', String(on)); if (on) li.scrollIntoView({ block: 'nearest' }); });
    q.setAttribute('aria-activedescendant', i >= 0 ? `veh-o${i}` : '');
  }
  function pickVehicle(v) {
    vidEl.value = v.id;
    q.value = `${v.make} ${v.model}`;
    if (v.logo) { logoEl.src = v.logo; logoEl.hidden = false; } else logoEl.hidden = true;
    clearBtn.hidden = false;
    list.hidden = true; q.setAttribute('aria-expanded', 'false');
    q.removeAttribute('aria-invalid');
    refresh();
  }
  function clearVehicle() {
    vidEl.value = ''; q.value = ''; logoEl.hidden = true; clearBtn.hidden = true; $('veh-hint').textContent = '';
    refresh(); q.focus();
  }
  q.addEventListener('input', () => { if (vidEl.value) { vidEl.value = ''; logoEl.hidden = true; clearBtn.hidden = !q.value; $('veh-hint').textContent = ''; } openList(); refresh(); });
  q.addEventListener('focus', () => { if (!vidEl.value && q.value) openList(); });
  q.addEventListener('keydown', (e) => {
    if (list.hidden || !hits.length) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); setAct((act + 1) % hits.length); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setAct((act - 1 + hits.length) % hits.length); }
    else if (e.key === 'Enter') { e.preventDefault(); if (act >= 0) pickVehicle(hits[act]); }
    else if (e.key === 'Escape') { list.hidden = true; }
  });
  list.addEventListener('mousedown', (e) => e.preventDefault());
  list.addEventListener('click', (e) => { const li = e.target.closest('li[data-i]'); if (li) pickVehicle(hits[Number(li.dataset.i)]); });
  q.addEventListener('blur', () => setTimeout(() => { list.hidden = true; q.setAttribute('aria-expanded', 'false'); }, 120));
  clearBtn.addEventListener('click', clearVehicle);

  // ------------------------------------------------------------ preview + summary
  function renderMini(id) {
    const el = $(id);
    const parts = [];
    if (screenshot) parts.push(`<img src="${esc(screenshot.url)}" alt="Your screenshot" />`);
    else if (videoId) parts.push('<i class="sb-mini-vid"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/></svg></i>');
    parts.push(`<span>${screenshot && videoId ? 'Screenshot and video' : screenshot ? 'Screenshot' : 'Video'}</span>`);
    el.innerHTML = parts.join('');
  }
  function renderSummary() {
    const v = vById.get(vidEl.value);
    const rows = [
      ['Proof', [screenshot && 'Screenshot', videoId && 'Video'].filter(Boolean).join(' + '), 1],
      ['PSN name', $('psn_name').value.trim(), 2],
      ['Car', v ? `${v.make} ${v.model}` : '', 2],
      ['Lap time', normalizeLapTime($('lap_time').value) ?? '', 2, 't'],
      ['Platform', 'PS5', 0],
    ];
    $('sum-list').innerHTML = rows.map(([k, val, s, cls]) => `<dt>${k}</dt><dd${cls ? ` class="${cls}"` : ''}>${esc(val)}</dd><dd class="e">${s ? `<button type="button" class="link-btn" data-edit="${s}">Edit</button>` : ''}</dd>`).join('');
  }
  $('sum-list').addEventListener('click', (e) => { const b = e.target.closest('[data-edit]'); if (b) go(Number(b.dataset.edit)); });

  // Leaderboard name: Discord name (default) or PSN name; a custom name from Settings is kept as an option.
  let nameChoice = null;
  function renderNames() {
    const psn = $('psn_name').value.trim();
    const cur = driver?.display_name ?? '';
    const opts = [];
    if (discordName) opts.push({ k: 'discord', label: 'Discord name', val: discordName });
    if (psn && psn !== discordName) opts.push({ k: 'psn', label: 'PSN name', val: psn });
    if (cur && !opts.some((o) => o.val === cur)) opts.unshift({ k: 'current', label: 'Current', val: cur });
    if (!opts.length) opts.push({ k: 'current', label: 'Current', val: cur || 'Driver' });
    if (!nameChoice || !opts.some((o) => o.k === nameChoice)) nameChoice = (opts.find((o) => o.val === cur) ?? opts[0]).k;
    $('name-opts').innerHTML = opts.map((o) => `<label><input type="radio" name="lb_name" value="${o.k}"${o.k === nameChoice ? ' checked' : ''} /><span>${esc(o.val)}</span><small>${o.label}</small></label>`).join('');
  }
  $('name-opts').addEventListener('change', (e) => { nameChoice = e.target.value; });
  const chosenName = () => {
    const el = $('name-opts').querySelector('input:checked');
    const lab = el?.closest('label')?.querySelector('span')?.textContent ?? '';
    return lab;
  };

  // ------------------------------------------------------------ submit
  const submitBtn = $('submit-btn'), submitLabel = $('submit-label');
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (step !== 3) { form.querySelector(`[data-next="${step}"]`)?.click(); return; }
    errs(3, []);
    const vehicleId = vidEl.value;
    const lapTimeMs = parseLapTimeToMs($('lap_time').value);
    const psn = $('psn_name').value.trim();
    const videoUrl = videoId ? $('video_url').value.trim() : '';
    const lbName = chosenName();
    if (!backendConfigured) { errs(3, ['Form is valid. The backend is not connected in this build, so nothing was submitted.']); return; }

    submitBtn.disabled = true;
    try {
      const sb = getSupabase();
      const { data: fresh } = await sb.auth.getSession();
      const token = fresh?.session?.access_token ?? session?.access_token;
      if (!token) throw new Error('Your login expired. Please log in again.');

      // Profile: PSN name + leaderboard name (same table/rules as Settings).
      const upd = {};
      if (psn !== (driver?.psn_name ?? '')) upd.psn_name = psn;
      if (lbName && lbName !== (driver?.display_name ?? '')) upd.display_name = lbName;
      if (Object.keys(upd).length) {
        const { error } = await sb.from('drivers').update(upd).eq('auth_user_id', session.user.id);
        if (error) throw new Error('Could not save your name. Please try again.');
        driver = { ...(driver ?? {}), ...upd };
      }

      const evidence = [];
      if (screenshot) {
        submitLabel.textContent = 'Uploading screenshot…';
        const path = `${session.user.id}/${Date.now()}-${safeName(screenshot.name)}`;
        const { error: upErr } = await sb.storage.from('lap-evidence').upload(path, screenshot.blob, { contentType: screenshot.type });
        if (upErr) throw new Error(`Upload failed: ${upErr.message}. Check your connection and try again.`);
        evidence.push({ type: 'screenshot', storage_reference: path, mime_type: screenshot.type, byte_size: screenshot.size });
      }
      if (videoUrl) evidence.push({ type: 'video_link', storage_reference: videoUrl });

      submitLabel.textContent = 'Submitting…';
      const res = await fetch(SUBMIT_LAP_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}`, apikey: SUPABASE_ANON_KEY },
        body: JSON.stringify({
          track_id: TRACK, vehicle_id: vehicleId, lap_time_ms: lapTimeMs, platform: PLATFORM,
          standard_version: 'v0-draft', conditions: {},
          // The leaderboard always shows the driver's display name; the name is chosen in step 3.
          display_name_consent: true,
          evidence,
        }),
      });
      const body = await res.json().catch(() => ({}));
      if (res.status === 429) throw new Error('You sent a lot of laps in the last hour. Please try again later.');
      if (!res.ok) throw new Error(body.error ?? `The server answered ${res.status}. Please try again.`);

      const v = vById.get(vehicleId);
      $('success-text').textContent = `${fmtMs(lapTimeMs)} in the ${v ? `${v.make} ${v.model}` : 'car you picked'}. A moderator checks it before it appears on the leaderboard${videoUrl ? ', and watches your video for Video verified' : ''}.`;
      show('done');
      successEl.scrollIntoView({ block: 'start', behavior: 'smooth' });
      placement(lapTimeMs);
    } catch (err) {
      errs(3, [`Not submitted: ${err instanceof Error ? err.message : String(err)}`]);
    } finally {
      submitBtn.disabled = false;
      submitLabel.textContent = 'Submit lap';
    }
  });

  // Where the time would land overall once accepted (accepted laps only; best per driver).
  async function placement(ms) {
    const el = $('success-rank');
    el.hidden = true;
    try {
      const { data } = await getSupabase().from('public_leaderboard_ranks').select('driver_id,lap_time_ms').eq('track_id', TRACK).eq('platform', PLATFORM).eq('scope', 'overall');
      if (!data) return;
      const mine = data.find((r) => r.driver_id === driver?.driver_id);
      const faster = data.filter((r) => r.driver_id !== driver?.driver_id && r.lap_time_ms < ms).length;
      let txt = `If accepted: <b>P${faster + 1}</b> overall at Gellhorn`;
      if (mine && ms < mine.lap_time_ms) txt += ` and a <b>new personal best</b> (${fmtMs(mine.lap_time_ms - ms).replace(/^0:0?/, '−')}s)`;
      else if (mine) txt = `Your best stays <b>${fmtMs(mine.lap_time_ms)}</b> (P${data.filter((r) => r.lap_time_ms < mine.lap_time_ms).length + 1} overall)`;
      el.innerHTML = `${txt}.`;
      el.hidden = false;
    } catch {}
  }

  $('submit-another').addEventListener('click', () => {
    // Keep PSN name and car; clear proof and time.
    clearScreenshot();
    $('video_url').value = ''; videoId = null; $('vid-ok').hidden = true;
    $('lap_time').value = '';
    show('form'); go(1);
  });

  go(1);
</script>
