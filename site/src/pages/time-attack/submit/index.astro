---
import Base from '../../../layouts/Base.astro';
import TimeAttackSubnav from '../../../components/TimeAttackSubnav.astro';
import { vehicleOptions } from '../../../data/vehicles';

import { PLATFORMS, comingLater } from '../../../data/platforms';
// DEC-0073: PS5 selectable; Xbox Series X|S and PC visible but greyed out (coming later).
// Vehicle list grouped by manufacturer -- a 100+ entry flat list is hard to
// scroll on a phone; the native picker shows the groups as headers.
const byMake = new Map<string, typeof vehicleOptions>();
[...vehicleOptions]
  .sort((a, b) => a.make.localeCompare(b.make) || a.model.localeCompare(b.model))
  .forEach((v) => byMake.set(v.make, [...(byMake.get(v.make) ?? []), v]));
---
<Base
  title="Submit a Lap — GTA VI Time Attack"
  description="Submit your Gellhorn International Raceway lap time with a results screenshot. Add a full lap video for Video Verified status."
  section="time-attack"
  noindex={true /* until laps can be submitted on launch day (RS-0050) */}
>
  <TimeAttackSubnav />
  <section class="wrap submit-wrap">
    <p class="eyebrow">Gellhorn International Raceway</p>
    <h1 class="display submit-title">Submit a Lap</h1>
    <p class="submit-lede">Add your results screenshot, check the details, and submit your lap. Include a full-lap YouTube link for Video Verified status. Once your proof is ready, submitting takes less than a minute.</p>

    <div id="backend-notice" class="notice" hidden>
      <strong>Backend not connected yet.</strong>
      <span>
        This page is fully wired to the real <code>submit-lap</code> Edge Function contract, but no
        Supabase project exists yet (see <code>SETUP-BACKEND.md</code>). You can fill in and validate the
        form; the actual submit call is disabled until <code>PUBLIC_SUPABASE_URL</code>,
        <code>PUBLIC_SUPABASE_ANON_KEY</code> and <code>PUBLIC_SUBMIT_LAP_URL</code> are configured.
      </span>
    </div>

    <div id="auth-box" class="panel auth-box" hidden>
      <div id="auth-signed-out" hidden>
        <p>Sign in with Discord to submit a lap.</p>
        <button type="button" id="discord-signin-btn" class="btn btn-outline">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 5.3A18 18 0 0 0 15.9 4l-.3.6a15 15 0 0 1 4 1.6 16 16 0 0 0-13.2 0 15 15 0 0 1 4-1.6L10.1 4a18 18 0 0 0-4.4 1.3C2.9 9 2.2 12.6 2.5 16.1a18 18 0 0 0 5.5 2.8l.8-1.3a11 11 0 0 1-1.9-.9l.5-.4a13 13 0 0 0 9.2 0l.5.4a11 11 0 0 1-1.9.9l.8 1.3a18 18 0 0 0 5.5-2.8c.4-4-.7-7.5-2.2-10.8ZM9.3 14c-.8 0-1.4-.7-1.4-1.6s.6-1.6 1.4-1.6 1.4.7 1.4 1.6-.6 1.6-1.4 1.6Zm5.4 0c-.8 0-1.4-.7-1.4-1.6s.6-1.6 1.4-1.6 1.4.7 1.4 1.6-.6 1.6-1.4 1.6Z"/></svg>
          Sign in with Discord
        </button>
      </div>
      <div id="auth-signed-in" hidden>
        <p>Signed in as <strong id="auth-user-label"></strong>.</p>
        <button type="button" id="discord-signout-btn" class="btn btn-outline">Sign out</button>
      </div>
    </div>

    <form id="submit-form" class="panel submit-form" novalidate>
      <!-- 1. Screenshot first: once it is in, the preview stays on screen so
           the driver can read vehicle and lap time off it while filling in
           the fields below. -->
      <div class="field">
        <span class="field-label">1 · Results screenshot</span>
        <label class="dropzone" id="dropzone" for="screenshot">
          <input id="screenshot" name="screenshot" type="file" accept="image/*" class="visually-hidden" />
          <span class="dz-empty" id="dz-empty">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            <strong class="dz-title">Add screenshot</strong>
            <span class="dz-sub dz-touch">Tap to pick it from your photos</span>
            <span class="dz-sub dz-desk">Drop it here, click to choose, or paste with <kbd>Ctrl</kbd>+<kbd>V</kbd></span>
          </span>
          <img id="dz-preview" class="dz-preview" alt="Preview of selected results screenshot" hidden />
          <span class="dz-busy" id="dz-busy" hidden>Preparing image…</span>
        </label>
        <div class="dz-meta" id="dz-meta" hidden>
          <span id="dz-info"></span>
          <span class="dz-actions">
            <button type="button" class="link-btn" id="dz-replace">Replace</button>
            <button type="button" class="link-btn" id="dz-remove">Remove</button>
          </span>
        </div>
        <p class="hint">Must clearly show driver name, vehicle and lap time. Stored privately, never published. On PS5: share the screenshot to the PlayStation App, save it to your phone, then add it here.</p>
      </div>

      <div class="field">
        <span class="field-label" id="platform-label">2 · Platform</span>
        <div class="seg" role="radiogroup" aria-labelledby="platform-label">
          {PLATFORMS.map((p) => p.active ? (
            <label class="seg-opt"><input type="radio" name="platform" value={p.runValue} checked /><span>{p.label}</span></label>
          ) : (
            <label class="seg-opt is-soon" title={comingLater(p)}><input type="radio" name="platform" value={p.runValue} disabled /><span>{p.label}<small>Coming later</small></span></label>
          ))}
        </div>
        <p class="hint">Time Attack runs on PS5 for now. Xbox Series X|S and PC will follow later.</p>
      </div>

      <div class="field">
        <label class="field-label" for="vehicle_id">3 · Vehicle</label>
        <select id="vehicle_id" name="vehicle_id" required>
          <option value="" disabled selected>Select the vehicle you drove</option>
          {[...byMake.entries()].map(([make, list]) => (
            <optgroup label={make}>
              {list.map((v) => <option value={v.id}>{v.make} {v.model}</option>)}
            </optgroup>
          ))}
        </select>
      </div>

      <div class="field">
        <label class="field-label" for="lap_time">4 · Lap time</label>
        <input id="lap_time" name="lap_time" type="text" inputmode="numeric" autocomplete="off" enterkeyhint="done" placeholder="1:24.683" required />
        <p class="hint">Just type the digits — <strong>124683</strong> becomes <strong>1:24.683</strong>.</p>
      </div>

      <details class="more" id="more">
        <summary>Add a full lap video <span>(optional — needed for Video verified)</span></summary>
        <div class="field">
          <label class="field-label" for="video_url">Video link</label>
          <input id="video_url" name="video_url" type="url" inputmode="url" placeholder="https://youtube.com/watch?v=..." />
          <p class="hint">Complete, uncut lap. A moderator watches it before the run can become Video verified. You can also add it later in your account.</p>
        </div>
      </details>

      <label class="consent">
        <input id="display_name_consent" name="display_name_consent" type="checkbox" required />
        <span>Show my display name next to this lap time.</span>
      </label>

      <div id="form-errors" class="form-errors" hidden></div>

      <button type="submit" class="btn btn-red submit-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg>
        <span id="submit-label">Submit Lap</span>
      </button>
    </form>

    <div id="form-success" class="panel success" hidden>
      <p class="eyebrow">Received</p>
      <h2 class="display success-title">Lap submitted</h2>
      <p id="success-text" class="success-text"></p>
      <div class="success-actions">
        <button type="button" class="btn btn-red" id="submit-another">Submit another lap</button>
        <a class="btn btn-white-tonal" id="to-account">My submissions</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Native [hidden] must win over any later display: rule on the same
     element, otherwise a class like .notice/.auth-box/.submit-form that
     sets its own `display` silently cancels `hidden` and the element
     stays visible even though its `hidden` attribute/property is true. */
  [hidden] { display: none !important; }

  .submit-wrap { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem); max-width: 40rem; }
  .submit-title { margin: .4rem 0 .8rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .submit-lede { color: var(--gh-muted); max-width: 56ch; margin: 0 0 1.5rem; }
  .submit-lede code { color: var(--gh-text); }

  .notice { display: flex; flex-direction: column; gap: .3rem; margin-bottom: 1.5rem; padding: 1rem 1.2rem; border: 1px solid var(--gh-yellow); background: rgba(255,149,90,.08); border-radius: var(--gh-radius); font-size: .85rem; }
  .notice strong { color: var(--gh-yellow); }
  .notice code { color: var(--gh-text); }

  .auth-box { margin-bottom: 1.5rem; padding: 1rem 1.2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .auth-box p { margin: 0; font-size: .88rem; }

  .submit-form { display: flex; flex-direction: column; gap: 1.4rem; padding: var(--gh-pad-card); }
  .field { display: flex; flex-direction: column; gap: .45rem; }
  .field-label { font-weight: 800; font-size: .82rem; letter-spacing: .02em; text-transform: uppercase; color: var(--gh-text); }
  .field select, .field input[type="text"], .field input[type="url"] {
    width: 100%; padding: .8rem .9rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line);
    background: var(--gh-bg); color: var(--gh-text); font-family: var(--gh-font-body);
    font-size: 16px; /* >=16px: iOS Safari would otherwise zoom the page on focus */
  }
  .field select option, .field select optgroup { background: var(--gh-surface); }
  #lap_time { font-family: var(--gh-font-display); font-weight: 900; font-size: 1.35rem; letter-spacing: .03em; }
  .field select:focus, .field input:focus { outline: 2px solid var(--gh-yellow); outline-offset: 1px; }
  .field input[aria-invalid="true"], .field select[aria-invalid="true"] { border-color: var(--gh-red); }
  .hint { margin: 0; color: var(--gh-muted); font-size: .78rem; line-height: 1.5; }
  .hint strong { color: var(--gh-text); font-weight: 700; }

  /* ---- screenshot drop zone: fixed 16:9 box, so nothing below moves when
     the preview appears (no layout jump on phones) ---- */
  .visually-hidden { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; clip: rect(0 0 0 0); }
  .dropzone { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 9; border: 2px dashed rgba(200,200,222,.35); border-radius: var(--gh-radius-lg); background: var(--gh-bg); cursor: pointer; overflow: hidden; transition: border-color .15s, background .15s; -webkit-tap-highlight-color: transparent; }
  .dropzone:hover, .dropzone:focus-within { border-color: var(--gh-muted); }
  .dropzone.is-over { border-color: var(--gh-yellow); background: rgba(255,149,90,.06); }
  .dropzone.has-file { border-style: solid; border-color: var(--gh-line); }
  .dropzone[aria-invalid="true"] { border-color: var(--gh-red); }
  .dz-empty { display: flex; flex-direction: column; align-items: center; gap: .4rem; padding: 1rem; text-align: center; color: var(--gh-muted); }
  .dz-title { color: var(--gh-text); font-size: 1rem; }
  .dz-sub { font-size: .8rem; }
  .dz-sub kbd { font-family: var(--gh-font-body); font-size: .72rem; padding: .05rem .35rem; border: 1px solid var(--gh-line); border-radius: 3px; }
  .dz-desk { display: none; }
  @media (hover: hover) and (pointer: fine) { .dz-desk { display: inline; } .dz-touch { display: none; } }
  :global(html.is-touch) .dz-desk { display: none; }
  :global(html.is-touch) .dz-touch { display: inline; }
  .dz-preview { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #000; }
  .dz-busy { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(11,11,20,.8); color: var(--gh-text); font-size: .85rem; font-weight: 700; }
  .dz-meta { display: flex; align-items: center; justify-content: space-between; gap: .75rem; font-size: .78rem; color: var(--gh-muted); }
  .dz-actions { display: flex; gap: .9rem; }
  .link-btn { background: none; border: none; padding: .3rem 0; color: var(--gh-text); font: inherit; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  /* ---- platform segmented control: one tap instead of a dropdown ---- */
  .seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
  .seg-opt { position: relative; }
  .seg-opt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg-opt span { display: flex; align-items: center; justify-content: center; min-height: 2.9rem; padding: .5rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: var(--gh-bg); color: var(--gh-muted); font-weight: 700; font-size: .9rem; text-align: center; }
  .seg-opt input:checked + span { border-color: var(--gh-yellow); color: var(--gh-text); background: rgba(255,149,90,.08); box-shadow: inset 0 0 0 1px var(--gh-yellow); }
  .seg-opt span small { display: block; margin-top: .15rem; font-size: .64rem; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: var(--gh-muted); }
  .seg-opt span { flex-direction: column; }
  .seg-opt.is-soon span { opacity: .5; border-style: dashed; }
  .seg-opt.is-soon, .seg-opt.is-soon input { cursor: not-allowed; }
  .seg-opt input:focus-visible + span { outline: 2px solid var(--gh-yellow); outline-offset: 2px; }

  .more { border-top: 1px solid var(--gh-line); padding-top: 1rem; }
  .more summary { cursor: pointer; font-weight: 700; font-size: .88rem; list-style: none; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before { content: '+ '; color: var(--gh-yellow); }
  .more[open] summary::before { content: '– '; }
  .more summary span { color: var(--gh-muted); font-weight: 400; font-size: .8rem; }
  .more .field { margin-top: .9rem; }

  .consent { display: flex; align-items: flex-start; gap: .7rem; font-size: .9rem; cursor: pointer; }
  .consent input { width: 1.25rem; height: 1.25rem; margin: .05rem 0 0; flex: none; accent-color: var(--gh-red); }

  .form-errors { padding: .8rem 1rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-red); background: rgba(242,75,157,.1); color: var(--gh-text); font-size: .85rem; }
  .form-errors ul { margin: .3rem 0 0; padding-left: 1.1rem; }

  .submit-btn { width: 100%; min-height: 3.2rem; font-size: 1.05rem; }
  .submit-btn:disabled { opacity: .7; cursor: progress; }

  .success { padding: var(--gh-pad-card); border-color: var(--gh-yellow); }
  .success-title { margin: .4rem 0 .6rem; font-size: 1.8rem; }
  .success-text { margin: 0 0 1.3rem; color: var(--gh-muted); }
  .success-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
</style>

<script>
  import { getSupabase, SUPABASE_URL, SUPABASE_ANON_KEY } from '../../../scripts/supabase-client';

  const SUBMIT_LAP_URL = import.meta.env.PUBLIC_SUBMIT_LAP_URL ?? '';
  // Stricter than the shared module's own backendConfigured -- this page
  // also needs its own edge function URL configured.
  const backendConfigured = Boolean(SUPABASE_URL && SUPABASE_ANON_KEY && SUBMIT_LAP_URL);

  const noticeEl = document.getElementById('backend-notice');
  const authBoxEl = document.getElementById('auth-box');
  const authSignedOutEl = document.getElementById('auth-signed-out');
  const authSignedInEl = document.getElementById('auth-signed-in');
  const authUserLabelEl = document.getElementById('auth-user-label');
  const formEl = document.getElementById('submit-form');

  if (!backendConfigured) {
    noticeEl.hidden = false;
  } else {
    authBoxEl.hidden = false;
  }

  let currentSession = null;

  function renderAuthState() {
    if (!backendConfigured) return;
    if (currentSession) {
      // Signed in: no extra box above the form -- logout is in the header's
      // avatar menu, and every pixel above the upload field counts on phones.
      authBoxEl.hidden = true;
      authSignedOutEl.hidden = true;
      authSignedInEl.hidden = false;
      authUserLabelEl.textContent =
        currentSession.user.user_metadata?.full_name ??
        currentSession.user.user_metadata?.name ??
        currentSession.user.email ??
        currentSession.user.id;
      // keep the success panel up (token refreshes also fire this)
      formEl.hidden = !document.getElementById('form-success').hidden;
    } else {
      authBoxEl.hidden = false;
      authSignedOutEl.hidden = false;
      authSignedInEl.hidden = true;
      formEl.hidden = true;
      document.getElementById('form-success').hidden = true;
    }
  }

  if (backendConfigured) {
    formEl.hidden = true; // hidden until we know the auth state
    const sbInit = getSupabase();
    sbInit.auth.getSession().then(({ data }) => {
      currentSession = data?.session ?? null;
      renderAuthState();
    });
    sbInit.auth.onAuthStateChange((_event, session) => {
      currentSession = session;
      renderAuthState();
    });

    document.getElementById('discord-signin-btn').addEventListener('click', async () => {
      const sb = getSupabase();
      await sb.auth.signInWithOAuth({
        provider: 'discord',
        // guilds.join on top of identify+email -- Header.astro's
        // onAuthStateChange listener (present on every page) picks up
        // the resulting provider_token and auto-adds the driver to our
        // Discord server. Scopes are replaced, not extended, by this
        // option, hence listing identify+email explicitly too.
        options: { redirectTo: window.location.origin + window.location.pathname + window.location.search, scopes: 'identify email guilds.join' },
      });
    });
    document.getElementById('discord-signout-btn').addEventListener('click', async () => {
      const sb = getSupabase();
      await sb.auth.signOut();
    });
  }

  // Touch devices whose browser still reports a fine pointer get the phone
  // wording in the drop zone ("Tap to pick…" instead of drag/paste).
  if (navigator.maxTouchPoints > 0 && !window.matchMedia('(pointer: fine)').matches) document.documentElement.classList.add('is-touch');

  // ------------------------------------------------------------ lap time
  // Accepts "1:24.683" or just digits ("124683" = 1:24.683). Phones show a
  // digits-only keypad for inputmode=numeric (no ":" on iOS), so digits must
  // be enough.
  function normalizeLapTime(text) {
    const t = String(text).trim();
    if (/^\d{1,2}:\d{2}\.\d{1,3}$/.test(t)) return t;
    const digits = t.replace(/\D/g, '');
    if (digits.length < 5 || digits.length > 7) return null;
    const ms = digits.slice(-3), sec = digits.slice(-5, -3), min = digits.slice(0, -5) || '0';
    if (parseInt(sec, 10) > 59) return null;
    return `${parseInt(min, 10)}:${sec}.${ms}`;
  }
  function parseLapTimeToMs(text) {
    const norm = normalizeLapTime(text);
    if (!norm) return null;
    const m = /^(\d{1,2}):(\d{2})\.(\d{1,3})$/.exec(norm);
    if (!m) return null;
    const [, min, sec, msRaw] = m;
    if (parseInt(sec, 10) > 59) return null;
    return (parseInt(min, 10) * 60 + parseInt(sec, 10)) * 1000 + parseInt(msRaw.padEnd(3, '0'), 10);
  }
  const lapInput = document.getElementById('lap_time');
  lapInput.addEventListener('blur', () => {
    const n = normalizeLapTime(lapInput.value);
    if (n) lapInput.value = n;
  });

  // ------------------------------------------------------------ screenshot
  const MAX_BYTES = 8 * 1024 * 1024;           // bucket limit (lap-evidence)
  // Storage (DEC-0070): every screenshot is stored at most 1920 px on the
  // long edge as JPEG, target <= 600 KB -- names and times stay readable,
  // the 1 GB free storage lasts ~3,000 submissions per 60-day window.
  const MAX_EDGE = 1920;
  const TARGET_BYTES = 600 * 1024;
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('screenshot');
  const previewEl = document.getElementById('dz-preview');
  const emptyEl = document.getElementById('dz-empty');
  const busyEl = document.getElementById('dz-busy');
  const metaEl = document.getElementById('dz-meta');
  const infoEl = document.getElementById('dz-info');
  let screenshot = null; // { blob, name, type, size }
  let previewUrl = null;

  const fmtSize = (n) => (n >= 1048576 ? `${(n / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(n / 1024))} KB`);
  const safeName = (n) => (n || 'screenshot').toLowerCase().normalize('NFKD').replace(/[^a-z0-9._-]+/g, '-').replace(/^-+|-+$/g, '').slice(-60) || 'screenshot';

  function loadImage(file) {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => resolve({ img, url });
      img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('unreadable')); };
      img.src = url;
    });
  }

  // Keeps the original only when it is already a small JPEG/WebP within
  // 1920 px; everything else (PNG, 4K, HEIC, big JPEGs) is re-encoded.
  async function prepareImage(file) {
    if (!file.type.startsWith('image/') && !/\.(heic|heif)$/i.test(file.name)) throw new Error('That file is not an image. Please choose your screenshot (JPG or PNG).');
    let loaded;
    try { loaded = await loadImage(file); }
    catch { throw new Error('This image format cannot be read by your browser. Please use a JPG or PNG screenshot.'); }
    const { img, url } = loaded;
    const small = ['image/jpeg', 'image/webp'].includes(file.type) && file.size <= TARGET_BYTES && Math.max(img.naturalWidth, img.naturalHeight) <= MAX_EDGE;
    if (small) {
      return { blob: file, name: file.name, type: file.type, size: file.size, url, converted: false };
    }
    const scale = Math.min(1, MAX_EDGE / Math.max(img.naturalWidth, img.naturalHeight));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(img.naturalWidth * scale);
    canvas.height = Math.round(img.naturalHeight * scale);
    canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
    let blob = null;
    for (const q of [0.86, 0.8, 0.72, 0.64]) {
      blob = await new Promise((r) => canvas.toBlob(r, 'image/jpeg', q));
      if (blob && blob.size <= TARGET_BYTES) break;
    }
    if (!blob || blob.size > MAX_BYTES) throw new Error('Could not shrink this image below 8 MB. Please use a normal screenshot.');
    const base = (file.name || 'screenshot').replace(/\.[^.]+$/, '');
    return { blob, name: `${base}.jpg`, type: 'image/jpeg', size: blob.size, url, converted: true };
  }

  async function setScreenshot(file) {
    if (!file) return;
    clearErrors();
    busyEl.hidden = false;
    try {
      const prepared = await prepareImage(file);
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = prepared.url;
      screenshot = prepared;
      previewEl.src = prepared.url;
      previewEl.hidden = false;
      emptyEl.hidden = true;
      dropzone.classList.add('has-file');
      dropzone.removeAttribute('aria-invalid');
      metaEl.hidden = false;
      infoEl.textContent = `${prepared.name} · ${fmtSize(prepared.size)}${prepared.converted ? ' (optimized)' : ''}`;
    } catch (err) {
      showErrors([err instanceof Error ? err.message : String(err)]);
    } finally {
      busyEl.hidden = true;
      fileInput.value = ''; // allow re-picking the same file
    }
  }
  function clearScreenshot() {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = null; screenshot = null;
    previewEl.hidden = true; previewEl.removeAttribute('src');
    emptyEl.hidden = false; metaEl.hidden = true;
    dropzone.classList.remove('has-file');
  }

  fileInput.addEventListener('change', () => setScreenshot(fileInput.files?.[0]));
  document.getElementById('dz-replace').addEventListener('click', () => fileInput.click());
  document.getElementById('dz-remove').addEventListener('click', clearScreenshot);

  // Drag & drop: the whole page accepts a dropped image (no precise aiming
  // needed), and the browser must never navigate away to the raw file.
  const formVisible = () => !document.getElementById('submit-form').hidden;
  let dragDepth = 0;
  window.addEventListener('dragenter', (e) => { if (e.dataTransfer?.types?.includes('Files')) { dragDepth++; dropzone.classList.add('is-over'); } });
  window.addEventListener('dragleave', () => { dragDepth = Math.max(0, dragDepth - 1); if (!dragDepth) dropzone.classList.remove('is-over'); });
  window.addEventListener('dragover', (e) => { if (e.dataTransfer?.types?.includes('Files')) e.preventDefault(); });
  window.addEventListener('drop', (e) => {
    if (!e.dataTransfer?.files?.length) return;
    e.preventDefault();
    dragDepth = 0; dropzone.classList.remove('is-over');
    if (formVisible()) setScreenshot(e.dataTransfer.files[0]);
  });

  // Paste (Ctrl+V / long-press "Paste"): only takes over when the clipboard
  // actually holds an image, so pasting text into the lap time still works.
  document.addEventListener('paste', (e) => {
    if (!formVisible()) return;
    const item = [...(e.clipboardData?.items ?? [])].find((i) => i.kind === 'file' && i.type.startsWith('image/'));
    if (!item) return;
    e.preventDefault();
    const f = item.getAsFile();
    if (f) setScreenshot(new File([f], `pasted-${Date.now()}.${(f.type.split('/')[1] || 'png').replace('jpeg', 'jpg')}`, { type: f.type }));
  });

  // ------------------------------------------------------------ submit
  const form = document.getElementById('submit-form');
  const errorsEl = document.getElementById('form-errors');
  const successEl = document.getElementById('form-success');
  const submitBtn = form.querySelector('.submit-btn');
  const submitLabel = document.getElementById('submit-label');

  function clearErrors() {
    errorsEl.hidden = true; errorsEl.innerHTML = '';
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
  }
  function showErrors(list) {
    errorsEl.hidden = false;
    errorsEl.innerHTML = list.length === 1 ? list[0] : '<strong>Please fix:</strong><ul>' + list.map((e) => `<li>${e}</li>`).join('') + '</ul>';
    errorsEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }
  form.addEventListener('input', (e) => e.target.removeAttribute?.('aria-invalid'));

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearErrors();

    const data = new FormData(form);
    const platform = data.get('platform');
    const vehicleId = data.get('vehicle_id');
    const lapTimeMs = parseLapTimeToMs(String(data.get('lap_time') ?? ''));
    const videoUrl = String(data.get('video_url') ?? '').trim();
    const consent = data.get('display_name_consent') === 'on';

    const errors = [];
    if (!screenshot) { errors.push('Add your results screenshot.'); dropzone.setAttribute('aria-invalid', 'true'); }
    if (!vehicleId) { errors.push('Select the vehicle.'); form.vehicle_id.setAttribute('aria-invalid', 'true'); }
    if (lapTimeMs === null) { errors.push('Enter the lap time, e.g. 124683 or 1:24.683.'); lapInput.setAttribute('aria-invalid', 'true'); }
    if (videoUrl && !/^https:\/\//.test(videoUrl)) errors.push('The video link must start with https://');
    if (!consent) errors.push('Tick the box to show your display name with this time.');
    if (errors.length) { showErrors(errors); return; }

    const n = normalizeLapTime(lapInput.value); if (n) lapInput.value = n;

    if (!backendConfigured) {
      showErrors(['<strong>Form is valid.</strong> The backend is not connected in this build, so nothing was submitted.']);
      return;
    }

    submitBtn.disabled = true;
    try {
      const sb = getSupabase();
      const accessToken = currentSession?.access_token;
      if (!accessToken) throw new Error('Please sign in with Discord first (button above).');

      submitLabel.textContent = 'Uploading screenshot…';
      const path = `${currentSession.user.id}/${Date.now()}-${safeName(screenshot.name)}`;
      const { error: uploadError } = await sb.storage.from('lap-evidence').upload(path, screenshot.blob, { contentType: screenshot.type });
      if (uploadError) throw new Error(`Upload failed: ${uploadError.message}. Check your connection and try again.`);

      submitLabel.textContent = 'Submitting…';
      const evidence = [{ type: 'screenshot', storage_reference: path, mime_type: screenshot.type, byte_size: screenshot.size }];
      if (videoUrl) evidence.push({ type: 'video_link', storage_reference: videoUrl });
      const res = await fetch(SUBMIT_LAP_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${accessToken}`, apikey: SUPABASE_ANON_KEY },
        body: JSON.stringify({
          track_id: 'gellhorn-international-raceway',
          vehicle_id: vehicleId,
          lap_time_ms: lapTimeMs,
          platform,
          standard_version: 'v0-draft',
          conditions: {},
          display_name_consent: consent,
          evidence,
        }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error ?? `The server answered ${res.status}. Please try again.`);

      const vehicleName = form.vehicle_id.selectedOptions[0]?.textContent ?? '';
      document.getElementById('success-text').textContent =
        `${lapInput.value} in the ${vehicleName}. ` +
        (body.publication_status === 'provisional' || body.publication_status === 'official'
          ? 'It is on the leaderboard now (provisional).'
          : 'A moderator checks it before it appears on the leaderboard.') +
        (videoUrl ? ' Your video will be reviewed for Video verified.' : '');
      document.getElementById('to-account').setAttribute('href', `${import.meta.env.BASE_URL}account/`);
      form.hidden = true;
      successEl.hidden = false;
      successEl.scrollIntoView({ block: 'start', behavior: 'smooth' });
    } catch (err) {
      showErrors([`<strong>Not submitted:</strong> ${err instanceof Error ? err.message : String(err)}`]);
    } finally {
      submitBtn.disabled = false;
      submitLabel.textContent = 'Submit Lap';
    }
  });

  document.getElementById('submit-another').addEventListener('click', () => {
    form.reset(); clearScreenshot(); clearErrors();
    successEl.hidden = true; form.hidden = false;
    form.scrollIntoView({ block: 'start', behavior: 'smooth' });
  });
</script>
