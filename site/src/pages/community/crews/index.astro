---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import HubSubnav from '../../../components/HubSubnav.astro';
import '../../../styles/hub.css';
import { sampleCrews, crewCardHtml, focusLabels, platformLabels } from '../../../data/hub';
import { PLATFORMS, ACTIVE_PLATFORMS } from '../../../data/platforms';

const initialHtml = sampleCrews.map((c) => crewCardHtml(c, undefined, { sample: true })).join('');
---
<Base
  title="GTA VI Racing Crews — Crew Directory"
  description="Find GTA 6 racing crews and car meet communities. Race competitively, run playlists for fun, and find a crew that races the way you do."
  section="hub"
  noindex={true /* until real crews/events replace the sample data (RS-0022) */}
>
  <PageHero status="hub" image="hub-crews" eyebrow="Find Your GTA VI Racing Crew" title="Crews" lede="Racing crews and car meet communities from across the GTA VI car scene. Race for the win, run playlists for fun, or bring your best build to the meet. Find a crew that races the way you do." />

  <HubSubnav active="crews" />

  <section class="wrap hub-body">
    <div class="hub-toolbar">
      <div class="hub-filters">
        <label class="ui-search hub-search"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg><input type="search" id="crew-search" placeholder="Search Crew" aria-label="Search crews by name or tag" /></label>
        <select class="ui-select" id="crew-focus" aria-label="Filter by focus">
          <option value="">All focus areas</option>
          {Object.entries(focusLabels).map(([k, v]) => <option value={k}>{v}</option>)}
        </select>
        <select class="ui-select" id="crew-lang" aria-label="Filter by language">
          <option value="">All languages</option>
        </select>
        <select class="ui-select" id="crew-platform" aria-label="Filter by platform">
          {PLATFORMS.map((p) => <option value={p.active && ACTIVE_PLATFORMS.length === 1 ? '' : p.id} disabled={!p.active} selected={p.id === 'ps5'}>{p.active ? p.label : `${p.label} — coming later`}</option>)}
        </select>
      </div>
      <span class="hub-sample-flag" id="crew-flag">Sample data — example crews, not real</span>
    </div>

    <div class="crew-me" id="crew-me" hidden aria-live="polite"></div>
    <div class="crew-grid" id="crew-root" set:html={initialHtml} />
    <p class="hub-empty" id="crew-empty" hidden>No crews match these filters.</p>

    <p class="hub-note">Want your crew listed? Apply as crew leader in <a href={`${import.meta.env.BASE_URL}account/crew/`}>My Account</a> — a moderator reviews it. Drivers can ask to join up to 5 listed crews right here; the crew leader approves.</p>
  </section>
</Base>

<script>
  import { crewCardHtml, esc, sampleCrews, type HubCrew } from '../../../data/hub';
  import { createCrewMembership } from '../../../scripts/crew-membership';
  import { languageLabel } from '../../../data/languages';
  import { fetchLiveCrews, fetchRoster } from '../../../scripts/hub-live';

  const root = document.getElementById('crew-root')!;
  const emptyEl = document.getElementById('crew-empty')!;
  const flagEl = document.getElementById('crew-flag')!;
  const search = document.getElementById('crew-search') as HTMLInputElement;
  const focusSel = document.getElementById('crew-focus') as HTMLSelectElement;
  const platSel = document.getElementById('crew-platform') as HTMLSelectElement;
  const langSel = document.getElementById('crew-lang') as HTMLSelectElement;

  // Language filter lists only languages that at least one shown crew uses
  // (fixed list of ~40 in data/languages.ts, 2026-09-30). Rebuilt whenever
  // the cards change (sample -> live), keeping the current choice if possible.
  function buildLanguageOptions() {
    const codes = new Set<string>();
    root.querySelectorAll<HTMLElement>('.crew-card').forEach((c) => (c.dataset.languages ?? '').split('|').filter(Boolean).forEach((x) => codes.add(x)));
    const keep = langSel.value;
    const sorted = [...codes].sort((a, b) => languageLabel(a).localeCompare(languageLabel(b)));
    langSel.innerHTML = '<option value="">All languages</option>' + sorted.map((c) => `<option value="${esc(c)}">${esc(languageLabel(c))}</option>`).join('');
    langSel.value = codes.has(keep) ? keep : '';
    langSel.hidden = codes.size === 0;
  }

  function applyFilters() {
    const q = search.value.trim().toLowerCase();
    const f = focusSel.value;
    const p = platSel.value;
    const l = langSel.value;
    let shown = 0;
    root.querySelectorAll<HTMLElement>('.crew-card').forEach((card) => {
      const ok =
        (!q || (card.dataset.search ?? '').includes(q)) &&
        (!f || (card.dataset.focus ?? '').split('|').includes(f)) &&
        (!l || (card.dataset.languages ?? '').split('|').includes(l)) &&
        (!p || (card.dataset.platforms ?? '').split('|').includes(p));
      card.hidden = !ok;
      if (ok) shown++;
    });
    emptyEl.hidden = shown > 0;
  }

  [search, focusSel, langSel, platSel].forEach((el) => el.addEventListener('input', applyFilters));
  buildLanguageOptions();
  // Deep link from the leaderboard crew tag: /community/crews/?q=TAG
  const q0 = new URLSearchParams(location.search).get('q');
  if (q0) { search.value = q0; applyFilters(); }

  // Crew membership (RS-0024; up to 5 crews + main crew, DEC-0093): shared module.
  let liveCrews: HubCrew[] = [];
  const membership = createCrewMembership(root, document.getElementById('crew-me')!);
  membership.setCrews(sampleCrews, false);

  let rosterMap = new Map<string, string[]>();
  function renderCards() {
    root.innerHTML = liveCrews.map((c) => crewCardHtml(c, rosterMap.get(c.crew_id!))).join('');
    buildLanguageOptions();
    applyFilters();
    membership.render();
  }
  async function init() {
    const live = await fetchLiveCrews();
    if (!live) return; // sample crews keep the demo membership UI
    liveCrews = live;
    flagEl.hidden = true;
    rosterMap = await fetchRoster();
    renderCards();
    // Deep link target for the redesigned home (DEC-0116): /community/crews/#crew-<id>.
    // Anchor + scroll only; the visual highlight comes with the redesign.
    const target = location.hash.startsWith('#crew-') ? document.getElementById(location.hash.slice(1)) : null;
    if (target) target.scrollIntoView({ block: 'center' });
    await membership.setCrews(liveCrews, true);
  }
  init();
</script>
