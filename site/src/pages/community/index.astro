---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import HubSubnav from '../../components/HubSubnav.astro';
import '../../styles/hub.css';
import { sampleEventsUpcoming, sampleCrews, eventRowHtml, crewCardHtml } from '../../data/hub';

const base = import.meta.env.BASE_URL;
const nextEventsHtml = sampleEventsUpcoming().filter((e) => e.status !== 'cancelled').slice(0, 3).map((e) => eventRowHtml(e, { rsvp: true, sample: true })).join('');
const crewsHtml = sampleCrews.slice(0, 3).map((c) => crewCardHtml(c, undefined, { sample: true })).join('');
---
<Base
  title="The Hub — GTA VI Racing Community"
  description="Find GTA 6 races, league rounds, car meets, crews, hosts, and creators. Connect with the racing community and car culture in The Hub."
  section="hub"
  noindex={false /* indexable since 2026-10-14 (Fausto): real crews exist; Tracks stays noindex */}
>
  <PageHero status="hub" image="hub" eyebrow="GTA VI Racing Community" title="The Hub" lede="Where the GTA VI racing scene meets. Find the next race, league round, or car meet. Connect with crews, hosts, and creators. Check out what the community is creating around GTA VI racing and car culture." />

  <HubSubnav active="overview" />

  <section class="wrap hub-body">
    <div class="hub-entry-grid">
      <a class="hub-entry" href={`${base}community/events/`}>
        <img class="hub-entry-img" src={`${base}images/hub/hub-entry-events-640.webp`} srcset={`${base}images/hub/hub-entry-events-640.webp 640w, ${base}images/hub/hub-entry-events-1280.webp 1280w`} sizes="(max-width: 700px) 100vw, 400px" alt="" width="640" height="360" loading="lazy" />
        <span class="hub-entry-body">
          <span class="eyebrow">Calendar</span>
          <strong class="display hub-entry-title">Events</strong>
          <span class="hub-entry-copy">Find races, racing leagues, community playlists, and car meets—all shown in your local time.</span>
          <span class="hub-entry-cta">Open calendar →</span>
        </span>
      </a>
      <a class="hub-entry" href={`${base}community/crews/`}>
        <img class="hub-entry-img" style="object-position: 50% 15%" src={`${base}images/hub/hub-entry-crews-640.webp`} srcset={`${base}images/hub/hub-entry-crews-640.webp 640w, ${base}images/hub/hub-entry-crews-1280.webp 1280w`} sizes="(max-width: 700px) 100vw, 400px" alt="" width="640" height="360" loading="lazy" />
        <span class="hub-entry-body">
          <span class="eyebrow">Directory</span>
          <strong class="display hub-entry-title">Crews</strong>
          <span class="hub-entry-copy">Find racing crews and car meet communities that fit the way you play.</span>
          <span class="hub-entry-cta">Browse crews →</span>
        </span>
      </a>
      <a class="hub-entry" href={`${base}community/tracks/`}>
        <img class="hub-entry-img" src={`${base}images/hub/hub-entry-tracks-640.webp`} srcset={`${base}images/hub/hub-entry-tracks-640.webp 640w, ${base}images/hub/hub-entry-tracks-1280.webp 1280w`} sizes="(max-width: 700px) 100vw, 400px" alt="" width="640" height="360" loading="lazy" />
        <span class="hub-entry-body">
          <span class="eyebrow">Race jobs</span>
          <strong class="display hub-entry-title">Tracks</strong>
          <span class="hub-entry-copy">Find community-built race jobs for your next playlist, discover creators, or share your own when creation tools go live.</span>
          <span class="hub-entry-cta">Find tracks →</span>
        </span>
      </a>
    </div>

    <!-- Discord strip (RS-0076): direct invite + the info page -->
    <div class="hub-discord">
      <div class="hub-discord-copy">
        <strong>The community lives on Discord</strong>
        <span>Find people to drive with, grab a spot in the next race and talk cars between events.</span>
      </div>
      <div class="hub-discord-act">
        <a class="btn btn-p btn-sm" href="https://discord.gg/hPGuBwXRqT" target="_blank" rel="noopener">Join the Discord</a>
        <a class="arrow" href={`${base}discord/`}>What’s on the server →</a>
      </div>
    </div>

    <div class="hub-block-head">
      <h2 class="display hub-block-title">Next Up</h2>
      <span class="hub-sample-flag" id="hub-ev-flag">Sample data</span>
      <a class="hub-block-link" href={`${base}community/events/`}>All events</a>
    </div>
    <div class="ev-list" id="hub-ev-root" set:html={nextEventsHtml} />

    <div class="hub-block-head">
      <h2 class="display hub-block-title">Featured Crews</h2>
      <span class="hub-sample-flag" id="hub-crew-flag">Sample data</span>
      <a class="hub-block-link" href={`${base}community/crews/`}>All crews</a>
    </div>
    <div class="crew-me" id="hub-crew-me" hidden aria-live="polite"></div>
    <div class="crew-grid" id="hub-crew-root" set:html={crewsHtml} />
  </section>
</Base>

<style>
  .hub-entry-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gh-gap-card); margin-bottom: 1rem; }
  .hub-entry { display: flex; flex-direction: column; overflow: hidden; background: var(--gh-surface); border: 1px solid var(--gh-line); border-radius: var(--gh-radius-lg); text-decoration: none; transition: border-color .15s; }
  .hub-entry-img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 7; object-fit: cover; object-position: 50% 40%; background: rgba(200,200,222,.08); }
  .hub-entry-body { display: flex; flex-direction: column; gap: .5rem; padding: var(--gh-pad-card); }
  .hub-entry:hover { border-color: var(--gh-muted); }
  @media (max-width: 900px) { .hub-entry-grid { grid-template-columns: 1fr; } }
  .hub-entry-title { font-size: 2rem; }
  .hub-entry-copy { color: var(--gh-muted); font-size: .92rem; line-height: 1.55; }
  .hub-entry-cta { margin-top: .4rem; color: var(--gh-red); font-weight: 800; font-size: .85rem; }
  .hub-discord { display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; margin-top: 1.5rem; padding: 1rem 1.25rem; border-radius: var(--gh-radius-lg); background: linear-gradient(100deg, rgba(42,31,158,.35), rgba(177,42,140,.22) 55%, rgba(242,106,61,.16)), var(--lr-card); border: 1px solid var(--lr-line-strong); }
  .hub-discord-copy { display: flex; flex-direction: column; gap: .25rem; min-width: 0; flex: 1 1 22rem; }
  .hub-discord-copy strong { font-size: 1.05rem; }
  .hub-discord-copy span { color: var(--lr-soft); font-size: .92rem; line-height: 1.5; }
  .hub-discord-act { display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap; }
  .hub-block-head { display: flex; align-items: center; gap: .75rem; margin: 2.75rem 0 1rem; }
  .hub-block-title { margin: 0; font-size: 1.5rem; }
  .hub-block-link { margin-left: auto; color: var(--gh-muted); font-size: .85rem; font-weight: 700; }
  .hub-block-link:hover { color: var(--gh-text); }
</style>

<script>
  import { eventRowHtml, crewCardHtml, localizeTimes, sampleEventsUpcoming, sampleCrews } from '../../data/hub';
  import { createCrewMembership } from '../../scripts/crew-membership';
  import { fetchLiveEvents, fetchLiveCrews, pickFeaturedCrews } from '../../scripts/hub-live';
  import { createEventRsvp } from '../../scripts/event-rsvp';

  // "Next Up" with the same sign-up functions as the Event Calendar (2026-10-02)
  const evRoot = document.getElementById('hub-ev-root')!;
  const rsvp = createEventRsvp(evRoot);
  localizeTimes(evRoot);
  rsvp.setEvents(sampleEventsUpcoming().filter((e) => e.status !== 'cancelled').slice(0, 3), false);
  rsvp.renderRsvps();
  fetchLiveEvents().then(async (live) => {
    if (!live) return;
    const next = live.filter((e) => e.status !== 'cancelled').slice(0, 3);
    evRoot.innerHTML = next.map((e) => eventRowHtml(e, { rsvp: true })).join('');
    localizeTimes(evRoot);
    document.getElementById('hub-ev-flag')!.hidden = true;
    rsvp.setEvents(next, true);
    rsvp.renderRsvps();
    await rsvp.connect();
  });
  // Crew cards with "Request to join" + Discord, same as The Hub > Crews (2026-10-02)
  const crewMembership = createCrewMembership(document.getElementById('hub-crew-root')!, document.getElementById('hub-crew-me')!);
  crewMembership.setCrews(sampleCrews, false);
  fetchLiveCrews().then((live) => {
    if (!live) return;
    document.getElementById('hub-crew-root')!.innerHTML = pickFeaturedCrews(live, 3).map((c) => crewCardHtml(c)).join('');
    document.getElementById('hub-crew-flag')!.hidden = true;
    crewMembership.setCrews(live, true);
  });
</script>
