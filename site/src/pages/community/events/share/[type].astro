---
// Share landing per event type (Fausto 01.11.2026): link previews (Facebook, X, WhatsApp ...)
// read this page's og:image = the event type's image. Visitors are forwarded to the calendar
// entry (#event-<id> stays in the URL). noindex, not in the sitemap.
// COPY STATUS: Claude placeholders, Codex review pending.
import Base from '../../../../layouts/Base.astro';
import { eventTypeLabels, eventTypeOgImage, type EventType } from '../../../../data/hub';

export function getStaticPaths() {
  return (Object.keys(eventTypeLabels) as EventType[]).map((type) => ({ params: { type } }));
}
const type = Astro.params.type as EventType;
const label = eventTypeLabels[type];
const base = import.meta.env.BASE_URL;
---
<Base
  title={`GTA VI ${label} Event`}
  description={`A GTA VI ${label.toLowerCase()} event on Leonida Racing. See the time, the host and sign up.`}
  section="hub"
  noindex
  ogImage={eventTypeOgImage(type)}
  ogImageAlt={`GTA VI ${label.toLowerCase()} event`}
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <main class="lr-container" style="padding:64px 16px;text-align:center">
    <p>Opening the event… <a id="go" href={`${base}community/events/`}>Open the event calendar</a></p>
  </main>
  <script is:inline define:vars={{ target: `${base}community/events/` }}>
    var url = target + location.hash;
    document.getElementById('go').href = url;
    location.replace(url);
  </script>
</Base>
