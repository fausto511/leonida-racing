---
// Features page (RS-0127, Fausto 15.11.2026): everything a free account can do, so search engines and
// AI assistants can see the full feature set. Linked from the footer (More) and the phone menu for guests.
// Facts checked against the code on 15.11.2026 (account/*, community/*, discord/*, RoleApply, VerifyRequest).
// COPY STATUS: Codex review 15.11. (Codex Zuarbeit/Features-Seite-Review-2026-11-15.md) applied 16.11. with Claude's
// counter-proposals, all approved by Fausto 16.11. (DEC-0088/0103).
// Time Attack note: Fausto 16.11. -- submissions open on launch day; the date-based note stays.
// Before launch the Time Attack lines say that submissions open on launch day (build-time check,
// same rule as GarageTaxonomy); after the launch date the next build drops that note.
import Base from '../../layouts/Base.astro';
import DiscordBand from '../../components/DiscordBand.astro';
import { FREE_PROMISE } from '../../data/site';
import { LAUNCH_DATE, LAUNCH_AT, LAUNCH_LABEL } from '../../data/launch';
const base = import.meta.env.BASE_URL;
const launched = Date.now() >= new Date(LAUNCH_AT ?? `${LAUNCH_DATE}T00:00:00Z`).getTime();
const taNote = launched ? '' : ` Submissions open on launch day, ${LAUNCH_LABEL}.`;

type Card = { t: string; c: string; href: string; go: string; i: string; list?: string[] };
type Section = { id: string; h: string; intro?: string; tone: 'pink' | 'orange' | 'discord' | 'soft'; cards: Card[] };

// stroke icons on the 24px grid (same style as the About page)
const I = {
  garage: 'M3 21V9l9-6 9 6v12 M7 21v-7h10v7',
  heart: 'M19 14c1.5-1.5 3-3.3 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7Z',
  pie: 'M21 12a9 9 0 1 1-9-9v9z M15 3.5A9 9 0 0 1 20.5 9H15z',
  star: 'm12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z',
  timer: 'M10 2h4 M12 14l3-3 M20 14a8 8 0 1 1-16 0a8 8 0 0 1 16 0',
  trophy: 'M6 9H4.5a2.5 2.5 0 0 1 0-5H6 M18 9h1.5a2.5 2.5 0 0 0 0-5H18 M6 3h12v7a6 6 0 0 1-12 0z M12 16v4 M8 21h8',
  list: 'M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01',
  check: 'M9 11l3 3L22 4 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
  search: 'M18 11a7 7 0 1 1-14 0a7 7 0 0 1 14 0 M20 20l-3.5-3.5',
  term: 'm4 17 6-5-6-5 M12 19h8',
  bot: 'M6 8h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z M12 8V4 M9 14h.01 M15 14h.01',
  video: 'M4 5h11a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z m13 5 5-3v10l-5-3',
  users: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M13 7a4 4 0 1 1-8 0a4 4 0 0 1 8 0 M22 21v-2a4 4 0 0 0-3-3.9 M16 3.1a4 4 0 0 1 0 7.8',
  tag: 'M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z M8 7.5a.5.5 0 1 1-1 0a.5.5 0 0 1 1 0',
  crown: 'M2 20h20 M4 20 3 8l5 4 4-7 4 7 5-4-1 12',
  cal: 'M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M16 3v4 M8 3v4 M3 11h18',
  send: 'M3 11l18-7-7 18-2-8z',
  bookmark: 'M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z',
  pen: 'M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z',
  lock: 'M6 11h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4',
  user: 'M16 8a4 4 0 1 1-8 0a4 4 0 0 1 8 0 M4 21a8 8 0 0 1 16 0',
  gauge: 'M12 13l4-4 M3.3 19a10 10 0 1 1 17.4 0',
  shield: 'M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z m-3 9 2 2 4-4',
  trash: 'M3 6h18 M8 6V4h8v2 M6 6l1 15h10l1-15',
  parking: 'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M9 17V7h4a3 3 0 0 1 0 6H9',
};

const highlights: Card[] = [
  { t: 'Your private garage', c: 'Track the GTA VI cars you own, park them in your in-game garages, keep a wishlist and see your collection by class and manufacturer.', href: 'account/', go: 'Open your garage', i: I.garage },
  { t: 'Reviewed lap times', c: `Every Time Attack lap at Gellhorn International Raceway is checked by a moderator before it appears on the leaderboard. Laps with a full video can be marked Video verified.${taNote}`, href: 'time-attack/gellhorn-international-raceway/', go: 'See Time Attack', i: I.timer },
  { t: 'Built into Discord', c: 'Sign up for events, find players and look up cars without leaving Discord. Server admins can add our bot to post events and more.', href: 'discord/', go: 'See the Discord server', i: I.check },
];

const sections: Section[] = [
  { id: 'garage', h: 'Your garage', intro: 'Private to you.', tone: 'orange', cards: [
    { t: 'My cars', c: 'Mark the cars you own in GTA VI, on any car page or straight from your garage. Only you can see this list.', href: 'account/', go: 'Open My cars', i: I.garage },
    { t: 'Wishlist', c: 'Save the cars you want next with the heart on any car page. When you buy one, mark it as owned and it moves to My cars.', href: 'account/#wishlist', go: 'Open Wishlist', i: I.heart },
    { t: 'Collection', c: 'See how much of each class and manufacturer you own.', href: 'account/#collection', go: 'Open Collection', i: I.pie },
    // RS-0088 (Fausto 22.11.2026). COPY: Claude placeholder -> Codex (DEC-0088).
    { t: 'Garages', c: 'Add the garages you own in GTA VI and park your cars in them. Each garage holds as many cars as it has spaces in the game, so you see at a glance where there is still room.', href: 'account/#garages', go: 'Open Garages', i: I.parking },
    { t: 'Car ratings', c: 'Rate GTA VI cars. Each car shows the average rating once enough players have rated it.', href: 'cars/', go: 'Browse cars', i: I.star },
  ] },
  { id: 'laps', h: 'Lap times', tone: 'pink', cards: [
    { t: 'Time Attack', c: `Submit your lap at Gellhorn International Raceway with a results screenshot or a full lap video. A moderator checks it before it goes live on the leaderboard.${taNote}`, href: 'time-attack/submit/', go: 'Submit a lap', i: I.timer },
    { t: 'My records', c: 'Your personal best for each car you’ve submitted a lap with.', href: 'account/laps/', go: 'Open My records', i: I.trophy },
    { t: 'My submissions', c: 'Every lap you’ve sent, including the ones still in review.', list: ['Correct a lap when asked, or withdraw it before review', 'Add a video later'], href: 'account/laps/', go: 'Open My submissions', i: I.list },
  ] },
  { id: 'discord', h: 'Discord', intro: 'The site and our Discord server work together.', tone: 'discord', cards: [
    { t: 'Sign up from Discord', c: 'Published events appear as cards in #events. Hit I’m in to sign up through your linked account.', href: 'discord/', go: 'See the server', i: I.check },
    { t: 'Find Players', c: 'Start a search in #lfg for a race, cruise, car meet or photo session. The bot opens a temporary voice channel for your group.', href: 'discord/', go: 'See the server', i: I.search },
    { t: '/car and /compare', c: 'Look up car data and compare cars right in Discord.', href: 'discord/bot/', go: 'See the commands', i: I.term },
    { t: 'Event bot for your server', c: 'Add the Leonida Racing bot to your own server and pick a feed: events, new cars, records or videos.', href: 'discord/bot/', go: 'Add the bot', i: I.bot },
    { t: '!car in your stream chat', c: 'Streamers can add a !car command with Nightbot or StreamElements.', href: 'discord/bot/', go: 'Set it up', i: I.video },
  ] },
  { id: 'crews', h: 'Crews', tone: 'orange', cards: [
    { t: 'Join a crew', c: 'Find a racing crew or car meet crew and send a join request, or accept an invite. You can be in up to five crews.', href: 'community/crews/', go: 'Browse crews', i: I.users },
    { t: 'Crew tag', c: 'Pick your active crew. Its tag shows next to your name.', href: 'account/crew/', go: 'Open My crews', i: I.tag },
    { t: 'Lead a crew', c: 'List your crew after a short application. Approve or decline join requests and manage your crew.', href: 'account/crew/', go: 'Apply as crew leader', i: I.crown },
  ] },
  { id: 'events', h: 'Events & tracks', tone: 'pink', cards: [
    { t: 'Sign up for events', c: 'Races, leagues, car meets and cruises. Start times show in your local time, and Events I’m going to keeps your sign-ups in one place.', href: 'community/events/', go: 'See the calendar', i: I.cal },
    { t: 'Host events', c: 'Submit your own events. A moderator reviews them before they go live until you’re a trusted host.', list: ['Single events, series and championships with rounds', 'Repeating dates and a participant limit', 'See who signed up', 'Some changes need moderator approval'], href: 'account/events/', go: 'Create an event', i: I.send },
    { t: 'Saved tracks', c: 'Save race jobs to your list and open them on Social Club.', href: 'community/tracks/', go: 'Browse tracks', i: I.bookmark },
    { t: 'Submit your tracks', c: 'Track creators can submit their own race jobs after applying. A moderator checks the details before publishing.', href: 'account/tracks/', go: 'Apply as creator', i: I.pen },
  ] },
  { id: 'account', h: 'Your account', tone: 'soft', cards: [
    { t: 'Discord login', c: 'No new password. You also join our Discord server automatically.', href: 'discord/', go: 'About the server', i: I.lock },
    { t: 'Display name', c: 'The name shown on leaderboards, crews and events. Add your PSN name if you like.', href: 'account/settings/', go: 'Open Settings', i: I.user },
    { t: 'km/h or mph', c: 'Pick the units you’re used to.', href: 'account/settings/', go: 'Open Settings', i: I.gauge },
    { t: 'Verified badge', c: 'Known in the scene? Request a verified badge in Settings. Crew leaders can request one for their crew.', href: 'account/settings/', go: 'Request it', i: I.shield },
    { t: 'Delete your account', c: 'Deletes your login, garage, crews and other personal data. Published lap times stay on the leaderboard as Deleted driver.', href: 'account/settings/', go: 'Open Settings', i: I.trash },
  ] },
];

const faq = [
  { q: 'Is Leonida Racing free?', a: 'Yes. Every feature is free. There are no ads and no paid features.' }, // keep in line with FREE_PROMISE (data/site.ts)
  { q: 'Where can I track the GTA 6 cars I own?', a: 'In My cars. Mark a car as owned on its car page or in your garage. Your wishlist works the same way.' },
  { q: 'Can I sort my cars into my GTA 6 garages?', a: 'Yes. In Garages, add the garages you own in the game and park your cars in them. Each garage takes as many cars as it has spaces.' },
  { q: 'Can other people see my garage?', a: 'No. My cars, Wishlist, Collection and Garages are private.' },
  { q: 'Do I have to use my real name on the leaderboard?', a: 'Your display name is what others see. Pick any name you like and change it in Settings.' },
  { q: 'Is there a GTA 6 Discord bot?', a: 'Yes. Add it to your server to post your events, or try /car and /compare on our Discord first.' },
  { q: 'What do I need to sign up?', a: 'A Discord account. Click Log in with Discord at the top of any page.' },
];

const open = [
  { t: 'Compare cars', c: 'Up to four GTA VI cars side by side: cost to register, top speed, Gellhorn lap times, ratings and more.', href: 'cars/compare/' },
  { t: 'Rankings', c: 'Cars ranked by tested stock values once enough cars in a group have been measured.', href: 'cars/rankings/' },
  { t: 'Classes, manufacturers & families', c: 'Browse every car by class, manufacturer or model family.', href: 'cars/classes/' },
  { t: 'New cars', c: 'Officially revealed GTA VI cars with no counterpart in an earlier GTA game.', href: 'cars/new-cars/' },
  { t: 'Community tracks', c: 'Race jobs by type, layout, vehicle class and lobby size.', href: 'community/tracks/' },
  { t: 'Racing guide', c: 'What is confirmed about racing in GTA VI, and what is still open.', href: 'guide/' },
];

const jump = [...sections.map((s) => ({ id: s.id, h: s.h })), { id: 'faq', h: 'FAQ' }, { id: 'open', h: 'No account needed' }];
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base
  title="Free GTA 6 Garage, Lap Times & Crews"
  description={`Track the GTA 6 cars you own, post lap times, join a crew and sign up for events. Free with Discord login. ${FREE_PROMISE}`}
  breadcrumbs={[{ name: 'Features', path: 'features/' }]}
  jsonLd={jsonLd}
>
  <section class="lr-band-plain">
    <div class="wrap lr-band-in is-compact ft-band">
      <nav class="lr-crumb" aria-label="Breadcrumb"><a href={base}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Features</span></nav>
      <p class="eyebrow">Free account</p>
      <h1 class="display lr-t1 ft-h1">Free GTA 6 garage tracker, lap times &amp; crews</h1>
      <p class="lr-lede">Leonida Racing is free. Log in with Discord to keep track of your GTA VI cars, post lap times, join a crew and sign up for events. {FREE_PROMISE}</p>
      <div class="ft-cta">
        <a class="btn btn-discord" id="ft-login" href={`${base}account/`}>Log in with Discord</a>
        <a class="btn btn-s" href="#faq">Questions</a>
      </div>
    </div>
  </section>

  <div class="wrap ft">
    <div class="ft-hl">
      {highlights.map((h) => (
        <a class="card ft-hl-card" href={`${base}${h.href}`}>
          <svg class="ft-ico is-pink" viewBox="0 0 24 24" aria-hidden="true"><path d={h.i} /></svg>
          <h2 class="display">{h.t}</h2>
          <p>{h.c}</p>
          <span class="ft-go">{h.go} →</span>
        </a>
      ))}
    </div>

    <nav class="ft-jump" aria-label="On this page">
      {jump.map((j) => <a href={`#${j.id}`}>{j.h}</a>)}
    </nav>

    {sections.map((s, n) => (
      <section class="ft-sec" id={s.id} aria-labelledby={`${s.id}-h`}>
        <p class="eyebrow ft-eb">{String(n + 1).padStart(2, '0')}</p>
        <h2 class="lr-h2" id={`${s.id}-h`}>{s.h}</h2>
        {s.intro && <p class="ft-intro">{s.intro}</p>}
        <div class="ft-grid">
          {s.cards.map((c) => (
            <a class="card ft-card" href={`${base}${c.href}`}>
              <svg class:list={['ft-ico', `is-${s.tone}`]} viewBox="0 0 24 24" aria-hidden="true"><path d={c.i} /></svg>
              <h3>{c.t}</h3>
              <p>{c.c}</p>
              {c.list && <ul>{c.list.map((l) => <li>{l}</li>)}</ul>}
              <span class="ft-go">{c.go} →</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="ft-sec" id="faq" aria-labelledby="faq-h">
      <p class="eyebrow ft-eb">FAQ</p>
      <h2 class="lr-h2" id="faq-h">Questions</h2>
      <div class="ft-faq">
        {faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p></div>)}
      </div>
    </section>

    <section class="ft-sec" id="open" aria-labelledby="open-h">
      <p class="eyebrow ft-eb">No account needed</p>
      <h2 class="lr-h2" id="open-h">Open to everyone</h2>
      <p class="ft-intro">The car database, the guide and the community pages work without logging in.</p>
      <div class="ft-open">
        {open.map((o) => <a href={`${base}${o.href}`}><strong>{o.t}</strong><span>{o.c}</span></a>)}
      </div>
    </section>
  </div>

  <DiscordBand />
</Base>

<style>
  .ft-h1 { max-width: 900px; }
  .ft-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .ft { padding-top: var(--lr-gap-head); padding-bottom: var(--lr-gap-sec); }

  /* three key features */
  .ft-hl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .ft-hl-card { display: flex; flex-direction: column; gap: 10px; padding: 24px; text-decoration: none; color: var(--lr-text); border-color: rgba(242,75,157,.35); transition: border-color .15s, background .15s; }
  .ft-hl-card h2 { margin: 6px 0 0; font-size: 22px; line-height: 1; }
  .ft-hl-card p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--lr-soft); }

  .ft-jump { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 32px; font-size: 14px; font-weight: 600; }
  .ft-jump a { color: var(--lr-soft); text-decoration: none; }
  .ft-jump a:hover { color: var(--lr-orange); }

  .ft-sec { padding-top: var(--lr-gap-sec); scroll-margin-top: 80px; }
  .ft-eb { margin: 0 0 8px; }
  .ft-intro { margin: 8px 0 0; max-width: 640px; font-size: 15px; color: var(--lr-soft); }
  .ft-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; margin-top: 22px; }
  .ft-card { display: flex; flex-direction: column; gap: 8px; padding: 22px; text-decoration: none; color: var(--lr-text); transition: border-color .15s, background .15s; }
  .ft-card h3 { margin: 6px 0 0; font-size: var(--lr-h3-s); font-weight: 700; }
  .ft-card p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--lr-soft); }
  .ft-card ul { margin: 2px 0 0; padding-left: 18px; font-size: 14px; line-height: 1.5; color: var(--lr-soft); }
  .ft-card li + li { margin-top: 3px; }
  .ft-hl-card:hover, .ft-card:hover { border-color: rgba(242,75,157,.6); background: var(--lr-raised); }
  .ft-hl-card:focus-visible, .ft-card:focus-visible { outline: 2px solid var(--lr-orange); outline-offset: 2px; }
  .ft-go { margin-top: auto; padding-top: 8px; font-size: 14px; font-weight: 600; color: var(--lr-orange); }

  .ft-ico { width: 26px; height: 26px; flex: none; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .is-pink { stroke: var(--lr-pink); }
  .is-orange { stroke: var(--lr-orange); }
  .is-discord { stroke: #8C95FF; }
  .is-soft { stroke: var(--lr-soft); }

  .ft-faq { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; margin-top: 22px; border-top: 1px solid var(--lr-line); }
  .ft-faq div { padding: 20px 0; border-bottom: 1px solid var(--lr-line); }
  .ft-faq h3 { margin: 0 0 6px; font-size: 17px; font-weight: 700; }
  .ft-faq p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--lr-soft); }

  .ft-open { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; margin-top: 22px; border-top: 1px solid var(--lr-line); }
  .ft-open a { display: block; padding: 16px 0; border-bottom: 1px solid var(--lr-line); text-decoration: none; }
  .ft-open strong { display: block; font-size: 16px; color: var(--lr-text); }
  .ft-open span { display: block; margin-top: 2px; font-size: 14px; color: var(--lr-soft); }
  .ft-open a:hover strong { color: var(--lr-orange); }

  @media (max-width: 1000px) {
    .ft-hl { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .ft-cta .btn { flex: 1 1 auto; justify-content: center; }
    .ft-jump { flex-wrap: nowrap; overflow-x: auto; white-space: nowrap; gap: 18px; margin-inline: calc(-1 * clamp(1.25rem, 4vw, 2.5rem)); padding: 0 clamp(1.25rem, 4vw, 2.5rem) 6px; }
    .ft-hl-card { padding: 18px; }
    .ft-hl-card h2 { font-size: 19px; }
    .ft-grid { gap: 10px; margin-top: 18px; }
    .ft-card { display: grid; grid-template-columns: 22px minmax(0, 1fr); column-gap: 14px; row-gap: 4px; padding: 16px; }
    .ft-card > .ft-ico { width: 22px; height: 22px; grid-row: 1 / span 5; }
    .ft-card > :not(.ft-ico) { grid-column: 2; }
    .ft-card h3 { margin: 0; font-size: 16px; }
    .ft-card p { font-size: 14px; }
    .ft-go { padding-top: 4px; font-size: 13px; }
    .ft-faq, .ft-open { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Hero button: guests start the Discord login right here (same call as DiscordBand); logged in -> garage.
  import { getSupabase, backendConfigured } from '../../scripts/supabase-client';
  const btn = document.getElementById('ft-login') as HTMLAnchorElement | null;
  if (btn && backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => {
      if (data?.session) { btn.textContent = 'Open your garage'; return; }
      btn.addEventListener('click', (e) => {
        if (document.documentElement.classList.contains('lr-authed')) return;
        e.preventDefault();
        sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
      });
    });
  }
</script>
