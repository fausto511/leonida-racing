---
// The Guide (/guide/): one sourced overview page. No /guide/... sub-pages
// until they have enough own sourced content (Codex handoff 2026-10-02).
// Copy and corrections: see data/guide.ts.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import GuideSubnav from '../../components/GuideSubnav.astro';
import { SITE_NAME } from '../../data/site';
import { GUIDE_PUBLISHED, GUIDE_UPDATED, GUIDE_VEHICLES, guideHeroImage, type GuideImage, guideCoverage, guideFaq, guideMethodology, guideSections } from '../../data/guide';

const base = import.meta.env.BASE_URL;
const title = 'The Guide — GTA VI Cars, Tuning & Racing';
const description = 'Explore sourced information on GTA 6 cars, driving physics, car theft, customization, mod shops, garages, racing, car meets, and Gellhorn.';
const updatedLabel = new Date(`${GUIDE_UPDATED}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
// Vehicle card = approximate GTA VI total (not the Garage count); note in Methodology.
const pageUrl = new URL(`${base}guide/`, Astro.site).href;
// Internal links in the copy use {base}; JSON-LD uses the plain FAQ text.
const withBase = (html: string) => html.replaceAll('{base}', base);
const srcset = (i: GuideImage) => i.widths.map((w) => `${base}images/guide/${i.key}-${w}.webp ${w}w`).join(', ');
const src = (i: GuideImage) => `${base}images/guide/${i.key}-${i.widths[Math.min(1, i.widths.length - 1)]}.webp`;
const org = { '@type': 'Organization', name: SITE_NAME, url: new URL(base, Astro.site).href };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    // Full ISO 8601 with time zone (Google flags date-only values); noon UTC like the visible label.
    datePublished: `${GUIDE_PUBLISHED}T12:00:00Z`,
    dateModified: `${GUIDE_UPDATED}T12:00:00Z`,
    author: org,
    publisher: org,
    image: new URL(`${base}images/guide/og-guide.jpg`, Astro.site).href,
    about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI', alternateName: ['GTA VI', 'GTA 6'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guideFaq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={title} description={description} section="guide" jsonLd={jsonLd} breadcrumbs={[{ name: 'The Guide', path: 'guide/' }]} ogImage="images/guide/og-guide.jpg" ogImageAlt={guideHeroImage.alt} ogImageWidth={1200} ogImageHeight={630}>
  <PageHero status="guide" image="guide" eyebrow="GTA VI Vehicle Knowledge" title="The Guide" lede="The sourced guide to GTA VI cars, driving, customization, garages, racing, and car culture. See what Rockstar has confirmed, what official footage shows, and which details are still open." />
  <GuideSubnav />

  <section class="wrap gd-head">
    <div class="gd-stats">
      <a class="panel gd-stat" href="#vehicle-count"><strong>{GUIDE_VEHICLES.value}</strong><span>{GUIDE_VEHICLES.label}</span></a>
      <div class="panel gd-stat"><strong>3</strong><span>Racing Formats Shown</span></div>
      <div class="panel gd-stat"><strong>2</strong><span>Named Mod Shops</span></div>
      <div class="panel gd-stat"><strong class="gd-stat-date"><time datetime={GUIDE_UPDATED}>{updatedLabel}</time></strong><span>Updated</span></div>
    </div>
    <p class="gd-note">This page follows official Rockstar material and on-record developer interviews. Visible details are described as shown, without turning them into features Rockstar has not announced.</p>

  </section>

  <div class="wrap gd-body">
    {guideSections.map((s) => (
      <section class="gd-sec" id={s.id} aria-labelledby={`${s.id}-h`}>
        <h2 class="gd-h2" id={`${s.id}-h`}>{s.title}</h2>
        {s.status && <p class="gd-status"><span class="gd-status-k">Status:</span> {s.status}</p>}
        {s.paragraphs.map((p, i) => (
          <Fragment>
            <p class="gd-p" set:html={withBase(p)} />
            {i === 0 && s.images && (
              <div class:list={['gd-figs', { 'gd-figs-2': s.images.length > 1 }]}>
                {s.images.map((im) => (
                  <figure class="gd-fig">
                    <img src={src(im)} srcset={srcset(im)} sizes={s.images!.length > 1 ? '(max-width: 760px) 100vw, 390px' : '(max-width: 860px) 100vw, 780px'} width={im.w} height={im.h} alt={im.alt} loading="lazy" decoding="async" />
                    <figcaption>{im.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </Fragment>
        ))}
        {s.cta && <a class="btn btn-outline gd-cta" href={`${base}${s.cta.href}`}>{s.cta.label} →</a>}
        <div class="gd-sources">
          <p class="gd-sources-h">{s.sourcesHeading ?? 'Sources for this section'}</p>
          <ul>
            {s.sources.map((src) => (
              <li><a href={src.url} target="_blank" rel="noopener">{src.label}</a>{src.note ? `: ${src.note}` : ''}</li>
            ))}
          </ul>
        </div>
      </section>
    ))}

    <section class="gd-sec" id="coverage" aria-labelledby="coverage-h">
      <h2 class="gd-h2" id="coverage-h">How Leonida Racing Covers GTA VI Cars and Racing</h2>
      {guideCoverage.map((c) => <p class="gd-p"><strong>{c.name}</strong> {c.text}</p>)}
      <div class="gd-ctas">
        <a class="btn btn-outline" href={`${base}garage/`}>Explore The Garage</a>
        <a class="btn btn-outline" href={`${base}time-attack/gellhorn-international-raceway/`}>Visit Time Attack</a>
        <a class="btn btn-outline" href={`${base}hub/`}>Open The Hub</a>
      </div>
    </section>

    <section class="gd-sec" id="faq" aria-labelledby="faq-h">
      <h2 class="gd-h2" id="faq-h">Frequently Asked Questions</h2>
      {guideFaq.map((f) => (
        <div class="gd-faq">
          <h3 class="gd-h3">{f.q}</h3>
          <p class="gd-p" set:html={withBase(f.aHtml ?? f.a)} />
        </div>
      ))}
    </section>

    <section class="gd-sec" id="sources" aria-labelledby="sources-h">
      <h2 class="gd-h2" id="sources-h">Methodology and Source Note</h2>
      {guideMethodology.map((p) => <p class="gd-p" set:html={p} />)}
      <p class="gd-p" id="vehicle-count"><strong>{GUIDE_VEHICLES.value} {GUIDE_VEHICLES.label}:</strong> <a href={GUIDE_VEHICLES.sourceUrl} target="_blank" rel="noopener">{GUIDE_VEHICLES.sourceLabel}</a> {GUIDE_VEHICLES.note}</p>
      <p class="gd-updated">Last updated: <time datetime={GUIDE_UPDATED}>{updatedLabel}</time></p>
      <p class="gd-indep">Leonida Racing is an independent community project and is not affiliated with Rockstar Games or Take-Two Interactive.</p>
    </section>
  </div>
</Base>

<style>
  .gd-fig { margin: 0; }
  .gd-fig img { display: block; width: 100%; height: auto; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: var(--gh-surface); }
  .gd-fig figcaption { margin-top: .4rem; color: var(--gh-muted); font-size: .76rem; line-height: 1.4; }
  .gd-figs { margin: .4rem 0 1.2rem; }
  .gd-figs-2 { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .gd-figs-2 img { aspect-ratio: 16 / 9; object-fit: cover; }
  .gd-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin-top: 0; }
  .gd-stat { display: flex; flex-direction: column; gap: .3rem; padding: 1rem 1.1rem; color: var(--gh-text); text-decoration: none; }
  a.gd-stat:hover { border-color: var(--gh-muted); }
  .gd-stat strong { font-family: var(--gh-font-display); font-style: italic; font-weight: 900; font-size: 2rem; line-height: 1; color: var(--gh-yellow); }
  .gd-stat strong.gd-stat-date { font-size: 1.15rem; line-height: 1.75rem; }
  .gd-stat span { color: var(--gh-muted); font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
  .gd-note { max-width: 70ch; margin: .9rem 0 0; color: var(--gh-muted); font-size: .85rem; line-height: 1.55; }
  .gd-body > .gd-sec { max-width: 780px; }
  .gd-sec { padding-top: 2.5rem; scroll-margin-top: 5rem; }
  .gd-h2 { margin: 0 0 .6rem; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(1.35rem, 3vw, 1.75rem); line-height: 1.1; }
  .gd-h3 { margin: 1.25rem 0 .35rem; font-size: 1.02rem; font-weight: 800; }
  .gd-status { display: inline-block; margin: 0 0 .9rem; padding: .25rem .65rem; border: 1px solid var(--gh-yellow); border-radius: var(--gh-radius); color: var(--gh-yellow); font-size: .74rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
  .gd-status-k { color: var(--gh-muted); }
  .gd-p { margin: 0 0 .9rem; line-height: 1.7; font-size: 1rem; }
  .gd-p :global(strong) { color: var(--gh-text); }
  .gd-p :global(a) { color: var(--gh-text); text-decoration: underline; text-decoration-color: var(--gh-red); text-underline-offset: 3px; }
  .gd-p :global(a:hover) { color: var(--gh-yellow); }
  .gd-cta { margin: .2rem 0 .4rem; padding: .6rem 1.1rem; font-size: .85rem; }
  .gd-ctas { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .4rem; }
  .gd-ctas .btn { padding: .6rem 1.1rem; font-size: .85rem; }
  .gd-sources { margin-top: 1rem; padding: .85rem 1rem; border-left: 2px solid var(--gh-line); background: color-mix(in srgb, var(--gh-surface) 55%, transparent); border-radius: 0 var(--gh-radius) var(--gh-radius) 0; }
  .gd-sources-h { margin: 0 0 .4rem; color: var(--gh-muted); font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
  .gd-sources ul { margin: 0; padding-left: 1.1rem; color: var(--gh-muted); font-size: .82rem; line-height: 1.55; }
  .gd-sources li + li { margin-top: .3rem; }
  .gd-sources a { color: var(--gh-text); text-underline-offset: 2px; }
  .gd-faq + .gd-faq { border-top: 1px solid var(--gh-line); }
  .gd-updated { margin: 1.25rem 0 .3rem; font-weight: 700; }
  .gd-indep { margin: 0; color: var(--gh-muted); font-size: .85rem; }
  @media (max-width: 760px) {
    .gd-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gd-figs-2 { grid-template-columns: 1fr; }
  }
</style>
