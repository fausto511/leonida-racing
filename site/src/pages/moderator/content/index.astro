---
// Moderator: content reports (RS-0039, DEC-0083). Reports come from
// /report-content/ (crews, events, driver names, other). Check the content,
// act on it (Hub Content for crews/events), then close the report:
// "Action taken" or "No action". The decision note is SHOWN TO THE REPORTER
// (Art. 16(5) DSA: inform the reporter of the decision).
import Base from '../../../layouts/Base.astro';
import ModeratorNav from '../../../components/ModeratorNav.astro';
---
<Base
  title="Content Reports — Moderator"
  description="Internal: crews, events, driver names and other content reported by drivers."
  section="moderator"
  noindex
>
  <section class="wrap mod-wrap">
    <ModeratorNav active="content" />
    <p class="eyebrow">Moderation</p>
    <h1 class="display mod-title">Content Reports</h1>
    <p class="mod-lede">Reports about crews, events, driver names or anything else. Check the content, remove or change it if needed (crews and events in Hub Content), then close the report. <strong>The reporter sees the status and your decision note.</strong> Handle reports about possibly illegal content first and without delay. If you remove someone's content, tell them why (Terms, section "Moderation").</p>

    <div id="cr-backend" class="notice" hidden><strong>Backend not connected.</strong><span>Reports cannot be loaded from this build.</span></div>
    <div id="cr-auth" class="panel cr-box" hidden><p>Sign in as a moderator to see reports.</p></div>
    <div id="cr-notmod" class="panel cr-box" hidden><p>This page is for moderators only.</p></div>

    <div id="cr-body" hidden>
      <div class="cr-tabs" role="tablist">
        <button type="button" class="cr-tab is-active" data-f="open" role="tab" aria-selected="true">Open</button>
        <button type="button" class="cr-tab" data-f="closed" role="tab" aria-selected="false">Closed</button>
      </div>
      <p id="cr-error" class="cr-error" hidden></p>
      <div id="cr-list"></div>
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .mod-wrap { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem); }
  .mod-title { margin: .4rem 0 .6rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .mod-lede { margin: 0 0 1.5rem; color: var(--gh-muted); font-size: .92rem; max-width: 46rem; }
  .mod-lede strong { color: var(--gh-text); }
  .notice { display: flex; flex-direction: column; gap: .3rem; margin-bottom: 1.5rem; padding: 1rem 1.2rem; border: 1px solid var(--gh-yellow); background: var(--lr-orange-tint); border-radius: var(--gh-radius); font-size: .85rem; }
  .cr-box { padding: 1rem 1.2rem; }
  .cr-box p { margin: 0; font-size: .88rem; }
  .cr-tabs { display: flex; gap: .4rem; margin-bottom: 1rem; max-width: 22rem; }
  .cr-tab { flex: 1; padding: .5rem .6rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: transparent; color: var(--gh-muted); font-weight: 700; font-size: .74rem; cursor: pointer; font-family: var(--gh-font-body); }
  .cr-tab.is-active { background: var(--gh-surface-soft); color: var(--gh-text); border-color: var(--gh-muted); }
  .cr-error { color: var(--lr-coral); font-size: .85rem; }
  :global(.cr-card) { border: 1px solid var(--gh-line); border-radius: var(--gh-radius); background: var(--gh-surface); padding: 1rem 1.1rem; margin-bottom: .75rem; }
  :global(.cr-card.is-urgent) { border-color: var(--lr-pink-border); }
  :global(.cr-card h3) { margin: 0 0 .25rem; font-size: 1rem; overflow-wrap: anywhere; }
  :global(.cr-meta) { margin: 0 0 .6rem; color: var(--gh-muted); font-size: .8rem; }
  :global(.cr-reason) { display: inline-block; margin-bottom: .5rem; padding: .15rem .55rem; border-radius: 999px; border: 1px solid var(--gh-line); font-size: .72rem; font-weight: 700; }
  :global(.cr-card.is-urgent .cr-reason) { border-color: var(--lr-pink-border); color: #ff8a95; }
  :global(.cr-details) { margin: 0 0 .8rem; font-size: .88rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  :global(.cr-actions) { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  :global(.cr-actions input) { flex: 1 1 16rem; min-width: 0; padding: .45rem .6rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: var(--gh-bg); color: var(--gh-text); font: inherit; font-size: .85rem; }
  :global(.cr-actions .btn) { min-height: 36px; font-size: .76rem; padding: .45rem .85rem; }
  :global(.cr-note) { margin: .4rem 0 0; color: var(--gh-muted); font-size: .82rem; }
  :global(.cr-empty) { color: var(--gh-muted); font-size: .88rem; }
</style>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  import { esc } from '../../../data/hub';
  import { contentReasonLabels, contentTypeLabels } from '../../../data/reports';

  const base = import.meta.env.BASE_URL;
  const $ = (id: string) => document.getElementById(id)!;
  const STATUS: Record<string, string> = { open: 'Open', resolved: 'Action taken', dismissed: 'No action' };
  const URGENT = new Set(['illegal', 'hate_or_harassment', 'sexual_or_violent']);
  let me: string | null = null;
  let filter: 'open' | 'closed' = 'open';
  let rows: any[] = [];
  const when = (iso: string) => new Date(iso).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });

  function targetLink(r: any): string {
    if (r.target_type === 'crew') return r.target_crew_id ? `<a class="btn btn-s" href="${base}moderator/hub/">Open Hub Content</a>` : '<span class="cr-meta">Crew no longer exists</span>';
    if (r.target_type === 'event') return r.target_event_id ? `<a class="btn btn-s" href="${base}moderator/hub/">Open Hub Content</a>` : '<span class="cr-meta">Event no longer exists</span>';
    const t = String(r.target_text ?? '');
    return /^https?:\/\//i.test(t) ? `<a class="btn btn-s" href="${esc(t)}" target="_blank" rel="noopener noreferrer">Open link ↗</a>` : '';
  }

  function render() {
    const list = rows.filter((r) => (filter === 'open' ? r.status === 'open' : r.status !== 'open'));
    const openCount = rows.filter((r) => r.status === 'open').length;
    document.querySelector<HTMLElement>('.cr-tab[data-f="open"]')!.textContent = `Open (${openCount})`;
    // urgent reasons first among open reports
    if (filter === 'open') list.sort((a, b) => Number(URGENT.has(b.reason)) - Number(URGENT.has(a.reason)));
    $('cr-list').innerHTML = list.length
      ? list.map((r) => {
          const what = r.target_snapshot ?? r.target_text ?? '—';
          const actions = r.status === 'open'
            ? `<div class="cr-actions">
                 ${targetLink(r)}
                 <input type="text" maxlength="1000" placeholder="Decision note — visible to the reporter" data-note="${esc(r.report_id)}" />
                 <button type="button" class="btn btn-p" data-act="resolved" data-id="${esc(r.report_id)}">Action taken</button>
                 <button type="button" class="btn btn-s" data-act="dismissed" data-id="${esc(r.report_id)}">No action</button>
               </div>`
            : `<div class="cr-actions">${targetLink(r)}<span class="cr-meta">${STATUS[r.status]} · ${r.handled_at ? esc(when(r.handled_at)) : ''}${r.handler?.display_name ? ` · by ${esc(r.handler.display_name)}` : ''}</span></div>
               ${r.decision_note ? `<p class="cr-note">Note to reporter: ${esc(r.decision_note)}</p>` : ''}`;
          return `<article class="cr-card${URGENT.has(r.reason) && r.status === 'open' ? ' is-urgent' : ''}">
            <h3>${esc(contentTypeLabels[r.target_type] ?? r.target_type)}: ${esc(what)}</h3>
            <p class="cr-meta">Reported ${esc(when(r.created_at))} by ${esc(r.reporter?.display_name ?? 'unknown')}</p>
            <span class="cr-reason">${esc(contentReasonLabels[r.reason] ?? r.reason)}</span>
            <p class="cr-details">${esc(r.details)}</p>
            ${actions}
          </article>`;
        }).join('')
      : `<p class="cr-empty">${filter === 'open' ? 'No open reports.' : 'No closed reports yet.'}</p>`;
  }

  async function load() {
    $('cr-error').hidden = true;
    const { data, error } = await getSupabase()
      .from('content_reports')
      .select(`report_id, target_type, target_crew_id, target_event_id, target_text, target_snapshot, reason, details, status, created_at, handled_at, decision_note,
        reporter:drivers!content_reports_reporter_driver_id_fkey(display_name),
        handler:drivers!content_reports_handled_by_fkey(display_name)`)
      .order('created_at', { ascending: false })
      .limit(300);
    if (error) { $('cr-error').hidden = false; $('cr-error').textContent = `Could not load reports: ${error.message}`; rows = []; }
    else rows = data ?? [];
    render();
  }

  document.querySelectorAll<HTMLButtonElement>('.cr-tab').forEach((t) => t.addEventListener('click', () => {
    filter = t.dataset.f as any;
    document.querySelectorAll('.cr-tab').forEach((x) => { x.classList.toggle('is-active', x === t); x.setAttribute('aria-selected', String(x === t)); });
    render();
  }));

  $('cr-list').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
    if (!b) return;
    const id = b.dataset.id!;
    const note = document.querySelector<HTMLInputElement>(`[data-note="${id}"]`)?.value.trim() || null;
    b.disabled = true;
    const { error } = await getSupabase().from('content_reports')
      .update({ status: b.dataset.act, handled_at: new Date().toISOString(), handled_by: me, decision_note: note })
      .eq('report_id', id);
    if (error) { $('cr-error').hidden = false; $('cr-error').textContent = `Could not update the report: ${error.message}`; b.disabled = false; return; }
    await load();
  });

  async function init(session: any) {
    $('cr-auth').hidden = Boolean(session);
    $('cr-body').hidden = true;
    $('cr-notmod').hidden = true;
    if (!session) return;
    const sb = getSupabase();
    const mod = await sb.from('moderators').select('driver_id').limit(1);
    if (mod.error || !mod.data?.length) { $('cr-notmod').hidden = false; return; }
    const own = await sb.from('drivers').select('driver_id').eq('auth_user_id', session.user.id).maybeSingle();
    me = own.data?.driver_id ?? null;
    $('cr-body').hidden = false;
    await load();
  }

  if (!backendConfigured) $('cr-backend').hidden = false;
  else {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
  }
</script>
