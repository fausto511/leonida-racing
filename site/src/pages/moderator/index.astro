---
// Moderator overview (RS-0102 stage 1, Fausto 09.11.2026; design: artifact "Moderator Overview").
// To do = every open review in one list, Stats = totals only (no lists of people).
// Data: mod_overview() (refuses non-moderators). Lap Review moved to /moderator/laps/;
// old links with ?run= are forwarded there. COPY: internal page, Claude (no Codex needed).
import Base from '../../layouts/Base.astro';
import ModeratorNav from '../../components/ModeratorNav.astro';
---
<Base title="Overview — Moderator" description="Internal: open reviews and site stats." section="moderator" noindex>
  <section class="wrap mod-wrap">
    <ModeratorNav active="overview" />
    <h1 class="display mo-title">Overview</h1>
    <p class="mo-lede">Everything waiting for a moderator, and how the site is doing.</p>

    <div id="mo-auth" class="panel mo-box" hidden><p>Log in as a moderator to see the overview.</p></div>
    <div id="mo-notmod" class="panel mo-box" hidden><p>This page is for moderators only.</p></div>

    <div id="mo-body" hidden>
      <section class="mo-sec" aria-labelledby="mo-todo-h">
        <div class="mo-head">
          <h2 id="mo-todo-h" class="mo-h2">To do</h2>
          <span class="mo-meta">Open items first · empty ones stay listed</span>
        </div>
        <div class="mo-todo" id="mo-todo"></div>
      </section>

      <section class="mo-sec" aria-labelledby="mo-stats-h">
        <div class="mo-head">
          <h2 id="mo-stats-h" class="mo-h2">Stats</h2>
          <span class="mo-meta" id="mo-at">Totals only, no lists of people</span>
        </div>
        <div class="mo-kpis" id="mo-kpis"></div>
        <div class="mo-charts">
          <figure class="mo-card">
            <figcaption><b>Accounts</b><span>Total accounts, last 30 days</span></figcaption>
            <div id="mo-acc"></div>
          </figure>
          <figure class="mo-card">
            <figcaption><b>New accounts per day</b><span id="mo-new-sub">Last 30 days</span></figcaption>
            <div id="mo-new"></div>
          </figure>
          <figure class="mo-card">
            <figcaption><b>Active drivers per day</b><span>Logged in and on the site</span></figcaption>
            <div id="mo-active"></div>
          </figure>
          <figure class="mo-card">
            <figcaption><b>Car ratings by stars</b><span id="mo-stars-sub"></span></figcaption>
            <div id="mo-stars"></div>
          </figure>
          <figure class="mo-card">
            <figcaption><b>Laps by status</b><span id="mo-laps-sub"></span></figcaption>
            <div id="mo-laps"></div>
          </figure>
          <figure class="mo-card">
            <figcaption><b>Garage, community and bot</b><span>Totals</span></figcaption>
            <div class="mo-totals" id="mo-totals"></div>
          </figure>
        </div>
      </section>
    </div>
  </section>
</Base>

<script>
  import { getSupabase, backendConfigured } from '../../scripts/supabase-client';
  import { loadModOverview, type ModOverview } from '../../scripts/mod-overview';

  // Old links (Discord alerts, bot, DB) pointed to /moderator/?run=<id> for Lap Review.
  if (new URLSearchParams(location.search).has('run')) location.replace(`laps/${location.search}`);

  const base = import.meta.env.BASE_URL;
  const m = `${base}moderator/`;
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const fmt = (n: number) => n.toLocaleString('en-US');
  const dayLabel = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });

  function todoHtml(ov: ModOverview) {
    const t = ov.todo;
    const rows = [
      { n: t.laps_review, title: 'Laps to review', text: 'New and corrected submissions waiting for a decision.', where: 'Review · Laps', href: `${m}laps/` },
      { n: t.videos_check, title: 'Videos to check', text: 'Accepted laps with a video that is not verified yet.', where: 'Review · Laps', href: `${m}laps/` },
      { n: t.events_review, title: 'Events to review', text: 'New events and series from stage 1 and 2 hosts.', where: 'Review · Events', href: `${m}event-review/` },
      { n: t.event_changes, title: 'Event changes', text: 'New title, description or Discord invite on a live event.', where: 'Review · Events', href: `${m}event-review/` },
      { n: t.requests, title: 'Requests', text: 'Crew applications, ICON, verified crews and role requests.', where: 'Community · Roles & requests', href: `${m}hub/?tab=requests` },
      { n: t.tracks, title: 'Tracks to review', text: 'Community tracks submitted for publishing.', where: 'Review · Tracks', href: `${m}hub/?tab=tracks` },
      { n: t.time_reports, title: 'Reported times', text: 'Lap times other drivers have reported.', where: 'Reports · Times', href: `${m}reports/` },
      { n: t.content_reports, title: 'Reported content', text: 'Crews, events or names reported as breaking the rules.', where: 'Reports · Content', href: `${m}content/` },
    ];
    const open = rows.filter((r) => r.n > 0), done = rows.filter((r) => !(r.n > 0));
    return [...open, ...done].map((r) => `<div class="mo-row${r.n > 0 ? ' is-open' : ''}">
      <span class="mo-n">${fmt(r.n)}</span>
      <div class="mo-rt"><b>${esc(r.title)}</b><span>${esc(r.text)}</span></div>
      <span class="mo-where">${esc(r.where)}</span>
      ${r.n > 0 ? `<a class="btn btn-s btn-sm" href="${r.href}">Open</a>` : '<span class="mo-none">Nothing to do</span>'}
    </div>`).join('');
  }

  // ---- charts: one series each, plain SVG, value on hover (<title>) ----
  const W = 560, H = 200, X0 = 44, X1 = 552, YB = 170, YT = 20;
  const niceMax = (v: number) => { if (v <= 5) return 5; const p = 10 ** Math.floor(Math.log10(v)); return Math.ceil(v / p) * p; };
  const axis = (max: number) => `<line x1="${X0}" y1="${YB}" x2="${X1}" y2="${YB}" class="ax"/><line x1="${X0}" y1="${YT}" x2="${X1}" y2="${YT}" class="gr"/>
    <text x="${X0 - 8}" y="${YB + 4}" text-anchor="end">0</text><text x="${X0 - 8}" y="${YT + 4}" text-anchor="end">${fmt(max)}</text>`;
  const xLabels = (a: string, b: string) => `<text x="${X0}" y="${H - 8}">${a}</text><text x="${X1}" y="${H - 8}" text-anchor="end">${b}</text>`;

  function lineChart(days: { day: string; n: number }[], startTotal: number, label: string) {
    let total = startTotal;
    const vals = days.map((d) => (total += d.n));
    const max = niceMax(Math.max(...vals, 1));
    const step = (X1 - X0) / Math.max(days.length - 1, 1);
    const pts = vals.map((v, i) => [X0 + i * step, YB - (v / max) * (YB - YT)]);
    const last = pts[pts.length - 1];
    const hits = vals.map((v, i) => `<rect x="${(pts[i][0] - step / 2).toFixed(1)}" y="${YT}" width="${step.toFixed(1)}" height="${YB - YT}" class="hit"><title>${dayLabel(days[i].day)}: ${fmt(v)}</title></rect>`).join('');
    return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(label)}">${axis(max)}
      <polyline points="${pts.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' ')}" class="ln"/>
      <circle cx="${last[0].toFixed(1)}" cy="${last[1].toFixed(1)}" r="5" class="dot"/>
      <text x="${(last[0] - 10).toFixed(1)}" y="${(last[1] - 10).toFixed(1)}" text-anchor="end" class="val">${fmt(vals[vals.length - 1])}</text>
      ${xLabels(dayLabel(days[0].day), dayLabel(days[days.length - 1].day))}${hits}</svg>`;
  }

  function barChart(days: { day: string; n: number }[], label: string) {
    const max = niceMax(Math.max(...days.map((d) => d.n), 1));
    const slot = (X1 - X0) / days.length;
    const bars = days.map((d, i) => {
      const h = d.n ? Math.max((d.n / max) * (YB - YT), 2) : 0;
      return `<g><rect x="${(X0 + i * slot).toFixed(1)}" y="${YT}" width="${slot.toFixed(1)}" height="${YB - YT}" class="hit"/>${d.n ? `<rect x="${(X0 + i * slot + 2).toFixed(1)}" y="${(YB - h).toFixed(1)}" width="${(slot - 4).toFixed(1)}" height="${h.toFixed(1)}" rx="3" class="bar"/>` : ''}<title>${dayLabel(d.day)}: ${fmt(d.n)}</title></g>`;
    }).join('');
    return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(label)}">${axis(max)}${bars}${xLabels(dayLabel(days[0].day), dayLabel(days[days.length - 1].day))}</svg>`;
  }

  function hBars(rows: [string, number][]) {
    const max = Math.max(...rows.map((r) => r[1]), 1);
    return `<div class="mo-hb">${rows.map(([k, n]) => `<div class="mo-hbr" title="${esc(k)}: ${fmt(n)}"><span>${esc(k)}</span><div class="mo-hbt"><div style="width:${(n / max) * 100}%${n ? ';min-width:4px' : ''}"></div></div><b>${fmt(n)}</b></div>`).join('')}</div>`;
  }

  function render(ov: ModOverview) {
    $('mo-todo').innerHTML = todoHtml(ov);
    const u = ov.users;
    $('mo-at').textContent = `Totals only, no lists of people · ${new Date(ov.at).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' })}`;
    $('mo-kpis').innerHTML = [
      ['Accounts', u.accounts, u.new_today ? `+${fmt(u.new_today)} today` : 'none new today'],
      ['Active today', u.active_1, 'Logged in and on the site'],
      ['Active 7 days', u.active_7, 'Logged in and on the site'],
      ['Active 30 days', u.active_30, 'Includes moderator and test accounts'],
    ].map(([k, v, s]) => `<div class="mo-kpi"><span class="mo-lbl">${k}</span><b>${fmt(v as number)}</b><span>${s}</span></div>`).join('');
    $('mo-acc').innerHTML = lineChart(u.new_per_day, u.accounts_before, `Total accounts over the last 30 days, now ${u.accounts}`);
    const newSum = u.new_per_day.reduce((a, d) => a + d.n, 0);
    $('mo-new-sub').textContent = `Last 30 days · ${fmt(newSum)} new`;
    $('mo-new').innerHTML = barChart(u.new_per_day, `New accounts per day, last 30 days, ${newSum} in total`);
    const act = u.active_per_day ?? [];
    $('mo-active').innerHTML = act.length >= 7
      ? barChart(act, 'Active drivers per day')
      : `<div class="mo-empty">The site saves one total per day since this page went live, so the history is still short.${act.length ? ` So far: ${act.map((d) => `${dayLabel(d.day)}: ${fmt(d.n)}`).join(' · ')}.` : ''}</div>`;
    const c = ov.cars;
    $('mo-stars-sub').textContent = `${fmt(c.ratings)} ratings from ${fmt(c.rating_drivers)} driver${c.rating_drivers === 1 ? '' : 's'}`;
    $('mo-stars').innerHTML = hBars([5, 4, 3, 2, 1].map((s) => [`${s} star${s === 1 ? '' : 's'}`, Number(c.stars?.[s] ?? 0)]));
    const l = ov.laps;
    $('mo-laps-sub').textContent = `All submitted laps · ${fmt(l.total)} in total`;
    $('mo-laps').innerHTML = hBars([['In review', l.in_review], ['Needs correction', l.needs_correction], ['Accepted', l.accepted], ['Video verified', l.verified], ['Rejected', l.rejected]]);
    const co = ov.community;
    $('mo-totals').innerHTML = [
      [c.owned, 'Cars owned'], [c.wishlist, 'Wishlist entries'], [co.crews, 'Published crews'],
      [co.events_upcoming, 'Upcoming events'], [co.signups, 'Event sign-ups'], [co.feeds, 'Bot feeds'],
    ].map(([v, k]) => `<div><b>${fmt(v as number)}</b><span>${k}</span></div>`).join('');
  }

  (async () => {
    if (!backendConfigured) return;
    const { data: s } = await getSupabase().auth.getSession();
    if (!s?.session) { $('mo-auth').hidden = false; return; }
    const ov = await loadModOverview();
    if (!ov) { $('mo-notmod').hidden = false; return; }
    render(ov);
    $('mo-body').hidden = false;
  })();
</script>

<style>
  .mod-wrap { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem); }
  .mo-title { margin: 0; font-size: 52px; line-height: .95; text-transform: uppercase; }
  .mo-lede { margin: 10px 0 40px; max-width: 600px; font-size: 17px; line-height: 1.55; color: var(--lr-soft); }
  .mo-box { padding: 20px; }
  .mo-sec { display: flex; flex-direction: column; gap: 16px; margin-bottom: 48px; }
  .mo-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .mo-h2 { margin: 0; font-family: var(--gh-font-display); font-weight: 800; font-size: 24px; line-height: 1.05; text-transform: uppercase; }
  .mo-meta { font-size: 13px; color: var(--lr-muted); }
  .mo-todo { border: 1px solid var(--lr-line); border-radius: 8px; background: var(--lr-card); overflow: hidden; }
  .mo-todo :global(.mo-row) { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 14px 18px; border-top: 1px solid var(--lr-line-soft); }
  .mo-todo :global(.mo-row:first-child) { border-top: 0; }
  .mo-todo :global(.mo-row.is-open) { background: var(--lr-orange-tint); }
  .mo-todo :global(.mo-n) { flex: none; width: 40px; height: 40px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-variant-numeric: tabular-nums; background: var(--lr-raised); color: var(--lr-muted); }
  .mo-todo :global(.is-open .mo-n) { background: var(--lr-orange); color: var(--lr-on-orange); }
  .mo-todo :global(.mo-rt) { flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .mo-todo :global(.mo-rt b) { font-size: 16px; line-height: 1.35; }
  .mo-todo :global(.mo-rt span) { font-size: 14px; line-height: 1.5; color: var(--lr-soft); }
  .mo-todo :global(.mo-where), .mo-todo :global(.mo-none) { font-size: 13px; color: var(--lr-muted); white-space: nowrap; }
  .mo-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
  .mo-kpis :global(.mo-kpi) { border: 1px solid var(--lr-line); border-radius: 8px; background: var(--lr-card); padding: 18px; display: flex; flex-direction: column; gap: 4px; }
  .mo-kpis :global(.mo-kpi b) { font-family: var(--gh-font-display); font-weight: 800; font-size: 40px; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .mo-kpis :global(.mo-kpi > span:last-child) { font-size: 13px; color: var(--lr-muted); }
  :global(.mo-lbl) { font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-orange); }
  .mo-charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr)); gap: 16px; }
  .mo-card { margin: 0; border: 1px solid var(--lr-line); border-radius: 8px; background: var(--lr-card); padding: 18px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .mo-card figcaption { display: flex; flex-direction: column; gap: 2px; }
  .mo-card figcaption b { font-size: 16px; }
  .mo-card figcaption span { font-size: 13px; color: var(--lr-muted); }
  .mo-card :global(svg) { width: 100%; height: auto; display: block; font-size: 12px; fill: var(--lr-muted); }
  .mo-card :global(.ax) { stroke: var(--lr-line-strong); }
  .mo-card :global(.gr) { stroke: var(--lr-line-soft); }
  .mo-card :global(.ln) { fill: none; stroke: var(--lr-orange); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .mo-card :global(.dot) { fill: var(--lr-orange); stroke: var(--lr-card); stroke-width: 2; }
  .mo-card :global(.val) { fill: var(--lr-text); font-size: 13px; font-weight: 700; }
  .mo-card :global(.bar) { fill: var(--lr-orange); }
  .mo-card :global(.hit) { fill: transparent; }
  .mo-card :global(g:hover .bar) { fill: var(--lr-orange-hover); }
  .mo-card :global(.mo-empty) { min-height: 160px; border: 1px dashed var(--lr-line-strong); border-radius: 6px; display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; text-align: center; font-size: 14px; line-height: 1.5; color: var(--lr-soft); }
  .mo-card :global(.mo-hb) { display: flex; flex-direction: column; gap: 10px; }
  .mo-card :global(.mo-hbr) { display: grid; grid-template-columns: 120px minmax(0, 1fr) 44px; align-items: center; gap: 12px; font-size: 13px; }
  .mo-card :global(.mo-hbr span) { color: var(--lr-soft); }
  .mo-card :global(.mo-hbr b) { text-align: right; font-variant-numeric: tabular-nums; }
  .mo-card :global(.mo-hbt) { height: 14px; background: var(--lr-raised); border-radius: 0 4px 4px 0; overflow: hidden; }
  .mo-card :global(.mo-hbt div) { height: 100%; background: var(--lr-orange); border-radius: 0 4px 4px 0; }
  .mo-totals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 12px; }
  .mo-totals :global(div) { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mo-totals :global(b) { font-family: var(--gh-font-display); font-weight: 800; font-size: 28px; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .mo-totals :global(span) { font-size: 13px; color: var(--lr-soft); }
  @media (max-width: 760px) {
    .mo-title { font-size: 34px; }
    .mo-card :global(.mo-hbr) { grid-template-columns: 96px minmax(0, 1fr) 40px; }
    .mo-totals { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
