---
// Moderator: drivers overview (Fausto 2026-10-09). Key figures come from the DB
// (moderator_driver_stats), the list is a paged search (moderator_search_drivers,
// 25 per page, newest first) -- stays fast with many thousands of accounts.
// No e-mail addresses, no Discord IDs. Both functions refuse non-moderators.
// RS-0102 stage 2 (Fausto 10.11.2026): charts (accounts, new per day, active per day, page views from
// Cloudflare Web Analytics = consented visitors only, mod_site_visits) and roles right in the list.
import Base from '../../../layouts/Base.astro';
import ModeratorShell from '../../../components/ModeratorShell.astro';
---
<Base title="Drivers — Moderator" description="Internal: registered drivers." section="moderator" noindex>
  <section class="wrap mod-wrap">
    <ModeratorShell active="drivers">
    <h1 class="display mod-title">Drivers</h1>

    <div id="dx-backend" class="notice" hidden><strong>Backend not connected.</strong><span>Drivers cannot be loaded from this build.</span></div>
    <div id="dx-auth" class="panel dx-box" hidden><p>Log in as a moderator to see drivers.</p></div>
    <div id="dx-notmod" class="panel dx-box" hidden><p>This page is for moderators only.</p></div>

    <div id="dx-body" hidden>
      <!-- placeholders with the final labels: the figures fill in without moving the page (CLS) -->
      <div class="dx-stats" id="dx-stats"><div class="panel dx-stat"><span>Drivers</span><strong>…</strong></div><div class="panel dx-stat"><span>New, 7 days</span><strong>…</strong></div><div class="panel dx-stat"><span>New, 30 days</span><strong>…</strong></div><div class="panel dx-stat"><span>Crew Leaders</span><strong>…</strong></div><div class="panel dx-stat"><span>Event Hosts</span><strong>…</strong></div><div class="panel dx-stat"><span>Creators</span><strong>…</strong></div><div class="panel dx-stat"><span>Moderators</span><strong>…</strong></div><div class="panel dx-stat"><span>Deleted accounts</span><strong>…</strong></div></div>

      <div class="mc-grid dx-charts">
        <figure class="mc-card"><figcaption><b>Accounts</b><span id="dx-acc-sub">Last 30 days</span></figcaption><div id="dx-acc"></div></figure>
        <figure class="mc-card"><figcaption><b>New accounts per day</b><span id="dx-new-sub">Last 30 days</span></figcaption><div id="dx-new"></div></figure>
        <figure class="mc-card"><figcaption><b>Active drivers per day</b><span id="dx-act-sub">Logged in and on the site</span></figcaption><div id="dx-act"></div></figure>
        <figure class="mc-card"><figcaption><b>Page views per day</b><span id="dx-vis-sub">Cloudflare Web Analytics · only visitors who allowed statistics</span></figcaption><div id="dx-vis"></div></figure>
      </div>

      <div class="panel dx-listbox">
        <div class="dx-listhead">
          <label class="ui-search dx-search"><input type="search" id="dx-q" placeholder="Search display name" aria-label="Search drivers" autocomplete="off" /></label>
          <span class="dx-count" id="dx-count"></span>
        </div>
        <div class="dx-table-wrap">
          <table class="dx-table">
            <thead><tr><th>Display name</th><th>Joined</th><th>Roles</th><th>Crews</th><th><span class="dx-sr">Edit roles</span></th></tr></thead>
            <tbody id="dx-rows"></tbody>
          </table>
        </div>
        <div class="dx-pager">
          <button type="button" class="btn btn-s" id="dx-prev">← Newer</button>
          <span id="dx-page"></span>
          <button type="button" class="btn btn-s" id="dx-next">Older →</button>
        </div>
      </div>
    </div>
  </ModeratorShell>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .mod-wrap { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem); }
  .mod-title { margin: .4rem 0 1.2rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .dx-box { padding: 1rem 1.2rem; } .dx-box p { margin: 0; }
  .dx-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: var(--gh-gap-card); margin-bottom: var(--gh-gap-card); }
  :global(.dx-stat) { padding: .9rem 1.1rem; display: flex; flex-direction: column; gap: .25rem; }
  :global(.dx-stat span) { color: var(--gh-muted); font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; }
  :global(.dx-stat strong) { font-family: var(--gh-font-display); font-weight: 900; font-size: 1.7rem; line-height: 1; }
  .dx-listbox { padding: 1rem 1.1rem; }
  .dx-listhead { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: .8rem; }
  .dx-search { flex: 1 1 16rem; max-width: 24rem; }
  .dx-count { color: var(--gh-muted); font-size: .8rem; }
  .dx-table-wrap { overflow-x: auto; }
  .dx-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  .dx-table th, .dx-table td { text-align: left; padding: .55rem .5rem; border-bottom: 1px solid var(--gh-line); white-space: nowrap; }
  .dx-table th { color: var(--gh-muted); font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; }
  :global(.dx-tag) { display: inline-flex; margin-right: .3rem; padding: .1rem .45rem; border-radius: 999px; border: 1px solid var(--gh-line); font-size: .68rem; font-weight: 700; }
  :global(.dx-tag.is-mod) { border-color: var(--lr-orange-border); color: var(--gh-yellow); }
  :global(.dx-muted) { color: var(--gh-muted); }
  .dx-pager { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: .9rem; font-size: .8rem; color: var(--gh-muted); }
  .dx-pager .btn { min-height: 36px; font-size: .78rem; padding: .4rem .8rem; }
  .dx-charts { margin-bottom: var(--gh-gap-card); }
  .dx-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  :global(.dx-rbtn) { height: 32px; padding: 0 12px; border-radius: 6px; border: 1px solid var(--lr-line-strong); background: transparent; color: var(--lr-text); font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
  :global(.dx-edit td) { background: var(--lr-raised); white-space: normal !important; padding: 14px 12px !important; }
  :global(.dx-roles) { display: flex; flex-direction: column; gap: 12px; }
  :global(.dx-have) { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 14px; }
  :global(.dx-chip) { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 4px 0 12px; border-radius: 999px; border: 1px solid var(--lr-line-strong); font-size: 13px; font-weight: 600; }
  :global(.dx-chip button) { height: 24px; min-width: 24px; padding: 0 6px; border: 0; border-radius: 999px; background: transparent; color: var(--lr-muted); font: inherit; font-size: 12px; cursor: pointer; }
  :global(.dx-chip button:hover), :global(.dx-chip button[data-armed]) { background: var(--lr-coral); color: #1a0d0d; }
  :global(.dx-add) { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  :global(.dx-add select) { height: 36px; padding: 0 10px; border: 1px solid var(--lr-line-strong); border-radius: 6px; background: var(--lr-bg); color: var(--lr-text); font: inherit; font-size: 14px; }
  :global(.dx-rmsg) { margin: 0; font-size: 13px; color: var(--lr-muted); }
  :global(.dx-rmsg.is-error) { color: var(--lr-coral); }
  :global(.dx-rmsg.is-ok) { color: var(--lr-lime); }
</style>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  import { esc } from '../../../data/hub';
  import { loadModOverview } from '../../../scripts/mod-overview';
  import { lineChart, barChart, fillDays, dayLabel } from '../../../scripts/mod-charts';

  const PAGE = 25;
  const ROLE: Record<string, string> = { crew_leader: 'Crew Leader', event_host: 'Event Host', creator: 'Creator', notable: 'ICON' };
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  let offset = 0;
  let total = 0;
  let q = '';
  let timer: number | undefined;

  const stat = (label: string, n: number) => `<div class="panel dx-stat"><span>${esc(label)}</span><strong>${n.toLocaleString('en-US')}</strong></div>`;

  async function loadStats() {
    const { data, error } = await getSupabase().rpc('moderator_driver_stats');
    if (error || !data) { $('dx-stats').innerHTML = `<p class="dx-muted">Could not load figures${error ? `: ${esc(error.message)}` : ''}.</p>`; return; }
    const s = data as Record<string, number>;
    $('dx-stats').innerHTML = [
      stat('Drivers', s.total), stat('New, 7 days', s.new_7d), stat('New, 30 days', s.new_30d),
      stat('Crew Leaders', s.crew_leaders), stat('Event Hosts', s.event_hosts), stat('Creators', s.creators),
      stat('Moderators', s.moderators), stat('Deleted accounts', s.deleted),
    ].join('');
  }

  async function loadPage() {
    const { data, error } = await getSupabase().rpc('moderator_search_drivers', { p_q: q || null, p_limit: PAGE, p_offset: offset });
    if (error) { $('dx-rows').innerHTML = `<tr><td colspan="5" class="dx-muted">Could not load drivers: ${esc(error.message)}</td></tr>`; return; }
    const rows = (data ?? []) as any[];
    total = rows.length ? Number(rows[0].total_count) : 0;
    $('dx-rows').innerHTML = rows.length ? rows.map((r) => `<tr>
      <td>${esc(r.display_name)}</td>
      <td class="dx-muted">${esc(new Date(r.created_at).toLocaleDateString(undefined, { dateStyle: 'medium' }))}</td>
      <td>${r.is_moderator ? '<span class="dx-tag is-mod">Moderator</span>' : ''}${(r.roles ?? []).map((x: string) => `<span class="dx-tag">${esc(ROLE[x] ?? x)}</span>`).join('') || (r.is_moderator ? '' : '<span class="dx-muted">—</span>')}</td>
      <td>${(r.crews ?? []).map((t: string) => `<span class="dx-tag">${esc(t)}</span>`).join('') || '<span class="dx-muted">—</span>'}</td>
      <td style="text-align:right"><button type="button" class="dx-rbtn" data-roles="${esc(r.driver_id)}" data-name="${esc(r.display_name)}" aria-expanded="false">Roles</button></td>
    </tr>`).join('') : `<tr><td colspan="5" class="dx-muted">${q ? 'No driver matches this search.' : 'No drivers yet.'}</td></tr>`;
    $('dx-count').textContent = q ? `${total.toLocaleString('en-US')} match${total === 1 ? '' : 'es'}` : `${total.toLocaleString('en-US')} drivers`;
    const pages = Math.max(1, Math.ceil(total / PAGE));
    $('dx-page').textContent = `Page ${Math.floor(offset / PAGE) + 1} of ${pages}`;
    ($('dx-prev') as HTMLButtonElement).disabled = offset === 0;
    ($('dx-next') as HTMLButtonElement).disabled = offset + PAGE >= total;
  }

  // ---- charts ----
  async function loadCharts() {
    const [ov, vis] = await Promise.all([loadModOverview(), getSupabase().rpc('mod_site_visits', { p_days: 30 })]);
    if (ov) {
      const u = ov.users;
      $('dx-acc').innerHTML = lineChart(u.new_per_day, u.accounts_before, `Total accounts over the last 30 days, now ${u.accounts}`);
      $('dx-acc-sub').textContent = `Last 30 days · now ${u.accounts.toLocaleString('en-US')}`;
      const sum = u.new_per_day.reduce((a, d) => a + d.n, 0);
      $('dx-new-sub').textContent = `Last 30 days · ${sum.toLocaleString('en-US')} new`;
      $('dx-new').innerHTML = barChart(u.new_per_day, `New accounts per day, last 30 days, ${sum} in total`);
      const act = u.active_per_day ?? [];
      // Fausto 11.11.: bars from the first saved day on (the note-only box read as an empty tile).
      $('dx-act').innerHTML = act.length
        ? barChart(act, `Active drivers per day: ${act.map((d) => `${dayLabel(d.day)} ${d.n}`).join(', ')}`)
        : `<div class="mc-empty">No day saved yet.</div>`;
      if (act.length && act.length < 7) $('dx-act-sub').textContent = `Logged in and on the site · counted since ${dayLabel(act[0].day)}`;
    }
    const rows = ((vis.data ?? []) as any[]).map((r) => ({ day: r.day, n: Number(r.pageviews) || 0 }));
    if (vis.error || !rows.length) { $('dx-vis').innerHTML = `<div class="mc-empty">${vis.error ? 'Could not load page views.' : 'No page views yet.'}</div>`; return; }
    const days = fillDays(rows, 30);
    const sum = days.reduce((a, d) => a + d.n, 0);
    $('dx-vis').innerHTML = barChart(days, `Page views per day, last 30 days, about ${sum} in total`);
    $('dx-vis-sub').textContent = `About ${sum.toLocaleString('en-US')} in 30 days · only visitors who allowed statistics · Cloudflare samples, so these are estimates`;
  }

  // ---- roles right in the list (same rules as Community > Roles & requests) ----
  let crewOpts: any[] | null = null;
  let me: string | null = null;
  async function crewOptions() {
    if (crewOpts) return crewOpts;
    const { data } = await getSupabase().from('crews').select('crew_id,name,tag,is_published').order('name');
    crewOpts = data ?? [];
    return crewOpts;
  }
  async function myId() {
    if (me) return me;
    const sb = getSupabase();
    const { data: s } = await sb.auth.getSession();
    const own = await sb.from('drivers').select('driver_id').eq('auth_user_id', s?.session?.user.id ?? '').maybeSingle();
    me = own.data?.driver_id ?? null;
    return me;
  }
  async function openRoles(btn: HTMLButtonElement) {
    const tr = btn.closest('tr')!;
    const next = tr.nextElementSibling as HTMLElement | null;
    if (next?.classList.contains('dx-edit')) { next.remove(); btn.setAttribute('aria-expanded', 'false'); btn.textContent = 'Roles'; return; }
    document.querySelectorAll('.dx-edit').forEach((x) => x.remove());
    document.querySelectorAll<HTMLButtonElement>('.dx-rbtn').forEach((b) => { b.setAttribute('aria-expanded', 'false'); b.textContent = 'Roles'; });
    btn.setAttribute('aria-expanded', 'true'); btn.textContent = 'Close';
    const row = document.createElement('tr');
    row.className = 'dx-edit';
    row.innerHTML = `<td colspan="5"><div class="dx-roles" data-driver="${esc(btn.dataset.roles!)}"><div class="dx-have">Loading roles…</div></div></td>`;
    tr.after(row);
    await renderRoles(row.querySelector<HTMLElement>('.dx-roles')!, btn.dataset.name ?? 'Driver');
  }
  async function renderRoles(box: HTMLElement, name: string, note = '', isErr = false) {
    const driver = box.dataset.driver!;
    const sb = getSupabase();
    const [{ data, error }, crews] = await Promise.all([sb.from('hub_roles').select('role_id,role,crew_id').eq('driver_id', driver), crewOptions()]);
    if (error) { box.innerHTML = `<p class="dx-rmsg is-error">Could not load roles: ${esc(error.message)}</p>`; return; }
    const have = (data ?? []) as any[];
    const crewName = (id: string | null) => { const c = crews.find((x) => x.crew_id === id); return c ? `${c.tag} · ${c.name}` : ''; };
    // keep the Roles cell of the driver row in step
    const cell = (box.closest('tr')?.previousElementSibling as HTMLElement | null)?.children[2] as HTMLElement | undefined;
    if (cell) {
      const mod = cell.querySelector('.is-mod')?.outerHTML ?? '';
      const tags = [...new Set(have.map((h) => h.role))].map((r) => `<span class="dx-tag">${esc(ROLE[r] ?? r)}</span>`).join('');
      cell.innerHTML = mod + tags || '<span class="dx-muted">—</span>';
    }
    box.innerHTML = `
      <div class="dx-have"><span class="dx-muted">${esc(name)}:</span>${have.length ? have.map((h) => `<span class="dx-chip">${esc(ROLE[h.role] ?? h.role)}${h.crew_id ? ` · ${esc(crewName(h.crew_id))}` : ''}<button type="button" data-revoke="${esc(h.role_id)}" title="Revoke" aria-label="Revoke ${esc(ROLE[h.role] ?? h.role)}">✕</button></span>`).join('') : '<span class="dx-muted">no roles</span>'}</div>
      <div class="dx-add">
        <select data-role aria-label="Role to grant"><option value="">Grant a role…</option>${Object.entries(ROLE).map(([k, v]) => `<option value="${k}">${v}</option>`).join('')}</select>
        <select data-crew aria-label="Crew" hidden><option value="">Choose the crew…</option>${crews.map((c) => `<option value="${esc(c.crew_id)}">${esc(c.tag)} · ${esc(c.name)}${c.is_published ? '' : ' (hidden)'}</option>`).join('')}</select>
        <button type="button" class="btn btn-p btn-sm" data-grant>Grant</button>
      </div>
      <p class="dx-rmsg${note ? (isErr ? ' is-error' : ' is-ok') : ''}">${note ? esc(note) : 'Crew Leader needs a crew. ✕ revokes a role (click twice).'}</p>`;
    const roleSel = box.querySelector<HTMLSelectElement>('[data-role]')!;
    const crewSel = box.querySelector<HTMLSelectElement>('[data-crew]')!;
    roleSel.addEventListener('change', () => { crewSel.hidden = roleSel.value !== 'crew_leader'; });
    box.querySelector('[data-grant]')!.addEventListener('click', async () => {
      const role = roleSel.value;
      if (!role) return renderRoles(box, name, 'Pick a role first.', true);
      if (role === 'crew_leader' && !crewSel.value) return renderRoles(box, name, 'Choose the crew this driver leads.', true);
      const { error: e } = await sb.from('hub_roles').insert({ driver_id: driver, role, crew_id: role === 'crew_leader' ? crewSel.value : null, granted_by: await myId() });
      await renderRoles(box, name, e ? (/duplicate|unique/i.test(e.message) ? 'Already has this role.' : e.message) : `${name} is now ${ROLE[role]}.`, Boolean(e));
    });
    box.querySelectorAll<HTMLButtonElement>('[data-revoke]').forEach((b) => b.addEventListener('click', async () => {
      if (!b.dataset.armed) { b.dataset.armed = '1'; b.textContent = 'Revoke?'; return; }
      const { error: e } = await sb.from('hub_roles').delete().eq('role_id', b.dataset.revoke!);
      await renderRoles(box, name, e ? e.message : 'Role revoked.', Boolean(e));
    }));
  }
  $('dx-rows').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-roles]');
    if (b) openRoles(b);
  });

  $('dx-q').addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => { q = ($('dx-q') as HTMLInputElement).value.trim(); offset = 0; loadPage(); }, 300);
  });
  $('dx-prev').addEventListener('click', () => { offset = Math.max(0, offset - PAGE); loadPage(); });
  $('dx-next').addEventListener('click', () => { offset += PAGE; loadPage(); });

  async function init(session: any) {
    $('dx-auth').hidden = Boolean(session); $('dx-body').hidden = true; $('dx-notmod').hidden = true;
    if (!session) return;
    const mod = await getSupabase().from('moderators').select('driver_id').limit(1);
    if (mod.error || !mod.data?.length) { $('dx-notmod').hidden = false; return; }
    $('dx-body').hidden = false;
    await Promise.all([loadStats(), loadPage(), loadCharts()]);
  }
  if (!backendConfigured) $('dx-backend').hidden = false;
  else {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
  }
</script>
