---
// Old address of Hub Content (RS-0102 stage 2, 10.11.2026): every tab has its own moderator page now.
// Discord mod alerts and bookmarks still use /moderator/hub/?tab=… -> forward to the new page.
import Base from '../../../layouts/Base.astro';
const m = `${import.meta.env.BASE_URL}moderator/`;
---
<Base title="Hub Content — Moderator" description="Internal: moved." section="moderator" noindex>
  <section class="wrap" style="padding-block: 3rem;">
    <p>This page moved. <a id="hub-fwd" href={m}>Continue</a></p>
  </section>
</Base>
<script>
  const m = `${import.meta.env.BASE_URL}moderator/`;
  // Discord mod alerts link here without ?tab= -> the Overview lists everything that waits
  const tab = new URLSearchParams(location.search).get('tab') ?? '';
  const to: Record<string, string> = { crews: 'crews/', events: 'calendar/', tracks: 'tracks/', roles: 'roles/?view=roles', requests: 'roles/' };
  location.replace(m + (to[tab] ?? ''));
</script>
