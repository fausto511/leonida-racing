---
// Moderator: YouTube / Twitch channels for the Discord video & stream feed (Fausto 28.10.2026).
// The bot (discord-dispatch, every 10 min) checks active channels and posts new videos / go-live
// notices to every Discord feed added with /leonida feed videos. A new channel's existing videos
// are only recorded, never posted. Table video_channels (RLS: moderators only).
import Base from '../../../layouts/Base.astro';
import ModeratorNav from '../../../components/ModeratorNav.astro';
---
<Base
  title="Videos & Streams — Moderator"
  description="Internal: YouTube and Twitch channels the Discord bot follows."
  section="moderator"
  noindex
>
  <section class="wrap mod-wrap">
    <ModeratorNav active="videos" />
    <p class="eyebrow">Moderation</p>
    <h1 class="display mod-title">Videos &amp; Streams</h1>
    <p class="mod-lede">Channels the Discord bot follows. New videos (YouTube) and go-live notices (Twitch) are posted within about 10 minutes to every server that added <code>/leonida feed videos</code>. When you add a channel, its existing videos are skipped – only new ones get posted.</p>

    <div id="vc-backend" class="notice" hidden><strong>Backend not connected.</strong><span>Channels cannot be loaded from this build.</span></div>
    <div id="vc-auth" class="panel vc-box" hidden><p>Sign in as a moderator to manage channels.</p></div>
    <div id="vc-notmod" class="panel vc-box" hidden><p>This page is for moderators only.</p></div>

    <div id="vc-body" hidden>
      <form id="vc-form" class="panel vc-form">
        <label>Platform
          <select name="platform"><option value="youtube">YouTube</option><option value="twitch">Twitch</option></select>
        </label>
        <label class="vc-wide">Channel link or name
          <input type="text" name="input" required maxlength="300" placeholder="youtube.com/@name · twitch.tv/name" />
        </label>
        <label>Display name
          <input type="text" name="display_name" required maxlength="80" placeholder="How it's shown in Discord" />
        </label>
        <label class="vc-filterfield">Which videos
          <select name="filter">
            <option value="gta" selected>GTA only</option>
            <option value="cars">GTA + cars &amp; racing</option>
            <option value="all">All videos</option>
          </select>
        </label>
        <button type="submit" class="btn btn-p">Add channel</button>
        <p class="vc-hint"><strong>GTA only:</strong> title mentions GTA, Vice City or Leonida. <strong>GTA + cars &amp; racing:</strong> also needs a car or racing word, or a car brand like Pegassi or Grotti. Use this for general GTA creators. Keep Rockstar on GTA only, because their trailer titles rarely name cars.</p>
      </form>
      <p id="vc-error" class="vc-error" hidden></p>
      <div id="vc-list"></div>
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .mod-wrap { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem); }
  .mod-title { margin: .4rem 0 .6rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .mod-lede { margin: 0 0 1.5rem; color: var(--gh-muted); font-size: .92rem; max-width: 46rem; }
  .mod-lede code { font-size: .85em; }
  .notice { display: flex; flex-direction: column; gap: .3rem; margin-bottom: 1.5rem; padding: 1rem 1.2rem; border: 1px solid var(--gh-yellow); border-radius: var(--gh-radius); }
  .vc-box { padding: 1rem 1.2rem; }
  .vc-box p { margin: 0; font-size: .88rem; }
  .vc-form { display: grid; grid-template-columns: 9rem 1fr 14rem; gap: .8rem 1rem; align-items: end; padding: 1rem 1.1rem; margin-bottom: 1.2rem; }
  .vc-form label { display: flex; flex-direction: column; gap: .35rem; font-size: .72rem; color: var(--gh-muted); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .vc-form input[type="text"], .vc-form select { padding: .55rem .7rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: var(--gh-bg); color: var(--gh-text); font: inherit; font-size: .9rem; text-transform: none; letter-spacing: 0; }
  .vc-form .vc-filterfield { grid-column: 1 / 3; max-width: 20rem; }
  .vc-form .vc-hint { grid-column: 1 / -1; margin: 0; color: var(--gh-muted); font-size: .8rem; line-height: 1.5; }
  .vc-form .vc-hint strong { color: var(--gh-text); }
  .vc-form .btn { justify-self: end; }
  @media (max-width: 760px) { .vc-form { grid-template-columns: 1fr; } .vc-form .vc-filterfield { grid-column: auto; max-width: none; } .vc-form .btn { justify-self: stretch; } }
  .vc-error { color: var(--lr-coral); font-size: .85rem; }
  :global(.vc-card) { display: grid; grid-template-columns: 1fr auto; gap: .4rem 1rem; align-items: center; border: 1px solid var(--gh-line); border-radius: var(--gh-radius); background: var(--gh-surface); padding: .85rem 1.05rem; margin-bottom: .6rem; }
  :global(.vc-card.is-off) { opacity: .6; }
  :global(.vc-name) { margin: 0; font-size: .98rem; font-weight: 800; overflow-wrap: anywhere; }
  :global(.vc-meta) { margin: .15rem 0 0; color: var(--gh-muted); font-size: .8rem; overflow-wrap: anywhere; }
  :global(.vc-warn) { margin: .3rem 0 0; color: var(--lr-coral); font-size: .8rem; }
  :global(.vc-actions) { display: flex; flex-wrap: wrap; gap: .4rem; justify-content: flex-end; }
  :global(.vc-filter) { min-height: 34px; padding: .3rem .55rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: var(--gh-bg); color: var(--gh-text); font: inherit; font-size: .76rem; }
  :global(.vc-actions .btn) { min-height: 34px; font-size: .74rem; padding: .4rem .8rem; }
  :global(.vc-pill) { display: inline-block; padding: .1rem .5rem; border-radius: 999px; border: 1px solid var(--gh-line); font-size: .7rem; font-weight: 700; margin-right: .35rem; }
  @media (max-width: 560px) { :global(.vc-card) { grid-template-columns: 1fr; } :global(.vc-actions) { justify-content: flex-start; } }
</style>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  import { esc } from '../../../data/hub';

  const $ = (id: string) => document.getElementById(id)!;
  let me: string | null = null;
  let rows: any[] = [];
  let recent: Record<string, any> = {};
  const when = (iso: string | null) => (iso ? new Date(iso).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) : 'not yet');
  const link = (c: any) => c.platform === 'twitch'
    ? `https://www.twitch.tv/${encodeURIComponent(c.external_id ?? String(c.input).replace(/^.*twitch\.tv\//i, ''))}`
    : c.external_id ? `https://www.youtube.com/channel/${c.external_id}` : (/^https?:/i.test(c.input) ? c.input : `https://www.youtube.com/${String(c.input).startsWith('@') ? c.input : '@' + c.input}`);

  function showError(msg: string | null) { $('vc-error').textContent = msg ?? ''; $('vc-error').hidden = !msg; }

  const FILTERS: [string, string][] = [['gta', 'GTA only'], ['cars', 'GTA + cars & racing'], ['all', 'All videos']];
  const filterOf = (c: any) => (c.cars_only ? 'cars' : c.gta_only ? 'gta' : 'all');
  const filterLabel = (c: any) => FILTERS.find(([v]) => v === filterOf(c))![1];
  const filterCols = (v: string) => ({ gta_only: v !== 'all', cars_only: v === 'cars' });

  function render() {
    $('vc-list').innerHTML = rows.length ? rows.map((c) => {
      const last = recent[c.channel_id];
      const status = !c.is_active ? 'Paused' : c.last_error ? '' : c.last_checked_at ? `Checked ${esc(when(c.last_checked_at))}` : 'Waiting for the first check (up to 10 min)';
      return `<article class="vc-card${c.is_active ? '' : ' is-off'}">
        <div>
          <p class="vc-name"><span class="vc-pill">${c.platform === 'twitch' ? 'Twitch' : 'YouTube'}</span>${esc(c.display_name)}</p>
          <p class="vc-meta"><a href="${esc(link(c))}" target="_blank" rel="noopener noreferrer">${esc(c.input)} ↗</a> · ${filterLabel(c)}${status ? ` · ${status}` : ''}</p>
          ${last ? `<p class="vc-meta">Last ${last.posted_at ? 'posted' : 'seen'}: ${esc(last.title ?? '')}${last.skipped_reason ? ` (skipped: ${esc(last.skipped_reason)})` : ''}</p>` : ''}
          ${c.last_error ? `<p class="vc-warn">${esc(c.last_error)}</p>` : ''}
        </div>
        <div class="vc-actions">
          <select class="vc-filter" data-id="${esc(c.channel_id)}" aria-label="Which videos">${FILTERS.map(([v, l]) => `<option value="${v}"${filterOf(c) === v ? ' selected' : ''}>${l}</option>`).join('')}</select>
          <button type="button" class="btn btn-s" data-act="pause" data-id="${esc(c.channel_id)}">${c.is_active ? 'Pause' : 'Resume'}</button>
          <button type="button" class="btn btn-s" data-act="delete" data-id="${esc(c.channel_id)}">Remove</button>
        </div>
      </article>`;
    }).join('') : '<p class="vc-meta">No channels yet. Add the first one above.</p>';
  }

  async function load() {
    const sb = getSupabase();
    const { data, error } = await sb.from('video_channels').select('*').order('display_name');
    if (error) { showError(`Couldn't load channels: ${error.message}`); return; }
    rows = data ?? [];
    recent = {};
    if (rows.length) {
      const { data: items } = await sb.from('video_items').select('channel_id,title,posted_at,skipped_reason,created_at').order('created_at', { ascending: false }).limit(300);
      for (const it of items ?? []) if (!recent[it.channel_id]) recent[it.channel_id] = it;
    }
    render();
  }

  $('vc-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    showError(null);
    const f = new FormData(ev.target as HTMLFormElement);
    const platform = String(f.get('platform'));
    let input = String(f.get('input') ?? '').trim();
    const display_name = String(f.get('display_name') ?? '').trim();
    if (!input || !display_name) return;
    if (platform === 'twitch') input = input.replace(/^.*twitch\.tv\//i, '').replace(/[/?#].*$/, '').toLowerCase();
    if (platform === 'youtube' && /twitch\.tv/i.test(input)) { showError('That looks like a Twitch link. Pick Twitch as the platform.'); return; }
    if (platform === 'twitch' && !/^[a-z0-9_]{3,25}$/.test(input)) { showError('Twitch: enter the channel name or the twitch.tv/name link.'); return; }
    const { error } = await getSupabase().from('video_channels').insert({ platform, input, display_name, ...filterCols(String(f.get('filter'))), created_by: me,
      external_id: platform === 'twitch' ? input : (input.match(/UC[\w-]{22}/)?.[0] ?? null) });
    if (error) { showError(error.code === '23505' ? 'This channel is already on the list.' : `Couldn't add it: ${error.message}`); return; }
    (ev.target as HTMLFormElement).reset();
    await load();
  });

  $('vc-list').addEventListener('click', async (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-act]');
    if (!b) return;
    const c = rows.find((r) => r.channel_id === b.dataset.id);
    if (!c) return;
    const sb = getSupabase();
    showError(null);
    let res;
    if (b.dataset.act === 'delete') {
      if (!confirm(`Remove ${c.display_name}? Posts already in Discord stay.`)) return;
      res = await sb.from('video_channels').delete().eq('channel_id', c.channel_id);
    } else res = await sb.from('video_channels').update({ is_active: !c.is_active }).eq('channel_id', c.channel_id);
    if (res.error) showError(res.error.message);
    await load();
  });

  $('vc-list').addEventListener('change', async (ev) => {
    const sel = (ev.target as HTMLElement).closest<HTMLSelectElement>('select.vc-filter');
    if (!sel) return;
    showError(null);
    const { error } = await getSupabase().from('video_channels').update(filterCols(sel.value)).eq('channel_id', sel.dataset.id!);
    if (error) showError(error.message);
    await load();
  });

  async function init(session: any) {
    $('vc-auth').hidden = Boolean(session);
    $('vc-body').hidden = true;
    $('vc-notmod').hidden = true;
    if (!session) return;
    const sb = getSupabase();
    const mod = await sb.from('moderators').select('driver_id').limit(1);
    if (mod.error || !mod.data?.length) { $('vc-notmod').hidden = false; return; }
    const own = await sb.from('drivers').select('driver_id').eq('auth_user_id', session.user.id).maybeSingle();
    me = own.data?.driver_id ?? null;
    $('vc-body').hidden = false;
    await load();
  }

  if (!backendConfigured) $('vc-backend').hidden = false;
  else {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
  }
</script>
