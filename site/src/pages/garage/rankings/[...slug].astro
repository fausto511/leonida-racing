---
// Ranking pages (Fausto 2026-10-08): fastest (overall + per class), most expensive,
// cheapest, Gellhorn reference lap. Filled from the database at build time;
// noindex until enough cars are measured (see data/rankings.ts).
// COPY STATUS: Codex 2026-10-08, approved by Fausto 2026-10-09.
import Base from '../../../layouts/Base.astro';
import { rankings, rankingEntries, rankingIndexable, RANKING_MIN_ENTRIES } from '../../../data/rankings';
// COPY: Codex 2026-10-08, approved 2026-10-09.
import { formatVehicleValue, valueSourceLabels } from '../../../data/vehicles';
import { releaseById } from '../../../data/releases';

export function getStaticPaths() {
  return rankings.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const base = import.meta.env.BASE_URL;
const entries = rankingEntries(r);
const indexable = rankingIndexable(r);
const complete = entries.length === r.scope.length;
const related = rankings.filter((x) => x.slug !== r.slug && (x.classSlug ? x.slug.startsWith('fastest/') && r.slug.startsWith('fastest') : true));
const pageUrl = new URL(`${base}${r.path}`, Astro.site).href;
const jsonLd = entries.length ? [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: r.title, url: pageUrl, numberOfItems: entries.length,
  itemListElement: entries.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: `${e.vehicle.make} ${e.vehicle.model}`, url: new URL(`${base}garage/vehicles/${e.vehicle.id}/`, Astro.site).href })),
}] : undefined;
---
<Base title={r.title} description={r.description} section="garage" noindex={!indexable} jsonLd={jsonLd}
  breadcrumbs={[{ name: 'The Garage', path: 'garage/' }, { name: 'Rankings', path: 'garage/rankings/fastest/' }, { name: r.title, path: r.path }]}>
  <section class="wrap rk-head">
    <nav class="rk-crumbs" aria-label="Breadcrumb"><a href={`${base}garage/`}>The Garage</a><span aria-hidden="true">/</span><span>Rankings</span></nav>
    <p class="eyebrow">GTA VI Rankings</p>
    <h1 class="display rk-title">{r.title}</h1>
    <p class="rk-intro">{r.intro}</p>
    {entries.length > 0 && !complete && (
      <p class="rk-note">{r.metric === 'price_gtad' ? 'Prices' : 'Results'} available for {entries.length} of {r.scope.length} officially revealed vehicles. Positions may change as more {r.metric === 'price_gtad' ? 'prices' : 'results'} are added.</p>
    )}
  </section>

  <section class="wrap rk-body">
    {entries.length === 0 ? (
      <div class="panel rk-empty">
        <p>{r.metric === 'price_gtad'
          ? 'No purchase prices are available yet. Cars will appear here as their prices are recorded in GTA VI.'
          : r.metric === 'gellhorn_reference_lap_ms'
            ? 'No reference lap times are available yet. Cars will appear here as their stock results are recorded at Gellhorn International Raceway.'
            : 'No top-speed results are available yet. Cars will appear here as their stock results are recorded.'}</p>
        <a class="btn btn-outline" href={`${base}garage/`}>Browse The Garage</a>
      </div>
    ) : (
      <div class="panel rk-table-wrap">
        <table class="rk-table">
          <thead><tr><th scope="col">#</th><th scope="col">Vehicle</th><th scope="col">Class</th><th scope="col">{r.valueLabel}</th><th scope="col">Source</th></tr></thead>
          <tbody>
            {entries.map((e, i) => (
              <tr>
                <td class="rk-pos">{i + 1}</td>
                <td><a class="rk-car" href={`${base}garage/vehicles/${e.vehicle.id}/`}><img src={`${base}images/logos/${e.vehicle.logoSlug}-gta-6-logo.webp`} alt="" width="18" height="18" loading="lazy" /><span><small>{e.vehicle.make}</small> {e.vehicle.model}</span></a></td>
                <td class="rk-muted">{e.vehicle.classes[0]}</td>
                <td class="rk-val">{formatVehicleValue(e.value)}</td>
                <td class="rk-muted">{valueSourceLabels[e.value.source_type]}{e.value.game_release_id && releaseById[e.value.game_release_id] ? ` · ${releaseById[e.value.game_release_id].name}` : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {!indexable && entries.length > 0 && entries.length < RANKING_MIN_ENTRIES && <p class="rk-note">This ranking currently contains only {entries.length} vehicles.</p>}
  </section>

  <nav class="wrap rk-more" aria-label="Other rankings">
    <h2 class="rk-more-title">Other rankings</h2>
    <ul>{related.map((x) => <li><a href={`${base}${x.path}`}>{x.title}</a></li>)}</ul>
  </nav>
</Base>

<style>
  .rk-head { padding-top: 1.75rem; }
  .rk-crumbs { display: flex; gap: .45rem; font-size: .78rem; color: var(--gh-muted); margin-bottom: 1rem; }
  .rk-crumbs a { color: var(--gh-muted); }
  .rk-title { margin: .3rem 0 .8rem; font-size: clamp(2rem, 4.5vw, 3rem); }
  .rk-intro { margin: 0 0 .6rem; color: var(--gh-muted); max-width: 46rem; }
  .rk-note { margin: .4rem 0 0; font-size: .82rem; color: var(--gh-yellow); }
  .rk-body { padding-top: 1.5rem; }
  .rk-empty { padding: var(--gh-pad-card); display: grid; gap: 1rem; justify-items: start; }
  .rk-empty p { margin: 0; color: var(--gh-muted); }
  .rk-table-wrap { padding: 0; overflow-x: auto; }
  .rk-table { width: 100%; border-collapse: collapse; font-size: .88rem; }
  .rk-table th, .rk-table td { text-align: left; padding: .7rem .9rem; border-bottom: 1px solid var(--gh-line); white-space: nowrap; }
  .rk-table th { color: var(--gh-muted); font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; }
  .rk-table tr:last-child td { border-bottom: 0; }
  .rk-pos { font-weight: 900; width: 2.5rem; }
  .rk-car { display: inline-flex; align-items: center; gap: .5rem; color: var(--gh-text); text-decoration: none; font-weight: 700; }
  .rk-car small { color: var(--gh-muted); font-weight: 600; }
  .rk-car:hover span { text-decoration: underline; }
  .rk-val { font-weight: 800; }
  .rk-muted { color: var(--gh-muted); }
  .rk-more { padding-block: var(--gh-gap-section); }
  .rk-more-title { font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.05rem; margin: 0 0 .8rem; }
  .rk-more ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; }
  .rk-more a { color: var(--gh-text); font-size: .88rem; }
  @media (max-width: 600px) { .rk-table th:nth-child(3), .rk-table td:nth-child(3), .rk-table th:nth-child(5), .rk-table td:nth-child(5) { display: none; } }
</style>
