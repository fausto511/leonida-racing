---
import Base from '../../../../layouts/Base.astro';
import { vehicleOptions, vehicleValues, formatVehicleValue, valueSourceLabels, compareGarageOrder, familyMembers, familyName, FAMILY_PAGE_MIN, type VehicleValue } from '../../../../data/vehicles';
import { gtaTitleBySlug, sortTitles } from '../../../../data/gta-titles';
import VehicleTile from '../../../../components/VehicleTile.astro';
import { vehicleCopy } from '../../../../data/vehicle-copy';
import { releaseById, formatReleaseDate } from '../../../../data/releases';
import { classHref, makeHref } from '../../../../data/garage-taxonomy';
import { vehiclePhotoAlt } from '../../../../data/vehicle-photo-alt';

export function getStaticPaths() {
  return vehicleOptions.map((v) => ({ params: { id: v.id }, props: { vehicle: v } }));
}

const { vehicle } = Astro.props;
const base = import.meta.env.BASE_URL;
const copy = vehicleCopy[vehicle.id];

const acquisitionLabels: Record<string, string> = {
  'pre-order': 'Pre-Order',
  'ultimate-edition': 'Ultimate Edition',
  'gta-plus': 'GTA+',
};

// Release Info (RS-0047, DEC-0084). No releaseId = not officially announced
// (leak-only): neutral wording, never "leaked" on the public site.
const release = vehicle.releaseId ? releaseById[vehicle.releaseId] : undefined;
const releaseDateText = release?.date ? formatReleaseDate(release.date) : 'TBA';
const addedWithText = release ? release.name : 'Not announced';
const acquisitionNotes: Record<string, string> = {
  'pre-order': 'Pre-order bonus (Vintage Vice City Pack)',
  'ultimate-edition': 'Ultimate Edition exclusive',
  'gta-plus': 'GTA+ members only',
};
const addedWithNote = release && vehicle.acquisition ? acquisitionNotes[vehicle.acquisition] : undefined;

// SEO metadata: approved Codex copy (2026-10-01). Browser title "GTA VI"
// without the brand suffix, meta description "GTA 6"; one template for all
// vehicles, so unknown values never show up as "TBA" in search results.
// Vehicles without an official release (leak-only) stay out of the index.
const fullName = `${vehicle.make} ${vehicle.model}`;
const photoAlt = vehiclePhotoAlt[vehicle.id] ?? `${fullName} in GTA VI`;
const metaTitle = `${fullName} — GTA VI Car Specs & Performance`;
const metaDescription = `Explore the ${fullName} in GTA 6, including key vehicle details, release information, real-life inspiration, and available performance data.`;
const makeLink = makeHref(vehicle);
// Measured values with provenance (RS-0052). Missing values show a per-field
// status (Fausto, 2026-10-06) instead of "Data pending"; same three rows, so
// real values simply replace the status after launch.
const vals = vehicleValues[vehicle.id] ?? {};
const valueTitle = (v: VehicleValue) => [valueSourceLabels[v.source_type], v.game_release_id && releaseById[v.game_release_id]?.name, v.measured_at].filter(Boolean).join(' · ');

// Similar Cars (Fausto, 2026-10-06): up to 4 (one row) officially revealed vehicles that
// share a class, ranked by same primary class, same drive, same seat count;
// ties in garage order. Leak-only vehicles (no releaseId) are never suggested.
// Model family (Fausto 2026-10-08): own row below Similar Cars, any class; family
// members are left out of Similar Cars so no car shows up twice.
const family = vehicle.family ? familyMembers(vehicle.family).filter((v) => v.id !== vehicle.id && v.releaseId).sort(compareGarageOrder) : [];
const familyLabel = vehicle.family ? familyName(vehicle.family) : '';
const familyPage = vehicle.family && familyMembers(vehicle.family).filter((v) => v.releaseId).length >= FAMILY_PAGE_MIN ? `${base}garage/families/${vehicle.family}/` : null;
const familyIds = new Set(family.map((v) => v.id));
const similar = vehicleOptions
  .filter((v) => v.id !== vehicle.id && v.releaseId && !familyIds.has(v.id) && v.classes.some((c) => vehicle.classes.includes(c)))
  .map((v) => ({ v, score: (v.classes[0] === vehicle.classes[0] ? 4 : 0) + (v.drive === vehicle.drive ? 2 : 0) + (v.seats === vehicle.seats ? 1 : 0) }))
  .sort((a, b) => b.score - a.score || compareGarageOrder(a.v, b.v))
  .slice(0, 4)
  .map((x) => x.v);

// Lightweight index for the quick vehicle search/switch dropdown above the
// stage -- id/name/href only, so the client script doesn't need the full
// vehicles dataset (classes, seats, drive, acquisition, etc).
const vehicleIndex = vehicleOptions.map((v) => ({
  id: v.id,
  name: `${v.make} ${v.model}`,
  href: `${base}garage/vehicles/${v.id}/`,
}));

// Vehicles with vehicle.photo use their garage photo (public/images/vehicles/);
// all others fall back to the shared placeholder with a "Photo pending" badge.
const photo = vehicle.photo ? `${base}images/vehicles/${vehicle.id}` : null;
---
<Base
  title={metaTitle}
  brandSuffix={false}
  description={metaDescription}
  section="garage"
  noindex={!vehicle.releaseId}
  ogImage={vehicle.photo ? `images/vehicles/${vehicle.id}-1280.webp` : undefined}
  ogImageAlt={vehicle.photo ? photoAlt : undefined}
  ogImageWidth={vehicle.photo ? 1280 : undefined}
  ogImageHeight={vehicle.photo ? 720 : undefined}
  breadcrumbs={[{ name: 'The Garage', path: 'garage/' }, { name: fullName, path: `garage/vehicles/${vehicle.id}/` }]}
>
  <section class="wrap v-toolbar">
    <div class="v-search-wrap">
      <label class="ui-search v-search-field"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg><input type="search" id="v-search" placeholder="Search Vehicle" aria-label="Search vehicles" autocomplete="off" /></label>
      <ul id="v-search-results" class="v-search-results" hidden></ul>
    </div>
    <div class="v-own-wrap">
      <!-- Shortcut to My Garage, shown while this vehicle is owned (Fausto, 2026-10-06; replaces the fading "Added to My Garage" note). -->
      <a href={`${base}account/garage/`} id="v-garage-link" class="v-garage-link" aria-label="Open My Garage" title="Open My Garage" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21V9l9-6 9 6v12"/><path d="M7 21v-8h10v8"/><path d="M7 16h10"/><path d="M7 19h10"/></svg>
      </a>
      <button type="button" id="v-own" class="v-own-btn" role="switch" aria-pressed="false" aria-checked="false" hidden>
        <span class="v-own-box" aria-hidden="true"></span>
        <span class="v-own-label">I Own This Vehicle</span>
      </button>
    </div>
    <a href={`${base}garage/#compare`} id="v-compare-cta" class="garage-compare-btn">Compare Selected (0)</a>
    <p class="v-own-msg" id="v-own-msg" role="status" hidden></p>
  </section>

  <section class="wrap v-stage">
    <div class="v-photo">
      {vehicle.acquisition && (
        <span class="v-badge">{acquisitionLabels[vehicle.acquisition]}</span>
      )}
      <button type="button" id="v-compare-mark" class="v-compare-mark" data-id={vehicle.id} aria-pressed="false" aria-label={`Add ${vehicle.make} ${vehicle.model} to compare`}>＋</button>
      {photo ? (
        <img
          src={`${photo}-1280.webp`}
          srcset={`${photo}-640.webp 640w, ${photo}-1280.webp 1280w, ${photo}-1920.webp 1920w`}
          sizes="(max-width: 900px) 100vw, 60vw"
          alt={photoAlt} width="1920" height="1080" fetchpriority="high" />
      ) : (
        <>
          <img class="v-photo-fallback" src={`${base}images/garage/garage-hero-placeholder.webp`} alt="" loading="lazy" width="1672" height="941" />
          <span class="v-photo-pending">Photo pending</span>
        </>
      )}
    </div>

    <aside class="panel v-identity">
      <!-- H1 carries the full name (RS-0050); the make keeps its small label look. -->
      <h1 class="v-h1">
        <span class="v-maker">
          <img src={`${base}images/logos/${vehicle.logoSlug}-gta-6-logo.webp`} alt="" width="22" height="22" />
          <span>{vehicle.make}</span>
        </span>
        <span class="display v-title">{vehicle.model}</span>
      </h1>
      <p class="v-classes">
        {vehicle.classes.map((c, i) => (
          <>{i > 0 && ' / '}{classHref(c) ? <a href={`${base}${classHref(c)}`}>{c}</a> : c}</>
        ))}
        {makeLink && <> · <a href={`${base}${makeLink}`}>More {vehicle.make} Cars</a></>}
      </p>
      <dl class="v-key">
        <div><dt>Price</dt>{vals.price_gtad ? <dd title={valueTitle(vals.price_gtad)}>{formatVehicleValue(vals.price_gtad)} <small class="v-src">{valueSourceLabels[vals.price_gtad.source_type]}</small></dd> : <dd class="status-pending"><span class="status-dot"></span>Not announced yet</dd>}</div>
        <div><dt>Top Speed</dt>{vals.top_speed_mph ? <dd title={valueTitle(vals.top_speed_mph)}>{formatVehicleValue(vals.top_speed_mph)} <small class="v-src">{valueSourceLabels[vals.top_speed_mph.source_type]}</small></dd> : <dd class="status-pending"><span class="status-dot"></span>Measured after launch</dd>}</div>
        <div><dt>Drive</dt><dd>{vehicle.drive}</dd></div>
        <div><dt>Seats</dt><dd>{vehicle.seats}</dd></div>
        {/* Leaderboard link moved from the line under the name onto this value (Fausto 2026-10-08). */}
        <div><dt>Gellhorn Lap Time</dt>{vehicle.releaseId
          ? <dd class={vals.gellhorn_reference_lap_ms ? undefined : 'status-pending'}><a class="v-lb-link" rel="nofollow" href={`${base}time-attack/gellhorn-international-raceway/?vehicle=${encodeURIComponent(vehicle.id)}#leaderboard`} title="Open the Gellhorn leaderboard for this car">{vals.gellhorn_reference_lap_ms ? <>{formatVehicleValue(vals.gellhorn_reference_lap_ms)} <small class="v-src">{valueSourceLabels[vals.gellhorn_reference_lap_ms.source_type]}</small></> : <><span class="status-dot"></span>From Nov 19, 2026</>} <span aria-hidden="true">↗</span></a></dd>
          : vals.gellhorn_reference_lap_ms ? <dd title={valueTitle(vals.gellhorn_reference_lap_ms)}>{formatVehicleValue(vals.gellhorn_reference_lap_ms)}</dd> : <dd class="status-pending"><span class="status-dot"></span>From Nov 19, 2026</dd>}</div>
      </dl>
    </aside>
  </section>

  {/* Release / Ownership / Origins (Fausto 2026-10-08, mockup E): two flat strips aligned
      with photo + main panel, origins as a borderless row below, same column split.
      COPY STATUS: labels and status texts are Claude placeholders, Codex review pending. */}
  <section class="wrap v-facts">
    <div class="v-facts-row">
      <div class="panel v-strip">
        <h2 class="v-strip-title">Release</h2>
        <div class="v-strip-f"><span>Release Date</span>{release?.date ? <strong><time datetime={release.date}>{releaseDateText}</time></strong> : <strong class="v-muted">{releaseDateText}</strong>}</div>
        <div class="v-strip-f"><span>Added With</span><strong class={release ? undefined : 'v-muted'} title={addedWithNote}>{addedWithText}</strong></div>
        <div class="v-strip-f"><span>First Seen In</span>{vehicle.firstSeenIn && vehicle.firstSeenUrl
          ? <strong><a class="v-source-link" href={vehicle.firstSeenUrl} target="_blank" rel="noopener">{vehicle.firstSeenIn}{vehicle.firstSeenTimestamp && <> · {vehicle.firstSeenTimestamp}</>} <span aria-hidden="true">↗</span></a></strong>
          : <strong class={vehicle.firstSeenIn ? undefined : 'v-muted'}>{vehicle.firstSeenIn ?? 'Not officially revealed'}</strong>}</div>
      </div>
      <div class="panel v-strip">
        <h2 class="v-strip-title">Ownership</h2>
        <div class="v-strip-f"><span>Sell Value</span>{vehicle.sellable === 'no'
          ? <strong>Can't be sold</strong>
          : vals.sell_price_gtad ? <strong title={`${valueTitle(vals.sell_price_gtad)} · stock, without upgrades`}>{formatVehicleValue(vals.sell_price_gtad)}</strong>
          : <strong class="status-pending"><span class="status-dot"></span>After launch</strong>}</div>
        <div class="v-strip-f"><span>Where to Get It</span>{vehicle.acquisition ? <strong>{acquisitionNotes[vehicle.acquisition]}</strong> : <strong class="status-pending"><span class="status-dot"></span>After launch</strong>}</div>
      </div>
    </div>
    <dl class="v-origins">
      <div><dt>Real-Life Inspiration</dt>{vehicle.realLifeInspiration ? <dd>{vehicle.realLifeInspiration}</dd> : <dd class="status-pending"><span class="status-dot"></span>Data pending</dd>}</div>
      <div><dt>GTA History</dt>{!vehicle.previousGames
        ? <dd class="status-pending"><span class="status-dot"></span>Being checked</dd>
        : vehicle.previousGames.length === 0
          ? <dd><span class="v-hist-tag">New in GTA VI</span></dd>
          : <dd class="v-hist"><span class="v-hist-tag">Returning</span>{sortTitles(vehicle.previousGames).map((g) => <span class="v-hist-chip" title={gtaTitleBySlug[g]?.name}>{gtaTitleBySlug[g]?.short ?? g}</span>)}</dd>}</div>
    </dl>
  </section>

  {copy && (
    <section class={`wrap v-description${similar.length > 0 || family.length > 0 ? ' has-similar' : ''}`}>
      <div class="panel v-description-panel">
        {copy.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
  )}

  {similar.length > 0 && (
    <section class="wrap v-similar" id="v-similar" aria-labelledby="v-similar-title">
      {/* COPY STATUS: heading reviewed by Codex 2026-10-06, no change. */}
      <h2 id="v-similar-title">Similar Cars</h2>
      <div class="v-similar-grid">
        {similar.map((v) => <VehicleTile vehicle={v} />)}
      </div>
    </section>
  )}

  {family.length > 0 && (
    <section class="wrap v-similar v-family" id="v-family" aria-labelledby="v-family-title">
      {/* COPY STATUS: Claude placeholder, Codex review pending. */}
      <div class="v-family-head">
        <h2 id="v-family-title">More {familyLabel} Models</h2>
        {familyPage && <a class="v-family-all" href={familyPage}>All {familyLabel} models →</a>}
      </div>
      <div class="v-similar-grid">
        {family.slice(0, 4).map((v) => <VehicleTile vehicle={v} />)}
      </div>
    </section>
  )}
</Base>

<style>
  .v-toolbar { display: grid; grid-template-columns: 1.5fr 1fr auto; align-items: center; gap: var(--gh-gap-card); padding-top: 1.5rem; }
  .v-search-wrap { position: relative; }
  .v-search-field { width: 100%; } /* look: site-wide .ui-search (tokens.css) */
  .v-search-results { position: absolute; top: calc(100% + .35rem); left: 0; right: 0; z-index: 20; margin: 0; padding: .3rem; list-style: none; background: var(--gh-surface); border: 1px solid var(--gh-line); border-radius: var(--gh-radius); max-height: 16rem; overflow-y: auto; }
  .v-search-results li + li { margin-top: .15rem; }
  .v-search-results a { display: block; padding: .5rem .6rem; border-radius: calc(var(--gh-radius) - .2rem); color: var(--gh-text); text-decoration: none; font-size: .85rem; }
  .v-search-results a:hover, .v-search-results a:focus { background: rgba(160,160,198,.12); }
  .garage-compare-btn { justify-self: end; background: var(--gh-surface); border: 1px solid var(--gh-line); border-radius: var(--gh-radius); color: var(--gh-text); padding: .55rem 1rem; font-size: .8rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .garage-compare-btn:hover { border-color: var(--gh-muted); }
  .garage-compare-btn.has-selection { border-color: var(--gh-yellow); color: var(--gh-yellow); }

  .v-stage { display: grid; grid-template-columns: 1.5fr 1fr; gap: var(--gh-gap-card); padding-top: 1.5rem; }
  .v-photo { position: relative; aspect-ratio: 16/9; background: rgba(160,160,198,.08); border-radius: var(--gh-radius-lg); overflow: hidden; }
  .v-photo > img { width: 100%; height: 100%; object-fit: cover; }
  .v-photo-fallback { opacity: .4; filter: saturate(.7); }
  .v-photo-pending { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(20,20,26,.7); border: 1px solid rgba(252,250,247,.12); padding: .35rem .75rem; border-radius: 999px; color: var(--gh-muted); font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; white-space: nowrap; }
  .v-badge { position: absolute; top: .7rem; left: .7rem; z-index: 2; padding: .3rem .65rem; border-radius: 999px; background: var(--gh-red); color: #fff; font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .v-compare-mark { position: absolute; top: .7rem; right: .7rem; z-index: 2; width: 2.1rem; height: 2.1rem; border-radius: 50%; border: 1px solid rgba(252,250,247,.35); background: rgba(20,20,26,.65); color: var(--gh-text); font-size: 1.2rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .v-compare-mark:hover { border-color: var(--gh-text); }
  .v-compare-mark.is-selected { background: var(--gh-yellow); border-color: var(--gh-yellow); color: #1a1206; }

  .v-identity { padding: var(--gh-pad-card); }
  /* "I own this" toggle (RS-0032) */
  .v-own-btn[hidden], .v-own-msg[hidden], .v-garage-link[hidden] { display: none; }
  .v-own-wrap { justify-self: end; display: flex; align-items: stretch; gap: .5rem; }
  .v-garage-link { display: inline-flex; align-items: center; justify-content: center; width: 2.4rem; flex: none; border-radius: var(--gh-radius); border: 1px solid var(--gh-yellow); background: rgba(255,215,76,.08); color: var(--gh-yellow); }
  .v-garage-link:hover { background: rgba(255,215,76,.16); }
  .v-own-btn { display: inline-flex; align-items: center; gap: .5rem; padding: .55rem 1rem; border-radius: var(--gh-radius); border: 1px solid var(--gh-line); background: var(--gh-surface); color: var(--gh-text); font: inherit; font-size: .8rem; font-weight: 700; cursor: pointer; white-space: nowrap; }
  .v-own-btn:hover { border-color: var(--gh-muted); }
  /* Toggle switch instead of a checkbox (Fausto, 2026-10-02) */
  .v-own-box { position: relative; flex: none; box-sizing: border-box; width: 2.1rem; height: 1.2rem; border-radius: 999px; background: rgba(160,160,198,.25); border: 1px solid var(--gh-line); transition: background .15s, border-color .15s; }
  .v-own-box::after { content: ''; position: absolute; top: 50%; left: .15rem; width: .82rem; height: .82rem; border-radius: 50%; background: var(--gh-text); transform: translateY(-50%); transition: transform .15s; }
  .v-own-btn[aria-pressed="true"] { border-color: var(--gh-yellow); background: rgba(255,215,76,.08); }
  .v-own-btn[aria-pressed="true"] .v-own-box { background: var(--gh-yellow); border-color: var(--gh-yellow); }
  .v-own-btn[aria-pressed="true"] .v-own-box::after { background: #1a1206; transform: translate(.88rem, -50%); }
  @media (prefers-reduced-motion: reduce) { .v-own-box, .v-own-box::after { transition: none; } }
  .v-own-btn:disabled { opacity: .6; cursor: progress; }
  .v-own-msg { grid-column: 1 / -1; justify-self: end; margin: -.4rem 0 0; font-size: .8rem; color: var(--gh-muted); }
  .v-own-msg a { color: var(--gh-text); }
  .v-h1 { margin: 0; font: inherit; }
  .v-maker { display: flex; align-items: center; gap: .5rem; margin-bottom: .5rem; }
  .v-maker img { filter: brightness(0) invert(1); opacity: .85; object-fit: contain; }
  .v-maker span { color: var(--gh-muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; font-weight: 700; }
  .v-title { display: block; font-size: clamp(1.45rem, 2.7vw, 2rem); margin: 0 0 .3rem; line-height: 1.1; }
  .v-classes { color: var(--gh-muted); font-size: .85rem; margin: 0 0 1.25rem; }
  .v-classes a { color: var(--gh-muted); text-decoration: underline; text-decoration-color: var(--gh-line); text-underline-offset: 3px; }
  .v-classes a:hover { color: var(--gh-text); }
  .v-key { display: grid; gap: .75rem; margin: 0; }
  .v-key > div { display: flex; justify-content: space-between; border-top: 1px solid var(--gh-line); padding-top: .6rem; }
  .v-key dt { color: var(--gh-muted); font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; margin: 0; }
  .v-key dd { margin: 0; font-size: .85rem; font-weight: 600; }
  .v-lb-link { color: inherit; text-decoration: underline; text-decoration-color: rgba(160,160,198,.5); text-underline-offset: 3px; display: inline-flex; align-items: center; gap: .35rem; }
  .v-lb-link:hover { color: var(--gh-text); text-decoration-color: var(--gh-text); }
  .v-src { color: var(--gh-muted); font-size: .68rem; font-weight: 600; margin-left: .3rem; }

  .v-similar h2 { font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.1rem; margin: 0 0 1rem; }
  .v-facts { padding-top: var(--gh-gap-card); }
  /* same column split as .v-stage, so the strips line up with photo and main panel */
  .v-facts-row, .v-origins { display: grid; grid-template-columns: 1.5fr 1fr; gap: var(--gh-gap-card); }
  .v-strip { display: flex; align-items: stretch; padding: 0; overflow: hidden; }
  .v-strip-title { display: flex; align-items: center; margin: 0; padding: 0 1rem; border-right: 1px solid var(--gh-line); background: rgba(252,250,247,.03); font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: .8rem; white-space: nowrap; }
  .v-strip-f { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: .15rem; padding: .55rem 1.1rem; border-right: 1px solid var(--gh-line); }
  .v-strip-f:last-child { border-right: 0; }
  .v-strip-f span { color: var(--gh-muted); font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; }
  .v-strip-f strong { font-size: .86rem; }
  .v-strip-f strong.v-muted { color: var(--gh-muted); font-weight: 600; }
  .v-origins { margin: 0; padding: .9rem 0 0; }
  .v-origins > div { display: flex; align-items: center; flex-wrap: wrap; gap: .3rem .7rem; padding: 0 1.1rem; }
  .v-origins dt { color: var(--gh-muted); font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; margin: 0; }
  .v-origins dd { margin: 0; font-size: .84rem; font-weight: 600; }
  .v-hist { display: flex; flex-wrap: wrap; gap: .3rem; }
  .v-hist-tag { display: inline-flex; padding: .12rem .5rem; border-radius: 999px; background: rgba(255,215,76,.14); color: var(--gh-yellow); font-size: .64rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
  .v-hist-chip { display: inline-flex; padding: .12rem .5rem; border-radius: 999px; border: 1px solid var(--gh-line); background: rgba(252,250,247,.05); font-size: .66rem; font-weight: 700; }
  @media (max-width: 900px) {
    .v-facts-row, .v-origins { grid-template-columns: 1fr; }
    .v-strip { flex-wrap: wrap; }
    .v-strip-title { flex-basis: 100%; padding: .55rem 1.1rem; border-right: 0; border-bottom: 1px solid var(--gh-line); }
    .v-strip-f { flex-basis: 40%; border-right: 0; padding-block: .6rem; }
    .v-origins { gap: .7rem; }
  }
  /* Even rhythm (Fausto 2026-10-08): every block below the stage is one --gh-gap-card apart;
     Similar Cars -> More <Family> Models included (was double gap). */
  .v-similar:has(+ .v-family) { padding-bottom: var(--gh-gap-card); }
  .v-family { padding-top: var(--gh-gap-card); }
  .v-similar + .v-family { padding-top: 0; }
  .v-family-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .v-family-all { color: var(--gh-text); font-size: .85rem; font-weight: 700; }

  .v-description { padding-top: var(--gh-gap-card); padding-bottom: var(--gh-gap-section); }
  .v-description-panel { padding: var(--gh-pad-card); color: var(--gh-muted); font-size: .8rem; line-height: 1.6; }
  .v-description-panel p { margin: 0 0 1rem; }
  .v-description-panel p:last-child { margin-bottom: 0; }
  /* Similar Cars: same spacing as between the other blocks; always full rows
     (4 / 2x2 / 1 column), never a half-filled second row (Fausto, 2026-10-06). */
  .v-description.has-similar { padding-bottom: 0; }
  .v-source-link { color: inherit; text-decoration: underline; text-decoration-color: var(--gh-yellow); text-underline-offset: .2em; }
  .v-source-link:hover { color: var(--gh-yellow); }
  .v-similar { padding-top: var(--gh-gap-card); padding-bottom: var(--gh-gap-section); }
  .v-similar-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gh-gap-card); }
  @media (max-width: 1120px) { .v-similar-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .v-similar-grid { grid-template-columns: 1fr; } }

  @media (max-width: 760px) {
    .v-stage { grid-template-columns: 1fr; }
    .v-toolbar { grid-template-columns: 1fr 1fr; }
    .v-search-wrap { grid-column: 1 / -1; }
    .garage-compare-btn, .v-own-wrap { justify-self: stretch; }
    .garage-compare-btn, .v-own-btn { justify-content: center; text-align: center; }
    .v-own-btn { flex: 1; }
    .v-own-msg { justify-self: start; }
  }
</style>

<script define:vars={{ vehicleIndex }}>
  const searchInput = document.getElementById('v-search');
  const resultsList = document.getElementById('v-search-results');

  function renderResults(matches) {
    resultsList.innerHTML = '';
    if (matches.length === 0) {
      resultsList.hidden = true;
      return;
    }
    matches.slice(0, 8).forEach((v) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = v.href;
      a.textContent = v.name;
      li.appendChild(a);
      resultsList.appendChild(li);
    });
    resultsList.hidden = false;
  }

  searchInput.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    if (!q) {
      resultsList.hidden = true;
      resultsList.innerHTML = '';
      return;
    }
    renderResults(vehicleIndex.filter((v) => v.name.toLowerCase().includes(q)));
  });

  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const first = resultsList.querySelector('a');
      if (first) {
        e.preventDefault();
        window.location.href = first.getAttribute('href');
      }
    }
  });

  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Node)) return;
    if (!searchInput.contains(e.target) && !resultsList.contains(e.target)) {
      resultsList.hidden = true;
    }
  });
</script>

<script>
  import { getSelected, isSelected, toggleSelected } from '../../../../scripts/compare';
  import { initVehicleTiles } from '../../../../scripts/vehicle-tiles';

  const iconBtn = document.getElementById('v-compare-mark') as HTMLButtonElement | null;
  const compareCta = document.getElementById('v-compare-cta') as HTMLAnchorElement | null;

  function updateCompareCta() {
    if (!compareCta) return;
    const count = getSelected().length;
    compareCta.textContent = `Compare Selected (${count})`;
    compareCta.classList.toggle('has-selection', count > 0);
  }

  const id = iconBtn?.dataset.id;
  if (id) {
    function render(selected: boolean) {
      iconBtn?.classList.toggle('is-selected', selected);
      iconBtn?.setAttribute('aria-pressed', String(selected));
    }
    render(isSelected(id));
    iconBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      const nowSelected = toggleSelected(id);
      render(nowSelected);
      updateCompareCta();
    });
  }

  updateCompareCta();

  // Similar Cars tiles: compare marks + owned badges, keeping the counter in sync.
  const similarSection = document.getElementById('v-similar');
  if (similarSection) initVehicleTiles(similarSection, updateCompareCta);
  const familySection = document.getElementById('v-family');
  if (familySection) initVehicleTiles(familySection, updateCompareCta);
</script>

<script>
  // "I own this vehicle" toggle (RS-0032, DEC-0074). Private list, shown in
  // My Account > Garage. Signed out: sign in first, then it is set on return.
  import { backendConfigured, getSupabase } from '../../../../scripts/supabase-client';
  import { currentDriverId, fetchOwned, setOwned } from '../../../../scripts/owned';
  const btn = document.getElementById('v-own') as HTMLButtonElement;
  const label = btn.querySelector('.v-own-label') as HTMLElement;
  const msg = document.getElementById('v-own-msg') as HTMLElement;
  const garageLink = document.getElementById('v-garage-link') as HTMLAnchorElement;
  const vehicleId = (document.getElementById('v-compare-mark') as HTMLElement).dataset.id!;
  const base = import.meta.env.BASE_URL;
  let me: string | null = null;

  function render(owned: boolean) {
    btn.setAttribute('aria-pressed', String(owned));
    btn.setAttribute('aria-checked', String(owned));
    label.textContent = owned ? 'In My Garage' : 'I Own This Vehicle';
    garageLink.hidden = !owned;
  }
  let noteTimer: number | undefined;
  function note(html: string) {
    msg.innerHTML = html; msg.hidden = !html;
    clearTimeout(noteTimer);
    if (html) noteTimer = window.setTimeout(() => { msg.hidden = true; }, 5000);
  }

  async function toggle(want: boolean) {
    if (!me) return;
    btn.disabled = true;
    try {
      render(await setOwned(me, vehicleId, want));
      note(''); // success is shown by the garage shortcut; the note is only for errors
    } catch {
      note('Could not save — please try again.');
    }
    btn.disabled = false;
  }

  async function init() {
    btn.hidden = false;
    me = await currentDriverId();
    const url = new URL(location.href);
    const pending = url.searchParams.get('own') === '1';
    if (pending) { url.searchParams.delete('own'); history.replaceState(null, '', url.pathname + url.search + url.hash); }
    if (!me) { render(false); return; }
    const owned = (await fetchOwned()).has(vehicleId);
    render(owned);
    if (pending && !owned) toggle(true);
  }

  if (backendConfigured) {
    btn.addEventListener('click', () => {
      if (!me) {
        const url = new URL(location.href);
        url.searchParams.set('own', '1');
        getSupabase().auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: url.toString(), scopes: 'identify email guilds.join' } });
        return;
      }
      toggle(btn.getAttribute('aria-pressed') !== 'true');
    });
    init();
  }
</script>
