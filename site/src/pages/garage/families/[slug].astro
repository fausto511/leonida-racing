---
// Model family pages (Fausto 2026-10-08): from FAMILY_PAGE_MIN models on, e.g. Dominator.
// Members may span several classes. noindex until the family has its own copy
// (familyCopy in data/rankings.ts) -- written from community experience after launch.
// COPY STATUS: Codex 2026-10-08, approved by Fausto 2026-10-09.
import Base from '../../../layouts/Base.astro';
import VehicleTile from '../../../components/VehicleTile.astro';
import { familyMembers, familyName, compareGarageOrder } from '../../../data/vehicles';
import { familyPageSlugs, familyIndexable, familyCopy } from '../../../data/rankings';

export function getStaticPaths() {
  return familyPageSlugs().map((f) => ({ params: { slug: f }, props: { f } }));
}
const { f } = Astro.props;
const base = import.meta.env.BASE_URL;
const name = familyName(f);
const list = familyMembers(f).filter((v) => v.releaseId).sort(compareGarageOrder);
const classes = [...new Set(list.flatMap((v) => v.classes))];
const title = `${name} Models in GTA 6`;
const description = `Explore the ${name} model family in GTA 6, with individual vehicle details, release information and available performance results.`;
---
<Base title={title} description={description} section="garage" noindex={!familyIndexable(f)}
  breadcrumbs={[{ name: 'The Garage', path: 'garage/' }, { name: `${name} family`, path: `garage/families/${f}/` }]}>
  <section class="wrap fm-head">
    <nav class="fm-crumbs" aria-label="Breadcrumb"><a href={`${base}garage/`}>The Garage</a><span aria-hidden="true">/</span><span>{name} family</span></nav>
    <p class="eyebrow">GTA VI Model Family</p>
    <h1 class="display fm-title">{title}</h1>
    <div class="fm-intro">
      {familyCopy[f]?.length ? familyCopy[f].map((p) => <p>{p}</p>) : <p>Explore the {name} model family and the vehicle details currently available for each model.</p>}
    </div>
  </section>
  <section class="wrap fm-grid" aria-label={`${name} models`}>
    {list.map((v) => <VehicleTile vehicle={v} />)}
  </section>
</Base>

<style>
  .fm-head { padding-top: 1.75rem; }
  .fm-crumbs { display: flex; gap: .45rem; font-size: .78rem; color: var(--gh-muted); margin-bottom: 1rem; }
  .fm-crumbs a { color: var(--gh-muted); }
  .fm-title { margin: .3rem 0 .8rem; font-size: clamp(2rem, 4.5vw, 3rem); }
  .fm-intro p { margin: 0 0 .6rem; color: var(--gh-muted); max-width: 46rem; }
  .fm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: var(--gh-gap-card); padding-block: 1.5rem var(--gh-gap-section); }
</style>
