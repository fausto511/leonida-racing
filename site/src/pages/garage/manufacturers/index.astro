---
import TaxonomyIndex from '../../../components/TaxonomyIndex.astro';
import { manufacturerPages, vehiclesByMake, manufacturersAbout } from '../../../data/garage-taxonomy';
// COPY STATUS: approved (Codex 2026-10-02, Fausto).
---
<TaxonomyIndex
  about={manufacturersAbout}
  kind="manufacturer"
  pages={manufacturerPages.map((page) => ({ page, vehicles: vehiclesByMake(page.slug) }))}
  title="GTA VI Car Manufacturers — Browse by Brand"
  heading="GTA VI Car Manufacturers"
  description="Browse GTA 6 car manufacturers including Vapid, Declasse, Grotti, and Pegassi. Compare their vehicles and real-world inspirations."
  intro="Browse The Garage by GTA VI manufacturer. See each brand's cars, compare models, and trace the real-world influence behind the badge."
/>
