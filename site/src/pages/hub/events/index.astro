---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import HubSubnav from '../../../components/HubSubnav.astro';
import '../../../styles/hub.css';
import { sampleEvents, eventRowHtml, eventTypeLabels, platformLabels, monthLabel } from '../../../data/hub';
import { PLATFORMS, ACTIVE_PLATFORMS } from '../../../data/platforms';

// Build-time render (UTC) of the flagged sample events, grouped by month.
const groups: { label: string; rows: string[] }[] = [];
for (const e of sampleEvents) {
  const label = monthLabel(e.starts_at, true);
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.rows.push(eventRowHtml(e, { sample: true }));
  else groups.push({ label, rows: [eventRowHtml(e, { sample: true })] });
}
const initialHtml = groups.map((g) => `<h2 class="ev-month">${g.label}</h2><div class="ev-list">${g.rows.join('')}</div>`).join('');
---
<Base
  title="GTA VI Event Calendar — Races, Playlists & Car Meets"
  description="Find GTA 6 races, league rounds, community playlists, and car meets. See who’s hosting and view every start time in your local time zone."
  section="hub"
  noindex={true /* until real crews/events replace the sample data (RS-0022) */}
>
  <PageHero status="hub" image="hub-events" eyebrow="Find Your Next GTA VI Race" title="Event Calendar" lede="Races, league rounds, community playlists, and car meets from across the GTA VI racing scene. Find out who’s hosting and what’s happening next. All times are shown in your local time zone." />

  <HubSubnav active="events" />

  <section class="wrap hub-body">
    <div class="hub-toolbar">
      <div class="hub-filters">
        <select class="ui-select" id="ev-type" aria-label="Filter by event type">
          <option value="">All event types</option>
          {Object.entries(eventTypeLabels).map(([k, v]) => <option value={k}>{v}</option>)}
        </select>
        <select class="ui-select" id="ev-platform" aria-label="Filter by platform">
          {PLATFORMS.map((p) => <option value={p.active && ACTIVE_PLATFORMS.length === 1 ? '' : p.id} disabled={!p.active} selected={p.id === 'ps5'}>{p.active ? p.label : `${p.label} — coming later`}</option>)}
        </select>
      </div>
      <span class="hub-sample-flag" id="ev-flag">Sample data — example events, not real</span>
    </div>

    <div id="ev-root" set:html={initialHtml} />
    <p class="hub-empty" id="ev-empty" hidden>No events match these filters.</p>

    <p class="hub-note">Hosting events? Apply as event host in <a href={`${import.meta.env.BASE_URL}account/events/`}>My Account</a> — once a moderator approves it, you publish your events here yourself. Every event is open to everyone.</p>
  </section>
</Base>

<script>
  import { sampleEventsUpcoming, eventRowHtml, localizeTimes, monthLabel, type HubEvent } from '../../../data/hub';
  import { fetchLiveEvents } from '../../../scripts/hub-live';
  import { createEventRsvp } from '../../../scripts/event-rsvp';

  const root = document.getElementById('ev-root')!;
  const emptyEl = document.getElementById('ev-empty')!;
  const flagEl = document.getElementById('ev-flag')!;
  const typeSel = document.getElementById('ev-type') as HTMLSelectElement;
  const platSel = document.getElementById('ev-platform') as HTMLSelectElement;

  // Sample events (flagged) until real ones exist -- moved to upcoming dates so
  // the sign-up demo keeps working after release (RS-0033).
  let events: HubEvent[] = sampleEventsUpcoming();
  let live = false;
  const rsvp = createEventRsvp(root);

  function render() {
    const t = typeSel.value;
    const p = platSel.value;
    const list = events.filter((e) => (!t || e.event_type === t) && (!p || e.platforms.includes(p as never)));
    let html = '';
    let current = '';
    for (const e of list) {
      const label = monthLabel(e.starts_at);
      if (label !== current) {
        if (current) html += '</div>';
        html += `<h2 class="ev-month">${label}</h2><div class="ev-list">`;
        current = label;
      }
      html += eventRowHtml(e, { rsvp: true, sample: !live });
    }
    if (current) html += '</div>';
    root.innerHTML = html;
    localizeTimes(root);
    emptyEl.hidden = list.length > 0;
    rsvp.setEvents(events, live);
    rsvp.renderRsvps();
  }

  typeSel.addEventListener('change', render);
  platSel.addEventListener('change', render);
  rsvp.setEvents(events, false);
  render();

  fetchLiveEvents().then(async (data) => {
    if (!data) return;
    events = data;
    live = true;
    rsvp.setEvents(events, true);
    flagEl.hidden = true;
    render();
    // Deep link from the Discord bot / shares: /hub/events/#event-<id> (2026-10-04)
    const target = location.hash.startsWith('#event-') ? document.getElementById(location.hash.slice(1)) : null;
    if (target) { target.scrollIntoView({ block: 'center' }); target.classList.add('is-target'); }
    await rsvp.connect();
  });
</script>
