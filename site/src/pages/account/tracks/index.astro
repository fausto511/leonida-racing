---
// My Account > Tracks (RS-0045): creators submit and edit their race jobs
// (HubEditor, personal mode "tracks"); everyone else can apply as creator.
import Base from '../../../layouts/Base.astro';
import AccountSubnav from '../../../components/AccountSubnav.astro';
import HubEditor from '../../../components/HubEditor.astro';
import RoleApply from '../../../components/RoleApply.astro';
import '../../../styles/hub.css';
const base = import.meta.env.BASE_URL;
---
<Base
  title="My Tracks — My Account"
  description="Submit and manage your GTA VI race jobs as a creator."
  section="account"
  noindex
>
  <section class="wrap account-wrap">
    <p class="eyebrow">Private Driver Area</p>
    <h1 class="display account-title">My Account</h1>
    <AccountSubnav active="tracks" />

    <div id="acc-auth" class="panel acc-auth" hidden>
      <p>Sign in with Discord to submit your tracks.</p>
      <button type="button" id="acc-signin" class="btn btn-discord">Sign in with Discord</button>
    </div>

    <div id="acc-body" hidden>
      <!-- Saved tracks (DEC-0146, Fausto 20.10.): one list, saved on Community > Tracks. COPY: Claude placeholder. -->
      <h2 class="section-heading">Saved tracks</h2>
      <p class="section-lede">Race jobs you saved on <a href={`${base}community/tracks/`}>Community → Tracks</a>. Open them on Social Club to bookmark them for the game.</p>
      <p class="tr-msg" id="sv-msg" role="status" hidden></p>
      <div class="tr-list" id="sv-root"></div>
      <div class="panel tr-cta" id="sv-empty" hidden>
        <p><strong>No saved tracks yet.</strong> Find a circuit or a point-to-point run and tap Save.</p>
        <a class="btn btn-outline" href={`${base}community/tracks/`}>Find tracks</a>
      </div>
      <div id="creator-block" hidden>
        <h2 class="section-heading">Your tracks</h2>
        <p class="section-lede">Submit your race jobs with the Social Club link. A moderator checks the details against Social Club and publishes the track. Every change goes back to a quick check before it is live again.</p>
        <HubEditor mode="tracks" />
      </div>

      <RoleApply focus="creator" />
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .account-wrap { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .account-title { margin: .4rem 0 1.2rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .acc-auth { margin-bottom: 1.5rem; padding: 1rem 1.2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .acc-auth p { margin: 0; font-size: .88rem; }
  .tr-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.2rem; }
  .tr-cta p { margin: 0; color: var(--gh-muted); font-size: .9rem; max-width: 40rem; }
  .tr-cta strong { color: var(--gh-text); }
  .section-heading { margin: 2.5rem 0 .3rem; font-family: var(--gh-font-display); font-weight: 900; text-transform: uppercase; font-size: 1.3rem; }
  .section-lede { margin: 0 0 1.2rem; color: var(--gh-muted); font-size: .88rem; }
  .section-lede a { color: var(--gh-text); }
  .section-heading:first-child { margin-top: 0; }
  .tr-msg { margin: 0 0 12px; padding: 10px 12px; border-radius: 6px; border: 1px solid var(--lr-line-strong); background: var(--lr-card); font-size: 14px; color: var(--lr-soft); }
  .tr-msg.is-error { border-color: rgba(255,122,122,.5); color: #FF8A8A; }
</style>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  document.addEventListener('hc-access', (e: any) => {
    document.getElementById('creator-block')!.hidden = !e.detail.hasAccess;
  });
  import { trackRowHtml, type CommunityTrack } from '../../../data/tracks';
  import { loadSaved, toggleSaved, type SavedState } from '../../../scripts/track-saves';
  const svRoot = document.getElementById('sv-root')!, svEmpty = document.getElementById('sv-empty')!, svMsg = document.getElementById('sv-msg')!;
  let state: SavedState | null = null;
  let list: CommunityTrack[] = [];
  function renderSaved() {
    svRoot.innerHTML = list.map((t) => trackRowHtml(t, { saved: true })).join('');
    svEmpty.hidden = list.length > 0;
  }
  async function loadSavedTracks() {
    state = await loadSaved(true);
    list = [];
    if (state.driverId && state.available) {
      const { data } = await getSupabase().from('saved_tracks')
        .select('created_at, track:community_tracks(track_id,title,social_club_url,layout,race_types,vehicle_classes,players_min,players_max,length_km,created_at,updated_at,is_published)')
        .eq('driver_id', state.driverId).order('created_at', { ascending: false });
      list = ((data ?? []) as any[]).map((r) => r.track).filter((t) => t && t.is_published).map((t) => ({ ...t, length_km: Number(t.length_km) }));
    }
    renderSaved();
  }
  svRoot.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-save]');
    if (!b || !state) return;
    b.disabled = true;
    const r = await toggleSaved(state, b.dataset.save!, true);
    if (r.error) { b.disabled = false; svMsg.textContent = r.error; svMsg.hidden = false; svMsg.classList.add('is-error'); return; }
    list = list.filter((t) => state!.ids.has(t.track_id));
    svMsg.textContent = 'Removed from your saved tracks.'; svMsg.hidden = false; svMsg.classList.remove('is-error');
    renderSaved();
  });
  function init(session: any) {
    document.getElementById('acc-auth')!.hidden = Boolean(session);
    document.getElementById('acc-body')!.hidden = !session;
    if (session) loadSavedTracks();
  }
  if (backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
    document.getElementById('acc-signin')!.addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  }
</script>
