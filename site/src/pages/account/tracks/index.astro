---
// My Account > Tracks (RS-0045): creators submit and edit their race jobs
// (HubEditor, personal mode "tracks"); everyone else can apply as creator.
import Base from '../../../layouts/Base.astro';
import AccountSubnav from '../../../components/AccountSubnav.astro';
import HubEditor from '../../../components/HubEditor.astro';
import RoleApply from '../../../components/RoleApply.astro';
import '../../../styles/hub.css';
const base = import.meta.env.BASE_URL;
---
<Base
  title="My Tracks — My Account"
  description="Submit and manage your GTA VI race jobs as a creator."
  section="account"
  noindex
>
  <section class="wrap account-wrap">
    <p class="eyebrow">Private Driver Area</p>
    <h1 class="display account-title">My Account</h1>
    <AccountSubnav active="tracks" />

    <div id="acc-auth" class="panel acc-auth" hidden>
      <p>Sign in with Discord to submit your tracks.</p>
      <button type="button" id="acc-signin" class="btn btn-discord">Sign in with Discord</button>
    </div>

    <div id="acc-body" hidden>
      <div class="panel tr-cta">
        <p><strong>Looking for a new track?</strong> Race jobs built by the community — circuits and point-to-point runs with lobby size and vehicle classes.</p>
        <a class="btn btn-primary" href={`${base}community/tracks/`}>Find tracks</a>
      </div>

      <div id="creator-block" hidden>
        <h2 class="section-heading">My Tracks</h2>
        <p class="section-lede">Submit your race jobs with the Social Club link. A moderator checks the details against Social Club and publishes the track. Every change goes back to a quick check before it is live again.</p>
        <HubEditor mode="tracks" />
      </div>

      <RoleApply focus="creator" />
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .account-wrap { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .account-title { margin: .4rem 0 1.2rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .acc-auth { margin-bottom: 1.5rem; padding: 1rem 1.2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .acc-auth p { margin: 0; font-size: .88rem; }
  .tr-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.2rem; }
  .tr-cta p { margin: 0; color: var(--gh-muted); font-size: .9rem; max-width: 40rem; }
  .tr-cta strong { color: var(--gh-text); }
  .section-heading { margin: 2.5rem 0 .3rem; font-family: var(--gh-font-display); font-weight: 900; text-transform: uppercase; font-size: 1.3rem; }
  .section-lede { margin: 0 0 1.2rem; color: var(--gh-muted); font-size: .88rem; }
</style>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  document.addEventListener('hc-access', (e: any) => {
    document.getElementById('creator-block')!.hidden = !e.detail.hasAccess;
  });
  function init(session: any) {
    document.getElementById('acc-auth')!.hidden = Boolean(session);
    document.getElementById('acc-body')!.hidden = !session;
  }
  if (backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
    document.getElementById('acc-signin')!.addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  }
</script>
