---
// My Account > Tracks (RS-0045; redesign DEC-0196, Fausto 30.10.2026), same pattern as Events:
// 1. Saved tracks: the track rows of Community > Tracks + "+ Find more tracks".
// 2. Your tracks (creators): the same rows; the right-hand slot shows status (Live / In review),
//    Edit and Open Social Club instead of Save. "+ Submit a track". Edit / Submit opens the editor
//    (HubEditor, tracks mode) under the list. 3. Creator application.
import Base from '../../../layouts/Base.astro';
import AccountHead from '../../../components/AccountHead.astro';
import HubEditor from '../../../components/HubEditor.astro';
import RoleApply from '../../../components/RoleApply.astro';
import '../../../styles/hub.css';
const base = import.meta.env.BASE_URL;
---
<Base
  title="My Tracks — My Account"
  description="Your saved tracks and, for creators, the race jobs you submitted."
  section="account"
  noindex
>
  <AccountHead active="tracks" cta={{ label: 'Find tracks', href: `${base}community/tracks/` }} />
  <section class="wrap account-wrap">

    <div id="acc-auth" class="acc-auth lr-empty-panel" hidden>
      <p>Log in to view saved tracks or submit your own.</p>
      <button type="button" id="acc-signin" class="btn btn-discord">Discord login</button>
    </div>

    <div id="acc-body" class="trs-secs" hidden>
      <!-- Saved tracks (DEC-0146, Fausto 20.10.): one list, saved on Community > Tracks. COPY: Codex 21.10.2026. -->
      <section>
        <div class="trs-head">
          <h2 class="lr-h2 lr-h2-s">Saved tracks</h2>
          <p class="trs-lede">Your saved list from <a href={`${base}community/tracks/`}>Community → Tracks</a>. Saving here does not add an in-game bookmark; open published jobs on Social Club to bookmark them for the game.</p>
        </div>
        <p class="tr-msg lr-note" id="sv-msg" role="status" hidden></p>
        <div class="tr-list" id="sv-root"></div>
      </section>

      <section id="creator-block" hidden>
        <div class="trs-head">
          <h2 class="lr-h2 lr-h2-s">Your tracks</h2>
          <p class="trs-lede">Submit your race jobs with their Social Club links. A moderator checks the details before publishing. Edited tracks return to review before they can be published again.</p>
        </div>
        <div class="tr-list" id="own-root"></div>
        <div class="trs-editor" id="own-editor" hidden>
          <div class="trs-editor-top">
            <h3 class="trs-editor-t" id="own-editor-t">Edit track</h3>
            <button type="button" class="btn btn-s btn-sm" id="own-editor-close">Close</button>
          </div>
          <HubEditor mode="tracks" />
        </div>
      </section>

      <RoleApply focus="creator" />
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .account-wrap { padding-top: var(--lr-gap-head); } /* DEC-0188; the footer brings the 64px gap below */
  .acc-auth { margin-bottom: 1.5rem; } /* box: .lr-empty-panel (DEC-0182) */
  .trs-secs:not([hidden]) { display: flex; flex-direction: column; gap: var(--lr-gap-sec); }
  .trs-head { margin-bottom: 20px; }
  .trs-lede { margin: 8px 0 0; max-width: 720px; font-size: 15px; line-height: 1.5; color: var(--lr-soft); }
  .trs-lede a { color: var(--lr-text); }
  .tr-msg { margin: 0 0 12px; } /* box: .lr-note, errors .is-error (DEC-0186) */
  /* "+" card at the end of a list (like My garage / Crews / Events) */
  :global(.trs-slot) { display: flex; align-items: center; justify-content: center; gap: 14px; width: 100%; min-height: 72px; padding: 0 18px; border: 1px dashed var(--lr-line-strong); border-radius: 8px; background: transparent; color: var(--lr-soft); font: inherit; font-size: 14px; text-decoration: none; cursor: pointer; box-sizing: border-box; }
  :global(.trs-slot:hover), :global(.trs-slot:focus-visible) { border-color: var(--lr-orange); background: var(--lr-orange-tint); color: var(--lr-text); outline: none; }
  :global(.trs-slot-plus) { width: 36px; height: 36px; border-radius: 50%; border: 1px solid currentColor; display: grid; place-items: center; font-size: 18px; line-height: 1; }
  :global(.trs-slot strong) { color: var(--lr-text); font-weight: 600; font-size: 15px; }
  :global(#own-root .tr-report) { display: none; } /* no report link on your own tracks */
  :global(.trs-side) { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  .trs-editor { margin-top: 24px; padding: 24px; border: 1px solid var(--lr-orange-border); border-radius: 8px; background: var(--lr-card); }
  .trs-editor-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
  .trs-editor-t { margin: 0; font-size: 18px; font-weight: 700; }
  @media (max-width: 760px) { .trs-editor { padding: 16px; } /* phones: status on its own line, then Edit + Social Club side by side -- same shape for Live and In review */
    :global(.trs-side) { display: grid; grid-template-columns: auto minmax(0, 1fr); justify-content: stretch; } :global(.trs-side > .lr-status) { grid-column: 1 / -1; justify-self: start; } }
</style>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  let isCreator = false;
  document.addEventListener('hc-access', (e: any) => {
    isCreator = Boolean(e.detail.hasAccess);
    document.getElementById('creator-block')!.hidden = !isCreator;
    if (isCreator && state?.driverId) loadOwn();
  });
  import { trackRowHtml, type CommunityTrack } from '../../../data/tracks';
  import { esc } from '../../../data/hub';
  import { loadSaved, toggleSaved, loadRatings, rateTrack, type SavedState, type Ratings } from '../../../scripts/track-saves';
  const svRoot = document.getElementById('sv-root')!, svMsg = document.getElementById('sv-msg')!;
  const base = import.meta.env.BASE_URL;
  const slot = (label: string, attrs: string, tag = 'a') => `<${tag} class="trs-slot" ${attrs}><span class="trs-slot-plus" aria-hidden="true">+</span><strong>${label}</strong></${tag}>`;
  let state: SavedState | null = null;
  let list: CommunityTrack[] = [];
  let ratings: Ratings = { pub: new Map(), my: new Map(), available: true };
  let loadFailed = false;
  function renderSaved() {
    svRoot.innerHTML = list.map((t) => { const pub = ratings.pub.get(t.track_id); return trackRowHtml(t, { saved: true, rating: { avg: pub?.avg ?? null, count: pub?.count ?? 0, my: ratings.my.get(t.track_id), canRate: (t as any).created_by !== state?.driverId, unavailable: !ratings.available } }); }).join('') + (loadFailed ? '' : slot(list.length ? 'Find more tracks' : 'Find a track to save', `href="${base}community/tracks/"`));
  }
  async function loadSavedTracks() {
    state = await loadSaved(true);
    ratings = await loadRatings(true, state);
    list = [];
    loadFailed = false; svMsg.hidden = true;
    // Codex 21.10.: a load error is not an empty list.
    if (state.driverId && !state.available) loadFailed = true;
    if (state.driverId && state.available) {
      const { data, error } = await getSupabase().from('saved_tracks')
        .select('created_at, track:community_tracks(track_id,title,social_club_url,layout,race_types,vehicle_classes,players_min,players_max,length_km,created_at,updated_at,is_published,created_by)')
        .eq('driver_id', state.driverId).order('created_at', { ascending: false });
      if (error) loadFailed = true;
      list = ((data ?? []) as any[]).map((r) => r.track).filter((t) => t && t.is_published).map((t) => ({ ...t, length_km: Number(t.length_km) }));
    }
    if (loadFailed) { svMsg.textContent = 'Could not load your saved tracks. Please try again.'; svMsg.hidden = false; svMsg.classList.add('is-error'); }
    renderSaved();
  }
  svRoot.addEventListener('click', async (e) => {
    const rb = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-rate]');
    if (rb && state) {
      const r = await rateTrack(state, ratings, rb.dataset.track!, Number(rb.dataset.rate), true);
      svMsg.textContent = r.error ?? 'Your rating is saved.'; svMsg.hidden = false; svMsg.classList.toggle('is-error', Boolean(r.error));
      renderSaved(); return;
    }
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-save]');
    if (!b || !state) return;
    b.disabled = true;
    const r = await toggleSaved(state, b.dataset.save!, true);
    if (r.error) { b.disabled = false; svMsg.textContent = r.error; svMsg.hidden = false; svMsg.classList.add('is-error'); return; }
    list = list.filter((t) => state!.ids.has(t.track_id));
    svMsg.textContent = 'Removed from your saved tracks.'; svMsg.hidden = false; svMsg.classList.remove('is-error');
    renderSaved();
  });
  // 2. Your tracks: same rows; right-hand slot = status, Edit, Open Social Club
  const ownRoot = document.getElementById('own-root')!;
  const TRACK_COLS = 'track_id,title,social_club_url,layout,race_types,vehicle_classes,players_min,players_max,length_km,created_at,updated_at,is_published,created_by';
  async function loadOwn() {
    if (!state?.driverId) return;
    const { data } = await getSupabase().from('community_tracks').select(TRACK_COLS).eq('created_by', state.driverId).order('updated_at', { ascending: false });
    const own = ((data ?? []) as any[]).map((t) => ({ ...t, length_km: Number(t.length_km) }));
    ownRoot.innerHTML = own.map((t) => {
      const sc = /^https:\/\/socialclub\.rockstargames\.com\//.test(t.social_club_url ?? '') ? t.social_club_url : null;
      const side = `<div class="trs-side">${t.is_published ? '<span class="lr-status is-ok">Live</span>' : '<span class="lr-status" title="A moderator checks the details before publishing">In review</span>'}<button type="button" class="btn btn-s btn-md" data-edit="${esc(t.track_id)}">Edit</button>${sc ? `<a class="btn btn-s btn-md tr-sc" href="${esc(sc)}" target="_blank" rel="noopener">Open Social Club <span class="lr-ext-after" aria-hidden="true"></span></a>` : ''}</div>`;
      const pub = ratings.pub.get(t.track_id);
      return trackRowHtml(t, { side, rating: { avg: pub?.avg ?? null, count: pub?.count ?? 0, canRate: false, unavailable: !ratings.available } });
    }).join('') + slot('Submit a track', 'type="button" data-new', 'button');
  }
  function openEditor(id: string | null, title: string) {
    document.getElementById('own-editor')!.hidden = false;
    document.getElementById('own-editor-t')!.textContent = title;
    document.dispatchEvent(new CustomEvent('hc-open-track', { detail: { id } }));
    document.getElementById('own-editor')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  ownRoot.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const ed = t.closest<HTMLElement>('[data-edit]');
    if (ed) { openEditor(ed.dataset.edit!, `Edit: ${ed.closest('.tr-row')?.querySelector('.tr-title')?.textContent ?? 'track'}`); return; }
    if (t.closest('[data-new]')) openEditor(null, 'New track');
  });
  document.getElementById('own-editor-close')!.addEventListener('click', () => { document.getElementById('own-editor')!.hidden = true; });
  document.addEventListener('hc-tracks-changed', () => {
    loadOwn();
    if ((document.getElementById('track-form') as HTMLElement)?.hidden) document.getElementById('own-editor')!.hidden = true; // deleted
    else document.getElementById('own-editor-t')!.textContent = `Edit: ${(document.querySelector('#track-form [name="title"]') as HTMLInputElement)?.value || 'track'}`;
  });

  function init(session: any) {
    document.getElementById('acc-auth')!.hidden = Boolean(session);
    document.getElementById('acc-body')!.hidden = !session;
    if (session) loadSavedTracks().then(() => { if (isCreator) loadOwn(); });
  }
  if (backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
    document.getElementById('acc-signin')!.addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  }
</script>
