---
// My Account > Garage (RS-0032, DEC-0074; redesign DEC-0189): the start page of
// My Account. Switch between My cars (vehicles the driver owns) and Wishlist
// (RS-0087, cars he wants next). Both lists are private. Each list ends in a
// "+" slot that opens the vehicle picker; the band action opens it too.
// Owning a car takes it off the wishlist (database trigger). Garages (RS-0088)
// join the switch after launch. Copy marked as placeholder until Codex (DEC-0088).
import Base from '../../layouts/Base.astro';
import AccountHead from '../../components/AccountHead.astro';
import CarCard from '../../components/CarCard.astro';
import { vehicleOptions, fastestGellhornLapMs } from '../../data/vehicles';
import { isNewInGame } from '../../data/releases';
const base = import.meta.env.BASE_URL;
// Gellhorn rank per class, same as on the Cars page (CarsBrowser)
const rankInClass = new Map<string, number>();
for (const cls of new Set(vehicleOptions.flatMap((v) => v.classes))) {
  vehicleOptions.filter((v) => v.classes[0] === cls && fastestGellhornLapMs(v.id) != null)
    .sort((a, b) => fastestGellhornLapMs(a.id)! - fastestGellhornLapMs(b.id)!)
    .forEach((v, i) => rankInClass.set(v.id, i + 1));
}
const vehicleIndex = [...vehicleOptions]
  .sort((a, b) => `${a.make} ${a.model}`.localeCompare(`${b.make} ${b.model}`))
  .map((v) => ({ id: v.id, make: v.make, model: v.model, cls: v.classes[0] ?? 'Other', classes: v.classes.join(' / '), logo: v.logoSlug, photo: Boolean(v.photo) }));
---
<Base
  title="My Garage — My Account"
  description="The GTA VI cars you own and the ones on your wishlist."
  section="account"
  noindex
>
  <AccountHead active="garage" cta={{ label: 'Add a car you own', id: 'acc-cta' }} />
  <section class="wrap account-wrap">

    <div id="acc-auth" class="acc-auth lr-empty-panel" hidden>
      <p>Sign in with Discord to see your garage.</p>
      <button type="button" id="acc-signin" class="btn btn-discord">Sign in with Discord</button>
    </div>

    <div id="acc-body" hidden>
      <div class="mg-seg" role="tablist" aria-label="Garage">
        <button type="button" role="tab" id="mg-tab-cars" aria-controls="mg-v-cars" aria-selected="true" data-view="cars">My cars <span class="mg-n" id="mg-n-cars"></span></button>
        <button type="button" role="tab" id="mg-tab-wish" aria-controls="mg-v-wish" aria-selected="false" data-view="wishlist">Wishlist <span class="mg-n" id="mg-n-wish"></span></button>
      </div>

      <section id="mg-v-cars" role="tabpanel" aria-labelledby="mg-tab-cars">
        <div class="mg-head">
          <div>
            <h2 class="lr-h2 lr-h2-s">My cars</h2>
            <p class="mg-lede">Cars you own in GTA VI. Only you can see this list.</p>
          </div>
          <div class="mg-meter"><b id="mg-own-n">0</b> of {vehicleIndex.length} cars<span class="mg-bar"><i id="mg-own-bar"></i></span></div>
        </div>
        <p class="mg-msg lr-note" id="mg-msg-cars" role="status" hidden></p>
        <div class="mg-grid" id="mg-grid-cars"></div>
      </section>

      <section id="mg-v-wish" role="tabpanel" aria-labelledby="mg-tab-wish" hidden>
        <div class="mg-head">
          <div>
            <h2 class="lr-h2 lr-h2-s">Wishlist</h2>
            <p class="mg-lede">Cars you want next. Only you can see this list. Add them here or with the heart on any car page. When you buy one, mark it as owned and it moves to My cars.</p>
          </div>
        </div>
        <p class="mg-msg lr-note" id="mg-msg-wish" role="status" hidden></p>
        <div class="mg-grid" id="mg-grid-wish"></div>
      </section>
    </div>
  </section>

  <!-- The standard car card of the Cars page for every car (Fausto 27.10.: one card per object, only
       the buttons differ). The page clones the cards it needs into My cars / Wishlist. -->
  <template id="mg-cards">
    {vehicleOptions.map((v) => (
      <CarCard vehicle={v} variant="cars" isNew={isNewInGame(v.releaseId)}
        lap={rankInClass.has(v.id) ? { rank: rankInClass.get(v.id)!, ms: fastestGellhornLapMs(v.id)! } : null} />
    ))}
  </template>

  <dialog class="mg-picker" id="mg-picker" aria-labelledby="mg-picker-title">
    <div class="mg-picker-head">
      <h2 id="mg-picker-title">Add a car you own</h2>
      <button type="button" class="mg-picker-close" id="mg-picker-close" aria-label="Close">✕</button>
    </div>
    <label class="ui-search mg-picker-search">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="mg-picker-q" placeholder="Search make or model" aria-label="Search vehicles" autocomplete="off" />
    </label>
    <div class="mg-picker-list" id="mg-picker-list"></div>
  </dialog>
</Base>

<style>
  [hidden] { display: none !important; }
  .account-wrap { padding-top: var(--lr-gap-head); } /* DEC-0188; the footer brings the 64px gap below */
  .acc-auth { margin-bottom: 1.5rem; } /* box: .lr-empty-panel (DEC-0182) */
  /* switch My cars / Wishlist (DEC-0189) */
  .mg-seg { display: inline-flex; gap: 4px; padding: 4px; margin-bottom: 32px; border: 1px solid var(--lr-line); border-radius: 8px; background: var(--lr-card); }
  .mg-seg button { display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px; border: 0; border-radius: 5px; background: transparent; color: var(--lr-muted); font: 600 14px var(--gh-font-body); cursor: pointer; white-space: nowrap; }
  .mg-seg button:hover { color: var(--lr-text); }
  .mg-seg button[aria-selected="true"] { background: var(--lr-raised); color: var(--lr-text); }
  .mg-n { color: var(--lr-muted); font-variant-numeric: tabular-nums; }
  .mg-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; margin-bottom: 20px; }
  .mg-lede { margin: 8px 0 0; max-width: 640px; font-size: 15px; line-height: 1.5; color: var(--lr-soft); }
  .mg-meter { min-width: 220px; font-size: 14px; color: var(--lr-soft); }
  .mg-meter b { font-family: var(--gh-font-display); font-weight: 800; font-size: 20px; color: var(--lr-text); font-variant-numeric: tabular-nums; }
  .mg-bar { display: block; height: 4px; margin-top: 8px; border-radius: 2px; background: var(--lr-raised); overflow: hidden; }
  .mg-bar i { display: block; width: 0; height: 100%; border-radius: 2px; background: var(--lr-orange); }
  .mg-msg { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 0 0 16px; }
  .mg-msg[hidden] { display: none; }
  :global(.mg-undo) { padding: 0; border: 0; background: none; color: var(--lr-orange); font: 600 14px var(--gh-font-body); cursor: pointer; }
  :global(.mg-undo:hover) { color: var(--lr-pink); }
  /* same grid as the Cars page: 4 / 3 / 2 columns, list rows on phones (DEC-0117) */
  .mg-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 1100px) { .mg-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .mg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .mg-grid { grid-template-columns: minmax(0, 1fr); gap: 10px; } }
  @media (max-width: 560px) { .mg-seg { display: flex; } .mg-seg button { flex: 1; justify-content: center; } }
  :global(.mg-grid .vcard.is-new) { animation: mg-in .45s ease-out; border-color: var(--lr-orange); }
  @keyframes mg-in { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { :global(.mg-grid .vcard.is-new) { animation: none; } }
  /* wishlist: heart (pressed = on the list) next to the garage button, like the vehicle page */
  :global(.mg-acts) { display: flex; gap: 8px; flex: none; }
  :global(.mg-heart[aria-pressed="true"]) { border-color: var(--lr-pink) !important; color: var(--lr-pink) !important; background: transparent !important; }
  :global(.mg-heart svg) { fill: none; }
  :global(.mg-heart[aria-pressed="true"] svg) { fill: currentColor !important; }
  @media (max-width: 760px) {
    /* list rows: heart takes the top-right spot that holds Compare on the Cars page */
    :global(.mg-grid .vc-list .mg-heart) { position: absolute; top: 10px; right: 8px; width: 40px; height: 40px; }
  }
  :global(.mg-logo) { flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--lr-text); padding: 4px; display: inline-flex; box-sizing: border-box; }
  :global(.mg-logo img) { width: 100%; height: 100%; object-fit: contain; }

  /* "+" slot at the end of each list */
  :global(.mg-slot) { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; min-height: 240px; padding: 20px; border: 1px dashed var(--lr-line-strong); border-radius: 8px; background: transparent; color: var(--lr-soft); font: inherit; font-size: 14px; text-align: center; cursor: pointer; }
  :global(.mg-slot:hover), :global(.mg-slot:focus-visible) { border-color: var(--lr-orange); background: var(--lr-orange-tint); color: var(--lr-text); outline: none; }
  :global(.mg-slot-plus) { width: 44px; height: 44px; border-radius: 50%; border: 1px solid currentColor; display: grid; place-items: center; font-size: 22px; line-height: 1; }
  :global(.mg-slot strong) { color: var(--lr-text); font-weight: 600; font-size: 15px; }
  :global(.mg-slot-t) { display: flex; flex-direction: column; gap: 4px; }
  @media (max-width: 760px) { :global(.mg-slot) { min-height: 118px; flex-direction: row; gap: 14px; } }

  /* picker */
  .mg-picker { width: min(34rem, calc(100vw - 2rem)); max-height: min(40rem, calc(100vh - 3rem)); padding: 0; border: 1px solid var(--gh-line); border-radius: var(--gh-radius-lg, 12px); background: var(--gh-surface); color: var(--gh-text); }
  .mg-picker[open] { display: flex; flex-direction: column; }
  .mg-picker::backdrop { background: rgba(8,8,12,.7); }
  .mg-picker-head { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.1rem .6rem; }
  .mg-picker-head h2 { margin: 0; font-family: var(--gh-font-display); font-weight: 900; text-transform: uppercase; font-size: 1.1rem; }
  .mg-picker-close { width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid var(--gh-line); background: transparent; color: var(--gh-text); cursor: pointer; }
  .mg-picker-search { margin: 0 1.1rem .8rem; }
  .mg-picker-list { overflow-y: auto; padding: 0 .6rem .8rem; }
  :global(.mg-group) { margin: .7rem .5rem .3rem; color: var(--gh-muted); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; border-bottom: 1px solid var(--gh-line); padding-bottom: .3rem; }
  :global(.mg-opt) { display: flex; align-items: center; gap: .6rem; width: 100%; padding: .5rem .5rem; border: none; border-radius: var(--gh-radius); background: transparent; color: var(--gh-text); font: inherit; font-size: .9rem; text-align: left; cursor: pointer; }
  :global(.mg-opt:hover:not(:disabled)), :global(.mg-opt:focus-visible) { background: var(--gh-surface-soft, var(--lr-white-hover)); outline: none; }
  :global(.mg-opt .mg-logo) { width: 26px; height: 26px; }
  :global(.mg-opt .mg-make) { color: var(--gh-muted); font-size: .8rem; }
  :global(.mg-opt:disabled) { cursor: default; opacity: .55; }
  :global(.mg-opt .mg-have) { margin-left: auto; font-size: .68rem; font-weight: 800; text-transform: uppercase; color: var(--gh-yellow); }
  :global(.mg-none) { padding: 1rem .5rem; color: var(--lr-muted); font-size: 14px; }
  @media (max-width: 560px) {
    .mg-picker { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; border-radius: 0; border: none; }
  }
</style>

<script define:vars={{ vehicleIndex }}>
  window.__mgVehicles = vehicleIndex;
</script>

<script>
  import { backendConfigured, getSupabase } from '../../scripts/supabase-client';
  import { currentDriverId, fetchOwnedList, setOwned, fetchWishList, setWished } from '../../scripts/owned';
  import { esc } from '../../data/hub';

  type V = { id: string; make: string; model: string; cls: string; classes: string; logo: string; photo: boolean };
  type View = 'cars' | 'wishlist';
  const all = (window as any).__mgVehicles as V[];
  const byId = new Map(all.map((v) => [v.id, v]));
  const base = import.meta.env.BASE_URL;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const picker = $<HTMLDialogElement>('mg-picker');
  const pq = $<HTMLInputElement>('mg-picker-q');
  const plist = $('mg-picker-list');
  const cta = document.getElementById('acc-cta');
  let me: string | null = null;
  let owned: string[] = []; // in the order they were added
  let wish: string[] = [];
  let fresh: string | null = null;
  let view: View = 'cars';
  let pickFor: View = 'cars';

  const name = (id: string) => { const v = byId.get(id); return v ? `${v.make} ${v.model}` : 'The car'; };
  const logo = (v: V) => `<span class="mg-logo"><img src="${base}images/logos/${esc(v.logo)}-gta-6-logo.svg" alt="" width="22" height="22" loading="lazy" /></span>`;

  /** status line above a list; with undo it offers to take the last step back */
  function msg(list: View, text: string, error = false, undo?: () => Promise<void>) {
    (['cars', 'wishlist'] as View[]).forEach((l) => { const o = $(l === 'cars' ? 'mg-msg-cars' : 'mg-msg-wish'); if (l !== list) o.hidden = true; });
    const el = $(list === 'cars' ? 'mg-msg-cars' : 'mg-msg-wish');
    el.className = `mg-msg lr-note${error ? ' is-error' : ''}`;
    el.innerHTML = `<span>${esc(text)}</span>${undo ? '<button type="button" class="mg-undo">Undo</button>' : ''}`;
    el.hidden = !text;
    if (undo) el.querySelector<HTMLButtonElement>('.mg-undo')!.addEventListener('click', async (e) => {
      (e.currentTarget as HTMLButtonElement).disabled = true;
      try { await undo(); el.hidden = true; render(); } catch { msg(list, 'Could not undo — please try again.', true); }
    }, { once: true });
  }

  // Standard car card (CarCard, Cars page) cloned from <template id="mg-cards">; only the buttons differ
  // (Fausto 27.10.): no Compare "+"; the garage button keeps its Cars-page meaning (pressed = you own it,
  // click on My cars = remove; click on the wishlist = you own it now); wishlist cards add the heart.
  const tpl = document.getElementById('mg-cards') as HTMLTemplateElement;
  const HEART_PATH = '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>';
  function card(x: V, list: View): HTMLElement | null {
    const src = tpl.content.querySelector<HTMLElement>(`.vcard[data-id="${CSS.escape(x.id)}"]`);
    if (!src) return null;
    const el = src.cloneNode(true) as HTMLElement;
    el.querySelector('.vc-cmp')?.remove();
    if (x.id === fresh) el.classList.add('is-new');
    const gar = el.querySelector<HTMLButtonElement>('.vc-garage')!;
    const label = `${x.make} ${x.model}`;
    if (list === 'cars') {
      gar.setAttribute('aria-pressed', 'true');
      gar.dataset.remove = x.id; gar.dataset.list = 'cars';
      gar.title = 'In My Garage · click to remove';
      gar.setAttribute('aria-label', `Remove ${label} from My cars`);
    } else {
      gar.dataset.own = x.id;
      gar.title = 'I own it · moves the car to My cars';
      gar.setAttribute('aria-label', `I own the ${label}`);
      const heart = gar.cloneNode(false) as HTMLButtonElement; // same size/scoped style as the garage button
      delete heart.dataset.garage; delete heart.dataset.own; // keep data-astro-cid-*: it carries the card's scoped style
      heart.className = `${gar.className} mg-heart`;
      heart.setAttribute('aria-pressed', 'true');
      heart.dataset.remove = x.id; heart.dataset.list = 'wishlist';
      heart.title = 'On your wishlist · click to remove';
      heart.setAttribute('aria-label', `Remove ${label} from your wishlist`);
      // keep the scoped style of the card's own icon: clone its <svg> and swap the drawing for a heart
      const svg = gar.querySelector('svg')!.cloneNode(false) as SVGElement;
      svg.removeAttribute('class');
      svg.innerHTML = HEART_PATH;
      heart.replaceChildren(svg);
      const acts = document.createElement('span');
      acts.className = 'mg-acts';
      gar.replaceWith(acts);
      acts.append(heart, gar);
    }
    return el;
  }
  const slot = (list: View, title: string, sub: string) => `<button type="button" class="mg-slot" data-add="${list}" aria-haspopup="dialog">
      <span class="mg-slot-plus" aria-hidden="true">+</span><span class="mg-slot-t"><strong>${title}</strong><span>${sub}</span></span></button>`;

  function render() {
    const cars = owned.map((id) => byId.get(id)).filter(Boolean) as V[];
    const wl = wish.map((id) => byId.get(id)).filter(Boolean) as V[];
    const fill = (grid: HTMLElement, xs: V[], list: View, slotHtml: string) => {
      grid.replaceChildren(...(xs.map((x) => card(x, list)).filter(Boolean) as HTMLElement[]));
      grid.insertAdjacentHTML('beforeend', slotHtml);
    };
    fill($('mg-grid-cars'), cars, 'cars', slot('cars', cars.length ? 'Add another car' : 'Add your first car', 'Pick a car you own'));
    // both lists work the same (Fausto 27.10.): cards, then the "+" slot that opens the picker
    fill($('mg-grid-wish'), wl, 'wishlist', slot('wishlist', wl.length ? 'Add another car' : 'Add your first car', 'Pick a car you want'));
    $('mg-n-cars').textContent = String(cars.length);
    $('mg-n-wish').textContent = String(wl.length);
    $('mg-own-n').textContent = String(cars.length);
    $('mg-own-bar').style.width = `${Math.min(100, (cars.length / all.length) * 100)}%`;
    fresh = null;
  }

  function show(v: View, updateHash = true) {
    view = v;
    $('mg-v-cars').hidden = v !== 'cars';
    $('mg-v-wish').hidden = v !== 'wishlist';
    $('mg-tab-cars').setAttribute('aria-selected', String(v === 'cars'));
    $('mg-tab-wish').setAttribute('aria-selected', String(v === 'wishlist'));
    if (cta) cta.textContent = v === 'cars' ? 'Add a car you own' : 'Add to wishlist';
    if (updateHash) history.replaceState(null, '', v === 'wishlist' ? '#wishlist' : location.pathname + location.search);
  }
  const viewFromHash = (): View => (location.hash === '#wishlist' ? 'wishlist' : 'cars');

  function renderPicker() {
    const q = pq.value.trim().toLowerCase();
    const have = new Set(owned), want = new Set(wish);
    const list = all.filter((v) => !q || `${v.make} ${v.model} ${v.classes}`.toLowerCase().includes(q));
    const groups = new Map<string, V[]>();
    list.forEach((v) => groups.set(v.cls, [...(groups.get(v.cls) ?? []), v]));
    // owned cars can't be added again; for the wishlist, cars already on it are off too
    const off = (id: string) => have.has(id) || (pickFor === 'wishlist' && want.has(id));
    const tag = (id: string) => have.has(id) ? 'Owned' : want.has(id) ? 'On wishlist' : '';
    plist.innerHTML = list.length
      ? [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0])).map(([cls, vs]) =>
          `<p class="mg-group">${esc(cls)}</p>` + vs.map((v) =>
            `<button type="button" class="mg-opt" data-pick="${esc(v.id)}"${off(v.id) ? ' disabled' : ''}>${logo(v)}<span><span class="mg-make">${esc(v.make)}</span> ${esc(v.model)}</span>${tag(v.id) ? `<span class="mg-have">${tag(v.id)}</span>` : ''}</button>`).join('')).join('')
      : '<p class="mg-none">No car matches your search.</p>';
  }

  function openPicker(list: View) {
    pickFor = list;
    $('mg-picker-title').textContent = list === 'cars' ? 'Add a car you own' : 'Add to your wishlist';
    pq.value = '';
    renderPicker();
    picker.showModal();
    plist.scrollTop = 0;
    // no auto-focus on phones: the keyboard would cover the list
    if (window.matchMedia('(pointer: fine)').matches) pq.focus();
  }

  async function own(id: string) {
    await setOwned(me!, id, true); // the database also takes it off the wishlist
    owned = [...owned.filter((x) => x !== id), id];
    wish = wish.filter((x) => x !== id);
  }

  document.querySelector('.mg-seg')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-view]');
    if (b) show(b.dataset.view as View);
  });
  window.addEventListener('hashchange', () => show(viewFromHash(), false));

  $('acc-body').addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const add = t.closest<HTMLElement>('[data-add]');
    if (add) { openPicker(add.dataset.add as View); return; }
    if (!me) return;
    const ownBtn = t.closest<HTMLButtonElement>('[data-own]');
    if (ownBtn) {
      const id = ownBtn.dataset.own!;
      ownBtn.disabled = true;
      try { await own(id); fresh = id; render(); msg('wishlist', `${name(id)} moved to My cars.`); }
      catch { ownBtn.disabled = false; msg('wishlist', 'Could not save — please try again.', true); }
      return;
    }
    const rm = t.closest<HTMLButtonElement>('[data-remove]');
    if (!rm) return;
    const id = rm.dataset.remove!;
    const list = rm.dataset.list as View;
    rm.disabled = true;
    try {
      if (list === 'cars') {
        const i = owned.indexOf(id);
        await setOwned(me, id, false);
        owned = owned.filter((x) => x !== id);
        render();
        msg('cars', `${name(id)} removed.`, false, async () => { await setOwned(me!, id, true); owned.splice(i, 0, id); });
      } else {
        const i = wish.indexOf(id);
        await setWished(me, id, false);
        wish = wish.filter((x) => x !== id);
        render();
        msg('wishlist', `${name(id)} removed from your wishlist.`, false, async () => { await setWished(me!, id, true); wish.splice(i, 0, id); });
      }
    } catch {
      rm.disabled = false;
      msg(list, 'Could not remove the car — please try again.', true);
    }
  });

  plist.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pick]');
    if (!b || b.disabled || !me) return;
    const id = b.dataset.pick!;
    b.disabled = true;
    try {
      if (pickFor === 'cars') {
        const wasWished = wish.includes(id);
        await own(id);
        msg('cars', `${name(id)} added to My cars${wasWished ? ' and taken off your wishlist' : ''}.`);
      } else {
        await setWished(me, id, true);
        wish = [...wish.filter((x) => x !== id), id];
        msg('wishlist', `${name(id)} added to your wishlist.`);
      }
      fresh = id;
      picker.close();
      render();
      document.querySelector('.mg-grid .vcard.is-new')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    } catch {
      b.disabled = false;
      picker.close();
      msg(pickFor, 'Could not add the car — please try again.', true);
    }
  });
  pq.addEventListener('input', renderPicker);
  // Escape in a search field would only clear the text -- close the picker right away.
  pq.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); picker.close(); } });
  $('mg-picker-close').addEventListener('click', () => picker.close());
  picker.addEventListener('click', (e) => { if (e.target === picker) picker.close(); }); // click on backdrop
  // band action (DEC-0188/0189): picker for the list on screen; signed out it starts the Discord sign-in
  cta?.addEventListener('click', () => { if (me) openPicker(view); else if (backendConfigured) $('acc-signin').click(); });

  async function init(session: any) {
    $('acc-auth').hidden = Boolean(session);
    $('acc-body').hidden = !session;
    show(viewFromHash(), false);
    if (!session) return;
    me = await currentDriverId();
    if (!me) { msg('cars', 'Your driver profile is not ready yet — reload the page in a moment.', true); return; }
    [owned, wish] = await Promise.all([fetchOwnedList(), fetchWishList()]);
    render();
  }

  if (backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
    $('acc-signin').addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  }
</script>
