---
// My Account > Settings (RS-0032, RS-0037): display name, optional PSN name (DEC-0112), sign-out and
// "Delete my account" (DEC-0079). There is no "hide my name" option any
// more: changing the display name is the way to stay unrecognised; deleting
// the account removes all personal data, reviewed times stay as "Deleted driver".
import Base from '../../../layouts/Base.astro';
import AccountHead from '../../../components/AccountHead.astro';
import UnitsSwitch from '../../../components/UnitsSwitch.astro';
---
<Base
  title="Settings — My Account"
  description="Your account settings: display name, sign-out and account deletion."
  section="account"
  noindex
>
  <AccountHead active="settings" />
  <section class="wrap account-wrap">

    <div id="acc-auth" class="acc-auth lr-empty-panel" hidden>
      <p>Sign in with Discord to change your settings.</p>
      <button type="button" id="acc-signin" class="btn btn-discord">Sign in with Discord</button>
    </div>

    <div id="acc-body" class="set-secs" hidden>
      <!-- DEC-0194: two sections like the other tabs; texts unchanged except the two headings (Claude placeholders) -->
      <section>
        <h2 class="lr-h2 lr-h2-s set-h">Profile</h2>
        <div class="set-card">
          <div class="set-fields">
            <label class="set-field">
              <span class="set-label">Display name</span>
              <input id="display-name-input" type="text" maxlength="40" />
              <small class="set-hint">Shown on leaderboards, crews and events. Don't want to be recognised? Just pick a different name.</small>
            </label>
            <label class="set-field">
              <span class="set-label">PSN name <span class="set-opt">optional</span></span>
              <input id="psn-name-input" type="text" maxlength="16" placeholder="e.g. Racer_01" autocomplete="off" spellcheck="false" />
              <small class="set-hint">Only used so others can add you on PlayStation: it is filled in for you when you create an event. Leave it empty to keep it to yourself.</small>
            </label>
          </div>
          <div class="set-acts"><button type="button" id="save-name-btn" class="btn btn-p">Save</button></div>
          <p id="settings-msg" class="lr-note set-msg" role="status" hidden></p>
        </div>
      </section>

      <!-- DEC-0197: units for the whole site; same switch as in the footer. Texts: Claude placeholders for Codex -->
      <section>
        <h2 class="lr-h2 lr-h2-s set-h">Units</h2>
        <div class="set-card set-row">
          <div class="set-field">
            <span class="set-label">Speed and distance</span>
            <small class="set-hint">Chosen from your device's time zone until you change it here or in the footer. Saved in this browser.</small>
          </div>
          <UnitsSwitch label="Speed and distance" />
        </div>
      </section>

      <section>
        <h2 class="lr-h2 lr-h2-s set-h">Account</h2>
        <div class="set-card set-row">
          <p>Signed in as <strong id="auth-user-label"></strong>.</p>
          <button type="button" id="discord-signout-btn" class="btn btn-s btn-md">Sign out</button>
        </div>
        <details class="panel danger" id="danger">
        <summary>Delete my account</summary>
        <div class="danger-body">
          <p class="danger-alt"><strong>Just want to stay unrecognised?</strong> You don't need to delete anything — <a href="#display-name-input" id="to-name">change your display name</a> and your times show under the new name.</p>
          <p class="danger-alt"><strong>Just taking a break?</strong> You can also remove Leonida Racing from the authorized apps in your Discord settings. Your account stays exactly as it is, and you can pick up where you left off whenever you sign in again.</p>
          <p>Deleting your account is permanent:</p>
          <ul>
            <li><strong>Your data is deleted:</strong> your display name and login, your garage, crew membership and roles, events you host, event sign-ups, reports you sent, submissions still in review, screenshots and video links. Nothing stays linked to you.</li>
            <li><strong>No way back:</strong> signing in with Discord again creates a new, empty account. Nothing from your old account can be restored.</li>
          </ul>
          <label class="danger-confirm"><span>Type <code>DELETE</code> to confirm</span>
            <input type="text" id="del-confirm" autocomplete="off" spellcheck="false" />
          </label>
          <button type="button" class="btn btn-danger" id="del-btn" disabled>Delete my account</button>
          <p class="lr-note set-msg" id="del-msg" role="status" hidden></p>
        </div>
        </details>
      </section>
    </div>

    <div class="panel deleted-box" id="deleted-box" hidden>
      <p><strong>Your account has been deleted.</strong> Your personal data is gone; reviewed lap times stay on the leaderboard as “Deleted driver”.</p>
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .account-wrap { padding-top: var(--lr-gap-head); } /* DEC-0188; the footer brings the 64px gap below */
  .acc-auth { margin-bottom: 1.5rem; } /* box: .lr-empty-panel (DEC-0182) */
  /* DEC-0194: sections 64px apart, H2 24px, one card per section, labels 14/600, hints 13 soft */
  .set-secs:not([hidden]) { display: flex; flex-direction: column; gap: var(--lr-gap-sec); }
  .set-h { margin: 0 0 20px; }
  .set-card { padding: 24px; background: var(--lr-card); border: 1px solid var(--lr-line); border-radius: 8px; }
  .set-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px; }
  .set-field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .set-label { font-size: 14px; font-weight: 600; color: var(--lr-text); }
  .set-opt { margin-left: 6px; font-weight: 400; color: var(--lr-muted); }
  .set-hint { font-size: 13px; line-height: 1.45; color: var(--lr-soft); }
  .set-field input, .danger input { height: var(--lr-field-h); box-sizing: border-box; padding: 0 14px; border-radius: 6px; border: 1px solid var(--lr-line-strong); background: var(--lr-bg); color: var(--lr-text); font-size: 14px; font-family: var(--gh-font-body); }
  .set-field input:focus, .danger input:focus { outline: none; border-color: var(--lr-field-focus); }
  .set-acts { margin-top: 20px; }
  .set-msg { margin: 16px 0 0; }
  .set-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .set-row p { margin: 0; font-size: 15px; color: var(--lr-soft); }
  .set-row strong { color: var(--lr-text); font-weight: 600; }
  /* delete: collapsed by default, neutral; the button turns coral once DELETE is typed (armed, DEC-0175) */
  .danger { margin-top: 16px; padding: 0; background: var(--lr-card); border: 1px solid var(--lr-line); border-radius: 8px; }
  .danger summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; padding: 0 24px; cursor: pointer; list-style: none; font-size: 15px; font-weight: 600; color: var(--lr-text); }
  .danger summary::-webkit-details-marker { display: none; }
  .danger summary::after { content: ""; width: 8px; height: 8px; margin-right: 4px; border-right: 2px solid var(--lr-muted); border-bottom: 2px solid var(--lr-muted); transform: rotate(45deg); transition: transform .15s; }
  .danger[open] summary::after { transform: rotate(-135deg); }
  .danger summary:focus-visible { outline: 2px solid var(--lr-orange); outline-offset: -2px; border-radius: 8px; }
  .danger-body { padding: 0 24px 24px; max-width: 760px; font-size: 15px; line-height: 1.5; color: var(--lr-soft); }
  .danger-body p { margin: 0 0 12px; }
  .danger-body ul { margin: 0 0 20px; padding-left: 20px; display: grid; gap: 6px; }
  .danger-body strong { color: var(--lr-text); font-weight: 600; }
  .danger-alt { padding: 12px 14px; border-radius: 8px; border: 1px solid var(--lr-line); background: var(--lr-white-hover); font-size: 14px; } /* note box (DEC-0186), neutral: it is an alternative, not a warning */
  .danger-alt a { color: var(--lr-text); }
  .danger-confirm { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; max-width: 18rem; font-size: 14px; font-weight: 600; color: var(--lr-text); }
  .danger-confirm code { color: var(--lr-coral); }
  #del-btn:not(:disabled) { background: var(--lr-coral-fill); border-color: var(--lr-coral); color: var(--lr-coral); }
  .deleted-box { padding: 1rem 1.2rem; }
  .deleted-box p { margin: 0; font-size: .9rem; }
  @media (max-width: 760px) {
    .set-fields { grid-template-columns: 1fr; }
    .set-card { padding: 20px; }
    .set-acts .btn { width: 100%; }
    .danger summary { padding: 0 20px; }
    .danger-body { padding: 0 20px 20px; }
  }
</style>

<script>
  import { backendConfigured, getSupabase, SUPABASE_URL } from '../../../scripts/supabase-client';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const nameEl = $<HTMLInputElement>('display-name-input');
  const psnEl = $<HTMLInputElement>('psn-name-input');
  // Same rule as the DB check (drivers.psn_name, hub_events.host_name).
  const PSN_RE = /^[A-Za-z][A-Za-z0-9_-]{2,15}$/;
  const msgEl = $('settings-msg');
  const confirmEl = $<HTMLInputElement>('del-confirm');
  const delBtn = $<HTMLButtonElement>('del-btn');
  const delMsg = $('del-msg');
  const DELETE_URL = SUPABASE_URL ? `${SUPABASE_URL}/functions/v1/delete-account` : '';
  let session: any = null;
  let deleting = false;

  function msg(el: HTMLElement, text: string, ok: boolean) {
    el.hidden = false;
    el.className = `lr-note set-msg${ok ? '' : ' is-error'}`; // notice box (DEC-0186)
    el.textContent = text;
  }

  async function init(s: any) {
    if (deleting) return;
    session = s;
    $('acc-auth').hidden = Boolean(s);
    $('acc-body').hidden = !s;
    if (!s) return;
    $('auth-user-label').textContent = s.user.user_metadata?.full_name ?? s.user.user_metadata?.name ?? s.user.email ?? s.user.id;
    const { data } = await getSupabase().from('drivers').select('display_name, psn_name').eq('auth_user_id', s.user.id).maybeSingle();
    if (data) { nameEl.value = data.display_name ?? ''; psnEl.value = data.psn_name ?? ''; }
  }

  confirmEl.addEventListener('input', () => { delBtn.disabled = confirmEl.value.trim() !== 'DELETE'; });
  $('to-name').addEventListener('click', (e) => { e.preventDefault(); ($('danger') as HTMLDetailsElement).open = false; nameEl.focus(); nameEl.select(); });

  if (backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
    $('acc-signin').addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
    $('discord-signout-btn').addEventListener('click', () => { try { localStorage.removeItem('lr-dash-cache'); } catch { /* ignore */ } sb.auth.signOut(); });
    $('save-name-btn').addEventListener('click', async () => {
      if (!session) return;
      const name = nameEl.value.trim();
      if (!name) return msg(msgEl, 'Display name cannot be empty.', false);
      const psn = psnEl.value.trim();
      if (psn && !PSN_RE.test(psn)) return msg(msgEl, 'PSN name: 3–16 characters, starts with a letter; letters, digits, - and _ only.', false);
      const { error } = await sb.from('drivers').update({ display_name: name, psn_name: psn || null }).eq('auth_user_id', session.user.id);
      msg(msgEl, error ? 'Could not save — please try again.' : 'Saved.', !error);
    });

    delBtn.addEventListener('click', async () => {
      if (!session || confirmEl.value.trim() !== 'DELETE' || !DELETE_URL) return;
      delBtn.disabled = true;
      delBtn.textContent = 'Deleting…';
      try {
        const { data: fresh } = await sb.auth.getSession();
        const token = fresh?.session?.access_token ?? session.access_token;
        const res = await fetch(DELETE_URL, {
          method: 'POST',
          headers: { 'content-type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ confirm: 'DELETE' }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body?.error || `HTTP ${res.status}`);
        deleting = true;
        try { localStorage.removeItem('lr-dash-cache'); } catch { /* ignore */ }
        await sb.auth.signOut().catch(() => {});
        $('acc-body').hidden = true;
        $('acc-auth').hidden = true;
        $('deleted-box').hidden = false;
      } catch (err) {
        delBtn.disabled = false;
        delBtn.textContent = 'Delete my account';
        msg(delMsg, `Could not delete the account: ${(err as Error).message}`, false);
      }
    });
  }
</script>
