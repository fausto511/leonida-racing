---
// My Account > Garage (RS-0032, DEC-0074): every vehicle the driver owns.
// Slot layout (Fausto, 2026-09-26): owned vehicles as garage tiles, followed
// by one empty "+" slot. The slot opens a vehicle picker (search + list by
// class); the picked car fills the slot and a new empty slot appears after it.
// Vehicles can also be marked with "I own this vehicle" on their Garage page.
// Private: only the driver sees this list.
import Base from '../../../layouts/Base.astro';
import AccountSubnav from '../../../components/AccountSubnav.astro';
import { vehicleOptions } from '../../../data/vehicles';
const base = import.meta.env.BASE_URL;
const vehicleIndex = [...vehicleOptions]
  .sort((a, b) => `${a.make} ${a.model}`.localeCompare(`${b.make} ${b.model}`))
  .map((v) => ({ id: v.id, make: v.make, model: v.model, cls: v.classes[0] ?? 'Other', classes: v.classes.join(' / '), logo: v.logoSlug, photo: Boolean(v.photo) }));
---
<Base
  title="My Garage — My Account"
  description="The GTA VI vehicles you own."
  section="account"
  noindex
>
  <section class="wrap account-wrap">
    <p class="eyebrow">Private Driver Area</p>
    <h1 class="display account-title">My Account</h1>
    <AccountSubnav active="garage" />

    <div id="acc-auth" class="panel acc-auth" hidden>
      <p>Sign in with Discord to see your garage.</p>
      <button type="button" id="acc-signin" class="btn btn-outline">Sign in with Discord</button>
    </div>

    <div id="acc-body" hidden>
      <h2 class="section-heading">My Garage <span class="mg-count" id="mg-count"></span></h2>
      <p class="section-lede">Vehicles you own in GTA VI. Only you can see this list. Add vehicles below, or switch on “I own this vehicle” from any vehicle page in <a href={`${base}cars/`}>The Garage</a>.</p>
      <p class="mg-msg" id="mg-msg" role="status" hidden></p>
      <div class="mg-grid" id="mg-grid"></div>
    </div>
  </section>

  <dialog class="mg-picker" id="mg-picker" aria-labelledby="mg-picker-title">
    <div class="mg-picker-head">
      <h2 id="mg-picker-title">Add a vehicle you own</h2>
      <button type="button" class="mg-picker-close" id="mg-picker-close" aria-label="Close">✕</button>
    </div>
    <label class="ui-search mg-picker-search">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="search" id="mg-picker-q" placeholder="Search make or model" aria-label="Search vehicles" autocomplete="off" />
    </label>
    <div class="mg-picker-list" id="mg-picker-list"></div>
  </dialog>
</Base>

<style>
  [hidden] { display: none !important; }
  .account-wrap { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .account-title { margin: .4rem 0 1.2rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .acc-auth { margin-bottom: 1.5rem; padding: 1rem 1.2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .acc-auth p { margin: 0; font-size: .88rem; }
  .section-heading { margin: 0 0 .3rem; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.3rem; }
  .mg-count { color: var(--gh-muted); font-size: .95rem; }
  .section-lede { margin: 0 0 1.4rem; color: var(--gh-muted); font-size: .88rem; max-width: 42rem; }
  .section-lede a { color: var(--gh-text); }
  .mg-msg { margin: -.6rem 0 1rem; font-size: .82rem; color: var(--gh-muted); }
  .mg-msg.is-error { color: var(--gh-red); }
  .mg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr)); gap: var(--gh-gap-card, 1rem); }

  /* owned vehicle tile -- same language as The Garage tiles */
  :global(.mg-tile) { position: relative; border: 1px solid var(--gh-line); border-radius: var(--gh-radius-lg, 12px); overflow: hidden; background: var(--gh-surface); display: flex; flex-direction: column; }
  :global(.mg-tile.is-new) { animation: mg-in .45s ease-out; border-color: var(--gh-yellow); }
  @keyframes mg-in { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: none; } }
  :global(.mg-photo) { position: relative; aspect-ratio: 16 / 9; background: #0e0e13; }
  :global(.mg-photo img.mg-bg) { width: 100%; height: 100%; object-fit: cover; opacity: .55; display: block; }
  :global(.mg-photo img.mg-real) { opacity: 1; }
  :global(.mg-name) { position: absolute; inset: auto 0 0 0; padding: .6rem .75rem; background: linear-gradient(to top, rgba(20,20,26,.95), transparent); display: flex; align-items: center; gap: .55rem; }
  :global(.mg-logo) { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--gh-text); padding: 4px; display: inline-flex; }
  :global(.mg-logo img) { width: 100%; height: 100%; object-fit: contain; }
  :global(.mg-name a) { color: var(--gh-text); font-weight: 800; text-decoration: none; line-height: 1.15; }
  :global(.mg-name a:hover) { text-decoration: underline; text-underline-offset: 3px; }
  :global(.mg-name small) { display: block; color: var(--gh-muted); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; }
  :global(.mg-remove) { position: absolute; top: .55rem; right: .55rem; width: 1.9rem; height: 1.9rem; border-radius: 50%; border: 1px solid rgba(252,250,247,.35); background: rgba(20,20,26,.7); color: var(--gh-text); font-size: .8rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  :global(.mg-remove:hover) { border-color: var(--gh-red); color: var(--gh-red); }
  :global(.mg-foot) { display: flex; justify-content: space-between; align-items: center; gap: .5rem; padding: .6rem .75rem; font-size: .76rem; }
  :global(.mg-foot a) { color: var(--gh-muted); font-weight: 700; text-decoration: none; }
  :global(.mg-foot a:hover) { color: var(--gh-text); }

  /* empty "+" slot */
  :global(.mg-slot) { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .55rem; min-height: 12.5rem; padding: 1.2rem; border: 2px dashed var(--gh-line); border-radius: var(--gh-radius-lg, 12px); background: transparent; color: var(--gh-muted); font: inherit; cursor: pointer; transition: border-color .15s, color .15s, background .15s; }
  :global(.mg-slot:hover), :global(.mg-slot:focus-visible) { border-color: var(--gh-yellow); color: var(--gh-text); background: rgba(255,215,76,.04); outline: none; }
  :global(.mg-slot-plus) { width: 3rem; height: 3rem; border-radius: 50%; border: 2px solid currentColor; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; line-height: 1; }
  :global(.mg-slot strong) { font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1rem; color: var(--gh-text); }
  :global(.mg-slot span.mg-slot-sub) { font-size: .78rem; }

  /* picker */
  .mg-picker { width: min(34rem, calc(100vw - 2rem)); max-height: min(40rem, calc(100vh - 3rem)); padding: 0; border: 1px solid var(--gh-line); border-radius: var(--gh-radius-lg, 12px); background: var(--gh-surface); color: var(--gh-text); }
  .mg-picker[open] { display: flex; flex-direction: column; }
  .mg-picker::backdrop { background: rgba(8,8,12,.7); }
  .mg-picker-head { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.1rem .6rem; }
  .mg-picker-head h2 { margin: 0; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.1rem; }
  .mg-picker-close { width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid var(--gh-line); background: transparent; color: var(--gh-text); cursor: pointer; }
  .mg-picker-search { margin: 0 1.1rem .8rem; }
  .mg-picker-list { overflow-y: auto; padding: 0 .6rem .8rem; }
  :global(.mg-group) { margin: .7rem .5rem .3rem; color: var(--gh-muted); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; border-bottom: 1px solid var(--gh-line); padding-bottom: .3rem; }
  :global(.mg-opt) { display: flex; align-items: center; gap: .6rem; width: 100%; padding: .5rem .5rem; border: none; border-radius: var(--gh-radius); background: transparent; color: var(--gh-text); font: inherit; font-size: .9rem; text-align: left; cursor: pointer; }
  :global(.mg-opt:hover:not(:disabled)), :global(.mg-opt:focus-visible) { background: var(--gh-surface-soft, rgba(255,255,255,.06)); outline: none; }
  :global(.mg-opt .mg-logo) { width: 26px; height: 26px; }
  :global(.mg-opt .mg-make) { color: var(--gh-muted); font-size: .8rem; }
  :global(.mg-opt:disabled) { cursor: default; opacity: .55; }
  :global(.mg-opt .mg-have) { margin-left: auto; font-size: .68rem; font-weight: 800; text-transform: uppercase; color: var(--gh-yellow); }
  :global(.mg-none) { padding: 1rem .5rem; color: var(--gh-muted); font-size: .88rem; }
  @media (max-width: 560px) {
    .mg-picker { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; border-radius: 0; border: none; }
  }
</style>

<script define:vars={{ vehicleIndex }}>
  window.__mgVehicles = vehicleIndex;
</script>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  import { currentDriverId, fetchOwnedList, setOwned } from '../../../scripts/owned';
  import { esc } from '../../../data/hub';

  type V = { id: string; make: string; model: string; cls: string; classes: string; logo: string; photo: boolean };
  const all = (window as any).__mgVehicles as V[];
  const byId = new Map(all.map((v) => [v.id, v]));
  const base = import.meta.env.BASE_URL;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const grid = $('mg-grid');
  const picker = $<HTMLDialogElement>('mg-picker');
  const pq = $<HTMLInputElement>('mg-picker-q');
  const plist = $('mg-picker-list');
  let me: string | null = null;
  let owned: string[] = []; // in the order they were added
  let fresh: string | null = null;

  const logo = (v: V) => `<span class="mg-logo"><img src="${base}images/logos/${esc(v.logo)}-gta-6-logo.webp" alt="" width="22" height="22" loading="lazy" /></span>`;

  function msg(text: string, error = false) {
    const el = $('mg-msg');
    el.textContent = text; el.hidden = !text; el.className = `mg-msg${error ? ' is-error' : ''}`;
  }

  function render() {
    $('mg-count').textContent = owned.length ? `· ${owned.length} vehicle${owned.length === 1 ? '' : 's'}` : '';
    const tiles = owned.map((id) => byId.get(id)).filter(Boolean).map((v) => {
      const x = v as V;
      return `<article class="mg-tile${x.id === fresh ? ' is-new' : ''}">
        <div class="mg-photo">
          ${x.photo
            ? `<img class="mg-bg mg-real" src="${base}images/vehicles/${esc(x.id)}-640.webp" alt="" loading="lazy" width="640" height="360" />`
            : `<img class="mg-bg" src="${base}images/garage/garage-hero-placeholder.webp" alt="" loading="lazy" width="640" height="360" />`}
          <button type="button" class="mg-remove" data-remove="${esc(x.id)}" title="Remove from my garage" aria-label="Remove ${esc(x.make)} ${esc(x.model)} from my garage">✕</button>
          <div class="mg-name">${logo(x)}<span><a href="${base}cars/vehicles/${esc(x.id)}/">${esc(x.make)} ${esc(x.model)}</a><small>${esc(x.classes)}</small></span></div>
        </div>
        <div class="mg-foot"><a rel="nofollow" href="${base}time-attack/gellhorn-international-raceway/?vehicle=${encodeURIComponent(x.id)}">Gellhorn leaderboard →</a></div>
      </article>`;
    });
    const slot = `<button type="button" class="mg-slot" id="mg-slot" aria-haspopup="dialog">
        <span class="mg-slot-plus" aria-hidden="true">+</span>
        <strong>${owned.length ? 'Add another vehicle' : 'Add your first vehicle'}</strong>
        <span class="mg-slot-sub">Pick a car you own</span>
      </button>`;
    grid.innerHTML = tiles.join('') + slot;
    fresh = null;
  }

  function renderPicker() {
    const q = pq.value.trim().toLowerCase();
    const have = new Set(owned);
    const list = all.filter((v) => !q || `${v.make} ${v.model} ${v.classes}`.toLowerCase().includes(q));
    const groups = new Map<string, V[]>();
    list.forEach((v) => groups.set(v.cls, [...(groups.get(v.cls) ?? []), v]));
    plist.innerHTML = list.length
      ? [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0])).map(([cls, vs]) =>
          `<p class="mg-group">${esc(cls)}</p>` + vs.map((v) =>
            `<button type="button" class="mg-opt" data-pick="${esc(v.id)}"${have.has(v.id) ? ' disabled' : ''}>${logo(v)}<span><span class="mg-make">${esc(v.make)}</span> ${esc(v.model)}</span>${have.has(v.id) ? '<span class="mg-have">In garage</span>' : ''}</button>`).join('')).join('')
      : '<p class="mg-none">No vehicle matches your search.</p>';
  }

  function openPicker() {
    pq.value = '';
    renderPicker();
    picker.showModal();
    plist.scrollTop = 0;
    // no auto-focus on phones: the keyboard would cover the list
    if (window.matchMedia('(pointer: fine)').matches) pq.focus();
  }

  grid.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('#mg-slot')) { openPicker(); return; }
    const b = t.closest<HTMLButtonElement>('[data-remove]');
    if (!b || !me) return;
    const id = b.dataset.remove!;
    b.disabled = true;
    try { await setOwned(me, id, false); owned = owned.filter((x) => x !== id); msg(`${byId.get(id)?.make} ${byId.get(id)?.model} removed.`); }
    catch { b.disabled = false; msg('Could not remove the vehicle — please try again.', true); return; }
    render();
  });

  plist.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pick]');
    if (!b || b.disabled || !me) return;
    const id = b.dataset.pick!;
    b.disabled = true;
    try {
      await setOwned(me, id, true);
      owned = [...owned.filter((x) => x !== id), id];
      fresh = id;
      picker.close();
      msg(`${byId.get(id)?.make} ${byId.get(id)?.model} added to your garage.`);
      render();
      document.querySelector('.mg-tile.is-new')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    } catch {
      b.disabled = false;
      picker.close();
      msg('Could not add the vehicle — please try again.', true);
    }
  });
  pq.addEventListener('input', renderPicker);
  // Escape in a search field would only clear the text -- close the picker right away.
  pq.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); picker.close(); } });
  $('mg-picker-close').addEventListener('click', () => picker.close());
  picker.addEventListener('click', (e) => { if (e.target === picker) picker.close(); }); // click on backdrop

  async function init(session: any) {
    $('acc-auth').hidden = Boolean(session);
    $('acc-body').hidden = !session;
    if (!session) return;
    me = await currentDriverId();
    if (!me) { msg('Your driver profile is not ready yet — reload the page in a moment.', true); return; }
    owned = await fetchOwnedList();
    render();
  }

  if (backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
    $('acc-signin').addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  }
</script>
