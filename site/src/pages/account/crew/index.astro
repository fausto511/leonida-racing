---
// My Account > Crew (RS-0026): own membership (join / pending / leave),
// crews I lead (same editor as the moderator panel, personal mode) and the
// Crew Leader / Event Host application.
import Base from '../../../layouts/Base.astro';
import AccountSubnav from '../../../components/AccountSubnav.astro';
import HubEditor from '../../../components/HubEditor.astro';
import RoleApply from '../../../components/RoleApply.astro';
import '../../../styles/hub.css';
const base = import.meta.env.BASE_URL;
---
<Base
  title="My Crew — My Account"
  description="Your crew membership and, for crew leaders, crew management."
  section="account"
  noindex
>
  <section class="wrap account-wrap">
    <p class="eyebrow">Private Driver Area</p>
    <h1 class="display account-title">My Account</h1>
    <AccountSubnav active="crew" />

    <div id="acc-auth" class="panel acc-auth" hidden>
      <p>Sign in with Discord to see your crew.</p>
      <button type="button" id="acc-signin" class="btn btn-outline">Sign in with Discord</button>
    </div>

    <div id="acc-body" hidden>
      <h2 class="section-heading">My Crews</h2>
      <div id="membership" class="membership"></div>

      <div id="lead-block" hidden>
        <h2 class="section-heading">Crew Management</h2>
        <p class="section-lede">Edit your crew card, accept join requests and manage members. Changes go live immediately.</p>
        <HubEditor mode="crew" />
      </div>

      <RoleApply focus="crew_leader" />
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .account-wrap { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .account-title { margin: .4rem 0 1.2rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .acc-auth { margin-bottom: 1.5rem; padding: 1rem 1.2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .acc-auth p { margin: 0; font-size: .88rem; }
  .section-heading { margin: 2.5rem 0 .3rem; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.3rem; }
  #acc-body > .section-heading:first-child { margin-top: 0; }
  .section-lede { margin: 0 0 1.2rem; color: var(--gh-muted); font-size: .88rem; }
  .membership { margin-top: 1rem; }
  :global(.mem-empty-card) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.2rem; }
  :global(.mem-empty-card p) { margin: 0; color: var(--gh-muted); font-size: .9rem; }
  :global(.mem-empty-card strong) { color: var(--gh-text); }
  :global(.mem-current) { display: grid; grid-template-columns: minmax(0, 24rem) 1fr; gap: 1.2rem; align-items: start; }
  @media (max-width: 760px) { :global(.mem-current) { grid-template-columns: 1fr; } }
  :global(.mem-side) { display: flex; flex-direction: column; align-items: flex-start; gap: .7rem; font-size: .88rem; color: var(--gh-muted); }
  :global(.mem-side p) { margin: 0; }
  :global(.mem-side .btn) { font-size: .8rem; }
  :global(.mem-msg) { margin: 0 0 1rem; font-size: .84rem; color: #4fd1c5; }
  :global(.mem-msg.is-error) { color: var(--gh-red); }
  :global(.mem-head) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem 1.2rem; margin-bottom: 1.2rem; }
  :global(.mem-head p) { margin: 0; color: var(--gh-muted); font-size: .88rem; max-width: 52ch; }
  :global(.mem-head strong) { color: var(--gh-text); }
  :global(.mem-current + .mem-current) { margin-top: 1.2rem; }
  :global(.mem-invites) { display: flex; flex-direction: column; gap: .7rem; margin-bottom: 1.2rem; }
  :global(.mem-invite-card) { border-color: var(--gh-yellow); }
  :global(.mem-invite-actions) { display: flex; gap: .5rem; }
  :global(.mem-pending) { display: flex; flex-direction: column; gap: .7rem; margin-top: 1.2rem; }
</style>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  import { crewCardHtml, crewTagHtml, esc } from '../../../data/hub';

  const base = import.meta.env.BASE_URL;
  const authEl = document.getElementById('acc-auth')!;
  const bodyEl = document.getElementById('acc-body')!;
  const memEl = document.getElementById('membership')!;
  let me: string | null = null;
  let leaderIds: string[] = [];
  // Up to 5 crews incl. open requests; one active crew is the main crew (DEC-0093).
  // COPY STATUS: membership texts approved (Codex 2026-10-02, Fausto);
  // invite texts (RS-0063) are Claude placeholders, Codex review pending.
  const LIMIT = 5;
  let mine: any[] = [];
  let crewData = new Map<string, any>();

  // Leader block visibility comes from the editor itself (same role check).
  document.addEventListener('hc-access', (e: any) => {
    document.getElementById('lead-block')!.hidden = !e.detail.hasAccess;
    leaderIds = e.detail.leaderCrewIds ?? [];
    render();
  });

  async function load() {
    const sb = getSupabase();
    let res: any = await sb.from('crew_membership_overview').select('membership_id, crew_id, status, crew_name, tag, color, is_primary, requested_at, invited_by_name').eq('driver_id', me!).order('requested_at');
    if (res.error) res = await sb.from('crew_membership_overview').select('membership_id, crew_id, status, crew_name, tag, color, is_primary, requested_at').eq('driver_id', me!).order('requested_at');
    if (res.error) res = await sb.from('crew_membership_overview').select('membership_id, crew_id, status, crew_name, tag, color, requested_at').eq('driver_id', me!).order('requested_at');
    mine = res.data ?? [];
    const activeIds = mine.filter((m) => m.status === 'active').map((m) => m.crew_id);
    crewData = new Map();
    if (activeIds.length) {
      const c = await sb.from('crews').select('crew_id,slug,name,tag,color,platforms,focus,region,languages,description,member_count,discord_url,social_club_url,is_partner,is_official').in('crew_id', activeIds);
      for (const row of (c.data ?? []) as any[]) crewData.set(row.crew_id, row);
    }
    render();
  }

  function render(note = '', isError = false) {
    const active = mine.filter((m) => m.status === 'active').sort((a, b) => Number(Boolean(b.is_primary)) - Number(Boolean(a.is_primary)));
    const pending = mine.filter((m) => m.status === 'pending');
    const invites = mine.filter((m) => m.status === 'invited');
    const used = active.length + pending.length; // invites don't count until accepted (DEC-0094)
    const invHtml = invites.length ? `<div class="mem-invites">${invites.map((m) => `<div class="panel mem-empty-card mem-invite-card"><p>${crewTagHtml(m.tag, m.color, 'sm')} <strong>${esc(m.crew_name)}</strong> invited you to join their crew${m.invited_by_name ? ` (invite from ${esc(m.invited_by_name)})` : ''}.</p><span class="mem-invite-actions"><button type="button" class="btn btn-primary" data-accept="${esc(m.crew_id)}"${used >= LIMIT ? ` disabled title="You are already in ${LIMIT} crews (open requests included)"` : ''}>Accept</button><button type="button" class="btn btn-outline" data-decline="${esc(m.crew_id)}">Decline</button></span></div>`).join('')}</div>` : '';
    const msg = note ? `<p class="mem-msg${isError ? ' is-error' : ''}">${esc(note)}</p>` : '';
    const find = used < LIMIT ? `<a class="btn btn-primary" href="${base}hub/crews/">Find a Crew</a>` : '';
    if (!active.length && !pending.length) {
      memEl.innerHTML = `${invHtml}<div class="panel mem-empty-card"><p><strong>You're not in a crew yet.</strong> Find one that fits how you play and request an invite. You can join or request up to five crews.</p>${find}</div>${msg}`;
      return;
    }
    const head = `<div class="mem-head"><p>You're in <strong>${active.length}</strong> crew${active.length === 1 ? '' : 's'}${pending.length ? ` with <strong>${pending.length}</strong> request${pending.length === 1 ? '' : 's'} pending` : ''} (${used}/${LIMIT}). Your <strong>Active Crew</strong> tag appears next to your name, including on leaderboards.</p>${find}</div>`;
    // Cards side by side like in The Hub; status and buttons in the card's bottom strip (Fausto 2026-10-07).
    const cards = `<div class="crew-grid">${active.map((m) => {
      const c = crewData.get(m.crew_id);
      if (!c) return '';
      const leads = leaderIds.includes(m.crew_id);
      const actions = `<span class="crew-pill${m.is_primary ? '' : ' is-pending'}">${m.is_primary ? 'Active Crew' : 'Crew Member'}</span>${leads ? '<span class="crew-pill">Crew Leader</span>' : ''}`
        + '<span class="crew-action-btns">'
        + (m.is_primary || active.length < 2 ? '' : `<button type="button" class="crew-link crew-action-btn" data-primary="${esc(m.crew_id)}">Set as Active Crew</button>`)
        + `<button type="button" class="crew-link crew-action-btn" data-leave="${esc(m.membership_id)}" data-kind="leave">Leave Crew</button></span>`;
      return crewCardHtml(c, undefined, { actions });
    }).join('')}</div>`;
    const reqs = pending.length ? `<div class="mem-pending">${pending.map((m) => `<div class="panel mem-empty-card"><p>Your request to join ${crewTagHtml(m.tag, m.color, 'sm')} <strong>${esc(m.crew_name)}</strong> is waiting for the crew leader.</p><button type="button" class="btn btn-outline" data-leave="${esc(m.membership_id)}" data-kind="withdraw">Withdraw</button></div>`).join('')}</div>` : '';
    memEl.innerHTML = invHtml + head + msg + cards + reqs;
  }

  memEl.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const acc = t.closest<HTMLButtonElement>('[data-accept]');
    const dec = t.closest<HTMLButtonElement>('[data-decline]');
    if (acc || dec) {
      (acc ?? dec)!.disabled = true;
      const { error } = await getSupabase().rpc(acc ? 'accept_crew_invite' : 'decline_crew_invite', { p_crew: (acc ?? dec)!.dataset[acc ? 'accept' : 'decline'] });
      await load();
      render(error ? (/crew_limit/.test(error.message) ? `You are already in ${LIMIT} crews (open requests included).` : 'That did not work. Please try again.') : acc ? 'Welcome to the crew!' : 'Invite declined.', Boolean(error));
      return;
    }
    const p = t.closest<HTMLButtonElement>('[data-primary]');
    if (p) {
      p.disabled = true;
      const { error } = await getSupabase().rpc('set_primary_crew', { p_crew: p.dataset.primary });
      await load();
      render(error ? 'Could not change your Active Crew. Please try again.' : 'Active Crew updated.', Boolean(error));
      return;
    }
    const b = t.closest<HTMLButtonElement>('[data-leave]');
    if (!b) return;
    if (b.dataset.armed !== '1') {
      b.dataset.armed = '1';
      b.textContent = b.dataset.kind === 'leave' ? 'Click again to leave' : 'Click again to withdraw';
      setTimeout(() => { if (b.isConnected && b.dataset.armed === '1') render(); }, 4000);
      return;
    }
    b.disabled = true;
    const { error } = await getSupabase().from('crew_memberships').delete().eq('membership_id', b.dataset.leave!);
    await load();
    render(error ? 'That did not work. Please try again.' : b.dataset.kind === 'leave' ? 'You left the crew.' : 'Request withdrawn.', Boolean(error));
  });

  async function init(session: any) {
    authEl.hidden = Boolean(session);
    bodyEl.hidden = !session;
    if (!session) return;
    const own = await getSupabase().from('drivers').select('driver_id').eq('auth_user_id', session.user.id).maybeSingle();
    me = own.data?.driver_id ?? null;
    if (me) await load();
  }

  if (backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
    document.getElementById('acc-signin')!.addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  }
</script>
