---
// My Account > Events (RS-0026): link to the calendar, own events for hosts
// and crew leaders (same editor as the moderator panel, personal mode) and
// the Crew Leader / Event Host application.
import Base from '../../../layouts/Base.astro';
import AccountSubnav from '../../../components/AccountSubnav.astro';
import HubEditor from '../../../components/HubEditor.astro';
import RoleApply from '../../../components/RoleApply.astro';
import '../../../styles/hub.css';
const base = import.meta.env.BASE_URL;
---
<Base
  title="My Events — My Account"
  description="Find events and, for event hosts, manage your own events."
  section="account"
  noindex
>
  <section class="wrap account-wrap">
    <p class="eyebrow">Private Driver Area</p>
    <h1 class="display account-title">My Account</h1>
    <AccountSubnav active="events" />

    <div id="acc-auth" class="panel acc-auth" hidden>
      <p>Sign in with Discord to see your events.</p>
      <button type="button" id="acc-signin" class="btn btn-outline">Sign in with Discord</button>
    </div>

    <div id="acc-body" hidden>
      <div class="panel ev-cta">
        <p><strong>Looking for something to drive?</strong> Races, league rounds, community playlists, and car meets from across the GTA VI scene—all in one calendar.</p>
        <a class="btn btn-primary" href={`${base}hub/events/`}>Find Events</a>
      </div>

      <h2 class="section-heading">Events I'm going to</h2>
      <div id="my-rsvps" class="my-rsvps"></div>

      <div id="host-block" hidden>
        <h2 class="section-heading">My Events</h2>
        <p class="section-lede">Create and edit the events you run. Every event is public and shows up in the calendar right away — you can see who signed up in each event.</p>
        <!-- Sign-ups overview for hosts (Fausto, 2026-10-01). Copy approved (Codex 2026-10-02, Fausto). -->
        <div class="panel host-signups" id="host-signups" hidden>
          <p class="host-signups-title">Sign-ups for Your Upcoming Events</p>
          <div id="host-signups-list"></div>
          <p class="host-signups-note">Players who sign up will use your Discord invite or PlayStation name to reach you. Make sure each event has the right contact details.</p>
        </div>
        <HubEditor mode="events" />
      </div>

      <RoleApply focus="event_host" />
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .account-wrap { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .account-title { margin: .4rem 0 1.2rem; font-size: clamp(2rem, 4vw, 2.8rem); }
  .acc-auth { margin-bottom: 1.5rem; padding: 1rem 1.2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .acc-auth p { margin: 0; font-size: .88rem; }
  .ev-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.2rem; }
  .ev-cta p { margin: 0; color: var(--gh-muted); font-size: .9rem; max-width: 40rem; }
  .ev-cta strong { color: var(--gh-text); }
  .section-heading { margin: 2.5rem 0 .3rem; font-family: var(--gh-font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.3rem; }
  .section-lede { margin: 0 0 1.2rem; color: var(--gh-muted); font-size: .88rem; }
  :global(.rsvp-row) { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; padding: .75rem 1rem; border: 1px solid var(--gh-line); border-radius: var(--gh-radius); background: var(--gh-surface); margin-bottom: .5rem; font-size: .88rem; }
  :global(.rsvp-row .rsvp-when) { color: var(--gh-muted); min-width: 10rem; }
  :global(.rsvp-row .rsvp-title) { flex: 1 1 12rem; font-weight: 700; }
  :global(.rsvp-row .btn) { font-size: .76rem; padding: .4rem .8rem; }
  :global(.rsvp-psn) { color: var(--gh-muted); font-size: .8rem; }
  :global(.rsvp-psn strong) { color: var(--gh-text); }
  .host-signups { margin-bottom: 1.25rem; padding: 1rem 1.1rem; }
  .host-signups-title { margin: 0 0 .6rem; font-weight: 800; }
  .host-signups-note { margin: .6rem 0 0; color: var(--gh-muted); font-size: .8rem; }
  :global(.hs-row) { display: flex; flex-wrap: wrap; gap: .25rem 1rem; padding: .6rem 0; border-top: 1px solid var(--gh-line); font-size: .86rem; }
  :global(.hs-row .hs-title) { flex: 1 1 12rem; font-weight: 700; }
  :global(.hs-row .hs-count) { color: var(--gh-text); }
  :global(.hs-row .hs-names) { flex: 1 1 100%; color: var(--gh-muted); font-size: .8rem; }
  :global(.rsvp-empty) { margin: 0; color: var(--gh-muted); font-size: .88rem; }
</style>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  import { esc, sampleEventsUpcoming, eventRowHtml, localizeTimes, type HubEvent } from '../../../data/hub';
  import { fetchLiveEvents } from '../../../scripts/hub-live';
  import { sampleRsvps } from '../../../scripts/sample-rsvp';
  import { createEventRsvp } from '../../../scripts/event-rsvp';
  document.addEventListener('hc-access', (e: any) => {
    document.getElementById('host-block')!.hidden = !e.detail.hasAccess;
  });
  const base = import.meta.env.BASE_URL;
  const listEl = document.getElementById('my-rsvps')!;
  let me: string | null = null;
  // Sample sign-ups (RS-0033) count only while no real events are published.
  let samplesActive: boolean | null = null;
  // Full event rows like in the calendar (Fausto 2026-10-04): same markup,
  // same "Going ✓" / next-step block, PSN profile link and host Discord.
  const rsvp = createEventRsvp(listEl);
  const EVENT_COLS = 'event_id,title,event_type,starts_at,ends_at,platforms,host_name,location,description,join_url,discord_url,status,max_participants,registration,created_by,host:crews(name,tag,color,discord_url),streams:hub_event_streams(platform,url,channel_name,sort_order)';
  async function loadMine() {
    const since = new Date(Date.now() - 6 * 3600e3).toISOString();
    const { data } = await getSupabase().from('hub_event_rsvps').select(`event_id, event:hub_events(${EVENT_COLS})`).eq('driver_id', me!);
    let events: HubEvent[] = ((data ?? []) as any[]).map((r) => r.event).filter((e) => e && e.starts_at >= since);
    let live = true;
    if (!events.length) {
      if (samplesActive === null) samplesActive = !(await fetchLiveEvents());
      if (samplesActive) {
        const picked = sampleRsvps();
        events = sampleEventsUpcoming().filter((e) => picked.has(e.event_id));
        live = false;
      }
    }
    events.sort((a, b) => a.starts_at.localeCompare(b.starts_at));
    if (!events.length) {
      listEl.innerHTML = `<p class="rsvp-empty">You haven't signed up for any upcoming event. <a href="${base}hub/events/">Browse the calendar</a>.</p>`;
      return;
    }
    listEl.innerHTML = `<div class="ev-list">${events.map((e) => eventRowHtml(e, { rsvp: true, sample: !live })).join('')}</div>`;
    localizeTimes(listEl);
    rsvp.setEvents(events, live);
    rsvp.renderRsvps();
    if (live) await rsvp.connect();
  }
  async function init(session: any) {
    document.getElementById('acc-auth')!.hidden = Boolean(session);
    document.getElementById('acc-body')!.hidden = !session;
    if (!session) return;
    const own = await getSupabase().from('drivers').select('driver_id').eq('auth_user_id', session.user.id).maybeSingle();
    me = own.data?.driver_id ?? null;
    if (me) { await loadMine(); await loadHostSignups(); }
  }
  // Hosts: sign-ups per own upcoming event, without opening each event.
  async function loadHostSignups() {
    const box = document.getElementById('host-signups')!;
    const since = new Date(Date.now() - 6 * 3600e3).toISOString();
    const sb = getSupabase();
    const { data: evs } = await sb.from('hub_events').select('event_id, title, starts_at, status, max_participants').eq('created_by', me!).gte('starts_at', since).order('starts_at');
    const list = (evs ?? []) as any[];
    if (!list.length) { box.hidden = true; return; }
    const { data: rs } = await sb.from('public_event_rsvps').select('event_id, display_name, created_at').in('event_id', list.map((e) => e.event_id)).order('created_at');
    const by = new Map<string, (string | null)[]>();
    for (const r of (rs ?? []) as any[]) { if (!by.has(r.event_id)) by.set(r.event_id, []); by.get(r.event_id)!.push(r.display_name); }
    document.getElementById('host-signups-list')!.innerHTML = list.map((e) => {
      const names = by.get(e.event_id) ?? [];
      const named = names.filter(Boolean).map((n) => esc(n as string));
      const anon = names.length - named.length;
      const who = names.length ? `${named.join(', ')}${anon ? `${named.length ? ' + ' : ''}${anon} anonymous` : ''}` : 'No sign-ups yet';
      return `<div class="hs-row"><span class="rsvp-when">${esc(new Date(e.starts_at).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }))}</span><span class="hs-title">${e.status === 'cancelled' ? '✕ ' : ''}${esc(e.title)}</span><span class="hs-count"><strong>${names.length}${e.max_participants ? ' / ' + e.max_participants : ''}</strong> going</span><span class="hs-names">${who}</span></div>`;
    }).join('');
    box.hidden = false;
  }
  if (backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
    document.getElementById('acc-signin')!.addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  }
</script>
