---
// My Account > Events (RS-0026; redesign DEC-0195, Fausto 30.10.2026).
// 1. Events I'm going to: the calendar's event rows (same row as Community > Events), "+ Find more events".
// 2. Events you host (event hosts): the same rows; the right-hand slot shows status, "x going" and Edit
//    instead of the sign-up button. "+ Create an event", past events folded. Edit / Create opens the
//    editor (HubEditor, events mode) under the list: Event details | Sign-ups. Discord feed folded below.
// 3. RS-0097 / DEC-0209: no host application any more. Every account can submit events; "How hosting
//    works" explains the three host stages (own stage highlighted, no number for stage 3).
//    COPY STATUS: Claude placeholders, Codex review pending.
import Base from '../../../layouts/Base.astro';
import AccountHead from '../../../components/AccountHead.astro';
import HubEditor from '../../../components/HubEditor.astro';
import DiscordFeedSteps from '../../../components/DiscordFeedSteps.astro';
import { DISCORD_INVITE_URL } from '../../../data/site';
import '../../../styles/hub.css';
const base = import.meta.env.BASE_URL;
---
<Base
  title="My Events — My Account"
  description="Your event sign-ups and, for event hosts, the events you run."
  section="account"
  noindex
>
  <AccountHead active="events" cta={{ label: 'Find events', href: `${base}community/events/` }} />
  <section class="wrap account-wrap">

    <div id="acc-auth" class="acc-auth lr-empty-panel" hidden>
      <p>Log in with Discord to see your events.</p>
      <button type="button" id="acc-signin" class="btn btn-discord">Log in with Discord</button>
    </div>

    <div id="acc-body" class="evs-secs" hidden>
      <section>
        <div class="evs-head"><div>
          <h2 class="lr-h2 lr-h2-s">Events I'm going to</h2>
          <p class="evs-lede">Your sign-ups, soonest first. Start times are in your local time.</p>
        </div></div>
        <div id="my-rsvps" class="ev-list"></div>
      </section>

      <section id="host-block" hidden>
        <div class="evs-head"><div>
          <h2 class="lr-h2 lr-h2-s">Events you host</h2>
          <p class="evs-lede"><span id="host-lede-review">A moderator reviews each event before it goes live in the calendar.</span> Players who sign up will use your Discord invite or PlayStation name to reach you. Make sure each event has the right contact details. Edit an event to change it or to see who signed up.</p>
        </div></div>
        <div class="evs-how" id="host-how">
          <p class="evs-how-t">How hosting works</p>
          <ol class="evs-steps">
            <li data-step="1"><strong>New host</strong><span>A moderator reviews your first event before it goes live. One event in review at a time.</span></li>
            <li data-step="2"><strong>Event Host</strong><span>After your first approved event you get the Event Host role and can have up to 3 events in review.</span></li>
            <li data-step="3"><strong>Trusted host</strong><span>Run good events and a moderator can unlock publishing without review.</span></li>
          </ol>
          <p class="evs-how-note">Events need to start at least 24 hours after you submit them, so there's time to review. <span id="host-quota"></span></p>
        </div>
        <div class="evs-blocked lr-note lr-note-warn" id="host-blocked" hidden>
          <span>You can't submit events right now. If you think this is a mistake, contact a moderator on our Discord.</span>
          <a class="btn btn-s btn-sm" href={DISCORD_INVITE_URL} target="_blank" rel="noopener">Open Discord</a>
        </div>
        <div id="host-list" class="ev-list"></div>
        <div class="evs-editor" id="host-editor" hidden>
          <div class="evs-editor-top">
            <h3 class="evs-editor-t" id="host-editor-t">Edit event</h3>
            <button type="button" class="btn btn-s btn-sm" id="host-editor-close">Close</button>
          </div>
          <HubEditor mode="events" />
        </div>
        <!-- RS-0095 / DEC-0203: recurring series. COPY STATUS: Claude placeholders, Codex review pending. -->
        <div class="evs-series" id="series-block" hidden>
          <h3 class="evs-sub">Your series</h3>
          <p class="evs-msg" id="series-msg" aria-live="polite"></p>
          <div id="series-list"></div>
          <form class="evs-sform" id="series-form" hidden novalidate>
            <div class="evs-editor-top"><h3 class="evs-editor-t" id="series-form-t">Edit series</h3><button type="button" class="btn btn-s btn-sm" id="series-close">Close</button></div>
            <p class="lr-note" id="series-form-note"></p>
            <div class="evs-sgrid">
              <label class="span2">Title *<input type="text" name="title" maxlength="80" required /></label>
              <label>Repeat<select name="freq"><option value="weekly">Every week</option><option value="biweekly">Every 2 weeks</option><option value="monthly">Every month</option></select></label>
              <label data-sf-monthly>On the<select name="monthly_nth"><option value="1">1st</option><option value="2">2nd</option><option value="3">3rd</option><option value="4">4th</option><option value="-1">last</option></select></label>
              <label>First date <small>sets the weekday</small><input type="date" name="anchor_date" required /></label>
              <label>Start time <small id="sf-tz"></small><input type="time" name="local_time" required /></label>
              <label>Duration <small>minutes, optional</small><input type="number" name="duration_min" min="15" max="1440" step="5" /></label>
              <label>Max. participants <small>optional</small><input type="number" name="max_participants" min="2" max="500" step="1" /></label>
              <label>Sign-ups<select name="registration"><option value="open">Open</option><option value="closed">Closed — Listed, No Sign-ups</option></select></label>
              <label>Host PSN name<input type="text" name="host_name" maxlength="16" autocomplete="off" /></label>
              <label class="span2">Discord invite<input type="url" name="discord_url" placeholder="https://discord.gg/…" /></label>
              <label class="span2">Description <small>max. 600</small><textarea name="description" maxlength="600" rows="3"></textarea></label>
            </div>
            <div class="evs-sactions"><button type="submit" class="btn btn-p">Save series</button><p class="evs-msg" id="series-form-msg" aria-live="polite"></p></div>
          </form>
        </div>
        <div class="evs-dfs"><DiscordFeedSteps source="host" /></div>
      </section>

    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }
  .account-wrap { padding-top: var(--lr-gap-head); } /* DEC-0188; the footer brings the 64px gap below */
  .acc-auth { margin-bottom: 1.5rem; } /* box: .lr-empty-panel (DEC-0182) */
  .evs-secs:not([hidden]) { display: flex; flex-direction: column; gap: var(--lr-gap-sec); }
  .evs-head { margin-bottom: 20px; }
  .evs-lede { margin: 8px 0 0; max-width: 640px; font-size: 15px; line-height: 1.5; color: var(--lr-soft); }
  /* "+" row at the end of a list, like the "+" tiles in My garage / Crews */
  :global(.evs-slot) { display: flex; align-items: center; justify-content: center; gap: 14px; width: 100%; min-height: 72px; padding: 0 18px; border: 0; border-top: 1px dashed var(--lr-line-strong); background: transparent; color: var(--lr-soft); font: inherit; font-size: 14px; text-decoration: none; cursor: pointer; }
  :global(.evs-slot:first-child) { border-top: 0; }
  :global(.evs-slot:hover), :global(.evs-slot:focus-visible) { background: var(--lr-orange-tint); color: var(--lr-text); outline: none; }
  :global(.evs-slot-plus) { width: 36px; height: 36px; border-radius: 50%; border: 1px solid currentColor; display: grid; place-items: center; font-size: 18px; line-height: 1; }
  :global(.evs-slot strong) { color: var(--lr-text); font-weight: 600; font-size: 15px; }
  /* host rows: right-hand slot */
  :global(.evs-side) { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; text-align: right; }
  :global(.evs-going) { font-size: 14px; color: var(--lr-soft); white-space: nowrap; }
  :global(.evs-going b) { color: var(--lr-text); font-family: var(--gh-font-display); font-size: 18px; font-weight: 800; }
  :global(.evs-past) { border-top: 1px solid var(--lr-line-soft); }
  :global(.evs-past > summary) { cursor: pointer; padding: 14px 20px; list-style: none; font-size: 14px; font-weight: 600; color: var(--lr-muted); }
  :global(.evs-past > summary::-webkit-details-marker) { display: none; }
  :global(.evs-past > summary:hover) { color: var(--lr-text); }
  :global(.evs-past .ev-row) { opacity: .7; }
  .evs-editor { margin-top: 24px; padding: 24px; border: 1px solid var(--lr-orange-border); border-radius: 8px; background: var(--lr-card); }
  .evs-editor-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
  .evs-editor-t { margin: 0; font-size: 18px; font-weight: 700; }
  .evs-dfs { margin-top: 16px; }
  .evs-series { margin-top: 28px; }
  .evs-sub { margin: 0 0 10px; font-size: 17px; font-weight: 700; }
  .evs-msg { margin: 0 0 10px; font-size: 14px; color: var(--lr-lime); min-height: 0; }
  .evs-msg.is-error { color: var(--lr-coral); }
  :global(.evs-srow) { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 14px 16px; border: 1px solid var(--lr-line-soft); border-radius: 8px; margin-bottom: 10px; background: var(--lr-card); }
  :global(.evs-srow h4) { margin: 0 0 4px; font-size: 16px; }
  :global(.evs-srow p) { margin: 2px 0; font-size: 14px; color: var(--lr-soft); }
  :global(.evs-srow .evs-warn) { color: var(--lr-orange); }
  :global(.evs-sbtns) { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .evs-sform { margin-top: 16px; padding: 20px; border: 1px solid var(--lr-orange-border); border-radius: 8px; background: var(--lr-card); }
  .evs-sgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
  .evs-sgrid label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 600; }
  .evs-sgrid label small { font-weight: 400; color: var(--lr-muted); }
  .evs-sgrid .span2 { grid-column: span 2; }
  .evs-sgrid :is(input, select, textarea) { padding: 8px 10px; border: 1px solid var(--lr-line-strong); border-radius: 6px; background: transparent; color: inherit; font: inherit; font-weight: 400; }
  .evs-sactions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 16px; }
  @media (max-width: 760px) { .evs-sgrid { grid-template-columns: 1fr; } .evs-sgrid .span2 { grid-column: auto; } }
  .evs-how { margin-bottom: 20px; padding: 18px 20px; border: 1px solid var(--lr-line-soft); border-radius: 8px; background: var(--lr-card); }
  .evs-how-t { margin: 0 0 12px; font-size: 15px; font-weight: 700; }
  .evs-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; counter-reset: st; }
  .evs-steps li { counter-increment: st; display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border: 1px solid var(--lr-line-soft); border-radius: 6px; font-size: 14px; line-height: 1.45; color: var(--lr-soft); }
  .evs-steps li strong { color: var(--lr-text); font-size: 15px; }
  .evs-steps li strong::before { content: counter(st) ". "; color: var(--lr-muted); }
  .evs-steps li.is-current { border-color: var(--lr-orange-border); background: var(--lr-orange-tint); }
  .evs-steps li.is-current strong::after { content: "  · You"; color: var(--lr-orange); font-size: 13px; font-weight: 600; }
  .evs-how-note { margin: 12px 0 0; font-size: 14px; color: var(--lr-soft); }
  .evs-blocked { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
  :global(.evs-why) { max-width: 260px; font-size: 13px; line-height: 1.4; color: var(--lr-soft); }
  :global(.evs-slot[disabled]) { cursor: default; opacity: .6; }
  :global(.evs-slot[disabled]:hover) { background: transparent; color: var(--lr-soft); }
  :global(.evs-slot small) { color: var(--lr-muted); font-size: 13px; }
  @media (max-width: 760px) { .evs-steps { grid-template-columns: 1fr; } .evs-editor { padding: 16px; } :global(.evs-side) { align-items: flex-start; text-align: left; } }
</style>

<script>
  import { backendConfigured, getSupabase } from '../../../scripts/supabase-client';
  import { esc, eventRowHtml, localizeTimes, type HubEvent } from '../../../data/hub';
  import { createEventRsvp } from '../../../scripts/event-rsvp';
  import { attachSeries } from '../../../scripts/hub-live';
  import { seriesLabel } from '../../../data/hub';
  const base = import.meta.env.BASE_URL;
  const $ = (id: string) => document.getElementById(id)!;
  const listEl = $('my-rsvps');
  const hostEl = $('host-list');
  let me: string | null = null;
  let isHost = false;
  let hostStatus: any = null;
  const EVENT_COLS = 'event_id,title,event_type,starts_at,ends_at,platforms,host_name,location,description,join_url,discord_url,status,max_participants,registration,members_only,created_by,is_published,review_status,series_id,host:crews(name,tag,color,discord_url),streams:hub_event_streams(platform,url,channel_name,sort_order)';
  const slot = (label: string, attrs: string, tag = 'a', sub = '') => `<${tag} class="evs-slot" ${attrs}><span class="evs-slot-plus" aria-hidden="true">+</span><strong>${label}</strong>${sub ? `<small>${sub}</small>` : ''}</${tag}>`;

  document.addEventListener('hc-access', (e: any) => {
    isHost = Boolean(e.detail.hasAccess); // every signed-in driver (DEC-0209)
    hostStatus = e.detail.hostStatus ?? null;
    $('host-block').hidden = !isHost;
    if (me && isHost) loadHosted();
  });

  // DEC-0209: own stage, limits, blocked note
  function renderHostInfo() {
    const st = hostStatus ?? { level: 1, blocked: false, open: 0, open_limit: 1 };
    document.querySelectorAll<HTMLElement>('#host-how [data-step]').forEach((li) => li.classList.toggle('is-current', Number(li.dataset.step) === st.level));
    $('host-lede-review').textContent = st.level === 3 && !st.blocked ? 'Your events go live in the calendar right away.' : 'A moderator reviews each event before it goes live in the calendar.';
    $('host-quota').textContent = st.level === 3 ? `Created in the last 24 hours: ${st.created_24h} of ${st.daily_limit}.` : `In review now: ${st.open} of ${st.open_limit}.`;
    ($('host-quota').parentElement as HTMLElement).firstChild!.textContent = st.level === 3 ? '' : "Events need to start at least 24 hours after you submit them, so there's time to review. ";
    $('host-blocked').hidden = !st.blocked;
  }
  const canSubmit = () => { const st = hostStatus; return Boolean(st) && !st.blocked && (st.level === 3 ? st.created_24h < st.daily_limit : st.open < st.open_limit); };

  // 1. Events I'm going to: the calendar row (full), sign-up state on the right (Going ✓ / next steps)
  const rsvp = createEventRsvp(listEl);
  async function loadMine() {
    const since = new Date(Date.now() - 6 * 3600e3).toISOString();
    const { data } = await getSupabase().from('hub_event_rsvps').select(`event_id, event:hub_events(${EVENT_COLS})`).eq('driver_id', me!);
    const events: HubEvent[] = ((data ?? []) as any[]).map((r) => r.event).filter((e) => e && e.starts_at >= since)
      .sort((a, b) => a.starts_at.localeCompare(b.starts_at));
    await attachSeries(events);
    listEl.innerHTML = events.map((e) => eventRowHtml(e, { rsvp: true, full: true })).join('')
      + slot(events.length ? 'Find more events' : 'Find an event', `href="${base}community/events/"`);
    localizeTimes(listEl);
    if (events.length) { rsvp.setEvents(events, true); rsvp.renderRsvps(); await rsvp.connect(); }
  }

  // 2. Events you host: same rows; right-hand slot = status, "x going", Edit
  async function loadHosted() {
    const sb = getSupabase();
    const { data } = await sb.from('hub_events').select(EVENT_COLS).eq('created_by', me!).order('starts_at');
    const all = (data ?? []) as any[];
    await attachSeries(all);
    loadSeries();
    const since = Date.now() - 6 * 3600e3;
    const upcoming = all.filter((e) => new Date(e.starts_at).getTime() >= since);
    const past = all.filter((e) => new Date(e.starts_at).getTime() < since).reverse();
    const counts = new Map<string, number>();
    const reviews = new Map<string, any>();
    const st = await sb.rpc('my_event_host_status');
    if (st.data) hostStatus = st.data;
    renderHostInfo();
    if (all.length) {
      const ids = all.map((e) => e.event_id);
      const [{ data: rs }, { data: rv }] = await Promise.all([
        sb.from('public_event_rsvps').select('event_id').in('event_id', ids),
        sb.from('hub_event_reviews').select('event_id,note,pending,edit_note').in('event_id', ids),
      ]);
      for (const r of (rs ?? []) as any[]) counts.set(r.event_id, (counts.get(r.event_id) ?? 0) + 1);
      for (const r of (rv ?? []) as any[]) reviews.set(r.event_id, r);
    }
    const side = (e: any, wasPast: boolean) => {
      const n = counts.get(e.event_id) ?? 0;
      const rv = reviews.get(e.event_id);
      const rs = e.review_status ?? 'approved';
      const edit = `<button type="button" class="btn btn-s btn-sm" data-edit="${esc(e.event_id)}">Edit</button>`;
      if (rs === 'rejected' || rs === 'expired') {
        const why = rs === 'rejected' ? (rv?.note ? `Moderator note: ${esc(rv.note)}` : '') : 'The start time passed before a moderator reviewed it.';
        return `<div class="evs-side"><span class="lr-status is-no">${rs === 'rejected' ? 'Not approved' : 'Expired'}</span>${why ? `<span class="evs-why">${why}</span>` : ''}</div>`;
      }
      if (rs === 'pending') return `<div class="evs-side"><span class="lr-status">In review</span>${edit}</div>`;
      if (rs === 'needs_changes') return `<div class="evs-side"><span class="lr-status is-fix">Needs changes</span>${rv?.note ? `<span class="evs-why">${esc(rv.note)}</span>` : ''}${edit}</div>`;
      const status = e.status === 'cancelled' ? '' : e.is_published ? '<span class="lr-status is-ok">Live</span>' : '<span class="lr-status" title="Hidden by a moderator">Hidden</span>';
      const chg = rv?.pending ? '<span class="lr-status is-fix" title="The calendar shows the previous version until a moderator approves your changes">Changes in review</span>' : '';
      return `<div class="evs-side">${status}${chg}<span class="evs-going"><b>${n}</b>${e.max_participants ? ` / ${e.max_participants}` : ''} ${wasPast ? 'went' : 'going'}</span>${edit}</div>`;
    };
    const row = (e: any, wasPast = false) => eventRowHtml(e, { full: true, side: side(e, wasPast) });
    const st0 = hostStatus ?? { level: 1, blocked: false, open: 0, open_limit: 1 };
    const create = st0.blocked ? ''
      : !canSubmit() ? slot('Create an event', 'type="button" disabled', 'button', st0.level === 3 ? `you've reached ${st0.daily_limit} new events in 24 hours` : `${st0.open} of ${st0.open_limit} events in review — wait for a moderator`)
      : st0.level === 1 && !all.length ? slot('Become an Event Host', 'type="button" data-new', 'button', 'create your first event')
      : slot('Create an event', 'type="button" data-new', 'button');
    hostEl.innerHTML = upcoming.map((e) => row(e)).join('')
      + create
      + (past.length ? `<details class="evs-past"><summary>Past events (${past.length})</summary>${past.map((e) => row(e, true)).join('')}</details>` : '');
    localizeTimes(hostEl);
  }

  // ---- Your series (RS-0095) ----
  let seriesRows: any[] = [];
  let editSeries: any = null;
  const sMsg = (t: string, err = false) => { const m = $('series-msg'); m.textContent = t; m.className = `evs-msg${err ? ' is-error' : ''}`; };
  const fmtTime = (t: string) => String(t ?? '').slice(0, 5);
  const seriesErr = (m: string) => /series_limit/.test(m) ? 'You can run up to 3 series at a time.'
    : /contact_required/.test(m) ? 'Add your PSN name or a Discord invite, so players can reach you.'
    : /not_editable/.test(m) ? "This series can't be changed any more." : m;
  async function loadSeries() {
    const { data } = await getSupabase().from('hub_event_series').select('*').eq('created_by', me!).order('created_at', { ascending: false });
    const cutoff = Date.now() - 30 * 864e5;
    seriesRows = ((data ?? []) as any[]).filter((r) => r.status === 'active' || new Date(r.ended_at ?? r.updated_at).getTime() > cutoff);
    $('series-block').hidden = seriesRows.length === 0;
    $('series-list').innerHTML = seriesRows.map((r) => {
      const label = `${seriesLabel(r)} · ${fmtTime(r.local_time)} (${r.tz.replace(/_/g, ' ')})`;
      const pill = r.status === 'cancelled' ? '<span class="lr-status is-no">Cancelled by a moderator</span>'
        : r.status === 'ended' ? (r.review_status === 'rejected' ? '<span class="lr-status is-no">Not approved</span>' : '<span class="lr-status">Ended</span>')
        : r.review_status === 'pending' ? '<span class="lr-status">In review</span>'
        : r.review_status === 'needs_changes' ? '<span class="lr-status is-fix">Needs changes</span>'
        : '<span class="lr-status is-ok">Live</span>';
      const notes = [
        r.note && (r.review_status !== 'approved' || r.status === 'cancelled') ? `<p>Moderator note: ${esc(r.note)}</p>` : '',
        r.pending ? '<p class="evs-warn">Changes to the title, description or Discord invite are waiting for a moderator.</p>' : '',
        r.edit_note ? `<p>Your last changes were not approved. Moderator note: ${esc(r.edit_note)}</p>` : '',
        r.status === 'active' && r.empty_count >= 2 ? `<p class="evs-warn">Nobody signed up for the last ${r.empty_count} dates. Is the series still running?</p>` : '',
      ].join('');
      const btns = r.status !== 'active' ? '' : [
        r.empty_count >= 2 ? `<button type="button" class="btn btn-p btn-sm" data-skeep="${esc(r.series_id)}">Keep it running</button>` : '',
        r.review_status === 'rejected' ? '' : `<button type="button" class="btn btn-s btn-sm" data-sedit="${esc(r.series_id)}">Edit series</button>`,
        `<button type="button" class="btn btn-danger btn-sm" data-send="${esc(r.series_id)}">End series</button>`,
      ].join('');
      return `<div class="evs-srow"><div><h4>${esc(r.title)}</h4><p>${esc(label)}</p>${notes}</div><div class="evs-sbtns">${pill}${btns}</div></div>`;
    }).join('');
  }
  const sf = () => ($('series-form') as HTMLFormElement).elements as any;
  function openSeriesForm(r: any) {
    editSeries = r;
    const f = sf();
    const p = r.pending ?? {};
    f.title.value = p.title ?? r.title; f.description.value = ('description' in p ? p.description : r.description) ?? '';
    f.discord_url.value = ('discord_url' in p ? p.discord_url : r.discord_url) ?? '';
    f.freq.value = r.freq; f.monthly_nth.value = String(r.monthly_nth ?? 1); f.anchor_date.value = r.anchor_date;
    f.local_time.value = fmtTime(r.local_time); f.duration_min.value = r.duration_min ?? ''; f.max_participants.value = r.max_participants ?? '';
    f.registration.value = r.registration; f.host_name.value = r.host_name ?? '';
    $('sf-tz').textContent = `time zone ${r.tz.replace(/_/g, ' ')}`;
    $('series-form-t').textContent = `Edit series: ${r.title}`;
    $('series-form-note').textContent = (hostStatus?.level ?? 1) < 3 && r.review_status === 'approved'
      ? 'Changes to the title, description and Discord invite are checked by a moderator first; everything else applies to all upcoming dates right away. Changing the rhythm or time moves upcoming dates without sign-ups; dates with sign-ups stay as they are (cancel them one by one if needed).'
      : 'Changes apply to all upcoming dates. Changing the rhythm or time moves upcoming dates without sign-ups; dates with sign-ups stay as they are.';
    syncSf();
    $('series-form-msg').textContent = '';
    $('series-form').hidden = false;
    $('series-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function syncSf() { (document.querySelector('[data-sf-monthly]') as HTMLElement).hidden = sf().freq.value !== 'monthly'; }
  $('series-form').addEventListener('change', syncSf);
  $('series-close').addEventListener('click', () => { $('series-form').hidden = true; editSeries = null; });
  $('series-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    if (!editSeries) return;
    const f = sf();
    const num = (v: string) => (v === '' ? null : Number(v));
    const payload: Record<string, unknown> = {
      title: String(f.title.value).trim(), description: f.description.value, discord_url: f.discord_url.value, host_name: f.host_name.value,
      freq: f.freq.value, monthly_nth: f.freq.value === 'monthly' ? Number(f.monthly_nth.value) : null, anchor_date: f.anchor_date.value,
      weekday: ((new Date(`${f.anchor_date.value}T12:00`).getDay() + 6) % 7) + 1, local_time: f.local_time.value,
      duration_min: num(f.duration_min.value), max_participants: num(f.max_participants.value), registration: f.registration.value,
    };
    const m = $('series-form-msg');
    if (String(payload.title).length < 3 || !payload.anchor_date || !payload.local_time) { m.textContent = 'Please fill in title, first date and start time.'; m.className = 'evs-msg is-error'; return; }
    const { data, error } = await getSupabase().rpc('update_event_series', { p_series: editSeries.series_id, p: payload });
    if (error) { m.textContent = seriesErr(error.message); m.className = 'evs-msg is-error'; return; }
    $('series-form').hidden = true; editSeries = null;
    sMsg((data as any)?.pending ? 'Saved. The new title, description or Discord invite go live once a moderator approves them; everything else applies now.' : 'Series saved — upcoming dates are updated.');
    await loadHosted();
  });
  $('series-list').addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const ed = t.closest<HTMLElement>('[data-sedit]');
    if (ed) { const r = seriesRows.find((x) => x.series_id === ed.dataset.sedit); if (r) openSeriesForm(r); return; }
    const kp = t.closest<HTMLButtonElement>('[data-skeep]');
    if (kp) { kp.disabled = true; const { error } = await getSupabase().rpc('keep_event_series', { p_series: kp.dataset.skeep }); sMsg(error ? seriesErr(error.message) : 'Thanks — the series keeps running.', Boolean(error)); await loadSeries(); return; }
    const en = t.closest<HTMLButtonElement>('[data-send]');
    if (en) {
      if (en.dataset.armed !== '1') { en.dataset.armed = '1'; en.textContent = 'Click again to end the series'; setTimeout(() => { if (en.isConnected) { en.dataset.armed = ''; en.textContent = 'End series'; } }, 4000); return; }
      en.disabled = true;
      const { error } = await getSupabase().rpc('end_event_series', { p_series: en.dataset.send });
      sMsg(error ? seriesErr(error.message) : 'Series ended. Upcoming dates without sign-ups were removed; dates with sign-ups are shown as cancelled.', Boolean(error));
      await loadHosted();
    }
  });
  document.addEventListener('hc-series-changed', (e: any) => {
    $('host-editor').hidden = true;
    sMsg(e.detail?.message ?? '');
    loadHosted();
    $('series-block').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // Edit / Create -> editor under the list
  function openEditor(id: string | null, title: string) {
    $('host-editor').hidden = false;
    $('host-editor-t').textContent = title;
    document.dispatchEvent(new CustomEvent('hc-open-event', { detail: { id } }));
    $('host-editor').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  hostEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const ed = t.closest<HTMLElement>('[data-edit]');
    if (ed) { openEditor(ed.dataset.edit!, `Edit: ${ed.closest('.ev-row')?.querySelector('.ev-title')?.textContent ?? 'event'}`); return; }
    if (t.closest('[data-new]') && canSubmit()) openEditor(null, 'New event');
  });
  $('host-editor-close').addEventListener('click', () => { $('host-editor').hidden = true; });
  document.addEventListener('hc-events-changed', () => {
    loadHosted();
    if ((document.getElementById('event-form') as HTMLElement)?.hidden) $('host-editor').hidden = true; // deleted
    else $('host-editor-t').textContent = `Edit: ${(document.querySelector('#event-form [name="title"]') as HTMLInputElement)?.value || 'event'}`;
  });

  // Share (same behaviour as the calendar): link to the event in the calendar
  document.addEventListener('click', (e) => {
    const s = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-share]');
    if (!s || !s.closest('#acc-body')) return;
    const url = `${location.origin}${base}community/events/#event-${s.dataset.share}`;
    if (navigator.share) navigator.share({ title: s.dataset.title, url }).catch(() => {});
    else navigator.clipboard?.writeText(url).then(() => { const o = s.innerHTML; s.textContent = 'Link copied'; setTimeout(() => { s.innerHTML = o; }, 1500); }).catch(() => {});
  });

  async function init(session: any) {
    $('acc-auth').hidden = Boolean(session);
    $('acc-body').hidden = !session;
    if (!session) return;
    const own = await getSupabase().from('drivers').select('driver_id').eq('auth_user_id', session.user.id).maybeSingle();
    me = own.data?.driver_id ?? null;
    if (me) { await loadMine(); if (isHost) await loadHosted(); }
  }
  if (backendConfigured) {
    const sb = getSupabase();
    sb.auth.getSession().then(({ data }) => init(data?.session ?? null));
    sb.auth.onAuthStateChange((ev, s) => { if (ev === 'SIGNED_IN' || ev === 'SIGNED_OUT') init(s); });
    $('acc-signin').addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  }
</script>
