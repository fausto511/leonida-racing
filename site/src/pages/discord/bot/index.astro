---
// /discord/bot/ — the bot page (RS-0076, Fausto 17.10.2026; replaces the planned /discord-bot/).
// For server owners and crew leaders: what the bot does, setup, commands, permissions, FAQ.
// Short how-to clips (RS-0067) get their own section once they exist.
// COPY STATUS: data/discord-copy.ts (bot*) = Claude placeholders, Codex review pending (DEC-0088).
import Base from '../../../layouts/Base.astro';
import { SITE_NAME, DISCORD_INVITE_URL, DISCORD_BOT_INVITE_URL, DISCORD_ICON_PATH } from '../../../data/site';
import { botPage as P, botGlance, botFeatures, botSetup, botCommands, botPerms, botFaq } from '../../../data/discord-copy';

const base = import.meta.env.BASE_URL;
const pageUrl = new URL(`${base}discord/bot/`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Leonida Racing Discord bot',
    applicationCategory: 'CommunicationApplication',
    operatingSystem: 'Discord',
    url: pageUrl,
    description: P.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: SITE_NAME, url: new URL(base, Astro.site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: botFaq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const img = `${base}images/hub/hub-events`;
---
<Base title={P.title} description={P.description} section="hub" jsonLd={jsonLd} breadcrumbs={[{ name: 'Discord', path: 'discord/' }, { name: 'Bot', path: 'discord/bot/' }]}>
  <section class="db">
    <picture>
      <source type="image/webp" srcset={`${img}-640.webp 640w, ${img}-1080.webp 1080w, ${img}-1672.webp 1672w`} sizes="100vw" />
      <img class="db-bg" src={`${img}-1672.jpg`} alt="" width="1672" height="941" fetchpriority="high" />
    </picture>
    <span class="lr-shade" aria-hidden="true"></span>
    <div class="wrap db-inner lr-band-in">
      <div class="db-copy">
        <nav class="lr-crumb" aria-label="Breadcrumb"><a href={`${base}discord/`}>Discord</a><span aria-hidden="true">/</span><span aria-current="page">Bot</span></nav>
        <p class="eyebrow">{P.eyebrow}</p>
        <h1 class="display lr-t2">{P.h1}</h1>
        <p class="lr-lede">{P.intro}</p>
        <div class="db-act">
          <a class="btn btn-discord" href={DISCORD_BOT_INVITE_URL} target="_blank" rel="noopener">
            <svg class="dico" viewBox="0 0 24 24" aria-hidden="true"><path d={DISCORD_ICON_PATH} /></svg>
            <span>Add to Discord</span>
          </a>
          <span class="db-note">{P.addNote}</span>
        </div>
      </div>
      <div class="glance">
        <p class="glance-eb">At a glance</p>
        {botGlance.map((r) => <div class="gl-row"><span>{r.k}</span><b>{r.v}</b></div>)}
      </div>
    </div>
  </section>

  <section class="wrap dsec feat">
    <div>
      <p class="eyebrow dsec-eb">What it does</p>
      <h2 class="lr-h2 lr-h2-s dsec-h">Your events, posted and kept up to date</h2>
      <div class="areas">
        {botFeatures.map((f) => (
          <article class="area"><h3 class="area-t">{f.title}</h3><p class="area-p">{f.text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap dsec lfg">
    <div class="lfg-copy">
      <p class="eyebrow dsec-eb">Setup</p>
      <h2 class="lr-h2 lr-h2-s dsec-h">Running in three steps</h2>
      <ol class="steps1">
        {botSetup.map((s, i) => (
          <li><span class="step-n" aria-hidden="true">{i + 1}</span><div><h3 class="step-t">{s.title}</h3><p class="step-p">{s.text}</p></div></li>
        ))}
      </ol>
      <a class="btn btn-s" href={DISCORD_BOT_INVITE_URL} target="_blank" rel="noopener">Open bot invite</a>
    </div>
    <figure class="mock" aria-label="Example of an event card posted by the bot">
      <div class="mock-msg">
        <span class="mock-av" aria-hidden="true"><img src={`${base}images/brand/lr-logo-color.webp`} alt="" width="79" height="24" loading="lazy" /></span>
        <div class="mock-body">
          <p class="mock-name">Leonida Racing <span class="mock-app">APP</span></p>
          <div class="mock-embed">
            <p class="mock-au">Race · PlayStation</p>
            <p class="mock-et">Friday Night Sprint</p>
            <div class="mock-fields three">
              <div><p class="mock-fk">Starts</p><p class="mock-fv">Friday 8:00 PM<br /><span class="mock-dim">in 2 days</span></p></div>
              <div><p class="mock-fk">Host</p><p class="mock-fv"><span class="mock-link">your-psn</span> [CREW]</p></div>
              <div><p class="mock-fk">Going</p><p class="mock-fv">9 / 16</p></div>
            </div>
            <img class="mock-img" src={`${base}images/hub/hub-events-640.webp`} alt="" width="640" height="360" loading="lazy" />
            <p class="mock-foot">Leonida Racing · times shown in your time zone</p>
          </div>
          <div class="mock-btns"><span class="mb mb-g">I’m in</span><span class="mb">Withdraw</span><span class="mb">Details ↗</span><span class="mb">Host Discord ↗</span></div>
        </div>
      </div>
      <figcaption>Example event card with fictional names and details.</figcaption>
    </figure>
  </section>

  <section class="wrap dsec">
    <p class="eyebrow dsec-eb">Commands</p>
    <h2 class="lr-h2 lr-h2-s dsec-h">Commands for your server</h2>
    <div class="tiers-wrap">
      <table class="cmds">
        <thead><tr><th scope="col">Command</th><th scope="col">What it does</th><th scope="col">Who</th></tr></thead>
        <tbody>
          {botCommands.map((c) => <tr><th scope="row"><code>{c.cmd}</code></th><td>{c.text}</td><td class="who">{c.who}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="dsec-small">Role menus and LFG searches are available on the official Leonida Racing server. There, Verified Event Hosts can use /ping for the permitted notification groups. <a class="arrow" href={`${base}discord/`}>What’s on the server →</a></p>
  </section>

  <section class="wrap dsec">
    <p class="eyebrow dsec-eb">Permissions</p>
    <h2 class="lr-h2 lr-h2-s dsec-h">What the bot needs, and why</h2>
    <ul class="perms">
      {botPerms.map((p) => <li><b>{p.p}</b><span>{p.why}</span></li>)}
    </ul>
    <p class="dsec-small">If cards are not posting, check the bot’s server and channel permissions. Private channels need explicit access. Reopening the bot invite can help update server-level permissions, but it does not replace channel settings.</p>
  </section>

  <section class="wrap dsec faq" aria-labelledby="faq-h">
    <p class="eyebrow dsec-eb">FAQ</p>
    <h2 class="lr-h2 lr-h2-s dsec-h" id="faq-h">Questions about the bot</h2>
    <div class="faq-list">
      {botFaq.map((f, i) => (
        <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </section>

  <section class="dband">
    <div class="wrap dband-inner">
      <div class="dband-copy">
        <h2 class="lr-h2 display dband-title">See it in action first</h2>
        <p class="dband-text">Try /car or /compare on our Discord and see how the event cards work before adding the bot to your own server.</p>
      </div>
      <a href={DISCORD_INVITE_URL} target="_blank" rel="noopener" class="btn dband-btn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={DISCORD_ICON_PATH} /></svg>
        <span>Join the Discord</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .db { position: relative; overflow: hidden; border-bottom: 1px solid var(--lr-line-strong); }
  .db picture, .db-bg, .db-t { position: absolute; inset: 0; width: 100%; height: 100%; }
  .db-bg { object-fit: cover; object-position: 50% 55%; }
  .db-inner { display: flex; align-items: flex-start; justify-content: space-between; gap: 48px; }
  /* Tile sits on the lower edge of the photo band (Fausto 22.10.2026, DEC-0154): text top, tile bottom. */
  @media (min-width: 1101px) { .db-inner > .glance { align-self: flex-end; margin-top: 0; } }
  .db-copy { min-width: 0; max-width: 680px; }
  .db-act { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 18px; margin-top: 18px; }
  .dico { width: 20px; height: 20px; fill: currentColor; flex: none; }
  .db-note { font-size: 13px; color: var(--lr-soft); }
  .glance { flex: none; width: 380px; margin-top: 30px; padding: 18px 18px 12px; border: 1px solid var(--lr-line-strong); border-radius: 8px; background: rgba(20,20,31,.88); backdrop-filter: blur(6px); }
  .glance-eb { margin: 0 0 6px; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-orange); }
  .gl-row { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; padding: 9px 0; border-top: 1px solid var(--lr-line); font-size: 15px; color: var(--lr-soft); }
  .gl-row:first-of-type { border-top: 0; }
  .gl-row b { color: var(--lr-text); font-weight: 600; text-align: right; }

  .dsec { padding-top: 56px; }
  .dsec-eb { display: flex; width: fit-content; margin: 0 0 8px; } /* label -> H2: 8px (DEC-0168) */
  .dsec-h { margin: 0 0 20px; }
  .dsec-small { margin: 14px 0 0; font-size: 14px; line-height: 1.55; color: var(--lr-soft); max-width: 820px; }
  .areas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .area { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px 20px; border: 1px solid var(--lr-line-strong); border-radius: 8px; background: var(--lr-card); }
  .area-t { margin: 0; font-size: var(--lr-h3-s); font-weight: 700; line-height: 1.25; }
  .area-p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--lr-soft); }

  .lfg { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 460px); gap: 48px; align-items: center; }
  .steps1 { list-style: none; margin: 0 0 22px; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .steps1 li { display: flex; gap: 14px; }
  .step-n { width: 34px; height: 34px; flex: none; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--lr-brand-gradient); color: var(--lr-text); font-weight: 800; font-size: 15px; }
  .step-t { margin: 4px 0 4px; font-size: var(--lr-h3-s); font-weight: 700; }
  .step-p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--lr-soft); }

  .mock { margin: 0; }
  .mock-msg { display: flex; gap: 14px; padding: 16px; border-radius: 8px; background: #313338; color: #DBDEE1; font-family: 'gg sans', 'Noto Sans', system-ui, sans-serif; }
  .mock-av { width: 40px; height: 40px; flex: none; border-radius: 50%; background: #1E1F22; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .mock-av img { width: 32px; height: auto; }
  .mock-body { min-width: 0; flex: 1; }
  .mock-msg p { margin: 0; }
  .mock-name { font-weight: 600; color: #F2F3F5; font-size: 15px; display: flex; align-items: center; gap: 6px; }
  .mock-app { font-size: 10px; font-weight: 700; background: #5865F2; color: var(--lr-discord-text); border-radius: 3px; padding: 1px 4px; }
  .mock-embed { margin-top: 6px; padding: 10px 14px 12px; border-left: 4px solid #FFD74C; border-radius: 4px; background: #2B2D31; }
  .mock-au { font-size: 13px; font-weight: 600; color: #F2F3F5; }
  .mock-et { margin-top: 6px !important; font-weight: 700; color: #00A8FC; font-size: 16px; }
  .mock-fields { display: grid; gap: 10px; margin-top: 10px; }
  .mock-fields.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .mock-fk { font-size: 13px; font-weight: 700; color: #F2F3F5; }
  .mock-fv { font-size: 14px; margin-top: 2px !important; }
  .mock-dim { color: #B5BAC1; }
  .mock-link { color: #00A8FC; }
  .mock-img { margin-top: 12px; width: 100%; height: auto; border-radius: 4px; aspect-ratio: 16 / 8; object-fit: cover; }
  .mock-foot { margin-top: 10px !important; font-size: 12px; color: #B5BAC1; }
  .mock-btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .mb { height: 32px; display: inline-flex; align-items: center; padding: 0 14px; border-radius: 4px; background: #4E5058; color: var(--lr-discord-text); font-size: 14px; font-weight: 500; }
  .mb-g { background: #248046; }
  .mock figcaption { margin-top: 8px; font-size: 13px; color: var(--lr-muted); }

  .tiers-wrap { overflow-x: auto; border: 1px solid var(--lr-line-strong); border-radius: 8px; background: var(--lr-card); }
  .cmds { width: 100%; border-collapse: collapse; font-size: 15px; }
  .cmds th, .cmds td { padding: 12px 16px; border-top: 1px solid var(--lr-line); text-align: left; vertical-align: top; }
  .cmds thead th { border-top: 0; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-soft); }
  .cmds tbody th { white-space: nowrap; font-weight: 500; }
  .cmds code { font-size: 14px; padding: 2px 7px; border-radius: 4px; background: var(--lr-raised); color: var(--lr-text); }
  .cmds td { color: var(--lr-text); line-height: 1.5; }
  .cmds .who { color: var(--lr-soft); white-space: nowrap; font-size: 14px; }
  .perms { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .perms li { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: 8px; border: 1px solid var(--lr-line-strong); background: var(--lr-card); }
  .perms b { font-size: 16px; }
  .perms span { font-size: 15px; line-height: 1.5; color: var(--lr-soft); }

  .faq { padding-bottom: 64px; }
  .faq-list { border-top: 1px solid var(--lr-line); max-width: 880px; }
  .faq details { border-bottom: 1px solid var(--lr-line); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; padding: 16px 0; font-size: 17px; font-weight: 600; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--lr-orange); font-size: 22px; line-height: 1; }
  .faq details[open] summary::after { content: '–'; }
  .faq details p { margin: 0 0 18px; font-size: 16px; line-height: 1.65; color: var(--lr-text); max-width: 760px; }

  .dband { background: var(--lr-brand-gradient); }
  .dband-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding-top: 56px; padding-bottom: 56px; }
  .dband-copy { display: flex; flex-direction: column; gap: 8px; max-width: 720px; }
  .dband-title { margin: 0; }
  .dband-text { margin: 0; font-size: 15px; line-height: 1.5; color: var(--lr-text); }
  .dband-btn { background: var(--lr-discord-text); color: var(--lr-discord); flex: none; }
  .dband-btn:hover { background: var(--lr-discord-text); color: var(--lr-discord); }
  .dband-btn svg { width: 20px; height: 20px; fill: currentColor; flex: none; } /* white button, logo + text blurple (Fausto 20.10.) */
  :global(main:has(.dband) + .site-foot) { margin-top: 0; }

  @media (max-width: 1100px) {
    .db-inner { flex-direction: column; gap: 22px; }
    .glance { width: 100%; max-width: 560px; margin-top: 0; }
    .areas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lfg { grid-template-columns: 1fr; gap: 28px; }
    .mock { max-width: 520px; }
    .perms { grid-template-columns: 1fr; gap: 12px; }
  }
  @media (max-width: 760px) {
    .db-act .btn { width: 100%; }
    .gl-row { font-size: 14px; }
    .dsec { padding-top: 40px; }
    .areas { grid-template-columns: 1fr; gap: 12px; }
    .area { padding: 16px; }
    .mock-msg { padding: 12px; gap: 10px; }
    .mock-fields.three { grid-template-columns: 1fr 1fr; }
    /* commands as stacked rows */
    .cmds thead { display: none; }
    .cmds, .cmds tbody, .cmds tr, .cmds th, .cmds td { display: block; }
    .cmds tr { padding: 12px 14px; border-top: 1px solid var(--lr-line); }
    .cmds tr:first-child { border-top: 0; }
    .cmds th, .cmds td { padding: 0; border: 0; }
    .cmds td { margin-top: 6px; font-size: 14px; }
    .cmds .who { margin-top: 4px; font-size: 13px; }
    .faq summary { font-size: 16px; }
    .dband-inner { flex-direction: column; align-items: stretch; gap: 18px; padding-top: 36px; padding-bottom: 36px; }
    .dband-btn { width: 100%; justify-content: center; }
  }
</style>
