---
// New cars in GTA VI (Fausto 2026-10-08): officially revealed vehicles with no
// earlier GTA title of the same model name (vehicles.previous_games = '{}').
// noindex until the research covers most revealed cars (data/rankings.ts).
// Redesign 20.10.2026 (DEC-0147): same layout as class / manufacturer pages (GarageTaxonomy, kind "custom"),
// band photo Sirius (Fausto). COPY: About = Codex 2026-10-08 (approved 09.10.); band/glance labels = Codex 21.10.2026.
import GarageTaxonomy from '../../../components/GarageTaxonomy.astro';
import { classPages, classSlug, manufacturerPages } from '../../../data/garage-taxonomy';
import { newCars, newCarsIndexable, newCarsResearchCoverage } from '../../../data/rankings';
const base = import.meta.env.BASE_URL;
const list = newCars();
const coverage = newCarsResearchCoverage();
const pct = Math.round(coverage * 100);
const classes = [...new Set(list.flatMap((v) => v.classes))].sort();
const makes = [...new Map(list.map((v) => [v.logoSlug, v.make])).entries()].sort((a, b) => a[1].localeCompare(b[1]));
const page = { slug: 'new-cars', name: 'New cars', intro: [], copyStatus: 'approved' as const };
---
<GarageTaxonomy kind="custom" page={page} vehicles={list} label="New Cars" custom={{
  path: 'cars/new-cars/',
  crumbs: [{ name: 'Cars', href: `${base}cars/` }, { name: 'New cars' }],
  breadcrumbs: [{ name: 'Cars', path: 'cars/' }, { name: 'New Cars', path: 'cars/new-cars/' }],
  eyebrow: 'GTA VI',
  heading: 'New cars',
  lede: 'Revealed GTA VI cars with no identified counterpart in earlier GTA games or GTA Online, from new models to distinct variants of familiar families.',
  metaTitle: 'New Cars in GTA 6',
  metaDescription: 'Explore officially revealed GTA 6 cars with no identified earlier GTA model counterpart, including new models and distinct variants of familiar families.',
  noindex: !newCarsIndexable(),
  band: { id: 'dundreary-sirius', pos: '50% 50%' },
  glanceTitle: 'New cars at a glance',
  countLabel: 'New cars listed',
  glance: [
    { k: 'Manufacturers', v: String(makes.length) },
    { k: 'History reviewed', v: pct >= 100 ? 'All listed revealed cars' : `<span class="is-tba">${pct}% of listed revealed cars</span>` },
  ],
  about: { title: 'What counts as a new car', paras: [
    'Officially revealed GTA VI cars with no identified counterpart in an earlier GTA game, expansion or GTA Online. A familiar family name does not make every model a returning car. Confirmed renamings are treated as returning models.',
    ...(pct < 100 ? [`Earlier GTA appearances reviewed for ${pct}% of officially revealed vehicles. The remaining models are still being checked.`] : []),
  ] },
  links: [
    { title: 'New cars by class', items: classes.map((c) => ({ name: c, href: classPages.some((p) => p.slug === classSlug(c)) ? `${base}cars/classes/${classSlug(c)}/` : `${base}cars/`, count: list.filter((v) => v.classes.includes(c)).length })), all: { name: 'All classes', href: `${base}cars/classes/` } },
    { title: 'New cars by manufacturer', items: makes.map(([slug, name]) => ({ name, href: manufacturerPages.some((m) => m.slug === slug) ? `${base}cars/manufacturers/${slug}/` : `${base}cars/manufacturers/`, count: list.filter((v) => v.logoSlug === slug).length })), all: { name: 'All manufacturers', href: `${base}cars/manufacturers/` } },
  ],
  noun: 'new cars',
}} />
