---
import Base from '../../layouts/Base.astro';
import { vehicleOptions, garageOrderedVehicles } from '../../data/vehicles';
import { classPages, manufacturerPages } from '../../data/garage-taxonomy';
import LaunchStatus from '../../components/LaunchStatus.astro';
import VehicleTile from '../../components/VehicleTile.astro';

const base = import.meta.env.BASE_URL;


const classes = [...new Set(vehicleOptions.flatMap((v) => v.classes))].sort();
const makes = [...new Set(vehicleOptions.map((v) => v.make))].sort();
const drives = [...new Set(vehicleOptions.map((v) => v.drive))].sort();

---
<Base
  title="The Garage — GTA VI Vehicle Database"
  description="Browse the GTA 6 vehicle database. Compare cars, key vehicle details, real-life inspirations, release information, and available performance data."
  section="garage"
  breadcrumbs={[{ name: 'The Garage', path: 'cars/' }]}
>
  <section class="hero">
    <picture>
      <img src={`${base}images/garage/garage-hero-placeholder.webp`} srcset={`${base}images/garage/garage-hero-placeholder-640.webp 640w, ${base}images/garage/garage-hero-placeholder-1080.webp 1080w, ${base}images/garage/garage-hero-placeholder.webp 1672w`} sizes="100vw" alt="" width="1672" height="941" loading="eager" fetchpriority="high" />
    </picture>
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">GTA VI Vehicle Database</p>
        <h1 class="display hero-title">The Garage</h1>
        <p class="hero-lede">Find your next car in GTA VI. Check the specs, see how the cars stack up, and decide what deserves a place in your garage. Compare key vehicle details before you spend your money, and see the real-life inspiration behind each model. Keep track of the cars you own and organize your collection in one place.</p>
      </div>
      <LaunchStatus area="garage" />
    </div>
  </section>

  <div class="garage-tabs-bar">
    <div class="wrap">
      <div class="garage-tabs" role="tablist" aria-label="Garage sections">
        <button type="button" class="garage-tab is-active" data-tab="vehicles" role="tab" aria-selected="true">Vehicles</button>
        <button type="button" class="garage-tab" data-tab="compare" role="tab" aria-selected="false" id="compare">Compare</button>
      </div>
    </div>
  </div>

  <section class="wrap garage-body">
    <div class="garage-panel" data-panel="vehicles">
      <div class="garage-content-head">
        <p class="garage-count" id="garage-count" aria-live="polite">{vehicleOptions.length} vehicles</p>
        <button type="button" class="garage-compare-btn" id="garage-compare-btn">Compare selected (0)</button>
      </div>

      <div class="garage-controls">
        <label class="ui-search garage-search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="garage-search" placeholder="Search Vehicle" aria-label="Search vehicles" />
        </label>
        <select class="ui-select garage-filter" id="garage-class-filter" aria-label="Filter by GTA class">
          <option value="">All classes</option>
          {classes.map((c) => <option value={c}>{c}</option>)}
        </select>
        <select class="ui-select garage-filter" id="garage-make-filter" aria-label="Filter by manufacturer">
          <option value="">All manufacturers</option>
          {makes.map((m) => <option value={m}>{m}</option>)}
        </select>
        <select class="ui-select garage-filter" id="garage-drive-filter" aria-label="Filter by drivetrain">
          <option value="">All drivetrains</option>
          {drives.map((d) => <option value={d}>{d}</option>)}
        </select>
      </div>

      <section class="garage-grid" id="garage-grid" aria-label="Vehicle tiles">
        {garageOrderedVehicles.map((v) => (
          <VehicleTile vehicle={v} />
        ))}
      </section>
      <p class="garage-empty" id="garage-empty" hidden>No vehicles match that search.</p>

      <!-- Crawlable class + manufacturer pages (RS-0050, DEC-0087) -->
      <nav class="garage-browse" aria-label="Browse the garage">
        <div>
          <h2 class="garage-browse-title"><a href={`${base}cars/classes/`}>Browse by Class</a></h2>
          <ul>{classPages.map((c) => <li><a href={`${base}cars/classes/${c.slug}/`}>{c.name}</a></li>)}</ul>
        </div>
        <div>
          <h2 class="garage-browse-title"><a href={`${base}cars/manufacturers/`}>Browse by Manufacturer</a></h2>
          <ul>{manufacturerPages.map((m) => <li><a href={`${base}cars/manufacturers/${m.slug}/`}>{m.name}</a></li>)}</ul>
        </div>
      </nav>
    </div>

    <div class="garage-panel" data-panel="compare" hidden>
      <div class="panel compare-placeholder">
        <p class="eyebrow">Coming soon</p>
        <p id="compare-empty-note">Side-by-side comparison isn't built yet — once vehicle photos, prices and performance data start coming in, you'll be able to line vehicles up here. For now, open individual vehicles from the Vehicles tab.</p>
        <ul id="compare-selected-list" class="compare-selected-list" hidden></ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .garage-browse { display: grid; grid-template-columns: 1fr 2fr; gap: var(--gh-gap-card); margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--gh-line); }
  .garage-browse-title { font-family: var(--gh-font-display); font-weight: 900; text-transform: uppercase; font-size: .95rem; margin: 0 0 .8rem; }
  .garage-browse .garage-browse-title a { display: inline; padding: 0; border: none; border-radius: 0; color: var(--gh-text); font-size: inherit; }
  .garage-browse .garage-browse-title a:hover { color: var(--gh-yellow); }
  .garage-browse ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .45rem; }
  .garage-browse a { display: inline-block; padding: .4rem .75rem; border: 1px solid var(--gh-line); border-radius: 999px; color: var(--gh-muted); font-size: .78rem; font-weight: 700; text-decoration: none; }
  .garage-browse a:hover { color: var(--gh-text); border-color: var(--gh-muted); }
  @media (max-width: 760px) { .garage-browse { grid-template-columns: 1fr; } }
  .hero { position: relative; overflow: hidden; }
  .hero picture, .hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-veil { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(11,11,20,.97) 15%, rgba(11,11,20,.6) 60%, rgba(11,11,20,.85)); }
  /* Fixed hero height -- kept in sync, literally, with time-attack/gellhorn-international-raceway/index.astro's .hero-grid so the header band is identical on every page that has one. Not viewport-fluid (clamp/vw) on purpose. */
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.5fr 1fr; align-items: center; gap: 2rem; min-height: 21rem; padding-block: 2rem; }
  .hero-copy { max-width: 46rem; align-self: start; }
  .hero-title { font-size: 2.5rem; margin: .5rem 0 .8rem; }
  .hero-lede { color: var(--gh-muted); font-size: 1rem; margin: 0; max-width: 56ch; }
  .garage-body { padding-bottom: var(--gh-gap-section); }

  /* Same visual language as the Time Attack subnav's page tabs
     (.subnav-tab in TimeAttackSubnav.astro) -- kept in sync intentionally.
     The divider line lives on .garage-tabs-bar (full page width, like
     .subnav-bar in TimeAttackSubnav.astro) rather than on .garage-tabs
     (content width), so it matches the main nav's full-bleed line. */
  .garage-tabs-bar { border-bottom: 1px solid var(--gh-line); margin-bottom: 1.5rem; }
  .garage-tabs { display: flex; gap: .5rem; }
  .garage-tab { color: var(--gh-muted); background: none; text-decoration: none; font-family: var(--gh-font-body); font-weight: 600; text-transform: uppercase; font-size: .8rem; letter-spacing: .08em; padding: .7rem 1rem; border: none; border-top: 2px solid transparent; border-bottom: 2px solid transparent; cursor: pointer; }
  .garage-tab:hover { color: var(--gh-text); }
  .garage-tab.is-active { color: var(--gh-text); border-bottom-color: var(--gh-red); }

  .garage-content-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .garage-count { margin: 0; color: var(--gh-muted); font-size: .8rem; }
  .garage-compare-btn { background: transparent; border: 1px solid var(--gh-line); border-radius: var(--gh-radius); color: var(--gh-text); padding: .55rem 1rem; font-size: .8rem; font-weight: 700; cursor: pointer; }
  .garage-compare-btn:hover { border-color: var(--gh-muted); }
  .garage-compare-btn.has-selection { border-color: var(--gh-yellow); color: var(--gh-yellow); }

  .garage-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-bottom: 1.5rem; }
  /* Look comes from the site-wide .ui-search / .ui-select (tokens.css);
     only layout lives here. */
  .garage-search { flex: 0 1 18rem; min-width: 12rem; }

  .garage-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr)); gap: var(--gh-gap-card); }
  .garage-empty { color: var(--gh-muted); text-align: center; padding: 3rem 0; }
  .compare-placeholder { padding: var(--gh-pad-card); }
  .compare-placeholder p { color: var(--gh-muted); margin: .75rem 0 0; max-width: 52ch; }
  .compare-selected-list { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .4rem; }
  .compare-selected-list li { color: var(--gh-text); font-size: .85rem; font-weight: 600; }
@media (max-width: 860px) {
  .hero-grid { grid-template-columns: 1fr; min-height: 35rem; padding-block: 2.5rem; }
}
</style>

<script>
  import { getSelected } from '../../scripts/compare';
  import { initVehicleTiles } from '../../scripts/vehicle-tiles';

  const tabs = document.querySelectorAll<HTMLButtonElement>('.garage-tab');
  const panels = document.querySelectorAll<HTMLElement>('.garage-panel');
  function activateTab(tab: HTMLButtonElement) {
    tabs.forEach((t) => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
    panels.forEach((p) => { p.hidden = p.dataset.panel !== tab.dataset.tab; });
    tab.classList.add('is-active');
    tab.setAttribute('aria-selected', 'true');
  }
  tabs.forEach((tab) => tab.addEventListener('click', () => activateTab(tab)));

  const search = document.getElementById('garage-search') as HTMLInputElement;
  const classFilter = document.getElementById('garage-class-filter') as HTMLSelectElement;
  const makeFilter = document.getElementById('garage-make-filter') as HTMLSelectElement;
  const driveFilter = document.getElementById('garage-drive-filter') as HTMLSelectElement;
  const grid = document.getElementById('garage-grid') as HTMLElement;
  const tiles = Array.from(grid.querySelectorAll<HTMLElement>('.v-tile'));
  const count = document.getElementById('garage-count') as HTMLElement;
  const empty = document.getElementById('garage-empty') as HTMLElement;

  function applyFilter() {
    const q = search.value.trim().toLowerCase();
    const cls = classFilter.value;
    const make = makeFilter.value;
    const drive = driveFilter.value;
    let visible = 0;
    tiles.forEach((tile) => {
      const matchesSearch = !q || (tile.dataset.search ?? '').includes(q);
      const matchesClass = !cls || (tile.dataset.classes ?? '').split('|').includes(cls);
      const matchesMake = !make || tile.dataset.make === make;
      const matchesDrive = !drive || tile.dataset.drive === drive;
      const show = matchesSearch && matchesClass && matchesMake && matchesDrive;
      tile.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    count.textContent = `${visible} vehicle${visible === 1 ? '' : 's'}`;
    empty.hidden = visible !== 0;
  }

  search.addEventListener('input', applyFilter);
  classFilter.addEventListener('change', applyFilter);
  makeFilter.addEventListener('change', applyFilter);
  driveFilter.addEventListener('change', applyFilter);

  // Header search (Redesign Phase 1) submits to /cars/?q=… -> prefill + filter.
  const initialQ = new URLSearchParams(window.location.search).get('q');
  if (initialQ) {
    search.value = initialQ;
    applyFilter();
    search.scrollIntoView({ block: 'center' });
  }

  // Compare selection: persisted in localStorage (src/scripts/compare.ts) so
  // marking a vehicle here or on its own detail page stays in sync across
  // page loads. No comparison view exists yet (see the Compare tab
  // placeholder) -- this just tracks which vehicles were marked, so the "+"
  // buttons and "Compare selected" count aren't decorative dead ends.
  const compareBtn = document.getElementById('garage-compare-btn') as HTMLButtonElement;
  const compareList = document.getElementById('compare-selected-list') as HTMLUListElement;
  const compareEmptyNote = document.getElementById('compare-empty-note') as HTMLElement;

  function updateCompareUI() {
    const selected = getSelected();
    compareBtn.textContent = `Compare selected (${selected.length})`;
    compareBtn.classList.toggle('has-selection', selected.length > 0);
    compareList.innerHTML = '';
    if (selected.length > 0) {
      selected.forEach((id) => {
        const tile = grid.querySelector<HTMLElement>(`.v-tile[data-id="${id}"]`);
        const name = tile?.querySelector('.v-name strong')?.textContent ?? id;
        const li = document.createElement('li');
        li.textContent = name;
        compareList.appendChild(li);
      });
      compareList.hidden = false;
      compareEmptyNote.textContent = "Detailed side-by-side comparison isn't built yet, but here's what you've marked so far:";
    } else {
      compareList.hidden = true;
      compareEmptyNote.textContent = "Side-by-side comparison isn't built yet — once vehicle photos, prices and performance data start coming in, you'll be able to line vehicles up here. For now, open individual vehicles from the Vehicles tab.";
    }
  }

  initVehicleTiles(grid, updateCompareUI);

  updateCompareUI();

  compareBtn.addEventListener('click', () => {
    const compareTab = document.getElementById('compare') as HTMLButtonElement;
    activateTab(compareTab);
  });

  if (location.hash === '#compare') {
    activateTab(document.getElementById('compare') as HTMLButtonElement);
  }
  // Header menu "Compare" while already on this page: only the hash changes.
  window.addEventListener('hashchange', () => {
    if (location.hash === '#compare') activateTab(document.getElementById('compare') as HTMLButtonElement);
  });
</script>

