---
// Cars — Redesign Phase 4 (DEC-0117). Image band + My Garage tile; the list itself
// is components/CarsBrowser.astro (shared with class and manufacturer pages, DEC-0130).
// COPY STATUS: all new texts are Claude placeholders from the mockup -> Codex (DEC-0088).
import Base from '../../layouts/Base.astro';
import CarsBrowser from '../../components/CarsBrowser.astro';
import '../../styles/garage-tile.css';
import { vehicleOptions } from '../../data/vehicles';
import { classPages, manufacturerPages } from '../../data/garage-taxonomy';

const base = import.meta.env.BASE_URL;
const N = vehicleOptions.length;
---
<Base
  title="GTA VI Cars — Car List & Vehicle Database"
  description="Browse the GTA 6 car list: classes, manufacturers, real-life inspirations, prices, top speeds and Gellhorn lap times. Compare cars and track the ones you own."
  section="garage"
  breadcrumbs={[{ name: 'Cars', path: 'cars/' }]}
>
  <!-- ===== Image band (motif: Car Meet 3, DEC-0117) ===== -->
  <section class="band">
    <img class="band-bg" src={`${base}images/garage/cars-band-1280.webp`} srcset={`${base}images/garage/cars-band-640.webp 640w, ${base}images/garage/cars-band-1280.webp 1280w, ${base}images/garage/cars-band-1920.webp 1920w`} sizes="100vw" alt="" width="1920" height="1072" fetchpriority="high" />
    <span class="lr-shade is-open" aria-hidden="true"></span>
    <div class="wrap band-inner lr-band-in is-compact">
      <div class="band-copy">
        <nav class="lr-crumb" aria-label="Breadcrumb"><a href={base}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Cars</span></nav>
        <p class="eyebrow">GTA VI Vehicle Database</p>
        <h1 class="display lr-t2">Cars</h1>
        <p class="lr-lede">Specs, real-life inspirations and Gellhorn times for GTA VI cars. Compare them side by side and track the ones you own.</p>
      </div>
      <a class="garage-tile lr-hcard" id="garage-tile" href={`${base}account/`}>
        <span class="gt-top"><span class="gt-eb">My Garage</span><span class="arrow gt-cta" id="gt-cta">Log in to start →</span></span>
        <span class="gt-val"><span id="gt-owned">0</span> <small>/ {N} owned</small></span>
        <span class="mbar"><i id="gt-bar" style="width:0%"></i></span>
      </a>
    </div>
  </section>

  <CarsBrowser>
    <Fragment slot="after-grid">
  <!-- Crawlable class + manufacturer pages (RS-0050, DEC-0087) -->
  <section class="wrap browse">
    <div>
      <h3><a href={`${base}cars/classes/`}>Browse by class</a></h3>
      <div class="ls">{classPages.map((c) => <a href={`${base}cars/classes/${c.slug}/`}>{c.name}</a>)}</div>
    </div>
    <div>
      <h3><a href={`${base}cars/manufacturers/`}>Browse by manufacturer</a></h3>
      <div class="ls">{manufacturerPages.map((m) => <a href={`${base}cars/manufacturers/${m.slug}/`}>{m.name}</a>)}</div>
    </div>
  </section>

    </Fragment>
  </CarsBrowser>
</Base>

<style>
  /* ---- band ---- */
  .band { position: relative; overflow: hidden; border-bottom: 1px solid var(--lr-line); }
  .band-bg, .band-t { position: absolute; inset: 0; width: 100%; height: 100%; }
  .band-bg { object-fit: cover; object-position: 50% 88%; }
  .band-inner { display: flex; align-items: flex-start; justify-content: space-between; gap: 40px; }
  /* Tile sits on the lower edge of the photo band (Fausto 22.10.2026, DEC-0154): text top, tile bottom. */
  @media (min-width: 761px) { .band-inner > .garage-tile { align-self: flex-end; } }
  .band-copy { min-width: 0; }
  /* garage tile: styles/garage-tile.css */

  /* ---- browse lists ---- */
  .browse { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding-top: 40px; padding-bottom: 24px; border-top: 1px solid var(--lr-line); margin-top: calc(var(--lr-gap-sec) - 24px); }
  .browse h3 { margin: 0 0 12px; font-size: var(--lr-h3-xs); font-weight: 700; }
  .browse h3 a { color: var(--lr-text); text-decoration: none; }
  .browse h3 a:hover { color: var(--lr-orange); }
  .ls { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; }
  .ls a { color: var(--lr-muted); text-decoration: none; }
  .ls a:hover { color: var(--lr-orange); }

  @media (max-width: 760px) {
    .band-inner { flex-direction: column; align-items: stretch; gap: 16px; }
    .browse { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
