---
// Cars — Redesign Phase 4 (DEC-0117). Image band + My Garage tile; the list itself
// is components/CarsBrowser.astro (shared with class and manufacturer pages, DEC-0130).
// COPY STATUS: all new texts are Claude placeholders from the mockup -> Codex (DEC-0088).
import Base from '../../layouts/Base.astro';
import CarsBrowser from '../../components/CarsBrowser.astro';
import { vehicleOptions } from '../../data/vehicles';
import { classPages, manufacturerPages } from '../../data/garage-taxonomy';

const base = import.meta.env.BASE_URL;
const N = vehicleOptions.length;
---
<Base
  title="GTA VI Cars — Vehicle Database"
  description="Browse every GTA 6 car: classes, manufacturers, real-life inspirations, prices, top speeds and Gellhorn lap times. Compare cars and track the ones you own."
  section="garage"
  breadcrumbs={[{ name: 'Cars', path: 'cars/' }]}
>
  <!-- ===== Image band (motif: Car Meet 3, DEC-0117) ===== -->
  <section class="band">
    <img class="band-bg" src={`${base}images/garage/cars-band-1280.webp`} srcset={`${base}images/garage/cars-band-640.webp 640w, ${base}images/garage/cars-band-1280.webp 1280w, ${base}images/garage/cars-band-1920.webp 1920w`} sizes="100vw" alt="" width="1920" height="1072" fetchpriority="high" />
    <span class="band-t band-t1" aria-hidden="true"></span><span class="band-t band-t2" aria-hidden="true"></span><span class="band-t band-t3" aria-hidden="true"></span><span class="band-t band-t4" aria-hidden="true"></span>
    <div class="wrap band-inner lr-band-in is-compact">
      <div class="band-copy">
        <p class="eyebrow">GTA VI Vehicle Database</p>
        <h1 class="display lr-t2">Cars</h1>
        <p class="lr-lede">Specs, real-life inspirations and Gellhorn times for every car in GTA VI. Compare them side by side and track the ones you own.</p>
      </div>
      <a class="garage-tile" id="garage-tile" href={`${base}account/garage/`}>
        <span class="gt-top"><span class="gt-eb">My Garage</span><span class="arrow gt-cta" id="gt-cta">Log in to start →</span></span>
        <span class="gt-val"><span id="gt-owned">0</span> <small>/ {N} owned</small></span>
        <span class="mbar"><i id="gt-bar" style="width:0%"></i></span>
      </a>
    </div>
  </section>

  <CarsBrowser>
    <Fragment slot="after-grid">
  <!-- Crawlable class + manufacturer pages (RS-0050, DEC-0087) -->
  <section class="wrap browse">
    <div>
      <h2><a href={`${base}cars/classes/`}>Browse by class</a></h2>
      <div class="ls">{classPages.map((c) => <a href={`${base}cars/classes/${c.slug}/`}>{c.name}</a>)}</div>
    </div>
    <div>
      <h2><a href={`${base}cars/manufacturers/`}>Browse by manufacturer</a></h2>
      <div class="ls">{manufacturerPages.map((m) => <a href={`${base}cars/manufacturers/${m.slug}/`}>{m.name}</a>)}</div>
    </div>
  </section>

    </Fragment>
  </CarsBrowser>
</Base>

<style>
  /* ---- band ---- */
  .band { position: relative; overflow: hidden; border-bottom: 1px solid rgba(200,200,222,.22); }
  .band-bg, .band-t { position: absolute; inset: 0; width: 100%; height: 100%; }
  .band-bg { object-fit: cover; object-position: 50% 55%; }
  .band-t1 { background: linear-gradient(115deg, rgba(242,75,157,.75) 0%, rgba(242,75,157,.2) 42%, rgba(255,122,61,.2) 58%, rgba(255,122,61,.75) 100%); mix-blend-mode: color; }
  .band-t2 { background: linear-gradient(115deg, rgba(242,75,157,.22) 0%, rgba(242,75,157,0) 42%, rgba(255,122,61,0) 58%, rgba(255,122,61,.22) 100%); }
  .band-t3 { background: linear-gradient(90deg, rgba(11,11,20,.9) 0%, rgba(11,11,20,.65) 45%, rgba(11,11,20,.25) 100%); }
  .band-t4 { background: linear-gradient(180deg, rgba(11,11,20,.1) 0%, rgba(11,11,20,.7) 100%); }
  .band-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; }
  .band-copy { min-width: 0; }
  .garage-tile { flex: none; display: flex; flex-direction: column; gap: 8px; min-width: 260px; padding: 14px 16px; border: 1px solid rgba(200,200,222,.18); border-radius: 8px; background: rgba(20,20,31,.88); backdrop-filter: blur(6px); color: var(--lr-text); text-decoration: none; transition: border-color .15s; }
  .garage-tile:hover { border-color: var(--lr-orange); }
  .gt-top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .gt-eb { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-orange); }
  .gt-cta { font-size: 13px; }
  .gt-val { font-family: var(--gh-font-display); font-weight: 800; font-size: 24px; text-transform: uppercase; font-variant-numeric: tabular-nums; }
  .gt-val small { color: var(--lr-muted); font-size: 15px; }
  .mbar { display: block; height: 4px; border-radius: 999px; background: rgba(251,247,234,.1); overflow: hidden; }
  .mbar i { display: block; height: 100%; background: var(--lr-orange); border-radius: 999px; }

  /* ---- browse lists ---- */
  .browse { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding-top: 40px; padding-bottom: 24px; border-top: 1px solid var(--lr-line); margin-top: 32px; }
  .browse h2 { margin: 0 0 12px; font-size: 16px; font-weight: 700; }
  .browse h2 a { color: var(--lr-text); text-decoration: none; }
  .browse h2 a:hover { color: var(--lr-orange); }
  .ls { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; }
  .ls a { color: var(--lr-muted); text-decoration: none; }
  .ls a:hover { color: var(--lr-orange); }

  @media (max-width: 760px) {
    .band-inner { flex-direction: column; align-items: stretch; gap: 16px; }
    .garage-tile { min-width: 0; flex-direction: row; align-items: center; flex-wrap: wrap; gap: 6px 12px; padding: 10px 12px; }
    .gt-top { order: 1; flex: 1; }
    .gt-val { order: 0; font-size: 18px; }
    .gt-val small { font-size: 13px; }
    .mbar { order: 2; flex-basis: 100%; }
    .browse { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
