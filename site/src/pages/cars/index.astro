---
// Cars — Redesign Phase 4 (DEC-0117). Image band + My Garage tile; the list itself
// is components/CarsBrowser.astro (shared with class and manufacturer pages, DEC-0130).
// COPY STATUS: all new texts are Claude placeholders from the mockup -> Codex (DEC-0088).
import Base from '../../layouts/Base.astro';
import CarsBrowser from '../../components/CarsBrowser.astro';
import '../../styles/garage-tile.css';
import { vehicleOptions, vehicleValues, COST_METRIC } from '../../data/vehicles';
import { classPages, manufacturerPages } from '../../data/garage-taxonomy';

const base = import.meta.env.BASE_URL;
const N = vehicleOptions.length;

// ---- FAQ (Fausto 23.11.2026, DEC-0252): the big questions about cars in GTA VI, short answers with links.
// The cost range comes from the data (no numbers typed into the text). COPY: Claude placeholders -> Codex.
const costs = vehicleOptions.filter((v) => v.releaseId).map((v) => ({ v, c: vehicleValues[v.id]?.[COST_METRIC]?.value })).filter((x): x is { v: typeof x.v; c: number } => x.c != null).sort((a, b) => a.c - b.c);
const usd = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
const faqs: { q: string; a: string; link?: [string, string] }[] = [
  { q: 'Can you buy cars in GTA VI?', a: 'No. GTA VI has no car dealers. You steal a car and pay to register it if you want to keep it.', link: [`${base}guide/#theft`, 'Stealing and registering cars'] },
  { q: 'How do you keep a car in GTA VI?', a: 'Register it. From Chapter 2, Moses registers cars without a tracker; from Chapter 3, Pay ’n’ Spray also takes cars with a standard tracker. A stolen car you don’t register is gone when the game restarts.', link: [`${base}guide/#theft`, 'How registering works'] },
  ...(costs.length >= 2 ? [{ q: 'How much does it cost to register a car in GTA VI?', a: `It depends on the model. Among the ${costs.length} cars we have scanned, it runs from ${usd(costs[0].c)} for the ${costs[0].v.make} ${costs[0].v.model} to ${usd(costs[costs.length - 1].c)} for the ${costs[costs.length - 1].v.make} ${costs[costs.length - 1].v.model}.`, link: [`${base}cars/rankings/most-expensive/`, 'Most expensive cars'] as [string, string] }] : []),
  { q: 'How many cars can you own in GTA VI?', a: 'Up to 18 in the standard game: 16 garage spaces plus Jason’s and Lucia’s personal vehicles. The pre-order bonus, the Ultimate Edition and GTA+ each add one more space, for up to 21.', link: [`${base}guide/#garages`, 'All garages'] },
  { q: 'Where does Leonida Racing get its car data?', a: 'We read every value ourselves in the game, on a PS5 with the current game version, and keep its source and date.', link: [`${base}cars/how-we-measure/`, 'How we measure'] },
];
const faqLd = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<Base
  title="GTA VI Cars — Car List & Vehicle Database"
  description="Browse the GTA 6 car list: classes, manufacturers, real-life inspirations, top speeds, lap times and costs to register. Compare cars and track your own."
  section="garage"
  breadcrumbs={[{ name: 'Cars', path: 'cars/' }]}
  jsonLd={faqLd}
>
  <!-- ===== Image band (motif: Car Meet 3, DEC-0117) ===== -->
  <section class="band">
    <img class="band-bg" src={`${base}images/garage/cars-band-1280.webp`} srcset={`${base}images/garage/cars-band-640.webp 640w, ${base}images/garage/cars-band-1280.webp 1280w, ${base}images/garage/cars-band-1920.webp 1920w`} sizes="100vw" alt="" width="1920" height="1072" fetchpriority="high" />
    <span class="lr-shade is-open" aria-hidden="true"></span>
    <div class="wrap band-inner lr-band-in is-compact">
      <div class="band-copy">
        <nav class="lr-crumb" aria-label="Breadcrumb"><a href={base}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Cars</span></nav>
        <p class="eyebrow">GTA VI Vehicle Database</p>
        <h1 class="display lr-t2">Cars</h1>
        <p class="lr-lede">Specs, real-life inspirations and Gellhorn times for GTA VI cars. Compare them side by side and track the ones you own.</p>
      </div>
      <a class="garage-tile lr-hcard" id="garage-tile" href={`${base}account/`}>
        <span class="gt-top"><span class="gt-eb">My garage</span><span class="arrow gt-cta" id="gt-cta">Log in to start →</span></span>
        <span class="gt-val"><span id="gt-owned">0</span> <small>/ {N} owned</small></span>
        <span class="mbar"><i id="gt-bar" style="width:0%"></i></span>
      </a>
    </div>
  </section>

  <CarsBrowser>
    <Fragment slot="after-grid">
  <!-- Crawlable class + manufacturer pages (RS-0050, DEC-0087) -->
  <section class="wrap browse">
    <div>
      <h3><a href={`${base}cars/classes/`}>Browse by class</a></h3>
      <div class="ls">{classPages.map((c) => <a href={`${base}cars/classes/${c.slug}/`}>{c.name}</a>)}</div>
    </div>
    <div>
      <h3><a href={`${base}cars/manufacturers/`}>Browse by manufacturer</a></h3>
      <div class="ls">{manufacturerPages.map((m) => <a href={`${base}cars/manufacturers/${m.slug}/`}>{m.name}</a>)}</div>
    </div>
  </section>

    </Fragment>
  </CarsBrowser>

  <!-- ---- FAQ (DEC-0252): last block, compact ---- -->
  <section class="wrap cfaq" id="faq">
    <p class="eyebrow">FAQ</p>
    <h2 class="lr-h2 display cfaq-t">GTA VI cars FAQ</h2>
    <div class="cfaq-list">
      {faqs.map((f) => (
        <details class="cfaq-i">
          <summary>{f.q}</summary>
          <p>{f.a}{f.link && <>{' '}<a href={f.link[0]}>{f.link[1]}&nbsp;→</a></>}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  /* ---- band ---- */
  .band { position: relative; overflow: hidden; border-bottom: 1px solid var(--lr-line); }
  .band-bg, .band-t { position: absolute; inset: 0; width: 100%; height: 100%; }
  .band-bg { object-fit: cover; object-position: 50% 88%; }
  .band-inner { display: flex; align-items: flex-start; justify-content: space-between; gap: 40px; }
  /* Tile sits on the lower edge of the photo band (Fausto 22.10.2026, DEC-0154): text top, tile bottom. */
  @media (min-width: 761px) { .band-inner > .garage-tile { align-self: flex-end; } }
  .band-copy { min-width: 0; }
  /* garage tile: styles/garage-tile.css */

  /* ---- FAQ (DEC-0252) ---- */
  .cfaq { padding-top: var(--lr-gap-sec); padding-bottom: 8px; }
  .cfaq-t { margin: 8px 0 16px; }
  .cfaq-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 28px; }
  .cfaq-i { border-top: 1px solid var(--lr-line); }
  .cfaq-i summary { display: flex; justify-content: space-between; gap: 12px; padding: 10px 2px; font-size: 15px; font-weight: 600; color: var(--lr-text); cursor: pointer; list-style: none; }
  .cfaq-i summary::-webkit-details-marker { display: none; }
  .cfaq-i summary::after { content: '+'; color: var(--lr-muted); font-weight: 400; }
  .cfaq-i[open] summary::after { content: '–'; }
  .cfaq-i p { margin: 0 2px 12px; font-size: 15px; line-height: 1.5; color: var(--lr-soft); }
  .cfaq-i a { color: var(--lr-orange); text-decoration: none; font-weight: 600; white-space: nowrap; }
  .cfaq-i a:hover { color: var(--lr-pink); }
  @media (max-width: 760px) { .cfaq-list { grid-template-columns: 1fr; } }

  /* ---- browse lists ---- */
  .browse { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding-top: 40px; padding-bottom: 24px; border-top: 1px solid var(--lr-line); margin-top: calc(var(--lr-gap-sec) - 24px); }
  .browse h3 { margin: 0 0 12px; font-size: var(--lr-h3-xs); font-weight: 700; }
  .browse h3 a { color: var(--lr-text); text-decoration: none; }
  .browse h3 a:hover { color: var(--lr-orange); }
  .ls { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; }
  .ls a { color: var(--lr-muted); text-decoration: none; }
  .ls a:hover { color: var(--lr-orange); }

  @media (max-width: 760px) {
    .band-inner { flex-direction: column; align-items: stretch; gap: 16px; }
    .browse { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
