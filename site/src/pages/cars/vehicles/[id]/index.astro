---
// Vehicle page (Redesign phase 5, DEC-0118; mockup boards Vehicle / VehicleActive /
// VehicleStart / VehicleMobile*). Built for the state after launch: missing values
// sit as placeholders in their final place.
// COPY STATUS: all new labels, status lines and the #1 tile are Claude placeholders
// from the mockup -> Codex review (DEC-0088). About texts: data/vehicle-copy.ts (Codex).
import Base from '../../../../layouts/Base.astro';
import CarCard from '../../../../components/CarCard.astro';
import { MAKES_WITHOUT_LOGO, vehicleOptions, vehicleValues, compareGarageOrder, familyMembers, familyName, FAMILY_PAGE_MIN, fastestGellhornLapMs } from '../../../../data/vehicles';
import { groupedTitles } from '../../../../data/gta-titles';
import { vehicleCopy } from '../../../../data/vehicle-copy';
import { vehicleSources } from '../../../../data/vehicle-sources';
import { vehicleSeeAlso } from '../../../../data/vehicle-see-also';
import { releaseById, formatReleaseDate } from '../../../../data/releases';
import { classHref, makeHref, classSlug, vehiclesByMake } from '../../../../data/garage-taxonomy';
import { vehiclePhotoAlt } from '../../../../data/vehicle-photo-alt';
import { sampleEntries, vehicleRows, lapTime } from '../../../../data/leaderboard';
import { driverRowHtml, openRowHtml, startTileHtml, classRowsHtml, sampleClassRows, rivalsFromClass, rivalHtml, GELLHORN_ROWS, type ClassRow } from '../../../../data/vehicle-page';

export function getStaticPaths() {
  return vehicleOptions.map((v) => ({ params: { id: v.id }, props: { vehicle: v } }));
}

const { vehicle } = Astro.props;
const base = import.meta.env.BASE_URL;
const copy = vehicleCopy[vehicle.id];
const sources = vehicleSources[vehicle.id] ?? [];
const seeAlso = vehicleSeeAlso[vehicle.id];
const cls = vehicle.classes[0];
const fullName = `${vehicle.make} ${vehicle.model}`;
const photoAlt = vehiclePhotoAlt[vehicle.id] ?? `${fullName} in GTA VI`;

// SEO metadata: approved Codex copy (2026-10-01), unchanged by the redesign.
const metaTitle = `${fullName} — GTA VI Car Specs & Performance`;
const metaDescription = `Explore the ${fullName} in GTA 6, including key vehicle details, release information, real-life inspiration, and available performance data.`;
// WebPage + main photo for Google (thumbnail in search results prefers the marked primary image), 25.10.
const pageUrlAbs = new URL(`${import.meta.env.BASE_URL}cars/vehicles/${vehicle.id}/`, Astro.site).href;
const vehicleJsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${fullName} in GTA 6`,
  url: pageUrlAbs,
  description: metaDescription,
  about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI', alternateName: ['GTA VI', 'GTA 6'] },
  ...(vehicle.photo ? { primaryImageOfPage: { '@type': 'ImageObject', url: new URL(`${import.meta.env.BASE_URL}images/vehicles/${vehicle.id}-1920.webp`, Astro.site).href, width: 1920, height: 1080, caption: photoAlt } } : {}),
}];

const acqLabels: Record<string, string> = { 'pre-order': 'Pre-Order bonus', 'ultimate-edition': 'Ultimate Edition', 'gta-plus': 'GTA+' };
const acqNotes: Record<string, string> = { 'pre-order': 'Pre-order bonus', 'ultimate-edition': 'Ultimate Edition exclusive', 'gta-plus': 'GTA+ members only' };
const acq = vehicle.acquisition ? acqLabels[vehicle.acquisition] : null;

const release = vehicle.releaseId ? releaseById[vehicle.releaseId] : undefined;
const releaseDate = release?.date ? formatReleaseDate(release.date) : 'TBA';
const releaseText = release ? `${release.name} · ${releaseDate}` : 'Not announced';

const classLink = classHref(cls);
const makeLink = makeHref(vehicle);
const makeCars = vehiclesByMake(vehicle.logoSlug).filter((v) => v.releaseId || v.id === vehicle.id);
const classCars = vehicleOptions.filter((v) => v.classes.some((c) => classSlug(c) === classSlug(cls)));

// ---- values -----------------------------------------------------------------
const vals = vehicleValues[vehicle.id] ?? {};
const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
const price = vals.price_gtad?.value ?? null;
const speed = vals.top_speed_mph?.value ?? null;
const sell = vals.sell_price_gtad?.value ?? null;
const speedRank = speed == null ? null : 1 + classCars.filter((v) => (vehicleValues[v.id]?.top_speed_mph?.value ?? -1) > speed).length;

// Real Gellhorn laps known at build time (empty before launch); the browser refreshes them.
const realBest = (id: string) => fastestGellhornLapMs(id);
const myLap = realBest(vehicle.id);
const lapRank = myLap == null ? null : 1 + classCars.filter((v) => { const t = realBest(v.id); return t != null && t < myLap; }).length;
const haveRealLaps = vehicleOptions.some((v) => realBest(v.id) != null);

// ---- Gellhorn section: sample until the first real lap (like Home, DEC-0116) ----
const sample = !haveRealLaps;
const submitHref = `${base}time-attack/submit/`;
const lbHref = `${base}time-attack/gellhorn-international-raceway/?vehicle=${encodeURIComponent(vehicle.id)}#leaderboard`;
// SEO (Fausto 27.10.2026): the HTML only carries real data. Sample rows travel in data-sample attributes
// and are painted by scripts/vehicle.ts, so crawlers never index fictional drivers or times.
const driverRows: unknown[] = [];
const driversHtml = startTileHtml(vehicle.model, submitHref);
const sampleDriverRows = sample ? vehicleRows(sampleEntries, vehicle.id, false).slice(0, GELLHORN_ROWS) : [];
const sampleDriversHtml = sampleDriverRows.length ? sampleDriverRows.map(({ e, rank }) => driverRowHtml({ rank, driver: e.driver, ms: e.lap_time_ms })).join('') + openRowHtml() : '';
const sampleClass: ClassRow[] = sample ? sampleClassRows(sampleEntries, classCars.map((v) => v.id)) : [];
const classRows: ClassRow[] = classCars.map((v) => ({ id: v.id, ms: realBest(v.id) }));
// "See all": the class leaderboard at Gellhorn (class filter, Fausto 17.10.)
const classMoreHref = `${base}time-attack/gellhorn-international-raceway/?class=${encodeURIComponent(cls)}#leaderboard`;
const classHtml = classRowsHtml(classRows, vehicle.id, classMoreHref);
const classTimed = classRows.filter((r) => r.ms != null).length;
const csubFor = (timed: number) => timed < classCars.length ? `${timed} of ${classCars.length} cars have a lap · tap a car to open it` : `Best lap per car · tap a car to open it`;
const sampleClassHtml = sample ? classRowsHtml(sampleClass, vehicle.id, classMoreHref) : '';
const sampleCsub = sample ? csubFor(sampleClass.filter((r) => r.ms != null).length) : '';

// ---- Similar cars (Fausto 2026-10-06 scoring) + compare tile ----------------
const family = vehicle.family ? familyMembers(vehicle.family).filter((v) => v.id !== vehicle.id && v.releaseId).sort(compareGarageOrder) : [];
const familyLabel = vehicle.family ? familyName(vehicle.family) : '';
const familyPage = vehicle.family && familyMembers(vehicle.family).filter((v) => v.releaseId).length >= FAMILY_PAGE_MIN ? `${base}cars/families/${vehicle.family}/` : null;
const similarAll = vehicleOptions
  .filter((v) => v.id !== vehicle.id && v.releaseId && v.classes.some((c) => vehicle.classes.includes(c)))
  .map((v) => ({ v, score: (v.classes[0] === cls ? 4 : 0) + (v.drive === vehicle.drive ? 2 : 0) + (v.seats === vehicle.seats ? 1 : 0) }))
  .sort((a, b) => b.score - a.score || compareGarageOrder(a.v, b.v))
  .map((x) => x.v);
const similar = similarAll.slice(0, 3);
const lapFor = (id: string) => { const t = realBest(id); return t == null ? null : { rank: 1 + classCars.filter((v) => { const o = realBest(v.id); return o != null && o < t; }).length, ms: t }; };
const rivalsLap = rivalsFromClass(classRows, vehicle.id);
const rivalsSimilar = (similarAll.length > 3 ? similarAll.slice(3, 5) : similarAll.slice(0, 2)).map((v) => ({ id: v.id, note: `${v.classes[0]} · ${v.drive}` }));
const rivals = rivalsLap ?? rivalsSimilar;
const rivalsSub = rivalsLap ? 'Its closest rivals at Gellhorn' : 'Most similar cars until it has a lap';
const rivalsHtml = rivals.map((r) => rivalHtml(r.id, r.note, vehicle.id)).join('');
const sampleRivals = sample ? rivalsFromClass(sampleClass, vehicle.id) : null;
const sampleRivalsHtml = sampleRivals ? sampleRivals.map((r) => rivalHtml(r.id, r.note, vehicle.id)).join('') : '';

// ---- photo ----------------------------------------------------------------
const photo = vehicle.photo ? `${base}images/vehicles/${vehicle.id}` : null;
const logo = `${base}images/logos/${vehicle.logoSlug}-gta-6-logo.svg`;

const ico = {
  plus: '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>',
  check: '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>',
  house: '<svg class="ico vh-g-house" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V9l9-6 9 6v12M7 21v-7h10v7"/></svg>',
  houseCheck: '<svg class="ico vh-g-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V9l9-6 9 6v12"/><path d="M8.5 14.5l2.5 2.5 4.5-5"/></svg>',
  heart: '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>',
  timer: '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg>',
};
const star = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.3L14.38 9.62L22.08 9.62L15.85 14.15L18.23 21.48L12 16.95L5.77 21.48L8.15 14.15L1.92 9.62L9.62 9.62Z"/></svg>';
const starsHtml = [1, 2, 3, 4, 5].map((n) => '<button type="button" class="vr-star" data-star="' + n + '" aria-label="' + n + (n === 1 ? ' star' : ' stars') + '">' + star + '</button>').join('');
const others = makeCars.filter((v) => v.id !== vehicle.id).sort(compareGarageOrder);
---
<Base
  title={metaTitle}
  brandSuffix={false}
  description={metaDescription}
  section="garage"
  noindex={!vehicle.releaseId}
  jsonLd={vehicleJsonLd}
  ogImage={vehicle.photo ? `images/vehicles/${vehicle.id}-1280.webp` : undefined}
  ogImageAlt={vehicle.photo ? photoAlt : undefined}
  ogImageWidth={vehicle.photo ? 1280 : undefined}
  ogImageHeight={vehicle.photo ? 720 : undefined}
  breadcrumbs={[{ name: 'Cars', path: 'cars/' }, ...(classLink ? [{ name: cls, path: classLink }] : []), { name: fullName, path: `cars/vehicles/${vehicle.id}/` }]}
>
  <div class="vp" id="vp" data-id={vehicle.id} data-model={vehicle.model} data-class={cls} data-class-ids={classCars.map((v) => v.id).join(' ')} data-rateable={vehicle.releaseId ? '1' : ''}>
    <!-- ---- head ---- -->
    <section class="wrap vh">
      <nav class="vh-crumbs" aria-label="Breadcrumb">
        <a href={`${base}cars/`}>Cars</a><span aria-hidden="true">/</span>
        {classLink ? <a href={`${base}${classLink}`}>{cls}</a> : <span>{cls}</span>}<span aria-hidden="true">/</span>
        {makeLink ? <a href={`${base}${makeLink}`}>{vehicle.make}</a> : <span>{vehicle.make}</span>}<span aria-hidden="true">/</span>
        <span aria-current="page">{vehicle.model}</span>
      </nav>
      <div class="vh-grid">
        <div class="vh-id">
          <div class="vh-make">
            {!MAKES_WITHOUT_LOGO.has(vehicle.logoSlug) && <img src={logo} alt="" width="22" height="22" />}
            <span class="vh-make-n">{vehicle.make}</span>
            {makeLink && <><span class="vh-dot" aria-hidden="true">·</span><a class="vh-all" href={`${base}${makeLink}`}>All {makeCars.length} {vehicle.make} cars →</a></>}
          </div>
          <h1 class="vh-h1 display"><span class="sr-only">{vehicle.make} </span>{vehicle.model}</h1>
          <div class="vh-meta">
            {classLink ? <a class="vh-pill" href={`${base}${classLink}`}>{cls}</a> : <span class="vh-pill">{cls}</span>}
            {acq && <span class="vh-pill vh-pill-acq">{acq}</span>}
            {vehicle.realLifeInspiration && <span class="vh-based">Based on <b>{vehicle.realLifeInspiration}</b></span>}
          </div>
        </div>
        <div class="vh-actions">
          <button type="button" class="btn btn-s vh-cmp" id="vh-cmp" aria-pressed="false"><Fragment set:html={ico.plus} /><Fragment set:html={ico.check} /><span data-l>Compare</span></button>
          <button type="button" class="btn btn-s vh-gar" id="vh-gar" aria-pressed="false"><Fragment set:html={ico.house} /><Fragment set:html={ico.houseCheck} /><span data-l>Add to My Garage</span></button>
          <!-- Wishlist (RS-0087, DEC-0189): only while you don't own the car -->
          <button type="button" class="btn btn-s vh-wish" id="vh-wish" aria-pressed="false" aria-label="Add to wishlist" title="Add to wishlist"><Fragment set:html={ico.heart} /></button>
        </div>
      </div>
    </section>

    <!-- ---- photo + values ---- -->
    <section class="wrap vs">
      <div class:list={['vs-photo', { 'is-ph': !photo }]}>
        {photo ? (
          <img src={`${photo}-1280.webp`} srcset={`${photo}-640.webp 640w, ${photo}-1280.webp 1280w, ${photo}-1920.webp 1920w`} sizes="(max-width: 900px) 100vw, 58vw" alt={photoAlt} width="1920" height="1080" fetchpriority="high" />
        ) : (
          <>
            <img class="vs-ph-bg" src={`${base}images/garage/garage-hero-placeholder.webp`} alt="" width="1672" height="941" />
            <img class="vs-ph-logo" src={logo} alt="" width="170" height="170" />
            <span class="vs-ph-pill"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>Photo coming</span>
          </>
        )}
      </div>
      <div class="vs-panel">
        <div class="vs-tiles">
          <div class="vt">
            <span class="vt-l">Price</span>
            <b class:list={['vt-v tnum', { 'is-tba': price == null }]}>{price != null ? money(price) : 'TBA'}</b>
            <span class="vt-s">{price != null ? (acq ? `${acq} · store price` : 'Store price') : 'Not announced yet'}</span>
          </div>
          <div class="vt">
            <span class="vt-l">Top speed</span>
            <b class:list={['vt-v tnum', { 'is-tba': speed == null }]}>{speed != null ? `${speed} mph` : 'TBA'}</b>
            <span class="vt-s">{speedRank != null ? `#${speedRank} of ${classCars.length} in ${cls}` : 'Measured after launch'}</span>
          </div>
          <div class="vt" id="vt-lap">
            <span class="vt-l">Gellhorn <span class="vt-opt">best </span>lap</span>
            <b class:list={['vt-v tnum', { 'is-tba': myLap == null }]} data-v>{myLap != null ? lapTime(myLap) : 'No lap yet'}</b>
            <a class="vt-s vt-link" href="#gellhorn" data-s>{lapRank != null ? `#${lapRank} of ${classCars.length} in ${cls} ↓` : 'Set the first time ↓'}</a>
          </div>
          <div class="vt vr" id="vr">
            <span class="vt-l">Driver rating</span>
            <span class="vr-line"><b class="vt-v tnum" id="vr-avg" hidden></b><span class="vr-stars" id="vr-stars" role="group" aria-label="Rate this car">{<Fragment set:html={starsHtml} />}</span></span>
            <span class="vt-s" id="vr-sub">Not enough ratings yet</span>
          </div>
        </div>
        <dl class="vs-rows">
          <div><dt>Where to get</dt><dd class:list={{ 'is-tba': !vehicle.acquisition }}>{vehicle.acquisition ? acqNotes[vehicle.acquisition] : 'After launch'}</dd></div>
          <div><dt>Sell value</dt><dd class:list={{ 'is-tba': vehicle.sellable !== 'no' && sell == null }}>{vehicle.sellable === 'no' ? "Can't be sold" : sell != null ? money(sell) : 'After launch'}</dd></div>
          <div><dt>Drive{' · '}Seats</dt><dd>{vehicle.drive === 'n/a' && !vehicle.seats ? 'TBA' : <>{vehicle.drive}{' · '}{vehicle.seats} {vehicle.seats === 1 ? 'seat' : 'seats'}</>}</dd></div>
          <div><dt>Release</dt><dd class:list={{ 'is-tba': !release }}>{release?.date ? <>{release.name}{' · '}<time datetime={release.date}>{releaseDate}</time></> : releaseText}</dd></div>
        </dl>
        <p class="vs-own" id="vs-own"><Fragment set:html={ico.house} /><span id="vs-own-t">Be the first to add it to <button type="button" class="vs-own-btn" data-add-garage>your garage</button></span></p>
      </div>
    </section>

    <!-- ---- Gellhorn ---- -->
    <section class="wrap vsec" id="gellhorn">
      <div class="vsec-head">
        <div class="vsec-titles">
          <p class="eyebrow">Time Attack</p>
          <h2 class="lr-h2 vsec-title display">{vehicle.model} at Gellhorn</h2>
          <p class="vsec-sub">Best laps driven in this car, and where it stands in its class.</p>
        </div>
        <span class="vsec-flag" id="vg-flag" hidden>Sample until launch</span>
      </div>
      <div class="vg">
        <div class="vg-card">
          <div class="vg-h"><h3>Fastest drivers in this car</h3><p>Gellhorn International Raceway</p></div>
          <div class="vg-cols" id="vg-dhead" hidden={!driverRows.length}><span>#</span><span>Driver</span><span>Lap</span></div>
          <div class="vg-rows" id="vg-drivers" data-sample={sampleDriversHtml || undefined} set:html={driversHtml} />
          <div class="vg-btns">
            <a class="btn btn-p" href={submitHref} id="vg-set" hidden={!driverRows.length}><Fragment set:html={ico.timer} /><span data-l>Set a Gellhorn time</span></a>
            <a class="btn btn-s" href={lbHref} id="vg-lb" hidden={!driverRows.length}>Full leaderboard</a>
            <a class="btn btn-s" href={`${base}time-attack/how-it-works/`} id="vg-how" hidden={driverRows.length > 0}>How Gellhorn works</a>
          </div>
        </div>
        <div class="vg-card">
          <div class="vg-h"><h3>{cls} by best lap</h3><p id="vg-csub" data-sample={sampleCsub || undefined}>{csubFor(classTimed)}</p></div>
          <div class="vg-cols vg-cols-c"><span>#</span><span>Car</span><span>Gap</span><span>Best lap</span></div>
          <div class="vg-rows" id="vg-class" data-more={classMoreHref} data-sample={sampleClassHtml || undefined} set:html={classHtml} />
          <div class="vg-btns">
            <a class="btn btn-s" href={`${base}cars/compare/`} id="vg-vsleader" data-vs-leader>Compare with the class leader</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ---- About + Origins ---- -->
    <section class="wrap vsec va">
      <div class="va-about">
        <p class="eyebrow">About</p>
        <h2 class="lr-h2 vsec-title display">The {fullName}</h2>
        {copy ? copy.map((p) => <p class="va-p">{p}</p>) : <p class="va-p is-tba">A description of this car follows soon.</p>}
        {seeAlso && <p class="va-p va-see">{seeAlso.before}<a href={`${base}cars/vehicles/${seeAlso.id}/`}>{seeAlso.linkText}</a>{seeAlso.after}</p>}
        {sources.length > 0 && <p class="va-sources">Sources: {sources.map((x, i) => <>{i > 0 && ' · '}<a href={x.url} target="_blank" rel="noopener">{x.label}</a></>)}</p>}
      </div>
      <div class="va-orig">
        <p class="eyebrow">Origins</p>
        <dl class="va-card">
          <div><dt>Real-life inspiration</dt><dd class:list={{ 'is-tba': !vehicle.realLifeInspiration }}>{vehicle.realLifeInspiration ?? 'Under review'}</dd></div>
          <div><dt>First seen</dt><dd>{vehicle.firstSeenIn && vehicle.firstSeenUrl
            ? <a class="va-src" href={vehicle.firstSeenUrl} target="_blank" rel="noopener">{vehicle.firstSeenIn}{vehicle.firstSeenTimestamp && <>{' · '}{vehicle.firstSeenTimestamp}</>}</a>
            : <span class:list={{ 'is-tba': !vehicle.firstSeenIn }}>{vehicle.firstSeenIn ?? 'Not officially revealed'}</span>}</dd></div>
          <div><dt>Added with</dt><dd class:list={{ 'is-tba': !release }}>{releaseText}</dd></div>
          <div><dt>GTA history</dt><dd class="va-hist">{!vehicle.previousGames
            ? <span class="is-tba">Earlier appearances under review</span>
            : vehicle.previousGames.length === 0
              ? (vehicle.releaseId
                ? <a class="va-tag va-tag-link" href={`${base}cars/new-cars/`} title="Browse cars identified as new to GTA VI">New in GTA VI <span aria-hidden="true">→</span></a>
                : <span class="va-tag">New in GTA VI</span>)
              : <><span class="va-tag">Returning</span>{groupedTitles(vehicle.previousGames).map((t) => <span class="va-chip" title={t.tooltip}>{t.label}</span>)}</>}</dd></div>
        </dl>
      </div>
    </section>

    <!-- ---- Similar cars ---- -->
    {similar.length > 0 && (
      <section class="wrap vsec vm" id="v-similar">
        <div class="vsec-head">
          <div class="vsec-titles">
            <p class="eyebrow">Keep browsing</p>
            <h2 class="lr-h2 vsec-title display">Similar cars</h2>
          </div>
          {classLink && <a class="arrow" href={`${base}${classLink}`}>All {classCars.length} {cls} →</a>}
        </div>
        <div class="vm-row">
          <div class="vm-cards">{similar.map((v) => <CarCard vehicle={v} variant="cars" list={false} lap={lapFor(v.id)} />)}</div>
          <div class="vh2h" id="vh2h">
            <p class="eyebrow">Head to head</p>
            <h3>Compare the {vehicle.model}</h3>
            <p class="vh2h-sub" id="vh2h-sub">{rivalsSub}</p>
            <div class="vh2h-list" id="vh2h-list" data-sample={sampleRivalsHtml || undefined} set:html={rivalsHtml} />
            <a class="btn btn-s" href={`${base}cars/compare/`} data-pick-any><Fragment set:html={ico.plus} />Pick any car</a>
          </div>
        </div>
      </section>
    )}

    <!-- ---- More from <make> (+ model family) ---- -->
    <section class="wrap vsec vmore">
      {others.length > 0 && (
        <div class="vmore-card">
          <img class="vmore-logo" src={logo} alt="" width="40" height="40" loading="lazy" />
          <div class="vmore-main">
            <p class="vmore-t"><b>More from {vehicle.make}</b><span>{' · '}{makeCars.length} cars in GTA VI</span></p>
            <div class="vmore-chips">{others.slice(0, 6).map((v) => <a class="chip" href={`${base}cars/vehicles/${v.id}/`}>{v.model}</a>)}</div>
          </div>
          {makeLink && <a class="btn btn-s vmore-all" href={`${base}${makeLink}`}>All {vehicle.make} cars</a>}
        </div>
      )}
      {family.length > 0 && (
        <div class="vmore-card">
          <div class="vmore-main">
            <p class="vmore-t"><b>More {familyLabel} models</b><span>{' · '}any class</span></p>
            <div class="vmore-chips">{family.slice(0, 6).map((v) => <a class="chip" href={`${base}cars/vehicles/${v.id}/`}>{v.make} {v.model}</a>)}</div>
          </div>
          {familyPage && <a class="btn btn-s vmore-all" href={familyPage}>The {familyLabel} family</a>}
        </div>
      )}
    </section>
  </div>
</Base>

<style>
  .vp :global(.ico) { width: 18px; height: 18px; flex: none; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .is-tba { color: var(--lr-muted) !important; }

  /* ---- head ---- */
  .vh { padding-top: 24px; }
  .vh-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 14px; color: var(--lr-muted); }
  .vh-crumbs a { color: var(--lr-muted); text-decoration: none; }
  .vh-crumbs a:hover { color: var(--lr-text); }
  .vh-crumbs [aria-current] { color: var(--lr-text); font-weight: 500; }
  .vh-grid { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-top: 18px; }
  .vh-id { min-width: 0; }
  .vh-make { display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .vh-make img { width: 22px; height: 22px; object-fit: contain; filter: var(--lr-logo-filter); opacity: var(--lr-logo-info); }
  .vh-make-n { font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-soft); }
  .vh-dot { color: var(--lr-muted); }
  .vh-all { color: var(--lr-muted); text-decoration: none; letter-spacing: .04em; }
  .vh-all:hover { color: var(--lr-text); }
  .vh-h1 { margin: 10px 0 0; font-size: clamp(44px, 6.2vw, 76px); }
  .vh-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 14px; }
  .vh-pill { display: inline-flex; align-items: center; height: 28px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--lr-line-strong); background: var(--lr-white-hover); font-size: 14px; font-weight: 600; color: var(--lr-text); text-decoration: none; }
  a.vh-pill:hover { border-color: var(--lr-text); }
  .vh-pill-acq { color: var(--lr-orange); border-color: var(--lr-orange-border); }
  .vh-based { margin-left: 6px; font-size: 15px; color: var(--lr-soft); }
  .vh-based b { color: var(--lr-text); font-weight: 600; }
  .vh-actions { display: flex; gap: 10px; flex: none; }
  .vh-actions .btn { min-width: 136px; }
  .vh-cmp :global(.ico + .ico), .vh-cmp[aria-pressed="true"] :global(.ico:first-child) { display: none; }
  .vh-cmp[aria-pressed="true"] :global(.ico + .ico) { display: block; }
  .vh-cmp[aria-pressed="true"] { border-color: var(--lr-pink); color: var(--lr-pink); }
  .vh-gar :global(.vh-g-check), .vh-gar[aria-pressed="true"] :global(.vh-g-house) { display: none; }
  .vh-gar[aria-pressed="true"] :global(.vh-g-check) { display: block; }
  .vh-gar[aria-pressed="true"] { background: var(--lr-lime-fill); border-color: var(--lr-lime-border); color: var(--lr-lime); }
  .vh-gar:disabled, .vh-cmp:disabled, .vh-wish:disabled { opacity: .6; cursor: progress; }
  .vh-actions .vh-wish { min-width: 0; width: 48px; padding: 0; flex: none; }
  .vh-wish[hidden] { display: none; }
  .vh-wish[aria-pressed="true"] { border-color: var(--lr-pink); color: var(--lr-pink); }
  .vh-wish[aria-pressed="true"] :global(.ico) { fill: currentColor; }

  /* ---- photo + panel: panel exactly as high as the 16:9 photo (DEC-0118) ---- */
  .vs { display: grid; grid-template-columns: minmax(0, 1.42fr) minmax(0, 1fr); gap: 20px; margin-top: 22px; align-items: start; }
  .vs-photo { position: relative; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; background: var(--lr-raised); }
  .vs-photo > img:not(.vs-ph-logo) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vs-photo.is-ph { display: flex; align-items: center; justify-content: center; border: 1px solid var(--lr-line); }
  .vs-ph-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(.6) brightness(.32); }
  .vs-ph-logo { position: relative; width: 170px; height: 170px; object-fit: contain; filter: var(--lr-logo-filter); opacity: var(--lr-logo-ph); }
  .vs-ph-pill { position: absolute; right: 14px; bottom: 14px; display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; border-radius: 999px; background: var(--lr-dark-80); font-size: 13px; font-weight: 600; }
  .vs-ph-pill .ico { width: 14px; height: 14px; }
  .vs-panel { position: relative; display: flex; flex-direction: column; min-height: 0; padding: 16px; border: 1px solid var(--lr-line); border-radius: 8px; background: var(--lr-card); }
  /* row height comes from the photo only; the panel fills it (DEC-0118) */
  @media (min-width: 1280px) {
    .vs { align-items: stretch; }
    .vs-panel { height: 0; min-height: 100%; overflow: hidden; }
  }
  /* narrower desktop: the photo follows the panel height instead (cropped, never squeezed) */
  @media (min-width: 1101px) and (max-width: 1279px) {
    .vs { align-items: stretch; }
    .vs-photo { aspect-ratio: auto; min-height: 100%; }
  }
  .vs-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .vt { display: flex; flex-direction: column; gap: 1px; min-width: 0; padding: 10px 14px; border-radius: 6px; background: var(--lr-raised); }
  .vt-l { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-muted); }
  .vt-v { font-size: 24px; font-weight: 700; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vt-s { font-size: 13px; color: var(--lr-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  a.vt-link { font-size: 14px; font-weight: 600; color: var(--lr-orange); text-decoration: none; } /* = .arrow (DEC-0170) */
  a.vt-link:hover { color: var(--lr-pink); }
  .vr-line { display: flex; align-items: center; gap: 10px; min-height: 32px; }
  .vr-stars { display: inline-flex; gap: 2px; }
  .vr-stars :global(.vr-star) { width: 20px; height: 22px; padding: 0; border: 0; background: none; color: var(--lr-disabled); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .vr-stars :global(.vr-star svg) { width: 18px; height: 18px; fill: currentColor; }
  .vr-stars :global(.vr-star.on) { color: var(--lr-orange); }
  .vr-stars:not(.is-locked):hover :global(.vr-star) { color: var(--lr-orange); }
  .vr-stars:not(.is-locked) :global(.vr-star:hover ~ .vr-star) { color: var(--lr-disabled); }
  .vr-stars.is-locked :global(.vr-star) { cursor: default; }
  .vr :global(.vr-act) { border: 0; padding: 0; background: none; font: inherit; color: var(--lr-orange); cursor: pointer; }
  .vr :global(.vr-act:hover) { color: var(--lr-pink); }
  .vr :global(.vr-saved) { color: var(--lr-lime); }
  .vs-rows { margin: 10px 0 0; padding: 0 2px; }
  .vs-rows > div { display: flex; justify-content: space-between; gap: 16px; padding: 6px 0; border-top: 1px solid var(--lr-line); font-size: 15px; }
  .vs-rows dt { color: var(--lr-soft); white-space: nowrap; }
  .vs-rows dd { margin: 0; font-weight: 600; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .vs-own { display: flex; align-items: center; gap: 10px; margin: auto 0 0; padding: 8px 2px 0; border-top: 1px solid var(--lr-line); font-size: 14px; color: var(--lr-soft); }
  .vs-own .ico { width: 16px; height: 16px; color: var(--lr-muted); }
  .vs-own :global(b) { color: var(--lr-text); }
  .vs-own :global(.vs-own-btn) { border: 0; padding: 0; background: none; font: inherit; font-weight: 600; color: var(--lr-orange); cursor: pointer; }
  .vs-own :global(.vs-own-btn:hover) { color: var(--lr-pink); }
  .vs-own .vh-g-check { display: none; }

  /* ---- sections ---- */
  .vsec { padding-top: var(--lr-gap-sec); }
  .vsec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
  .vsec-titles { display: flex; flex-direction: column; gap: 8px; } /* label -> H2: 8px (DEC-0168) */
  .vsec .eyebrow { margin: 0; }
  .vsec-title { margin: 0; }
  .vsec-sub { margin: 0; color: var(--lr-soft); font-size: 16px; }
  .vsec-flag { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-muted); white-space: nowrap; }
  .vsec-flag[hidden] { display: none; }

  /* ---- Gellhorn ---- */
  .vg { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .vg-card { display: flex; flex-direction: column; min-width: 0; padding: 20px 20px 20px; border: 1px solid var(--lr-line); border-radius: 8px; background: var(--lr-card); }
  .vg-h h3 { margin: 0; font-size: var(--lr-h3); font-weight: 700; }
  .vg-h p { margin: 2px 0 0; font-size: 14px; color: var(--lr-soft); }
  .vg-cols { display: grid; grid-template-columns: 40px 1fr auto; gap: 14px; margin-top: 14px; padding: 8px 14px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--lr-muted); }
  .vg-cols[hidden] { display: none; }
  .vg-cols-c { grid-template-columns: 40px 1fr 66px 70px; }
  .vg-cols-c span:nth-child(2) { padding-left: 78px; }
  .vg-cols-c span:nth-child(3), .vg-cols-c span:nth-child(4) { text-align: right; }
  .vg-rows { display: flex; flex-direction: column; }
  /* both cards: at most 10 rows + 1 extra row; shorter lists make both cards shorter,
     the grid keeps the two cards the same height (Fausto 17.10.) */
  .vg-rows :global(.vg-row) { display: grid; grid-template-columns: 40px 1fr auto; align-items: center; gap: 14px; min-height: 44px; padding: 0 14px; border-top: 1px solid var(--lr-line); font-size: 15px; color: var(--lr-soft); text-decoration: none; }
  .vg-rows :global(.vg-pos) { color: var(--lr-muted); }
  .vg-rows :global(.vg-pos.is-first) { color: var(--lr-pink); font-weight: 700; }
  .vg-rows :global(.vg-name) { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vg-rows :global(.vg-time) { text-align: right; }
  .vg-rows :global(.vg-row.me) { background: var(--lr-raised); border-radius: 6px; color: var(--lr-text); font-weight: 600; }
  .vg-rows :global(.vg-you) { display: inline-flex; margin-left: 6px; padding: 1px 6px; border-radius: 4px; background: var(--lr-pink-fill-hover); color: var(--lr-pink); font-size: 11px; font-weight: 700; font-style: normal; text-transform: uppercase; }
  .vg-rows :global(.vg-open) { margin-top: 6px; border-top: 1px solid var(--lr-line); color: var(--lr-muted); }
  .vg-rows :global(.vg-crow) { grid-template-columns: 40px 64px 1fr 66px 70px; min-height: 44px; }
  .vg-rows :global(.vg-more) { grid-template-columns: 40px 1fr auto; text-decoration: none; }
  .vg-rows :global(.vg-more:hover) { color: var(--lr-text); }
  .vg-rows :global(.vg-crow:hover) { background: var(--lr-white-hover); color: var(--lr-text); }
  .vg-rows :global(.vg-crow.is-this) { background: var(--lr-raised); border-radius: 6px; color: var(--lr-text); font-weight: 600; }
  .vg-rows :global(.vg-crow.no-lap) { color: var(--lr-muted); }
  .vg-rows :global(.vg-crow .vg-nolap) { grid-column: 4 / 6; }
  .vg-rows :global(.vg-thumb) { width: 64px; height: 36px; border-radius: 4px; object-fit: cover; background: var(--lr-raised); }
  .vg-rows :global(.vg-thumb-logo), .vh2h :global(.vg-thumb-logo) { position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .vg-rows :global(.vg-thumb-logo .vg-thumb-bg), .vh2h :global(.vg-thumb-logo .vg-thumb-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(.6) brightness(.35); opacity: 1; }
  .vg-rows :global(.vg-thumb-logo .vg-thumb-l), .vh2h :global(.vg-thumb-logo .vg-thumb-l) { position: relative; }
  .vg-rows :global(.vg-thumb-logo .vg-thumb-l) { width: 22px; height: 22px; object-fit: contain; filter: var(--lr-logo-filter); opacity: var(--lr-logo-ph); }
  .vg-rows :global(.vg-gap) { text-align: right; font-size: 14px; }
  .vg-rows :global(.vg-lead) { color: var(--lr-lime); font-weight: 600; }
  .vg-rows :global(.vg-start) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-top: 14px; padding: 28px 24px; border: 1px dashed var(--lr-pink-border); border-radius: 8px; background: var(--lr-pink-tint); }
  .vg-rows :global(.vg-start-n) { font-family: var(--gh-font-display); font-size: 48px; font-weight: 800; line-height: 1; color: var(--lr-pink); }
  .vg-rows :global(.vg-start-t) { margin: 4px 0 0; font-size: 19px; font-weight: 700; color: var(--lr-text); }
  .vg-rows :global(.vg-start-s) { margin: 0 0 8px; font-size: 15px; color: var(--lr-soft); }
  .vg-btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; padding-top: 18px; }
  .vg-btns [hidden] { display: none; }

  /* ---- About + Origins: same height ---- */
  .va { display: grid; grid-template-columns: minmax(0, 1.42fr) minmax(0, 1fr); gap: 20px; align-items: stretch; }
  .va-about, .va-orig { display: flex; flex-direction: column; gap: 8px; min-width: 0; } /* label -> H2: 8px (DEC-0168) */
  .va-about .vsec-title { margin-bottom: 10px; }
  .va-sources { margin: 4px 0 0; font-size: 14px; line-height: 1.5; color: var(--lr-muted); }
  .va-sources a { color: var(--lr-soft); text-decoration: underline; text-underline-offset: 3px; }
  .va-sources a:hover { color: var(--lr-text); }
  .va-p { margin: 0 0 14px; font-size: 18px; line-height: 1.6; color: var(--lr-text); }
  .va-card { flex: 1; display: flex; flex-direction: column; justify-content: space-around; margin: 8px 0 0; padding: 4px 20px; border: 1px solid var(--lr-line); border-radius: 8px; background: var(--lr-card); }
  .va-card > div { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; font-size: 15px; }
  .va-card > div + div { border-top: 1px solid var(--lr-line); }
  .va-card dt { color: var(--lr-soft); white-space: nowrap; }
  .va-card dd { margin: 0; font-weight: 600; text-align: right; }
  .va-src { color: var(--lr-text); text-decoration: none; }
  .va-src:hover { color: var(--lr-pink); }
  .va-hist { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }
  .va-tag { display: inline-flex; align-items: center; height: 26px; padding: 0 8px; border-radius: 4px; background: var(--lr-lime-fill); color: var(--lr-lime); font-size: 13px; font-weight: 600; }
  /* Fausto 20.10.: links to New cars (revealed cars only); hover = stronger lime background, no new colour rule. */
  a.va-tag-link { gap: 5px; text-decoration: none; transition: background .15s; }
  a.va-tag-link:hover, a.va-tag-link:focus-visible { background: var(--lr-lime-fill-hover); color: var(--lr-lime); text-decoration: none; }
  .va-chip { display: inline-flex; align-items: center; height: 26px; padding: 0 8px; border-radius: 4px; background: var(--lr-raised); font-size: 13px; font-weight: 600; }

  /* ---- Similar cars + head to head ---- */
  .vm-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .vm-cards { display: contents; }
  .vh2h { display: flex; flex-direction: column; gap: 6px; padding: 20px; border: 1px solid var(--lr-pink-border); border-radius: 8px; background: linear-gradient(160deg, rgba(242,75,157,.16), rgba(20,20,31,.9) 60%), var(--lr-card); }
  .vh2h .eyebrow { margin: 0; }
  .vh2h h3 { margin: 4px 0 0; font-size: var(--lr-h3); font-weight: 700; line-height: 1.2; }
  .vh2h-sub { margin: 0 0 8px; font-size: 14px; color: var(--lr-soft); }
  .vh2h-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; }
  .vh2h :global(.vh-rival) { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 6px; background: var(--lr-white-hover); text-decoration: none; color: var(--lr-text); }
  .vh2h :global(.vh-rival:hover) { background: var(--lr-white-active); }
  .vh2h :global(.vg-thumb) { width: 64px; height: 36px; flex: none; border-radius: 4px; object-fit: cover; background: var(--lr-raised); }
    .vh2h :global(.vg-thumb-logo .vg-thumb-l) { width: 22px; height: 22px; object-fit: contain; filter: var(--lr-logo-filter); opacity: var(--lr-logo-ph); }
  .vh2h :global(.vh-rival-t) { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .vh2h :global(.vh-rival-t b) { font-size: 15px; line-height: 1.25; }
  .vh2h :global(.vh-rival-t span) { font-size: 12px; color: var(--lr-soft); }
  .vh2h :global(.vh-vs) { flex: none; font-size: 14px; font-weight: 700; color: var(--lr-pink); }
  .vh2h > .btn { margin-top: auto; }

  /* ---- More from ---- */
  .vmore { display: flex; flex-direction: column; gap: 16px; padding-top: 20px; }
  .vmore-card { display: flex; align-items: center; gap: 18px; padding: 18px 22px; border: 1px solid var(--lr-line); border-radius: 8px; background: var(--lr-card); }
  .vmore-logo { width: 40px; height: 40px; object-fit: contain; filter: var(--lr-logo-filter); opacity: var(--lr-logo-info); flex: none; }
  .vmore-main { flex: 1; min-width: 0; }
  .vmore-t { margin: 0 0 10px; font-size: 17px; }
  .vmore-t span { color: var(--lr-soft); }
  .vmore-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { display: inline-flex; align-items: center; height: 34px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--lr-line-strong); font-size: 14px; font-weight: 500; color: var(--lr-text); text-decoration: none; white-space: nowrap; }
  .chip:hover { border-color: var(--lr-line-hover); color: var(--lr-text); }
  .vmore-all { flex: none; }

  /* ---- tablet ---- */
  @media (max-width: 1100px) {
    .vm-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vs { grid-template-columns: 1fr; }
  }
  @media (max-width: 900px) {
    .vh-grid { flex-direction: column; align-items: stretch; }
    .vg, .va { grid-template-columns: 1fr; }
  }
  /* ---- phone (DEC-0118): head -> photo edge to edge -> Compare + Garage -> 2x2 values -> ... ---- */
  @media (max-width: 760px) {
    .vp { display: flex; flex-direction: column; overflow-x: clip; }
    .vp > *, .vm-row, .vm-cards, .va > * { min-width: 0; }
    .vp > section { width: 100%; }
    .vm-cards > :global(.vcard) { min-width: 0; }
    .vh, .vh-grid, .vs { display: contents; }
    .vh-crumbs, .vh-id, .vh-actions { padding-inline: clamp(1.25rem, 4vw, 2.5rem); }
    .vh-crumbs { order: -3; padding-top: 16px; gap: 6px; font-size: 13px; }
    .vh-id { order: -2; padding-top: 12px; }
    .vh-make { font-size: 13px; }
    .vh-h1 { font-size: clamp(36px, 11vw, 48px); margin-top: 8px; }
    .vh-meta { margin-top: 12px; }
    .vh-based { flex-basis: 100%; margin: 4px 0 0; }
    .vs-photo { order: 1; margin-top: 16px; border-radius: 0; }
    .vs-photo.is-ph { border-left: 0; border-right: 0; }
    .vs-ph-logo { width: 96px; height: 96px; }
    .vh-actions { order: 2; display: flex; gap: 10px; padding-top: 14px; }
    .vh-actions .btn { flex: 1 1 0; min-width: 0; padding: 0 12px; }
    .vh-actions .vh-wish { flex: none; padding: 0; }
    .vs-panel { order: 3; margin: 14px clamp(1.25rem, 4vw, 2.5rem) 0; padding: 12px; }
    .vsec { order: 4; }
    .vt { padding: 10px 12px; }
    .vt-v { font-size: 21px; }
    .vt-opt { display: none; }
    .vt-s { font-size: 12px; }
    .vs-rows > div { font-size: 14px; }
    .vsec-head { flex-direction: column; align-items: flex-start; gap: 6px; }
    .vg-card { padding: 16px 14px; }
    .vg-rows :global(.vg-row) { gap: 10px; padding: 0 8px; grid-template-columns: 28px 1fr auto; }
    .vg-cols { grid-template-columns: 28px 1fr auto; gap: 10px; padding: 8px; }
    .vg-rows :global(.vg-crow) { grid-template-columns: 22px 48px 1fr 58px 64px; font-size: 14px; }
    .vg-rows :global(.vg-thumb) { width: 48px; height: 27px; }
    .vg-rows :global(.vg-make) { display: none; }
    .vg-cols-c { grid-template-columns: 22px 1fr 58px 64px; }
    .vg-cols-c span:nth-child(2) { padding-left: 58px; }
    /* stacked on the phone: two buttons side by side clipped 'Set a Gellhorn time' at 390 px (design audit 21.10.) */
    .vg-btns { display: grid; grid-template-columns: 1fr; }
    .vg-btns .btn { padding: 0 10px; min-width: 0; }
    .vg-btns #vg-vsleader, .vg-btns #vg-how { grid-column: 1 / -1; }
    .va-p { font-size: 17px; }
    .va-card { padding: 4px 14px; }
    .va-card > div { padding: 12px 0; font-size: 14px; }
    .vm-row { display: flex; flex-direction: column; gap: 16px; }
    .vm-cards { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin-inline: calc(-1 * clamp(1.25rem, 4vw, 2.5rem)); padding: 0 clamp(1.25rem, 4vw, 2.5rem) 4px; scroll-padding-inline: clamp(1.25rem, 4vw, 2.5rem); scrollbar-width: none; }
    .vm-cards > :global(.vcard) { flex: 0 0 78%; scroll-snap-align: start; }
    .vmore-card { flex-wrap: wrap; align-items: flex-start; padding: 16px; }
    .vmore-all { flex-basis: 100%; }
  }
  /* narrow phones: three buttons in one row only fit without the icons in Compare / Garage
     (the state still shows in text and colour); the heart keeps its icon (DEC-0189) */
  @media (max-width: 420px) {
    .vh-cmp :global(.ico), .vh-gar :global(.ico) { display: none !important; }
    .vh-actions { gap: 8px; }
    .vh-actions .btn { flex: 1 1 auto; padding: 0 10px; font-size: 14px; }
    .vh-actions .vh-wish { flex: none; padding: 0; }
  }
</style>

