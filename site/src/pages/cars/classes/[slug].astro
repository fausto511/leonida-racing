---
import GarageTaxonomy from '../../../components/GarageTaxonomy.astro';
import { classPages, vehiclesInClass } from '../../../data/garage-taxonomy';

// Search-facing names per class (RS-0050)
const labels: Record<string, string> = {
  super: 'Super Cars', sports: 'Sports Cars', muscle: 'Muscle Cars', 'sports-classics': 'Sports Classics',
  coupes: 'Coupes', sedans: 'Sedans', suvs: 'SUVs', 'off-road': 'Off-Road Vehicles',
};
export function getStaticPaths() {
  return classPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<GarageTaxonomy kind="class" page={page} vehicles={vehiclesInClass(page.slug)} label={labels[page.slug] ?? page.name} />
