---
// Home — Redesign Phase 3 (DEC-0116, mockup boards Home guest / active driver /
// new driver / phone). Order: Hero → Time Attack band → Fastest at Gellhorn →
// Community → Guide → Discord band. Everything a guest sees is in the HTML;
// the logged-in dashboard, live leaderboard, live events/crews and the
// rotations are filled in by scripts/home.ts.
// COPY STATUS: all new texts are Claude placeholders from the mockup
// (Codex brief Claude outputs/Codex-Brief-Home-Redesign-2026-10-11.md, DEC-0088).
import Base from '../layouts/Base.astro';
import CarCard from '../components/CarCard.astro';
import { SITE_NAME } from '../data/site';
import { sampleCrews, sampleEventsUpcoming } from '../data/hub';
import { homeEventRow, homeOpenSpotRow, homeCrewRow, homeLbRow } from '../data/home';
import { sampleEntries, overallRows } from '../data/leaderboard';
import { vehicleOptions, fastestGellhornLapMs, bandVehicle, type VehicleOption } from '../data/vehicles';
import { classSlug } from '../data/garage-taxonomy';
import { guideSections, GUIDE_UPDATED } from '../data/guide';

const base = import.meta.env.BASE_URL;
const N = vehicleOptions.length; // DEC-0117: N always from data
const DISCORD_INVITE_URL = 'https://discord.gg/hPGuBwXRqT';
const TA = `${base}time-attack/gellhorn-international-raceway/`;

// ---- Time Attack band: sample top 5 until real laps exist ----
const sampleTop = overallRows(sampleEntries, false).slice(0, 5);
const sampleTopHtml = sampleTop.map(({ e, rank }) => homeLbRow({ rank, driver: e.driver, crew: e.crew, car: `${e.make} ${e.model}`, ms: e.lap_time_ms })).join('');
const TA_CHIPS = ['Super', 'Sports', 'Muscle', 'Sports Classics', 'Off-Road'];

// ---- Fastest at Gellhorn: one car per class (DEC-0116) ----
// The class's fastest car at Gellhorn; until laps exist, the class's band car
// (first car with a photo). Super and Sports always, two more classes picked at
// random in the browser; classes without a car are skipped.
const classNames = [...new Set(vehicleOptions.flatMap((v) => v.classes))];
const anyLap = vehicleOptions.some((v) => fastestGellhornLapMs(v.id) != null);
type Pick = { cls: string; v: VehicleOption; ms: number | null };
const picks: Pick[] = classNames.map((cls) => {
  const inClass = vehicleOptions.filter((v) => v.classes.includes(cls));
  const timed = inClass.filter((v) => fastestGellhornLapMs(v.id) != null).sort((a, b) => fastestGellhornLapMs(a.id)! - fastestGellhornLapMs(b.id)!);
  // before any lap exists: only classes that have a car with a photo (Fausto 15.10.: no placeholder cards here)
  const v = timed[0] ?? (anyLap ? null : bandVehicle(inClass));
  return v ? { cls, v, ms: fastestGellhornLapMs(v.id) } : null;
}).filter((p): p is Pick => p !== null);
const fixed = ['Super', 'Sports'];
const fastFixed = fixed.map((c) => picks.find((p) => p.cls === c)).filter((p): p is Pick => Boolean(p));
const fastRest = picks.filter((p) => !fixed.includes(p.cls));

// ---- Community (sample rows; live rows replace them in the browser) ----
const sampleEv = sampleEventsUpcoming().filter((e) => e.status !== 'cancelled').slice(0, 3);
const eventsHtml = sampleEv.map(homeEventRow).join('') + Array.from({ length: Math.max(0, 3 - sampleEv.length) }, homeOpenSpotRow).join('');
const crewsHtml = sampleCrews.slice(0, 4).map((c) => homeCrewRow(c, true)).join('');

// ---- Guide: "Racing in GTA VI" fixed, two rotating (never "not-confirmed") ----
const GUIDE_CARD: Record<string, { img: string; line: string; title?: string }> = {
  // racing / vehicles / customization: image, title and sentence from the mockup (DEC-0116 board Home)
  racing: { img: 'guide/street-race', title: 'Racing in GTA VI', line: 'Circuit, off-road, and street racing, each shown with a live race HUD.' },
  vehicles: { img: 'guide/classic-collection-car', title: 'Vehicles in GTA VI', line: '298 vehicles spotted in official material. Which names Rockstar confirmed, and which are community IDs.' },
  customization: { img: 'guide/rideout-customs', title: 'Customization and mod shops', line: 'Two named mod shops, from detailed interiors and donk builds to lifted off-road rigs.' },
  driving: { img: 'guide/driving', line: 'What Rockstar has said about the rebuilt driving physics so far.' },
  theft: { img: 'guide/slim-jim', line: 'Stealing, scanning, selling and registering cars, as Rockstar described it.' },
  ownership: { img: 'guide/safehouse', line: 'Garages, storage spaces and the safehouse vehicles shown so far.' },
  classics: { img: 'guide/classic-collection-wyman', line: 'Classic cars, restoration and special builds from the Ultimate Edition.' },
  gellhorn: { img: 'guide/circuit-empty', line: 'The paved circuit behind Gellhorn Time Attack, and what is known about it.' },
  'car-culture': { img: 'guide/car-meet', line: 'Car meets and street takeovers as they appear in official footage.' },
};
const guideCards = guideSections.filter((s) => s.id !== 'not-confirmed' && GUIDE_CARD[s.id]);
const guideFixed = guideCards.find((s) => s.id === 'racing')!;
const MOCKUP_DEFAULT = ['vehicles', 'customization'];
const guideRest = [...guideCards.filter((s) => MOCKUP_DEFAULT.includes(s.id)), ...guideCards.filter((s) => s.id !== 'racing' && !MOCKUP_DEFAULT.includes(s.id))];
const guideUpdated = new Date(`${GUIDE_UPDATED}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const home = new URL(base, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: home,
    inLanguage: 'en',
    description: 'GTA VI racing database and community: vehicles with verified classes, proof-based lap-time leaderboards, and a hub for racing events and crews.',
    keywords: 'GTA 6, GTA VI, Grand Theft Auto VI, GTA 6 cars, GTA 6 racing, GTA 6 crews, GTA 6 car meets',
    about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI', alternateName: ['GTA VI', 'GTA 6'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: home,
    logo: new URL(`${base}images/logo-512.png`, Astro.site).href,
    sameAs: [DISCORD_INVITE_URL],
  },
];
const arrowSvg = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const discordPath = 'M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.2.4a18 18 0 0 1 4.5 2.3 15.6 15.6 0 0 0-15.4 0A18 18 0 0 1 8.8 3.4L8.6 3a19.8 19.8 0 0 0-4.9 1.4C.6 9.1-.3 13.7.1 18.2A20 20 0 0 0 6.1 21l1.3-2.1a12.9 12.9 0 0 1-2-1l.5-.4a14.3 14.3 0 0 0 12.2 0l.5.4a12.9 12.9 0 0 1-2 1l1.3 2.1a20 20 0 0 0 6-2.8c.5-5.2-.9-9.8-3.6-13.8ZM8.5 15.5c-1.2 0-2.1-1.1-2.1-2.4s.9-2.4 2.1-2.4 2.2 1.1 2.1 2.4c0 1.3-.9 2.4-2.1 2.4Zm7 0c-1.2 0-2.1-1.1-2.1-2.4s.9-2.4 2.1-2.4 2.2 1.1 2.1 2.4c0 1.3-.9 2.4-2.1 2.4Z';
---
<Base
  title="Leonida Racing — GTA VI Racing Database & Community"
  description="Explore the GTA 6 car database, submit lap times at Gellhorn International Raceway, and find crews, events, and car meets across Vice City and Leonida."
  jsonLd={jsonLd}
>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <picture class="hero-bg">
      <source type="image/webp" srcset={`${base}images/home/home-hero-640.webp 640w, ${base}images/home/home-hero-1080.webp 1080w, ${base}images/home/home-hero-1562.webp 1562w`} sizes="100vw" />
      <img src={`${base}images/home/home-hero-1562.jpg`} alt="" width="1562" height="1007" loading="eager" fetchpriority="high" />
    </picture>
    <span class="hero-tint hero-tint-1" aria-hidden="true"></span>
    <span class="hero-tint hero-tint-2" aria-hidden="true"></span>
    <span class="hero-tint hero-tint-3" aria-hidden="true"></span>
    <span class="hero-tint hero-tint-4" aria-hidden="true"></span>

    <div class="wrap hero-inner">
      <!-- guest -->
      <div class="hero-guest" id="hero-guest">
        <div class="hero-head">
          <p class="eyebrow">GTA VI Racing Database &amp; Community</p>
          <h1 class="display hero-title">The Home of<br /> GTA VI Car Culture</h1>
        </div>
        <p class="hero-sub">Get the stats on GTA VI cars and see what racers drive. Put down a time at Gellhorn. Find your crew, your next rival, or a car meet to roll up to.</p>
        <div class="htiles">
          {[
            { href: `${base}cars/`, img: 'vehicles/declasse-mamba-gt', eb: 'Database', name: 'Cars', line: 'Check the specs. Find your next car.' },
            { href: TA, img: 'gellhorn-raceway', eb: 'Gellhorn', name: 'Time Attack', line: 'Submit a lap. Move up the leaderboard.' },
            { href: `${base}community/`, img: 'hub/hub-carmeet', eb: 'Events & Crews', name: 'Community', line: 'Find races, crews, and car meets.' },
            { href: `${base}guide/`, img: 'home/guide-tile', eb: 'Sourced', name: 'Guide', line: 'Facts, not rumors. All sourced.' },
          ].map((t) => (
            <a href={t.href} class="htile">
              <span class="htile-img"><img src={`${base}images/${t.img}-640.webp`} alt="" width="640" height="360" loading="eager" /><span class="htile-go" set:html={arrowSvg} /></span>
              <span class="htile-body"><span class="htile-eb">{t.eb}</span><span class="htile-name">{t.name}</span><span class="htile-live">{t.line}</span></span>
            </a>
          ))}
        </div>
      </div>

      <!-- logged in: dashboard (filled by scripts/home.ts) -->
      <div class="hero-dash" id="hero-dash" hidden>
        <p class="eyebrow">Your dashboard</p>
        <h1 class="display hero-title hero-title-dash" id="dash-title">Welcome</h1>
        <div class="htiles">
          <a class="mtile" id="dash-lap" href={`${base}account/`}>
            <span class="mtile-top"><span class="mtile-ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9 2h6"/></svg></span><span class="htile-eb">Your best lap</span><span class="mtile-go" set:html={arrowSvg} /></span>
            <span class="mtile-val" data-val>…</span><span class="mtile-sub" data-sub>&nbsp;</span>
          </a>
          <a class="mtile" id="dash-garage" href={`${base}account/garage/`}>
            <span class="mtile-top"><span class="mtile-ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V9l9-6 9 6v12M7 21v-7h10v7"/></svg></span><span class="htile-eb">My Garage</span><span class="mtile-go" set:html={arrowSvg} /></span>
            <span class="mtile-val" data-val>…</span><span class="mbar"><i data-bar style="width:0%"></i></span><span class="mtile-sub" data-sub>&nbsp;</span>
          </a>
          <a class="mtile" id="dash-crew" href={`${base}account/crew/`}>
            <span class="mtile-top"><span class="mtile-ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span class="htile-eb">Your crew</span><span class="mtile-go" set:html={arrowSvg} /></span>
            <span class="mtile-val" data-val>…</span><span class="mtile-sub" data-sub>&nbsp;</span>
          </a>
          <a class="mtile" id="dash-events" href={`${base}account/events/`}>
            <span class="mtile-top"><span class="mtile-ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg></span><span class="htile-eb">Events</span><span class="mtile-go" set:html={arrowSvg} /></span>
            <span class="mtile-val" data-val>…</span><span class="mtile-sub" data-sub>&nbsp;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Time Attack band ===== -->
  <section class="wrap hsec hsec-first">
    <div class="hsec-head">
      <div class="hsec-titles">
        <p class="eyebrow">Time Attack</p>
        <h2 class="display hsec-title">Gellhorn International Raceway</h2>
        <p class="hsec-sub">One track, every car, one leaderboard. Set a lap, upload your proof, climb the board.</p>
      </div>
      <a href={TA} class="arrow">Full leaderboard →</a>
    </div>
    <div class="card tband" id="tband">
      <a href={TA} class="tband-link" aria-label="Open the Gellhorn leaderboard"></a>
      <div class="tband-img">
        <picture>
          <source type="image/webp" srcset={`${base}images/gellhorn-raceway-640.webp 640w, ${base}images/gellhorn-raceway-1080.webp 1080w`} sizes="(max-width: 760px) 100vw, 640px" />
          <img src={`${base}images/gellhorn-raceway-1672.jpg`} alt="Gellhorn International Raceway" width="1672" height="941" loading="lazy" />
        </picture>
        <div class="tband-actions">
          <a href={`${base}time-attack/submit/`} class="btn btn-p btn-44">Submit a lap</a>
          <a href={`${base}time-attack/how-it-works/`} class="btn btn-s btn-44 btn-glass">How it works</a>
        </div>
      </div>
      <div class="tband-board">
        <div class="tband-head"><h3 id="tband-title">Top 5 · overall</h3><span class="muted" id="tband-flag">sample until launch</span></div>
        <div class="tband-rows" id="tband-rows" set:html={sampleTopHtml} />
        <div class="tband-chips">
          <span class="tband-chips-label">By class</span>
          {TA_CHIPS.map((c) => <a href={`${TA}?class=${classSlug(c)}`} class="chip chip-sm">{c}</a>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Fastest at Gellhorn ===== -->
  <section class="wrap hsec">
    <div class="hsec-head">
      <div class="hsec-titles">
        <p class="eyebrow">Cars</p>
        <h2 class="display hsec-title">Fastest at Gellhorn</h2>
        <p class="hsec-sub">The cars holding each class record right now. Beat a time and the spot is yours.</p>
      </div>
      <a href={`${base}cars/`} class="arrow">All {N} cars →</a>
    </div>
    <div class="cgrid" id="fastest">
      {fastFixed.map((p) => <CarCard vehicle={p.v} cls={p.cls} lap={p.ms != null ? { rank: 1, ms: p.ms } : null} rotate="fixed" />)}
      {fastRest.map((p, i) => <CarCard vehicle={p.v} cls={p.cls} lap={p.ms != null ? { rank: 1, ms: p.ms } : null} rotate={i < 4 - fastFixed.length ? 'pool-default' : 'pool'} />)}
    </div>
  </section>

  <!-- ===== Community ===== -->
  <section class="wrap hsec">
    <div class="hsec-head">
      <div class="hsec-titles">
        <p class="eyebrow">Community</p>
        <h2 class="display hsec-title">Races, meets and crews</h2>
        <p class="hsec-sub">Find your next race or car meet, sign up in one click, and connect with crews that run the way you do.</p>
      </div>
      <a href={`${base}community/`} class="arrow">Open Community →</a>
    </div>
    <div class="ccards">
      <article class="card ccard">
        <div class="cimg"><img src={`${base}images/hub/hub-carmeet-640.webp`} srcset={`${base}images/hub/hub-carmeet-640.webp 640w, ${base}images/hub/hub-carmeet-1080.webp 1080w`} sizes="(max-width: 760px) 100vw, 640px" alt="" width="640" height="360" loading="lazy" /></div>
        <div class="cbody">
          <h3><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>Next events<span class="ctz">Your local time</span></h3>
          <div class="crows" id="home-events" set:html={eventsHtml} />
          <div class="cfoot"><a href={`${base}account/events/`} class="btn btn-s btn-sm">Become a host</a></div>
        </div>
      </article>
      <article class="card ccard">
        <div class="cimg cimg-crews"><img src={`${base}images/hub/hub-crews-640.webp`} srcset={`${base}images/hub/hub-crews-640.webp 640w, ${base}images/hub/hub-crews-1080.webp 1080w`} sizes="(max-width: 760px) 100vw, 640px" alt="" width="640" height="360" loading="lazy" /></div>
        <div class="cbody">
          <h3><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>Featured crews</h3>
          <div class="crows" id="home-crews" set:html={crewsHtml} />
          <div class="cfoot"><a href={`${base}account/crew/`} class="btn btn-s btn-sm">Start a crew</a></div>
        </div>
      </article>
    </div>
  </section>

  <!-- ===== Guide ===== -->
  <section class="wrap hsec hsec-last">
    <div class="hsec-head">
      <div class="hsec-titles">
        <p class="eyebrow">Guide</p>
        <h2 class="display hsec-title">What Rockstar has actually shown</h2>
        <p class="hsec-sub">Every claim with its source. Confirmed facts, community identifications, and open questions, kept apart.</p>
      </div>
      <div class="hsec-aside"><span class="muted">Updated {guideUpdated}</span><a href={`${base}guide/`} class="arrow">Open the Guide →</a></div>
    </div>
    <div class="cgrid cgrid-3" id="guide-cards">
      {[guideFixed, ...guideRest].map((s, i) => (
        <article class="card gcard" data-rotate={i === 0 ? 'fixed' : i <= 2 ? 'pool-default' : 'pool'}>
          <div class="g-img">
            <img src={`${base}images/${GUIDE_CARD[s.id].img}-640.webp`} srcset={`${base}images/${GUIDE_CARD[s.id].img}-640.webp 640w, ${base}images/${GUIDE_CARD[s.id].img}-1280.webp 1280w`} sizes="(max-width: 760px) 272px, 420px" alt="" width="640" height="360" loading="lazy" />
            {s.status && <span class="g-status"><i aria-hidden="true"></i>{s.status}</span>}
          </div>
          <div class="g-body">
            <a href={`${base}guide/#${s.id}`} class="g-name">{GUIDE_CARD[s.id].title ?? s.title}</a>
            <span class="g-txt">{GUIDE_CARD[s.id].line}</span>
            <div class="g-foot"><span class="g-src"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg>{s.sources.length} {s.sources.length === 1 ? 'source' : 'sources'}</span><span class="g-arrow" aria-hidden="true">→</span></div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ===== Discord band (one action) ===== -->
  <section class="dband">
    <div class="wrap dband-inner">
      <div class="dband-copy">
        <h2 class="display dband-title">The scene talks on Discord</h2>
        <p class="dband-text">Find people to race with, catch the next event, talk cars, and discover new tracks and race jobs.<span class="dband-guest"> Log in with Discord and you join the server automatically.</span></p>
      </div>
      <a href={DISCORD_INVITE_URL} target="_blank" rel="noopener" class="btn dband-btn" id="dband-btn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={discordPath} /></svg>
        <span id="dband-label">Log in with Discord</span>
      </a>
    </div>
  </section>
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  [hidden] { display: none !important; }
  :global(main) { overflow-x: clip; }
  .ico { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .muted { color: var(--lr-muted); }
  .tnum, :global(.tnum) { font-variant-numeric: tabular-nums; }

  /* ---- hero ---- */
  .hero { position: relative; display: flex; align-items: flex-end; overflow: hidden; border-bottom: 1px solid rgba(200,200,222,.22); }
  .hero-bg, .hero-bg img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-bg img { object-fit: cover; object-position: 60% 40%; }
  .hero-tint { position: absolute; inset: 0; pointer-events: none; }
  /* V1 gradient (DEC-0116): pink -> orange colour wash, dark reading side left, line at the bottom */
  .hero-tint-1 { background: linear-gradient(115deg, rgba(242,75,157,.75) 0%, rgba(242,75,157,.2) 42%, rgba(255,122,61,.2) 58%, rgba(255,122,61,.75) 100%); mix-blend-mode: color; }
  .hero-tint-2 { background: linear-gradient(115deg, rgba(242,75,157,.22) 0%, rgba(242,75,157,0) 42%, rgba(255,122,61,0) 58%, rgba(255,122,61,.22) 100%); }
  .hero-tint-3 { background: linear-gradient(90deg, rgba(11,11,20,.86) 0%, rgba(11,11,20,.6) 40%, rgba(11,11,20,.15) 100%); }
  .hero-tint-4 { background: linear-gradient(180deg, rgba(11,11,20,0) 40%, rgba(11,11,20,.82) 100%), radial-gradient(55% 60% at 22% 42%, rgba(11,11,20,.55) 0%, rgba(11,11,20,0) 100%); }
  .hero-inner { position: relative; width: 100%; padding-top: 30px; padding-bottom: 26px; }
  .hero-guest, .hero-dash { display: flex; flex-direction: column; gap: 22px; }
  :global(html.lr-authed) .hero-guest { visibility: hidden; }
  .hero-head { display: flex; flex-direction: column; gap: 16px; }
  .hero-inner .eyebrow { margin: 0; font-size: 12px; font-weight: 600; }
  .hero-title { margin: 0; font-size: clamp(38px, 5.4vw, 68px); line-height: .98; text-shadow: 0 2px 24px rgba(11,11,20,.55); }
  .hero-title-dash { font-size: clamp(30px, 4.4vw, 56px); line-height: 1; }
  .hero-sub { margin: 0; max-width: 760px; font-size: 18px; line-height: 1.6; color: #EDEBF2; font-weight: 500; text-wrap: balance; text-shadow: 0 1px 12px rgba(11,11,20,.9), 0 0 2px rgba(11,11,20,.6); }
  .htiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 10px; }
  .htile { position: relative; display: flex; flex-direction: column; background: rgba(20,20,31,.88); border: 1px solid rgba(200,200,222,.18); border-radius: 8px; overflow: hidden; backdrop-filter: blur(6px); color: var(--lr-text); text-decoration: none; transition: border-color .15s, transform .15s; }
  .htile:hover, .htile:focus-visible { border-color: var(--lr-orange); transform: translateY(-2px); outline: none; }
  .htile-img { position: relative; display: block; aspect-ratio: 16 / 6.4; overflow: hidden; background: var(--lr-raised); }
  .htile-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
