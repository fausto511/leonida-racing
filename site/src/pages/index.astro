---
// Home — Redesign Phase 3 (DEC-0116, mockup boards Home guest / active driver /
// new driver / phone). Order: Hero → Time Attack band → GTA 6 Rankings →
// Community → Guide → Discord band. Everything a guest sees is in the HTML;
// the logged-in dashboard, live leaderboard, live events/crews and the
// rotations are filled in by scripts/home.ts.
// COPY STATUS: all new texts are Claude placeholders from the mockup
// (Codex brief Claude outputs/Codex-Brief-Home-Redesign-2026-10-11.md, DEC-0088).
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../data/site';
import { homeLbRow } from '../data/home';
import { sampleEntries, overallRows } from '../data/leaderboard';
import { vehicleOptions, isMoneyMetric, statsFeed, statsTotals, statLabels, formatVehicleValueHtml, type VehicleOption } from '../data/vehicles';
import { classSlug } from '../data/garage-taxonomy';
import { guideSections, GUIDE_UPDATED } from '../data/guide';
import { rankings, rankingEntries } from '../data/rankings';

const base = import.meta.env.BASE_URL;
const N = vehicleOptions.length; // DEC-0117: N always from data
const DISCORD_INVITE_URL = 'https://discord.gg/hPGuBwXRqT';
const TA = `${base}time-attack/gellhorn-international-raceway/`;

// ---- Fresh in the database (RS-0130, Fausto 16./18.11.2026): newest stats first. Hidden until the
// first value is published, so nothing announces data that isn't there yet. Counters come from the data.
// COPY STATUS: Codex review 18.11., decided by Fausto (RS-0130).
const fresh = statsFeed.slice(0, 5);
const FRESH_CHIPS = 3;
const absDate = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
// money values as on the vehicle page ($24,500); everything else as the rankings show it
const chipValue = (v: (typeof fresh)[number]['changes'][number]['value']) => isMoneyMetric(v.metric)
  ? `$${Math.round(v.value).toLocaleString('en-US')}` : formatVehicleValueHtml(v);
const statChip = (c: (typeof fresh)[number]['changes'][number]) => `${statLabels[c.metric]}${c.tuning === 'tuned' ? ' (tuned)' : ''}${c.value.condition ? ` (${c.value.condition})` : ''}`;

// ---- Time Attack band: sample top 5 until real laps exist ----
const sampleTop = overallRows(sampleEntries, false).slice(0, 5);
const sampleTopHtml = sampleTop.map(({ e, rank }) => homeLbRow({ rank, driver: e.driver, crew: e.crew, car: `${e.make} ${e.model}`, ms: e.lap_time_ms })).join('');
const TA_CHIPS = ['Super', 'Sports', 'Muscle', 'Coupes', 'Off-Road'];

// ---- GTA 6 Rankings (Fausto 27.11.2026): top 3 of each car ranking, 4 tiles at a time. Replaces
// "Fastest at Gellhorn" (class records), which repeated the Time Attack band right above it.
// Tile photo = the #1 car (else the first top-3 car with a photo); rows show logos, no car photos.
// Rotation per page load in scripts/home.ts: never two tiles with the same #1 car at once.
// Gellhorn reference lap joins as a tile once that ranking has 3 cars.
// COPY STATUS: titles/sublines = Claude 27.11.2026, approved by Fausto in the mockup; Codex review open (DEC-0088).
const RANK_TILES: { slug: string; title: string; sub: string; icon: string; cta: string }[] = [
  { slug: 'best', title: 'Best road rating', sub: 'In-game, stock', icon: 'road', cta: 'All road ratings' },
  { slug: 'best-off-road', title: 'Best off-road', sub: 'Off-road rating · in-game, stock', icon: 'off', cta: 'All off-road ratings' },
  { slug: 'fastest', title: 'Highest speed', sub: 'Speed stat · in-game, stock', icon: 'speed', cta: 'All speed stats' },
  { slug: 'quickest', title: 'Best acceleration', sub: 'Acceleration stat · in-game, stock', icon: 'acc', cta: 'All acceleration stats' },
  { slug: 'most-expensive', title: 'Most expensive', sub: 'Cost to register', icon: 'gem', cta: 'All prices' },
  { slug: 'cheapest', title: 'Cheapest', sub: 'Cost to register', icon: 'sale', cta: 'All prices' },
  { slug: 'most-valuable', title: 'Best sell value', sub: 'Typical price when you sell', icon: 'dollar', cta: 'All sell values' },
  { slug: 'gellhorn-lap', title: 'Fastest at Gellhorn', sub: 'Reference lap · stock', icon: 'lap', cta: 'All lap times' },
];
const RANK_ICON: Record<string, string> = {
  road: '<path d="M9 3 5 21M15 3l4 18M12 5v2M12 11v2M12 17v2"/>',
  off: '<path d="m3 18 5-7 4 5 3-4 6 6"/>',
  speed: '<path d="m12 14 4-4"/><path d="M3.3 17a9 9 0 1 1 17.4 0"/>',
  acc: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  gem: '<path d="M6 3h12l4 6-10 12L2 9z"/><path d="M2 9h20M12 21 8 9l4-6 4 6z"/>',
  sale: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><path d="m8 13 5-5"/><circle cx="8.5" cy="8.5" r=".8"/><circle cx="12.5" cy="12.5" r=".8"/>',
  dollar: '<path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  lap: '<path d="M10 2h4M12 14l3-3"/><circle cx="12" cy="14" r="8"/>',
};
const rankTiles = RANK_TILES.flatMap((t) => {
  const r = rankings.find((x) => x.slug === t.slug);
  if (!r) return [];
  const top = rankingEntries(r).slice(0, 3);
  if (top.length < 3) return []; // a tile needs a full top 3
  const photo = top.find((e) => e.vehicle.photo)?.vehicle ?? null;
  return [{ ...t, href: `${base}${r.path}`, top, photo, lead: top[0].vehicle.id }];
});
// Without JavaScript: the first four tiles with different #1 cars.
const rankShown = new Set<string>();
{ const leads = new Set<string>(); for (const t of rankTiles) if (rankShown.size < 4 && !leads.has(t.lead)) { rankShown.add(t.slug); leads.add(t.lead); } }
// money as on the vehicle page and in the Fresh chips ($87,400), so names keep their room
const rankValue = (v: (typeof rankTiles)[number]['top'][number]['value']) => isMoneyMetric(v.metric) ? `$${Math.round(v.value).toLocaleString('en-US')}` : formatVehicleValueHtml(v);
const rankLogo = (v: VehicleOption) => `${base}images/logos/${v.logoSlug}-gta-6-logo.svg`;

// ---- Community: loading rows in the HTML; the browser fills in live rows, and only
// falls back to the sample rows when nothing live comes back (no flash of fake data, Fausto 15.10.)
const skel = (n: number, tag: boolean) => Array.from({ length: n }, () => `<div class="crow crow-sk" aria-hidden="true"><span class="sk sk-${tag ? 'tag' : 'date'}"></span><span class="sk-main"><span class="sk sk-l1"></span><span class="sk sk-l2"></span></span></div>`).join('');
const eventsHtml = skel(3, false);
const crewsHtml = skel(4, true);

// ---- Guide: three random cards, no fixed card (Fausto 23.11.2026; never "not-confirmed") ----
const GUIDE_CARD: Record<string, { img: string; line: string; title?: string }> = {
  // racing / vehicles / customization: image, title and sentence from the mockup (DEC-0116 board Home)
  racing: { img: 'guide/street-race', title: 'Racing in GTA VI', line: 'Circuit, off-road, and street racing, each shown with a live race HUD.' },
  vehicles: { img: 'guide/classic-collection-car', title: 'Vehicles in GTA VI', line: 'Which names Rockstar confirmed, and which are community IDs.' },
  customization: { img: 'guide/whisler-motorsport', title: 'Customization and mod shops', line: 'Named mod shops, from detailed interiors and donk builds to lifted off-road rigs.' },
  driving: { img: 'guide/driving', line: 'What Rockstar has said about the rebuilt driving physics so far.' },
  theft: { img: 'guide/slim-jim', line: 'Stealing, scanning, selling and registering cars, as Rockstar described it.' },
  ownership: { img: 'guide/safehouse', line: 'Garages, storage spaces and the safehouse vehicles shown so far.' },
  classics: { img: 'guide/classic-collection-wyman', line: 'Classic cars, restoration and special builds from the Ultimate Edition.' },
  gellhorn: { img: 'guide/gellhorn-finish-line', line: 'The paved circuit behind Gellhorn Time Attack, and what is known about it.' },
  tires: { img: 'guide/gellhorn-rental-lineup', title: 'Tires and grip', line: 'Tire types, their reported handling effects, and what to check before buying.' },
  standouts: { img: 'guide/drifter-elegy-garage', title: 'Standouts and special finds', line: 'Standout builds, where to find them, and what to check before changing their parts.' },
  'car-culture': { img: 'guide/car-meet', line: 'Car meets, takeovers and the details that give Leonida’s car scene its character.' },
};
const guideCards = guideSections.filter((s) => s.id !== 'not-confirmed' && GUIDE_CARD[s.id]);
// Without JavaScript the first three are shown; the script picks three at random.
const GUIDE_DEFAULT = ['racing', 'vehicles', 'customization'];
const guideOrdered = [...guideCards.filter((s) => GUIDE_DEFAULT.includes(s.id)), ...guideCards.filter((s) => !GUIDE_DEFAULT.includes(s.id))];
const guideUpdated = new Date(`${GUIDE_UPDATED}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const home = new URL(base, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    alternateName: ['leonidaracing.com'], // Google site name (search results), 25.10.
    url: home,
    inLanguage: 'en',
    description: 'GTA VI racing database and community: vehicles with verified classes, proof-based lap-time leaderboards, and a hub for racing events and crews.',
    keywords: 'GTA 6, GTA VI, Grand Theft Auto VI, GTA 6 cars, GTA 6 racing, GTA 6 crews, GTA 6 car meets',
    about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI', alternateName: ['GTA VI', 'GTA 6'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: home,
    logo: new URL(`${base}images/logo-512.png`, Astro.site).href,
    // Official channels (Fausto 04.11.2026). TikTok/Instagram follow once the accounts exist.
    sameAs: [DISCORD_INVITE_URL, 'https://www.youtube.com/@LeonidaRacingSociety', 'https://www.facebook.com/LeonidaRacing/', 'https://x.com/leonidaracing', 'https://www.reddit.com/r/LeonidaRacing/'],
  },
];
const arrowSvg = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const discordPath = 'M20.33 4.23C18.78 3.5 17.12 2.97 15.38 2.67C15.17 3.06 14.92 3.58 14.74 3.99C12.9 3.71 11.07 3.71 9.26 3.99C9.09 3.58 8.83 3.06 8.62 2.67C6.88 2.97 5.21 3.5 3.66 4.23C0.53 8.97 -0.32 13.58 0.1 18.14C2.18 19.69 4.19 20.63 6.17 21.25C6.66 20.58 7.1 19.86 7.48 19.11C6.76 18.83 6.07 18.5 5.43 18.11C5.6 17.98 5.77 17.85 5.93 17.71C9.88 19.56 14.17 19.56 18.07 17.71C18.23 17.85 18.4 17.98 18.57 18.11C17.92 18.5 17.24 18.84 16.52 19.11C16.9 19.86 17.33 20.58 17.82 21.25C19.8 20.63 21.82 19.69 23.9 18.14C24.4 12.86 23.05 8.28 20.33 4.23ZM8.01 15.34C6.83 15.34 5.86 14.23 5.86 12.88C5.86 11.53 6.81 10.43 8.01 10.43C9.22 10.43 10.19 11.53 10.17 12.88C10.17 14.23 9.22 15.34 8.01 15.34ZM15.99 15.34C14.8 15.34 13.83 14.23 13.83 12.88C13.83 11.53 14.78 10.43 15.99 10.43C17.19 10.43 18.17 11.53 18.14 12.88C18.14 14.23 17.19 15.34 15.99 15.34Z';
---
<Base
  title="Leonida Racing — GTA VI Racing Database & Community"
  description="The home of GTA 6 car culture and motorsport: compare cars, set lap times at Gellhorn International Raceway, and find crews and events across Vice City and Leonida."
  jsonLd={jsonLd}
>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <picture class="hero-bg">
      <source type="image/webp" srcset={`${base}images/home/home-hero-640.webp 640w, ${base}images/home/home-hero-1080.webp 1080w, ${base}images/home/home-hero-1562.webp 1562w`} sizes="100vw" />
      <img src={`${base}images/home/home-hero-1562.jpg`} alt="" width="1562" height="1007" loading="eager" fetchpriority="high" />
    </picture>
    <span class="hero-tint hero-tint-1" aria-hidden="true"></span>
    <span class="hero-tint hero-tint-2" aria-hidden="true"></span>
    <span class="hero-tint hero-tint-3" aria-hidden="true"></span>
    <span class="hero-tint hero-tint-4" aria-hidden="true"></span>

    <div class="wrap hero-inner">
      <!-- guest -->
      <div class="hero-guest" id="hero-guest">
        <div class="hero-head">
          <p class="eyebrow">GTA VI Racing Database &amp; Community</p>
          <h1 class="display hero-title">The Home of<br /> GTA VI Car Culture</h1>
        </div>
        <p class="hero-sub">Get the stats on GTA VI cars and see what racers drive. Put down a time at Gellhorn. Find your crew, your next rival, or a car meet to roll up to.</p>
        <div class="htiles">
          {[
            { href: `${base}cars/`, img: 'vehicles/declasse-mamba-gt', eb: 'Database', name: 'Cars', line: 'Check the specs. Find your next car.' },
            { href: TA, img: 'gellhorn-raceway', eb: 'Gellhorn', name: 'Time Attack', line: 'Submit a lap. Move up the leaderboard.' },
            { href: `${base}community/`, img: 'hub/hub-carmeet', eb: 'Events & Crews', name: 'Community', line: 'Find races, crews, and car meets.' },
            { href: `${base}guide/`, img: 'home/guide-tile', eb: 'Sourced', name: 'Guide', line: 'Facts, not rumors. All sourced.' },
          ].map((t) => (
            <a href={t.href} class="htile lr-hcard lr-hlift">
              <span class="htile-img"><img class="lr-hzoom" src={`${base}images/${t.img}-640.webp`} alt="" width="640" height="360" loading="eager" /><span class="htile-go" set:html={arrowSvg} /></span>
              <span class="htile-body"><span class="htile-eb">{t.eb}</span><span class="htile-name">{t.name}</span><span class="htile-live">{t.line}</span></span>
            </a>
          ))}
        </div>
      </div>

      <!-- logged in: dashboard (filled by scripts/home.ts) -->
      <div class="hero-dash" id="hero-dash" hidden>
        <p class="eyebrow">Your dashboard</p>
        <h2 class="display hero-title hero-title-dash" id="dash-title">Welcome</h2>
        <div class="htiles">
          <a class="mtile lr-hcard" id="dash-lap" href={`${base}account/laps/`}>
            <span class="mtile-top"><span class="mtile-ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg></span><span class="htile-eb">Your best lap</span><span class="mtile-go" set:html={arrowSvg} /></span>
            <span class="mtile-val" data-val>…</span><span class="mtile-sub" data-sub>&nbsp;</span>
          </a>
          <a class="mtile lr-hcard" id="dash-garage" href={`${base}account/`}>
            <span class="mtile-top"><span class="mtile-ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21V9l9-6 9 6v12M7 21v-7h10v7"/></svg></span><span class="htile-eb">My garage</span><span class="mtile-go" set:html={arrowSvg} /></span>
            <span class="mtile-val" data-val>…</span><span class="mbar"><i data-bar style="width:0%"></i></span><span class="mtile-sub" data-sub>&nbsp;</span>
          </a>
          <a class="mtile lr-hcard" id="dash-crew" href={`${base}account/crew/`}>
            <span class="mtile-top"><span class="mtile-ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span class="htile-eb">Your crew</span><span class="mtile-go" set:html={arrowSvg} /></span>
            <span class="mtile-val" data-val>…</span><span class="mtile-sub" data-sub>&nbsp;</span>
          </a>
          <a class="mtile lr-hcard" id="dash-events" href={`${base}account/events/`}>
            <span class="mtile-top"><span class="mtile-ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg></span><span class="htile-eb">Events</span><span class="mtile-go" set:html={arrowSvg} /></span>
            <span class="mtile-val" data-val>…</span><span class="mtile-sub" data-sub>&nbsp;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Fresh in the database (RS-0130) ===== -->
  {fresh.length > 0 && (
    <section class="wrap hsec hsec-first" aria-labelledby="fresh-title">
      <div class="hsec-head">
        <div class="hsec-titles">
          <p class="eyebrow">Live data</p>
          <h2 class="lr-h2 display hsec-title" id="fresh-title">Fresh in the database</h2>
          <p class="hsec-sub">New top speeds, lap times and costs to register.</p>
        </div>
        <a href={`${base}cars/`} class="arrow">All cars →</a>
      </div>
      <div class="fgrid">
        <div class="card flist">
          <div class="flist-head"><h3>Latest updates</h3></div>
          {fresh.map((u) => (
            <a class="frow" href={`${base}cars/vehicles/${u.vehicle.id}/`}>
              <span class="frow-img">
                {u.vehicle.photo
                  ? <img src={`${base}images/vehicles/${u.vehicle.id}-640.webp`} alt="" width="640" height="360" loading="lazy" />
                  : <img class="frow-logo" src={`${base}images/logos/${u.vehicle.logoSlug}-gta-6-logo.svg`} alt="" width="40" height="40" loading="lazy" />}
              </span>
              <span class="frow-main">
                <span class="frow-name"><b>{u.vehicle.make} {u.vehicle.model}</b><span class="frow-cls">{u.vehicle.classes[0]}</span></span>
                <span class="frow-chips">
                  {u.changes.slice(0, FRESH_CHIPS).map((c) => (
                    <span class="fchip">{statChip(c)} <b class="tnum" set:html={chipValue(c.value)} />{c.prev && <s class="tnum" set:html={chipValue(c.prev)} />}</span>
                  ))}
                  {u.changes.length > FRESH_CHIPS && <span class="fchip fchip-more">+{u.changes.length - FRESH_CHIPS} more</span>}
                </span>
              </span>
              <span class="frow-meta">
                <span class:list={['ftag', { 'is-new': u.isNew }]}>{u.isNew ? 'New' : 'Updated'}</span>
                <time datetime={u.at} data-rel>{absDate(u.at)}</time>
              </span>
            </a>
          ))}
        </div>
        <div class="fside">
          <div class="card fglance">
            <p class="eyebrow">At a glance</p>
            <div class="fg-row"><span>Cars with stats</span><b class="display tnum">{statsTotals.cars}</b></div>
            <div class="fg-row"><span>Stats published</span><b class="display tnum">{statsTotals.values}</b></div>
            {statsTotals.lastAt && <div class="fg-row"><span>Last update</span><b><time datetime={statsTotals.lastAt} data-rel>{absDate(statsTotals.lastAt)}</time></b></div>}
          </div>
          <div class="card fnote">
            <h3><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>Waiting on a car?</h3>
            <p>Tap the heart on its page or add it to My garage. A dot on your avatar shows you when its stats are in.</p>
            <a class="btn btn-s btn-md" href={`${base}cars/`}>Browse cars</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ===== Time Attack band ===== -->
  <section class:list={['wrap hsec', { 'hsec-first': fresh.length === 0 }]}>
    <div class="hsec-head">
      <div class="hsec-titles">
        <p class="eyebrow">Time Attack</p>
        <h2 class="lr-h2 display hsec-title">Gellhorn International Raceway</h2>
        <p class="hsec-sub">One track, every car, one leaderboard. Set a lap, upload your proof, climb the board.</p>
      </div>
      <a href={TA} class="arrow">Full leaderboard →</a>
    </div>
    <div class="card tband" id="tband">
      <a href={TA} class="tband-link" aria-label="Open the Gellhorn leaderboard"></a>
      <div class="tband-img">
        <picture>
          <source type="image/webp" srcset={`${base}images/gellhorn-raceway-640.webp 640w, ${base}images/gellhorn-raceway-760.webp 760w, ${base}images/gellhorn-raceway-1080.webp 1080w`} sizes="(max-width: 760px) calc(100vw - 40px), 640px" />
          <img src={`${base}images/gellhorn-raceway-1672.jpg`} alt="Gellhorn International Raceway" width="1672" height="941" loading="lazy" />
        </picture>
        <div class="tband-actions">
          <a href={`${base}time-attack/submit/`} class="btn btn-p">Submit a lap</a>
          <a href={`${base}time-attack/how-it-works/`} class="btn btn-s btn-glass">How it works</a>
        </div>
      </div>
      <div class="tband-board">
        <div class="tband-head"><h3 id="tband-title">Top 5 · overall</h3><span class="muted" id="tband-flag" title="Fictional drivers and times. Real laps replace them as soon as the first ones are published." hidden>sample until first laps</span></div>
        <div class="tband-rows" id="tband-rows" data-sample={sampleTopHtml} />
        <div class="tband-chips">
          <span class="tband-chips-label">By class</span>
          {TA_CHIPS.map((c) => <a href={`${TA}?class=${classSlug(c)}`} class="chip chip-sm">{c}</a>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== GTA 6 Rankings (Fausto 27.11.2026) ===== -->
  {rankTiles.length >= 4 && (
  <section class="wrap hsec">
    <div class="hsec-head">
      <div class="hsec-titles">
        <p class="eyebrow">Top 3</p>
        <h2 class="lr-h2 display hsec-title">GTA 6 Rankings</h2>
        <p class="hsec-sub">The top 3 cars in each ranking, every value read in the game. Tap a ranking for the full list.</p>
      </div>
    </div>
    <div class="rk-grid" id="rank-tiles">
      {rankTiles.map((t) => (
        <a class="rkt card" href={t.href} data-lead={t.lead} data-rotate={rankShown.has(t.slug) ? 'shown' : 'pool'}>
          <div class="rkt-hd">
            <p class="rkt-t"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={RANK_ICON[t.icon]} /><span>{t.title}</span></p>
            <p class="rkt-s">{t.sub}</p>
          </div>
          <div class="rkt-ph">
            {t.photo
