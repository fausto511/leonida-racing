---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../data/site';
import '../styles/hub.css';
import { sampleCrews, sampleEventsUpcoming } from '../data/hub';
import { homeCrewCard, homeEventCard } from '../data/home';
import { LAUNCH_DATE, LAUNCH_AT, LAUNCH_LABEL } from '../data/launch';
import VehicleTile from '../components/VehicleTile.astro';
import { vehicleOptions } from '../data/vehicles';
const base = import.meta.env.BASE_URL;
// Featured Cars on the home page (Fausto, 2026-10-01). Change the ids here.
const FEATURED_CAR_IDS = ['grotti-cheetah-95', 'declasse-mamba-gt', 'dundreary-sirius', 'schyster-deviant'];
const featuredCars = FEATURED_CAR_IDS.map((id) => {
  const v = vehicleOptions.find((x) => x.id === id);
  if (!v) throw new Error(`Featured car not found: ${id}`);
  return v;
});
const home = new URL(base, Astro.site).href;
const crewsHtml = sampleCrews.slice(0, 4).map(homeCrewCard).join('');
const eventsHtml = sampleEventsUpcoming().filter((e) => e.status !== 'cancelled').slice(0, 4).map(homeEventCard).join('');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: home,
    inLanguage: 'en',
    description: 'GTA VI racing database and community: vehicles with verified classes, proof-based lap-time leaderboards, and a hub for racing events and crews.',
    // Not shown on the page: search engines also get the common "GTA 6"
    // spelling here (visible text always says "GTA VI", 2026-09-30).
    keywords: 'GTA 6, GTA VI, Grand Theft Auto VI, GTA 6 cars, GTA 6 racing, GTA 6 crews, GTA 6 car meets',
    about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI', alternateName: ['GTA VI', 'GTA 6'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: home,
    logo: new URL(`${base}images/logo-512.png`, Astro.site).href,
    sameAs: ['https://discord.gg/hPGuBwXRqT'],
  },
];
---
<Base
  title="Leonida Racing — GTA VI Racing Database & Community"
  description="Explore the GTA 6 car database, submit lap times at Gellhorn International Raceway, and find crews, events, and car meets across Vice City and Leonida."
  jsonLd={jsonLd}
>
  <!-- Home layout (Fausto, 2026-09-28): full-width hero image over roughly
       the top two thirds, thin white line, then the normal background with
       Crews and Events strips. Hero image: Visual/Cars/gellhorn-race.png
       (car-maker badge removed in the source file, 06.10.2026). -->
  <section class="home-hero">
    <picture class="home-hero-bg">
      <source type="image/webp" srcset={`${base}images/home/home-hero-640.webp 640w, ${base}images/home/home-hero-1080.webp 1080w, ${base}images/home/home-hero-1562.webp 1562w`} sizes="100vw" />
      <img src={`${base}images/home/home-hero-1562.jpg`} alt="Race cars battling on a palm-lined race track in GTA VI" width="1562" height="1007" loading="eager" fetchpriority="high" />
    </picture>
    <div class="home-hero-veil" aria-hidden="true"></div>

    <div class="wrap home-hero-inner">
      <div class="home-intro">
        <p class="eyebrow">GTA VI Racing Database &amp; Community</p>
        <h1 class="display home-title">Find the cars setting the pace.<br />Make your mark on the track.</h1>
        <p class="home-lede">Get the stats on GTA VI cars. See what racers drive and what’s worth a spot in your garage. <br />Put down a time at Gellhorn. Show the community what you’ve got. <br />Find your crew, your next rival, or a car meet to roll up to.</p>
        <div class="home-cta">
          <button type="button" id="home-join" class="btn home-join">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 5.3A18 18 0 0 0 15.9 4l-.3.6a15 15 0 0 1 4 1.6 16 16 0 0 0-13.2 0 15 15 0 0 1 4-1.6L10.1 4a18 18 0 0 0-4.4 1.3C2.9 9 2.2 12.6 2.5 16.1a18 18 0 0 0 5.5 2.8l.8-1.3a11 11 0 0 1-1.9-.9l.5-.4a13 13 0 0 0 9.2 0l.5.4a11 11 0 0 1-1.9.9l.8 1.3a18 18 0 0 0 5.5-2.8c.4-4-.7-7.5-2.2-10.8ZM9.3 14c-.8 0-1.4-.7-1.4-1.6s.6-1.6 1.4-1.6 1.4.7 1.4 1.6-.6 1.6-1.4 1.6Zm5.4 0c-.8 0-1.4-.7-1.4-1.6s.6-1.6 1.4-1.6 1.4.7 1.4 1.6-.6 1.6-1.4 1.6Z"/></svg>
            <span>Login with Discord</span>
          </button>
          <a id="home-account" class="btn btn-white-tonal home-join" href={`${base}account/`} hidden>Go to My Account</a>
        </div>
        <!-- Launch countdown (RS-0050): local midnight, date only (no unlock time announced) -->
        <p class="home-launch" data-launch-date={LAUNCH_DATE} data-launch-at={LAUNCH_AT ?? ''}>
          <span class="launch-dot" aria-hidden="true"></span>
          GTA VI launches <span data-cd-when>{LAUNCH_LABEL}</span>
          <span class="home-launch-row" data-cd-row hidden><strong data-cd="d">–</strong> days <strong data-cd="h">–</strong> hrs <strong data-cd="m">–</strong> min</span>
        </p>
      </div>

      <div class="home-tiles">
        <a class="home-tile" href={`${base}garage/`}>
          <img src={`${base}images/garage/garage-hero-placeholder-640.webp`} srcset={`${base}images/garage/garage-hero-placeholder-640.webp 640w, ${base}images/garage/garage-hero-placeholder-1080.webp 1080w`} sizes="(max-width: 760px) 80vw, 33vw" alt="" width="1672" height="941" loading="lazy" />
          <span class="home-tile-veil" aria-hidden="true"></span>
          <span class="home-tile-copy">
            <span class="eyebrow">Vehicles</span>
            <span class="display home-tile-title">The Garage</span>
            <span class="home-tile-lede">Check the specs. Find your next car.</span>
          </span>
        </a>
        <a class="home-tile" href={`${base}time-attack/gellhorn-international-raceway/`}>
          <picture>
            <source type="image/webp" srcset={`${base}images/gellhorn-raceway-640.webp 640w, ${base}images/gellhorn-raceway-1080.webp 1080w`} sizes="(max-width: 760px) 80vw, 33vw" />
            <img src={`${base}images/gellhorn-raceway-1672.jpg`} alt="" width="1672" height="941" loading="lazy" />
          </picture>
          <span class="home-tile-veil" aria-hidden="true"></span>
          <span class="home-tile-copy">
            <span class="eyebrow">Time Attack</span>
            <span class="display home-tile-title">The Track</span>
            <span class="home-tile-lede">Submit a lap. Move up the leaderboard.</span>
          </span>
        </a>
        <a class="home-tile" href={`${base}hub/`}>
          <picture>
            <source type="image/webp" srcset={`${base}images/hub/hub-carmeet-640.webp 640w, ${base}images/hub/hub-carmeet-1080.webp 1080w`} sizes="(max-width: 760px) 80vw, 33vw" />
            <img src={`${base}images/hub/hub-carmeet-1672.jpg`} alt="Car meet in GTA VI: tuned cars and spectators on a waterfront parking lot" width="1672" height="940" loading="lazy" />
          </picture>
          <span class="home-tile-veil" aria-hidden="true"></span>
          <span class="home-tile-copy">
            <span class="eyebrow">Community</span>
            <span class="display home-tile-title">The Hub</span>
            <span class="home-tile-lede">Find races, crews, and car meets.</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="wrap home-strip">
    <div class="home-strip-head">
      <h2 class="display home-strip-title">Crews</h2>
      <span class="hub-sample-flag" id="home-crew-flag">Sample data</span>
      <a class="home-strip-link" href={`${base}hub/crews/`}>All crews →</a>
    </div>
    <p class="home-strip-lede">Find a crew to race with — drivers who challenge each other, share the grid, and show up as a team.</p>
    <div class="home-row" id="home-crews" set:html={crewsHtml} />
  </section>

  <section class="wrap home-strip home-strip-sep">
    <div class="home-strip-head">
      <h2 class="display home-strip-title">Events</h2>
      <span class="hub-sample-flag" id="home-ev-flag">Sample data</span>
      <a class="home-strip-link" href={`${base}hub/events/`}>All events →</a>
    </div>
    <p class="home-strip-lede">Find races, league rounds, community playlists, and car meets. All start times are shown in your time zone.</p>
    <div class="home-row" id="home-events" set:html={eventsHtml} />
  </section>

  <!-- Featured Cars (Fausto, 2026-10-01): four hand-picked vehicles with photos,
       same tile as The Garage. -->
  <section class="wrap home-strip home-strip-sep">
    <div class="home-strip-head">
      <h2 class="display home-strip-title">Featured Cars</h2>
      <a class="home-strip-link" href={`${base}garage/`}>All Vehicles →</a>
    </div>
    <p class="home-strip-lede">Check the specs. Find your next car.</p>
    <div class="home-row home-cars" id="home-cars">
      {featuredCars.map((v) => <VehicleTile vehicle={v} />)}
    </div>
  </section>

  <!-- Discord band (Fausto, 2026-09-28): full-width, Discord blurple,
       straight rectangle (no slant, Fausto 2026-09-28), big headline + two actions. -->
  <section class="home-band" aria-labelledby="home-band-title">
    <div class="wrap home-band-inner">
      <div class="home-band-copy">
        <h2 class="display home-band-title" id="home-band-title">Ready to Race?</h2>
        <p class="home-band-text">Join the Leonida Racing Discord to talk cars and see what the scene is organizing. Meet racers, find events, connect with hosts and creators — or bring something of your own to the community.</p>
        <div class="home-band-actions">
          <button type="button" class="btn home-band-btn home-band-primary" id="band-join">Login with Discord</button>
          <a class="btn home-band-btn home-band-primary" id="band-account" href={`${base}account/`} hidden>Go to My Account</a>
          <a class="btn home-band-btn home-band-outline" href="https://discord.gg/hPGuBwXRqT" target="_blank" rel="noopener">Join our Discord</a>
        </div>
      </div>
      <svg viewBox="0 0 24 24" width="220" height="220" class="home-cta-logo" fill="currentColor" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
    </div>
  </section>
</Base>

<style>
  [hidden] { display: none !important; }

  /* ---- Hero: image over ~2/3 of the viewport, thin white line below ---- */
  .home-hero {
    position: relative;
    min-height: calc(66vh - var(--gh-header-h));
    min-height: calc(66svh - var(--gh-header-h));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: 1px solid var(--gh-line); /* same hairline as under the header */
  }
  .home-hero-bg, .home-hero-bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  /* Colour wash like thesimgrid.com (Fausto, 2026-09-28): a 120deg red ->
     burgundy -> dark-purple veil at 70 % over the photo, plus a top-to-bottom
     fade into the page background so the image has no hard bottom edge. */
  .home-hero-veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(rgba(20,20,26,0) 0%, rgb(20,20,26) 100%),
      linear-gradient(120deg, rgba(176,40,60,.7) 0%, rgba(90,30,48,.7) 45%, rgba(43,26,43,.7) 75%, rgba(26,20,32,.7) 100%);
  }
  .home-hero-inner { position: relative; width: 100%; padding-block: clamp(2rem, 4.5vw, 3.25rem) clamp(1.5rem, 3vw, 2rem); display: grid; gap: clamp(1.75rem, 4vw, 2.75rem); }
  .home-intro { max-width: 64rem; margin-inline: auto; text-align: center; }
  .home-title { margin: .5rem 0 1rem; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1; text-wrap: balance; }
  .home-lede { margin: 0 auto 1.6rem; color: #d9d8e8; font-size: clamp(.95rem, 1.4vw, 1.08rem); line-height: 1.6; max-width: 46rem; }
  .home-launch { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .45rem; margin: 1rem 0 0; color: var(--gh-muted); font-size: .8rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  .home-launch-row[hidden] { display: none; }
  .home-launch strong { font-family: var(--gh-font-display); font-style: italic; font-weight: 900; font-size: 1.1rem; color: var(--gh-text); }
  .home-launch .launch-dot { width: .45rem; height: .45rem; border-radius: 50%; background: var(--gh-yellow); }
  .home-cta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .6rem 1rem; }
  /* Discord's own colour for the sign-in button, as in the header. */
  .home-join { gap: .6rem; padding: .95rem 1.5rem; font-size: 1rem; }
  #home-join { background: #5865f2; color: #fff; border: none; cursor: pointer; }
  #home-join:hover { filter: brightness(1.1); }

  .home-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .home-tile {
    position: relative; display: flex; align-items: flex-end; aspect-ratio: 2 / 1; overflow: hidden;
    border-radius: var(--gh-radius-lg); border: 1px solid rgba(252,250,247,.18); text-decoration: none; color: var(--gh-text);
    background: var(--gh-surface); transition: border-color .15s, transform .15s;
  }
  .home-tile:hover, .home-tile:focus-visible { border-color: rgba(252,250,247,.55); transform: translateY(-2px); }
  .home-tile picture, .home-tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .home-tile-veil { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(20,20,26,.95) 5%, rgba(20,20,26,.45) 60%, rgba(20,20,26,.25)); transition: background .15s; }
  .home-tile:hover .home-tile-veil { background: linear-gradient(0deg, rgba(20,20,26,.9) 5%, rgba(20,20,26,.25) 60%, rgba(20,20,26,.1)); }
  .home-tile-copy { position: relative; display: flex; flex-direction: column; gap: .25rem; padding: 1rem 1.1rem; }
  .home-tile-title { font-size: clamp(1.4rem, 2.2vw, 1.8rem); }
  .home-tile-lede { color: var(--gh-muted); font-size: .82rem; }

  /* ---- Strips below the line ---- */
  .home-strip { padding-top: clamp(2.25rem, 5vw, 3.25rem); }
  .home-strip + .home-strip { padding-top: clamp(1.75rem, 4vw, 2.5rem); }
  .home-strip-head { display: flex; align-items: center; gap: .75rem; margin-bottom: .35rem; }
  .home-strip-lede { margin: 0 0 1rem; color: var(--gh-muted); font-size: .9rem; }
  .home-strip-title { margin: 0; font-size: 1.5rem; }
  .home-strip-link { margin-left: auto; color: var(--gh-muted); font-size: .85rem; font-weight: 700; text-decoration: none; }
  .home-strip-link:hover { color: var(--gh-text); }
  .home-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }

  :global(.hc-card) { display: flex; flex-direction: column; gap: .65rem; padding: 1rem; background: var(--gh-surface); border: 1px solid var(--gh-line); border-radius: var(--gh-radius-lg); text-decoration: none; color: var(--gh-text); transition: border-color .15s; min-width: 0; }
  :global(.hc-card:hover) { border-color: var(--gh-muted); }
  :global(.hc-top) { display: flex; align-items: center; gap: .7rem; min-width: 0; }
  :global(.hc-top .crew-emblem) { width: 2.6rem; height: 2.6rem; flex: none; }
  :global(.hc-name) { display: block; margin: 0; font-weight: 800; font-size: .95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.hc-sub) { display: block; margin: .1rem 0 0; color: var(--gh-muted); font-size: .76rem; }
  :global(.hc-chips) { display: flex; flex-wrap: wrap; gap: .3rem; }
  /* event card: image by type, title first, date small (2026-09-30) */
  :global(.he-card) { padding: 0; gap: 0; overflow: hidden; }
  :global(.he-img) { position: relative; display: block; aspect-ratio: 16 / 8; background: rgba(160,160,198,.08); }
  :global(.he-img img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  :global(.he-type) { position: absolute; top: .6rem; left: .6rem; background: rgba(20,20,26,.8); }
  :global(.he-body) { display: flex; flex-direction: column; gap: .35rem; padding: .85rem 1rem 1rem; }
  :global(.he-title) { display: block; margin: 0; font-weight: 800; font-size: 1.02rem; line-height: 1.3; }
  :global(.he-when) { display: block; color: var(--gh-text); font-size: .8rem; font-weight: 600; }
  :global(.he-tz) { color: var(--gh-muted); font-size: .7rem; font-weight: 500; }
  :global(.he-meta) { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; margin: 0; color: var(--gh-muted); font-size: .78rem; }

  .home-strip-sep { position: relative; margin-top: clamp(2rem, 4.5vw, 3rem); }
  /* hairline across the content width only, like the header line style */
  .home-strip-sep::before { content: ''; position: absolute; top: 0; left: clamp(1.25rem, 4vw, 2.5rem); right: clamp(1.25rem, 4vw, 2.5rem); border-top: 1px solid var(--gh-line); }

  /* ---- Discord band ---- */
  .home-band {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: calc(-1 * var(--gh-gap-section)); /* sits right on the footer line */
    background: #5865f2;
    color: #fff;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .home-band-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .home-band-copy { max-width: 40rem; }
  .home-band-title { margin: 0 0 .9rem; font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1; color: #fff; }
  .home-band-text { margin: 0 0 1.75rem; font-size: clamp(.95rem, 1.4vw, 1.05rem); line-height: 1.6; color: rgba(255,255,255,.88); }
  .home-band-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .home-band-btn { padding: .95rem 1.6rem; font-size: 1rem; border-radius: var(--gh-radius); cursor: pointer; }
  .home-band-primary { background: #fff; color: #4752c4; border: 2px solid #fff; }
  .home-band-primary:hover { background: #eef0ff; }
  .home-band-outline { background: transparent; color: #fff; border: 2px solid #fff; }
  .home-band-outline:hover { background: rgba(255,255,255,.12); }
  .home-cta-logo { flex: none; width: clamp(8rem, 16vw, 13.5rem); height: auto; color: rgba(255,255,255,.85); }

  @media (max-width: 1000px) {
    .home-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .home-hero { min-height: 0; }
    .home-join { width: 100%; }
    .home-title { font-size: clamp(1.5rem, 6.6vw, 1.9rem); }
    .home-lede br { display: none; } /* one flowing paragraph on phones */
    /* tiles and strips scroll sideways on phones instead of stacking */
    .home-tiles, .home-row { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--wrap-pad, 1.25rem); gap: .75rem; margin-inline: calc(-1 * var(--wrap-pad, 1.25rem)); padding-inline: var(--wrap-pad, 1.25rem); scrollbar-width: none; }
    .home-tiles::-webkit-scrollbar, .home-row::-webkit-scrollbar { display: none; }
    .home-tile, :global(.home-row > .hc-card) { flex: 0 0 78%; scroll-snap-align: start; }
    :global(.home-cars > .v-tile) { flex: 0 0 78%; scroll-snap-align: start; }
    .home-tile { aspect-ratio: 16 / 9; }
    .home-cta-logo { display: none; }
    .home-band-btn { flex: 1 1 100%; }
  }
</style>

<script>
  import { initVehicleTiles } from '../scripts/vehicle-tiles';
  initVehicleTiles(document.getElementById('home-cars') ?? document);
</script>

<script>
  import '../scripts/launch-countdown';
  import { backendConfigured, getSupabase } from '../scripts/supabase-client';
  import { fetchLiveCrews, fetchLiveEvents, pickFeaturedCrews } from '../scripts/hub-live';
  import { homeCrewCard, homeEventCard } from '../data/home';
  import { localizeTimes } from '../data/hub';

  localizeTimes(document.getElementById('home-events')!);

  const join = document.getElementById('home-join') as HTMLButtonElement;
  const account = document.getElementById('home-account')!;

  if (backendConfigured) {
    const sb = getSupabase();
    const bandJoin = document.getElementById('band-join')!;
    const bandAccount = document.getElementById('band-account')!;
    const show = (signedIn: boolean) => { join.hidden = signedIn; account.hidden = !signedIn; bandJoin.hidden = signedIn; bandAccount.hidden = !signedIn; };
    const login = () => sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    bandJoin.addEventListener('click', login);
    sb.auth.getSession().then(({ data }) => show(Boolean(data?.session)));
    sb.auth.onAuthStateChange((_e, s) => show(Boolean(s)));
    join.addEventListener('click', () => {
      sb.auth.signInWithOAuth({ provider: 'discord', options: { redirectTo: window.location.origin + window.location.pathname, scopes: 'identify email guilds.join' } });
    });
  } else {
    join.addEventListener('click', () => { window.open('https://discord.gg/hPGuBwXRqT', '_blank', 'noopener'); });
  }

  fetchLiveCrews().then((live) => {
    if (!live || !live.length) return;
    document.getElementById('home-crews')!.innerHTML = pickFeaturedCrews(live, 4).map(homeCrewCard).join('');
    document.getElementById('home-crew-flag')!.hidden = true;
  });
  fetchLiveEvents().then((live) => {
    // Next events by start time (Fausto, 2026-10-03); running ones stay until they end, cancelled/finished drop out
    const endOf = (e: { starts_at: string; ends_at: string | null }) => new Date(e.ends_at ?? new Date(new Date(e.starts_at).getTime() + 3 * 3600e3).toISOString()).getTime();
    const next = (live ?? []).filter((e) => e.status !== 'cancelled' && endOf(e) > Date.now()).sort((a, b) => a.starts_at.localeCompare(b.starts_at)).slice(0, 4);
    if (!next.length) return;
    const root = document.getElementById('home-events')!;
    root.innerHTML = next.map(homeEventCard).join('');
    localizeTimes(root);
    document.getElementById('home-ev-flag')!.hidden = true;
  });
</script>
