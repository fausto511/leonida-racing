---
import '../styles/tokens.css';
import '../styles/fonts.css';
// Preload the two fonts every page uses above the fold (CLS fix 2026-10-04).
import fontDisplayUrl from '../assets/fonts/archivo-wdth112-latin.woff2?url';
import fontTextUrl from '../assets/fonts/instrument-sans-latin.woff2?url';
import ConsentBar from '../components/ConsentBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { SITE_NAME, SITE_TAGLINE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** false = no " | Leonida Racing" suffix (vehicle detail pages). */
  brandSuffix?: boolean;
  section?: 'time-attack' | 'garage' | 'hub' | 'guide' | 'account' | 'moderator' | null;
  noindex?: boolean;
  /** Path below the base, e.g. 'images/x.jpg'. Defaults to the 1200x630 share image of the section (RS-0050). */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Page trail below Home for BreadcrumbList JSON-LD, e.g. [{ name: 'The Garage', path: 'cars/' }, ...]. */
  breadcrumbs?: { name: string; path: string }[];
  /** schema.org objects rendered as JSON-LD (home page: WebSite + Organization). */
  jsonLd?: Record<string, unknown>[];
}
// Share/preview images, 1200x630 (Fausto, 2026-10-15): each section uses its own
// header image with the pink-orange tint and the LR mark, so Google results and
// Discord embeds are recognizable. Chosen by URL path (most specific first);
// vehicle pages pass their photo or generated card (scripts/og-cards.mjs).
const ogByPath: { prefix: string; path: string; alt: string }[] = [
  { prefix: '/community/events/', path: 'images/og/og-events.jpg', alt: 'Leonida Racing logo over a GTA VI car meet scene' },
  { prefix: '/community/crews/', path: 'images/og/og-crews.jpg', alt: 'Leonida Racing logo over a GTA VI crew scene' },
  { prefix: '/community/tracks/', path: 'images/og/og-tracks.jpg', alt: 'Leonida Racing logo over a race car on a GTA VI circuit' },
  { prefix: '/community/', path: 'images/og/og-community.jpg', alt: 'Leonida Racing logo over a GTA VI car meet' },
  { prefix: '/cars/', path: 'images/og/og-cars.jpg', alt: 'Leonida Racing logo over cars on a Vice City street in GTA VI' },
  { prefix: '/time-attack/', path: 'images/og/og-time-attack.jpg', alt: 'Leonida Racing logo over the palm-lined Gellhorn circuit in GTA VI' },
  { prefix: '/tracks/', path: 'images/og/og-time-attack.jpg', alt: 'Leonida Racing logo over the palm-lined Gellhorn circuit in GTA VI' },
  { prefix: '/guide/', path: 'images/og/og-guide-v2.jpg', alt: 'Leonida Racing logo over a white Grotti Cheetah in GTA VI' },
];
const ogDefault = { path: 'images/og/og-home.jpg', alt: 'Leonida Racing logo over GTA VI race cars on a palm-lined circuit' };
const { title, description, section = null, noindex = false, jsonLd = [], breadcrumbs = [], brandSuffix = true } = Astro.props;
const og = ogByPath.find((o) => Astro.url.pathname.startsWith(o.prefix)) ?? ogDefault;
const ogImage = Astro.props.ogImage ?? og.path;
const ogImageAlt = Astro.props.ogImageAlt ?? og.alt;
const ogImageWidth = Astro.props.ogImageWidth ?? (Astro.props.ogImage ? undefined : 1200);
const ogImageHeight = Astro.props.ogImageHeight ?? (Astro.props.ogImage ? undefined : 630);
const base = import.meta.env.BASE_URL;
// Every page title ends with the brand (DEC-0082), unless it already contains it (home)
// or the page opts out (vehicle detail pages, approved copy 2026-10-01).
// <title>, og:title and twitter:title use "GTA 6" (search spelling); visible page text keeps "GTA VI" (RS-0044).
const fullTitle = (title.includes(SITE_NAME) || !brandSuffix ? title : `${title} | ${SITE_NAME}`).replace(/\bGTA VI\b/g, 'GTA 6');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(`${base}${ogImage}`, Astro.site).href;
const allJsonLd = [...jsonLd];
if (breadcrumbs.length) {
  const trail = [{ name: 'Home', path: '' }, ...breadcrumbs];
  allJsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(`${base}${b.path}`, Astro.site).href })),
  });
}
---
<!doctype html>
<!-- Inline dark background + color-scheme: the page never flashes white
     while the stylesheet is still loading on navigation (2026-09-26). -->
<html lang="en" style="background:#0B0B14;color-scheme:dark">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={fontDisplayUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontTextUrl} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0B0B14" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <meta name="application-name" content={SITE_NAME} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="text/plain" title={`${SITE_NAME} — ${SITE_TAGLINE} (for AI assistants)`} href={`${base}llms.txt`} />
    {allJsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(allJsonLd.length === 1 ? allJsonLd[0] : allJsonLd)} />}
    <!-- Favicon: white LR mark on the pink-to-orange Vice Night gradient (Visual/Logos/lrs-favicon.png), Redesign Phase 1, 2026-10-14 -->
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header section={section} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <ConsentBar />
  </body>
</html>
